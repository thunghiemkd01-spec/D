    if remoteHackEvent == ev then return end

    if AH.ReleaseTap then AH.ReleaseTap() end
    ReleaseRemoteHack()

    remoteHackToken = remoteHackToken + 1
    remoteHackEvent = ev
    local myToken = remoteHackToken
    SetRemoteHackColor()

    task.spawn(function()
        while remoteHackActive and myToken == remoteHackToken do
            if not comp.Parent or not ev.Parent or IsComputerDone(comp) then break end
            pcall(function()
