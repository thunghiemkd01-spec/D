function MG.Valid(w)
    if MG.Known[w] then return true end
    local r = MG.LLM(MG.Prompt .. "\n\nright now you are only checking ONE word for validity. answer with exactly one word: yes or no. yes only if it is a real standard english dictionary word (not a proper noun, not slang, not an abbreviation, not made up, not another language).",
        "word: " .. w, 8)
    if not r then return true end
    return string.find(string.lower(r), "^%s*yes") ~= nil
end

function MG.PickBot(letter)
    local cands = {}
    local list = MG.Chain[letter]
    if list then
        for w in string.gmatch(list, "%a+") do
            if not MG.Used[w] then cands[#cands + 1] = w end
        end
    end
    if #cands > 0 then
        local best, bs
        for _, w in ipairs(cands) do
            local ll = MG.Chain[string.sub(w, -1)]
            local n = 0
            if ll then
                for x in string.gmatch(ll, "%a+") do
                    if not MG.Used[x] then n = n + 1 end
                end
            end
            local sc = n + math.random() * 3
            if not bs or sc < bs then best, bs = w, sc end
        end
        return best
    end
    local used = {}
    for w in pairs(MG.Used) do used[#used + 1] = w end
    local r = MG.LLM(MG.Prompt .. "\n\nright now reply with exactly ONE common standard english word (lowercase letters only, 3 to 10 letters) that starts with the requested letter and is not in the used list. no punctuation, no explanation.",
        "letter: " .. letter .. "\nused words: " .. table.concat(used, ", "), 8)
    if r then
        local w = string.match(string.lower(r), "%a+") or ""
        if #w >= 3 and string.sub(w, 1, 1) == letter and not MG.Used[w] then return w end
    end
    return nil
end

