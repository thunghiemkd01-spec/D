local realCache = setmetatable({}, { __mode = "k" })
local function ComputeReal(v, map)
    if v.Name ~= "ComputerTable" or not v:IsA("Model") or not IsInWorld(v) then return false end

    local screen = v:FindFirstChild("Screen")
    if not screen or not screen:IsA("BasePart") then return false end
    if map and not v:IsDescendantOf(map) then return false end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and v:IsDescendantOf(p.Character) then return false end
    end

    local anc = v.Parent
    while anc and anc ~= Workspace do
        if anc.Name == "ComputerTable" then return false end
        anc = anc.Parent
    end
    return true
end

local function IsRealComputer(v, map)
    local now = os.clock()
    local c = realCache[v]
    if c and c.map == map and now - c.at < 2 then return c.r end
    local r = ComputeReal(v, map)
    realCache[v] = { at = now, map = map, r = r }
    return r
end

