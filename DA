CB.BodyguardMatch = { on = FH.MatchOn(), generation = 0, readyAt = 0, deadline = 0, attempted = true }
function CB.CheckBodyguardMatch()
    local state, now = CB.BodyguardMatch, os.clock()
    local on = FH.MatchOn()
    if on ~= state.on then
        state.on, state.generation = on, state.generation + 1
        state.readyAt = on and now + 20 or 0
        state.deadline, state.attempted = on and now + 30 or 0, not on
    end
    if not on or state.attempted or now > state.deadline then return end
    local role = FH.Stat(LocalPlayer, FH.BEASTN)
    if not role then return end -- Never infer Survivor from missing role data.
    if role.Value == true then state.attempted = true return end
    if role.Value ~= false or now < state.readyAt or not CB.Active or not CB.CanSpeak() then return end
    state.attempted = true
    local generation = state.generation
    CB.Say(CB.TipText, true, nil, false, function()
        local currentRole = FH.Stat(LocalPlayer, FH.BEASTN)
        return state.generation == generation and FH.MatchOn()
            and os.clock() >= state.readyAt and os.clock() <= state.deadline
            and currentRole and currentRole.Value == false
    end)
end
