-- AI chỉ phân loại hội thoại; các hành động dưới đây chỉ nhận lệnh trực tiếp từ người chơi.
function Cmd.Norm(s)
    s = string.lower(s or "")
    s = string.gsub(s, "[^%w]+", " ")
    s = string.gsub(s, "%s+", " ")
    return string.match(s, "^%s*(.-)%s*$") or ""
end

function Cmd.Has(t, list)
    local p = " " .. t .. " "
    for _, kw in ipairs(list) do
        if string.find(p, " " .. kw .. " ", 1, true) then return true end
    end
    return false
end

