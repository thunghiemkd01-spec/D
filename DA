local function setCharacterTransparency(transparency)
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = transparency
            end
        end
    end
end

local InvisBody = {
    Model = nil,
    Color = Color3.fromRGB(175, 190, 215),
    OutlineColor = Color3.fromRGB(205, 215, 235),
    FillTransparency = 0.75,
    OutlineTransparency = 0.55,
}

function InvisBody.Hide()
    local m = InvisBody.Model
    InvisBody.Model = nil
    if m then pcall(function() m:Destroy() end) end
end

function InvisBody.Show()
    InvisBody.Hide()

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local body
    local oldArchivable = character.Archivable
    pcall(function()
        character.Archivable = true
        body = character:Clone()
    end)
    pcall(function() character.Archivable = oldArchivable end)

    if body then
        for _, d in ipairs(body:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = true
                d.CanCollide = false
                d.CanTouch = false
                d.CanQuery = false
                d.CastShadow = false
                d.Color = InvisBody.Color
                d.Material = Enum.Material.SmoothPlastic
                d.Reflectance = 0
                d.Transparency = (d.Name == "HumanoidRootPart") and 1 or 0
                if d:IsA("MeshPart") then
                    pcall(function() d.TextureID = "" end)
                end
            elseif not (d:IsA("Accessory") or d:IsA("Model") or d:IsA("DataModelMesh")
                or d:IsA("Attachment") or d:IsA("JointInstance") or d:IsA("Folder")) then
                pcall(function() d:Destroy() end)
            end
        end
    else
        body = Instance.new("Model")
        New("Part", body, {
            Size = Vector3.new(2, 5, 1), CFrame = root.CFrame, Anchored = true,
            CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false,
            Color = InvisBody.Color, Material = Enum.Material.SmoothPlastic,
        })
    end

    body.Name = "NovaBody"
    New("Highlight", body, {
        Name = "NovaBodyHL", Adornee = body,
        FillColor = InvisBody.Color, OutlineColor = InvisBody.OutlineColor,
        FillTransparency = InvisBody.FillTransparency,
        OutlineTransparency = InvisBody.OutlineTransparency,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    })
    body.Parent = Workspace
    InvisBody.Model = body
end

