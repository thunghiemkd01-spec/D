function TR.Hold(ev)
    if not TR.CanRun() then TR.Release() return false end
    if AH.ReleaseTap then AH.ReleaseTap() end
    if Follow.Held or Follow.KeyDown then Follow.Release() end
    if AR.Held or AR.KeyDown then AR.Release() end
    local now = os.clock()
    if ev and RemoteEvent and (now - TR.InAt > 0.2 or TR.Held ~= ev) then
        TR.InAt = now
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", true, ev)
            RemoteEvent:FireServer("Input", "Action", true)
        end)
        TR.Held = ev
    end
    if VIM and not TR.KeyDown and not UserInputService:GetFocusedTextBox() then
        Ctl.EUntil = os.clock() + 0.5
        pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
        TR.KeyDown = true
    end
end

function TR.Release()
    local h, kd = TR.Held, TR.KeyDown
    TR.Held, TR.KeyDown, TR.InAt = nil, false, 0
    if kd and VIM then
        Ctl.EUntil = os.clock() + 0.5
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
    end
    if h and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", false, h)
            RemoteEvent:FireServer("Input", "Action", false)
        end)
    end
end

function TR.FindDoor(from, forward)
    local mr = RootNow()
    if not mr then return nil, nil end
    local bestD, bestT, bd = nil, nil, 10
    local function scan(list)
        for _, d in ipairs(list) do
            if d:IsA("Model") and IsInWorld(d) then
                local trigs = FH.Triggers(d)
                if #trigs > 0 and #trigs <= 8 then
                    for _, t in ipairs(trigs) do
                        if t.Parent then
                            local dist = (t.Position - mr.Position).Magnitude
                            if from and forward and (t.Position - from):Dot(forward) < -1 then
                                dist = dist + 10
                            end
                            if dist < bd then bestD, bestT, bd = d, t, dist end
                        end
                    end
                end
            end
        end
    end
    scan(Doors)
    scan(ExitDoors)
    return bestD, bestT
end

function TR.Loop(token)
    local function ok() return not unloaded and TR.Active and TR.Token == token end
    while ok() do
        if not TR.CanRun() then
            TR.BusyFlag = false
            TR.Release()
            task.wait(0.05)
            continue
        end
        local trig = TR.Trig
        if not (trig and trig.Parent) then
            TR.Door, TR.Trig = TR.FindDoor()
            trig = TR.Trig
        end
        local root = RootNow()
        if root and trig and (trig.Position - root.Position).Magnitude <= 7 then
            TR.BusyFlag = true
            local ev = trig:FindFirstChild("Event")
            local t0 = os.clock()
            while ok() and TR.CanRun() and os.clock() - t0 < TR.HoldTime do
                TR.Hold(ev)
                task.wait(0.05)
            end
            if TR.Token ~= token then return end
            TR.Release()
            local t1 = os.clock()
            while ok() and os.clock() - t1 < TR.Gap do task.wait(0.03) end
        else
            TR.BusyFlag = false
            TR.Release()
            task.wait(0.25)
        end
    end
    if TR.Token ~= token then return end
    TR.Release()
    if TR.Token == token and TR.Active and not unloaded then TR.Stop() end
end

function TR.TargetLoop(token)
    local function ok() return not unloaded and TR.Active and TR.Mode == "target" and TR.Token == token end
    local heldAt, gapUntil, doorAt = 0, 0, 0
    while ok() do
        local target = TR.Target
        local targetChar = target and target.Parent == Players and target.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local root, hum = RootNow(), GetHumanoid()
        if target and target.Parent ~= Players then
            TR.Target = nil
            TR.OpenPicker()
        end
        if not invis_on or not TR.CanRun() or not targetRoot or not targetHum or targetHum.Health <= 0
            or not root or not hum or hum.Health <= 0 then
            TR.BusyFlag = false
            TR.Release()
            TR.SetNoclip(false)
            heldAt, gapUntil, doorAt = 0, 0, 0
            TR.SetLabel()
            task.wait(0.1)
            continue
        end
        TR.BusyFlag = true
        -- Use an offset in front of their facing direction, never their body position.
        FH.CancelMotion("follow")
        TR.SetNoclip(true)
        local forward = Vector3.new(targetRoot.CFrame.LookVector.X, 0, targetRoot.CFrame.LookVector.Z)
        if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, -1) else forward = forward.Unit end
        local pos = targetRoot.Position + forward * TR.FrontDistance
        root.CFrame = CFrame.lookAt(pos, pos + forward)
        root.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity
        root.AssemblyAngularVelocity = Vector3.zero
        local now = os.clock()
        if now >= doorAt then
            doorAt = now + 0.12
            local oldTrig = TR.Trig
            TR.Door, TR.Trig = TR.FindDoor(targetRoot.Position, forward)
            if oldTrig ~= TR.Trig then TR.Release() heldAt, gapUntil = 0, 0 end
        end
        local trig = TR.Trig
        if trig and trig.Parent and (trig.Position - root.Position).Magnitude <= 7 and now >= gapUntil then
            if heldAt == 0 then heldAt = now end
            if now - heldAt >= TR.HoldTime then
                TR.Release()
                heldAt, gapUntil = 0, now + TR.Gap
            else
                TR.Hold(trig:FindFirstChild("Event"))
            end
        else
            TR.Release()
            heldAt = 0
        end
        TR.SetLabel()
        task.wait(0.05)
    end
    -- A superseded loop must never release the new mode's E or collision ownership.
    if TR.Token ~= token then return end
    TR.BusyFlag = false
    TR.Release()
    TR.SetNoclip(false)
end

