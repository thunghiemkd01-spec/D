local hideIndex = 1

local HideTP = {
    MinSize = 2.5,
    MaxSize = 14,
    DedupeDist = 0.75,
    RescanEvery = 4,
    LastScan = 0,
    Debug = false,
    Strict = true,
    BadWords = { "barrier", "fake", "dummy", "decoration" },
}

function HideTP.Bounds(inst)
    local minV, maxV
    local function add(p)
        local cf, s = p.CFrame, p.Size
        local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
        local h = Vector3.new(
            (math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z) / 2,
            (math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z) / 2,
            (math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z) / 2
        )
        local lo, hi = cf.Position - h, cf.Position + h
        if minV then
            minV = Vector3.new(math.min(minV.X, lo.X), math.min(minV.Y, lo.Y), math.min(minV.Z, lo.Z))
            maxV = Vector3.new(math.max(maxV.X, hi.X), math.max(maxV.Y, hi.Y), math.max(maxV.Z, hi.Z))
        else
            minV, maxV = lo, hi
        end
    end

    if inst:IsA("BasePart") then
        add(inst)
    else
        local desc = inst:GetDescendants()
        for pass = 1, 2 do
            for i = 1, #desc do
                local p = desc[i]
                if p:IsA("BasePart") and (pass == 2 or p.Transparency < 0.95) then add(p) end
            end
            if minV then break end
        end
    end

    if not minV then return nil, nil end
    return (minV + maxV) / 2, maxV - minV
end

function HideTP.NameOk(name, extra)
    return IsHideSpotName(name) or (extra and IsExtraHideName(name))
end

function HideTP.HasInteraction(inst)
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then return true end
        if d.Parent and d.Parent:IsA("BasePart") and (d.Name == "Event" or d.Name == "RemoteEvent") then
            return true
        end
        if d:IsA("BasePart") and string.find(string.lower(d.Name), "trigger", 1, true) then
            return true
        end
    end
    return false
end

function HideTP.InCharacter(v)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and v:IsDescendantOf(p.Character) then return true end
    end
    return false
end

function HideTP.InnerCount(inst, extra)
    local n = 0
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("Model") and HideTP.NameOk(d.Name, extra) then
            local c, s2 = HideTP.Bounds(d)
            if c and math.max(s2.X, s2.Y, s2.Z) >= HideTP.MinSize then
                n = n + 1
                if n >= 2 then return n end
            end
        end
    end
    return n
end

function HideTP.HasNamedInner(inst)
    for _, d in ipairs(inst:GetDescendants()) do
        if (d:IsA("Model") or d:IsA("BasePart")) and HideTP.NameOk(d.Name, true) then return true end
    end
    return false
end

function HideTP.IsSpot(inst, extra)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    if not HideTP.NameOk(inst.Name, extra) then return false end
    local center, size = HideTP.Bounds(inst)
    if not center then return false end
    local m = math.max(size.X, size.Y, size.Z)
    if m < HideTP.MinSize or m > HideTP.MaxSize then return false end
    if inst:IsA("Model") and HideTP.InnerCount(inst, extra) >= 2 then return false end
    return true
end

function HideTP.InsideOther(inst, extra)
    local anc = inst.Parent
    while anc and anc ~= Workspace do
        if anc:IsA("Model") and HideTP.IsSpot(anc, extra) then return true end
        anc = anc.Parent
    end
    return false
end

function HideTP.Blacklisted(v)
    local cur = v
    while cur and cur ~= Workspace do
        local l = string.lower(cur.Name)
        for i = 1, #HideTP.BadWords do
            if string.find(l, HideTP.BadWords[i], 1, true) then return true end
        end
        cur = cur.Parent
    end
    return false
end

function HideTP.Why(v, extra)
    if not IsInWorld(v) then return "khong con trong workspace" end
    if not (v:IsA("Model") or v:IsA("BasePart")) then return "sai class" end
    if not HideTP.NameOk(v.Name, extra) then return "ten khong khop" end
    if HideTP.Blacklisted(v) then return "do trang tri (barrier/fake/...)" end

    local center, size = HideTP.Bounds(v)
    if not center then return "khong co part de do kich thuoc" end
    local m = math.max(size.X, size.Y, size.Z)
    if m < HideTP.MinSize then return string.format("qua nho (%.1f)", m) end
    if m > HideTP.MaxSize then return string.format("qua lon (%.1f)", m), "big" end

    if v:IsA("Model") and HideTP.InnerCount(v, extra) >= 2 then
        return "la nhom (>=2 tu ben trong)"
    end
    if HideTP.InsideOther(v, extra) then return "nam trong 1 tu khac" end
    if HideTP.InCharacter(v) then return "thuoc nhan vat" end

    local lname = string.lower(v.Name)
    local needsTrigger = extra or (string.find(lname, "cabinet", 1, true) ~= nil and size.Y < 4)
    if needsTrigger and not HideTP.HasInteraction(v) then
        return "can trigger nhung khong co"
    end
    return nil
end

function HideTP.Refresh(force, wholeWorkspace)
    local now = os.clock()
    if not force and now - HideTP.LastScan < HideTP.RescanEvery then return end
    HideTP.LastScan = now

    local root = (not wholeWorkspace and GetCurrentMap()) or Workspace
    local list = root:GetDescendants()
    for i = 1, #list do
        local v = list[i]
        if v.Parent then OnWorkspaceAdded(v) end
    end
end

local function UnderSpotFolder(v)
    local anc = v.Parent
    while anc and anc ~= Workspace do
        local l = string.lower(anc.Name)
        if string.find(l, "hidingspot", 1, true) or string.find(l, "hidespot", 1, true)
            or string.find(l, "hidingplace", 1, true) then
            return true
        end
        anc = anc.Parent
    end
    return false
end

function HideTP.Collect()
    local spots, seen = {}, {}

    local restrict = false
    for _, list in ipairs({ HideCandidates, HideExtra }) do
        for _, v in ipairs(list) do
            if IsInWorld(v) and UnderSpotFolder(v) then restrict = true break end
        end
        if restrict then break end
    end

    local function add(v)
        if restrict and not UnderSpotFolder(v) then return end
        local center, size = HideTP.Bounds(v)
        if not center then return end
        local floorY = center.Y - size.Y / 2
        local y = math.max(center.Y, floorY + 3.2)
        local goal = CFrame.new(center.X, y, center.Z) * v:GetPivot().Rotation

        for _, s in ipairs(spots) do
            if (s.Pos - goal.Position).Magnitude < HideTP.DedupeDist then return end
        end
        spots[#spots + 1] = { Inst = v, Pos = goal.Position, Goal = goal }
    end

    local function try(v, extra)
        if seen[v] then return end
        seen[v] = true

        local why, kind = HideTP.Why(v, extra)
        if not why then
            add(v)
        elseif kind == "big" and not HideTP.HasNamedInner(v) and not HideTP.InCharacter(v)
            and not HideTP.Blacklisted(v) then
            for _, c in ipairs(v:GetChildren()) do
                if (c:IsA("Model") or c:IsA("BasePart")) and not seen[c] then
                    seen[c] = true
                    local cc, cs = HideTP.Bounds(c)
                    if cc then
                        local cm = math.max(cs.X, cs.Y, cs.Z)
                        if cm >= HideTP.MinSize and cm <= HideTP.MaxSize and HideTP.HasInteraction(c) then
                            add(c)
                        end
                    end
                end
            end
        end
    end

    for _, v in ipairs(HideCandidates) do try(v, false) end
    for _, v in ipairs(HideExtra) do try(v, true) end

    if HideTP.Strict and #spots > 0 then
        local interCount = 0
        for _, s in ipairs(spots) do
            s.Inter = HideTP.HasInteraction(s.Inst)
            if s.Inter then interCount = interCount + 1 end
        end
        if interCount >= 3 then
            local kept = {}
            for _, s in ipairs(spots) do
                if s.Inter or string.lower(s.Inst.Name) == "locker" then
                    kept[#kept + 1] = s
                end
            end
            spots = kept
        end
    end

    return spots
end

function HideTP.GetSpots()
    HideTP.Refresh(false, false)

    local now = os.clock()
    local cache = HideState.Cache
    if cache and not HideState.Dirty and now - HideState.CacheAt < HideTP.RescanEvery then
        for i = 1, #cache do
            if not IsInWorld(cache[i].Inst) then cache = nil break end
        end
        if cache then return cache end
    end

    HideState.Dirty = false
    local spots = HideTP.Collect()

    if #spots == 0 then
        HideTP.Refresh(true, true)
        spots = HideTP.Collect()
    end

    table.sort(spots, function(a, b)
        if math.abs(a.Pos.X - b.Pos.X) > 0.1 then return a.Pos.X < b.Pos.X end
        if math.abs(a.Pos.Z - b.Pos.Z) > 0.1 then return a.Pos.Z < b.Pos.Z end
        return a.Pos.Y < b.Pos.Y
    end)

    HideState.Cache = spots
    HideState.CacheAt = os.clock()
    HideState.Dirty = false
    return spots
end

local function FlashText(btn, text, orig, t)
