-- Máy xong: màn hình Bright green / xanh lá / trong suốt (giống ESP Comp)
local function IsComputerDone(comp)
    local screen = comp and comp:FindFirstChild("Screen")
    if not screen or not screen:IsA("BasePart") then return false end
    if screen.Transparency > 0.5 or screen.BrickColor == BRIGHT_GREEN then return true end
    local c = screen.Color
    return c.G > 0.4 and c.G > c.R * 1.4 and c.G > c.B * 1.4
end

local function FindNearestComputerTrigger(maxDist)
    local root = RootNow()
    if not root then return nil, nil end

    local map = GetCurrentMap()
    local bestEvent, bestComp, bestDist = nil, nil, maxDist or math.huge
    local rootPos = root.Position

    for _, comp in ipairs(Computers) do
        if IsRealComputer(comp, map) and not IsComputerDone(comp) then
            for _, t in ipairs(comp:GetDescendants()) do
                if t:IsA("BasePart") and t.Name:sub(1, 15) == "ComputerTrigger" then
                    local ev = t:FindFirstChild("Event")
                    if ev then
                        local d = (t.Position - rootPos).Magnitude
                        if d < bestDist then
                            bestDist, bestEvent, bestComp = d, ev, comp
                        end
                    end
                end
            end
        end
    end
    return bestEvent, bestComp
end

local function ReleaseRemoteHack()
    local ev = remoteHackEvent
    remoteHackToken = remoteHackToken + 1
    remoteHackEvent = nil
    SetRemoteHackColor()

    if ev and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", false, ev)
            RemoteEvent:FireServer("Input", "Action", false)
        end)
    end
end

local function LockOnNearestComputer()
    if not remoteHackActive or not RemoteEvent then return end

