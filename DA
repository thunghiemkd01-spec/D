function CB.QuizKey(text)
    return string.gsub(string.lower(text or ""), "[^%w]", "")
end

function CB.NextQuiz()
    for _, quiz in ipairs(CB.QuizBank) do
        local key = CB.QuizKey(quiz[1])
        if not CB.QuizUsed[key] then return quiz[1], quiz[2], key end
    end
    CB.QuizSerial = CB.QuizSerial + 1
    local n = CB.QuizSerial + 12
    local question = string.format("math pit stop: what is %d times %d? my fridge brain needs a calculator.", n, n + 3)
    return question, tostring(n * (n + 3)), CB.QuizKey(question)
end

function CB.QuizLoop(token)
    while not unloaded and CB.Active and CB.Token == token do
        task.wait(1)
        if CB.CurrentQuiz and os.clock() - CB.CurrentQuiz.at >= 110 then
            local answer = CB.CurrentQuiz.answer
            CB.CurrentQuiz = nil
            CB.Say("quiz answer: " .. answer .. ". your brain may now return to escaping the beast.")
        end
        if os.clock() >= CB.NextQuizAt and CB.CanSpeak() and not MG.Active and not CB.QuizPending then
            local question, answer, key = CB.NextQuiz()
            CB.QuizPending = true
            local queued = CB.Say("quiz time! " .. question, false, function(sent)
                if CB.Token ~= token then return end
                CB.QuizPending = false
                if sent then
                    CB.QuizUsed[key] = true
                    CB.CurrentQuiz = { answer = answer, at = os.clock() }
                    CB.NextQuizAt = os.clock() + 620
                else
                    CB.NextQuizAt = os.clock() + 30
                end
            end)
            if not queued then CB.QuizPending = false end
        end
    end
end

-- A chat message can request AutoHelp; the feature owns its task and cancellation.
-- Turning chat off or starting an unrelated command cannot invalidate this request.
function AR.CancelRequest()
    local requestState = AR.Request
    if not requestState then return false end
    AR.Request = nil
    AR.RequestSerial = (AR.RequestSerial or 0) + 1
    AR.Release(requestState.token)
    FH.ReleaseMotion(requestState.token, true)
    AR.SetBusy(false)
    return true
end

function AR.RequestPlayer(player)
    if unloaded or not player or player == LocalPlayer or player.Parent ~= Players
        or FH.AmBeast() or not FH.MatchOn() or AH.Down() or Fly.Active or Ctl.On() then
        return false
    end
    if not FH.True(player, FH.RAG) and not FH.True(player, FH.CAP) then return false end

    -- A rescue request replaces an older command or requested rescue, then releases its lease on completion.
    Cmd.FollowDirectiveTarget, Cmd.FarmDirective = nil, false
    AR.CancelRequest()
    Cmd.CancelFlip()
    Cmd.Cleanup(Cmd.Token)
    Cmd.Token = Cmd.Token + 1
    Cmd.AimUnbind()
    FH.CancelMotion()
    pcall(Follow.Release)
    pcall(TR.Release)

    AR.RequestSerial = (AR.RequestSerial or 0) + 1
    local requestState = { player = player, id = AR.RequestSerial, started = os.clock(), userRequested = true }
    local tok = { owner = "rescue", priority = 110, userRequest = true }
    requestState.token = tok
    AR.Request = requestState
    tok.ok = function()
        return not unloaded and AR.Request == requestState and AR.RequestSerial == requestState.id
            and player.Parent == Players and os.clock() - requestState.started < 55
            and FH.MatchOn() and not AH.Down() and not Fly.Active and not Ctl.On() and not FH.AmBeast()
            and (FH.True(player, FH.RAG) or FH.True(player, FH.CAP))
    end
    local function goal()
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        return root and root.Position
    end
    local function runnable()
        return tok.ok() and FH.MotionAvailable(tok)
    end

    task.spawn(function()
        local ok, err = pcall(function()
            while tok.ok() do
                if not runnable() then
                    AR.Release(tok)
                    FH.ReleaseMotion(tok, false)
                    AR.SetBusy(false)
                    task.wait(0.08)
                else
                    AR.SetBusy(true)
                    if FH.True(player, FH.CAP) then
                        local pod
                        for _, info in ipairs(AR.Pods()) do
                            if info.owner == player then pod = info break end
                        end
                        if pod then
                            FH.RescuePod(tok, runnable, pod, nil,
                                function(ev, remoteOnly)
                                    if runnable() then AR.Hold(ev, remoteOnly, tok) end
                                end,
                                function() AR.Release(tok) end)
                        end
                    else
                        -- Follow a dragged, downed player; switch to their pod as soon as captured.
                        Follow.WalkTo(tok, goal, 5, function() return FH.True(player, FH.CAP) end,
                            { maxTime = 12, nearOk = 5, windows = true })
                    end
                    task.wait(0.12)
                end
            end
        end)
        if not ok then warn("[AutoHelp request] " .. tostring(err)) end
        AR.Release(tok)
        FH.ReleaseMotion(tok, true)
        if AR.Request == requestState then
            AR.Request = nil
            AR.SetBusy(false)
        end
    end)
    return true
end

