local ExitDoors, Computers, HideCandidates, HideExtra = {}, {}, {}, {}
local Doors, DoorSet = {}, {}
local Tracked = setmetatable({}, { __mode = "k" })
local HideState = { Dirty = true, Cache = nil, CacheAt = 0 }

local HIDE_NAMES = { "locker", "hide", "hiding", "cabinet", "wardrobe" }
local EXTRA_HIDE_NAMES = { "closet", "cupboard", "coffin", "armoire" }

local function MakeMatcher(list)
    local cache = {}
    return function(name)
        local r = cache[name]
        if r == nil then
            r = false
            local l = string.lower(name)
            for i = 1, #list do
                if string.find(l, list[i], 1, true) then r = true break end
            end
            cache[name] = r
        end
        return r
    end
end
local IsHideSpotName = MakeMatcher(HIDE_NAMES)
local IsExtraHideName = MakeMatcher(EXTRA_HIDE_NAMES)
local IsDoorName = MakeMatcher({ "door" })

local function ArrayRemove(arr, inst)
    for i = #arr, 1, -1 do
        if arr[i] == inst then table.remove(arr, i) return end
    end
end

local function OnWorkspaceAdded(v)
    if Tracked[v] then return end
    local n = v.Name
    if n == "ExitDoor" then
        Tracked[v] = true
        ExitDoors[#ExitDoors + 1] = v
    elseif n == "ComputerTable" then
        if v:IsA("Model") then
            Tracked[v] = true
            Computers[#Computers + 1] = v
        end
    elseif IsHideSpotName(n) then
        if v:IsA("Model") or v:IsA("BasePart") then
            Tracked[v] = true
            HideCandidates[#HideCandidates + 1] = v
            HideState.Dirty = true
        end
    elseif IsExtraHideName(n) then
        if v:IsA("Model") or v:IsA("BasePart") then
            Tracked[v] = true
            HideExtra[#HideExtra + 1] = v
            HideState.Dirty = true
        end
    elseif v:IsA("Model") and IsDoorName(n) then
        Tracked[v] = true
        DoorSet[v] = true
        Doors[#Doors + 1] = v
    end
end

local function OnWorkspaceRemoving(v)
    if not Tracked[v] then return end
    Tracked[v] = nil
    local n = v.Name
    if n == "ExitDoor" then
        ArrayRemove(ExitDoors, v)
    elseif n == "ComputerTable" then
        ArrayRemove(Computers, v)
    elseif DoorSet[v] then
        DoorSet[v] = nil
        ArrayRemove(Doors, v)
    else
        ArrayRemove(HideCandidates, v)
        ArrayRemove(HideExtra, v)
        HideState.Dirty = true
    end
end

TrackConnection(Workspace.DescendantAdded:Connect(OnWorkspaceAdded))
TrackConnection(Workspace.DescendantRemoving:Connect(OnWorkspaceRemoving))

