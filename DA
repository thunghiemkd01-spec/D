function CB.SpecialChat(player, text)
    local normalized = Cmd.Norm(text)
    local directive = Cmd.RequestText and Cmd.RequestText(text) or normalized
    local function startsWith(words)
        for _, phrase in ipairs(words) do
            if directive == phrase or string.sub(directive, 1, #phrase + 1) == phrase .. " " then return true end
        end
        return false
    end
    local bareGameWord = MG.Active and MG.Player == player and not string.find(normalized, " ", 1, true)
    if not bareGameWord and startsWith({ "be quiet", "keep quiet", "stop talking", "don t talk", "dont talk", "shut up", "silence", "quiet", "mute" }) then
        CB.MuteUntil = os.clock() + 300
        CB.CurrentQuiz = nil
        for _, item in ipairs(CB.Out) do
            if item.onSent then pcall(item.onSent, false, item.text) end
        end
        table.clear(CB.Out)
        CB.Say("ok, i'll keep quiet. tell me if you want me to speak again", true, nil, true)
        return true
    end
    if startsWith({ "speak again", "talk again", "unmute", "you can talk", "you can speak" }) then
        CB.MuteUntil = 0
        CB.Say("okay, i'm listening again.", true)
        return true
    end
    if Cmd.Has(normalized, CB.HelpWords) and (FH.True(player, FH.RAG) or FH.True(player, FH.CAP)) then
        CB.RequestHelp(player)
        return true
    end
    if not CB.CanSpeak() then return false end
    if not MG.Active and CB.CurrentQuiz and CB.QuizKey(text) == CB.QuizKey(CB.CurrentQuiz.answer) then
        CB.CurrentQuiz = nil
        CB.Say("correct, " .. player.DisplayName .. "! one imaginary trophy, coming right up.", true)
        return true
    end
    if Cmd.Has(normalized, { "exploiter", "exploiting", "hacker", "hacking", "are you a bot" })
        and (CB.IsQuestion(text) or Cmd.Has(normalized, { "are you", "is tom", "you are", "youre", "you re" })) then
        local replies = {
            "i'm tom, a scripted ai helper. the chat ai only routes requests to enabled features; server rules still apply.",
            "i'm an ai chat helper running a script, not a human. i can't promise every server allows these features.",
            "tom is a scripted helper with an ai chat brain. i'm not going to pretend scripts are automatically allowed everywhere.",
        }
        CB.Say(replies[math.random(1, #replies)], true)
        return true
    end
    return false
end

function CB.OnChat(player, msg)
    if unloaded or player == LocalPlayer or type(msg) ~= "string" then return end
    local text = string.match(msg, "^%s*(.-)%s*$") or ""
    if #text < 1 or string.sub(text, 1, 1) == "/" then return end
    if #text > 200 then text = string.sub(text, 1, 200) end

    local key = player.UserId .. ":" .. text
    local now = os.clock()
    if CB.Seen[key] and now - CB.Seen[key] < 2 then return end
    CB.Seen[key] = now
    if math.random() < 0.1 then
        for k, t in pairs(CB.Seen) do
            if now - t > 10 then CB.Seen[k] = nil end
        end
    end

    local name = (player.DisplayName ~= "" and player.DisplayName) or player.Name
    CB.Push(name, text, player)

    CB.LastHumanAt = now
    if not CB.Active then return end
    if Cmd.OnConsentChat and Cmd.OnConsentChat(player, text) then return end
    if CB.SpecialChat(player, text) then return end
    if MG.Active and MG.Player == player and not string.find(Cmd.Norm(text), " ", 1, true) then
        MG.OnChat(player, text)
        return
    end
    if Cmd.Process(player, text) then return end
    if not CB.CanSpeak() then return end

    if MG.OnChat(player, text) then return end
    if MG.TryStart(player, text) then return end

    if CB.InFlight >= 3 then return end
    local should, must = CB.ShouldReply(player, text)
    CB.Dbg("nghe:", name, text, should and "-> tra loi" or "-> bo qua")
    if not should then return end

    local item = { name = name, text = text, at = now, tok = CB.Token, must = must, player = player }
    item.context = CB.ContextMessages(item)
    task.spawn(CB.Handle, item)
end

