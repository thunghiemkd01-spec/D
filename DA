    [Enum.KeyCode.F] = TogglePlayerESP,
    [Enum.KeyCode.G] = TriggerCompESPOnce,
    [Enum.KeyCode.X] = ToggleNoclip,
    [Enum.KeyCode.C] = ToggleSpeed,
    [Enum.KeyCode.V] = ToggleInfJump,
    [Enum.KeyCode.Z] = ToggleInvisUI,
    [Enum.KeyCode.N] = function() TR.Toggle() end,
    [Enum.KeyCode.K] = HideTP.Report,
}

TrackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    local keyCode = input.KeyCode

    if keyCode == Enum.KeyCode.E and not Ctl.IsSelf(keyCode)
        and not UserInputService:GetFocusedTextBox() then
        if remoteHackActive then task.delay(0.1, LockOnNearestComputer) end
    end

    if gameProcessed or UserInputService:GetFocusedTextBox() then return end

    if keyCode == Enum.KeyCode.R then
        ScreenGui.Enabled = not ScreenGui.Enabled
        return
    end

    if keyCode == Enum.KeyCode.T then
        UnloadHack()
        return
    end

    if keyCode == Enum.KeyCode.Tab then
        if Tab1Container.Visible then
            SwitchTab(Tab2Btn, Tab2Container)
        else
            SwitchTab(Tab1Btn, Tab1Container)
        end
        return
    end

    if keyCode == Enum.KeyCode.Zero or keyCode == Enum.KeyCode.KeypadZero then
        Follow.Toggle()
        return
    end

    if TR.Picking then
        local pick = NUM_KEYS[keyCode]
        if pick then
            TR.Select(pick)
            return
        end
    end

    if Follow.Picking then
        if keyCode == Enum.KeyCode.Five or keyCode == Enum.KeyCode.KeypadFive then
            if Follow.RandomActive then Follow.Stop() else Follow.StartRandom() end
            return
        end
        local pick = NUM_KEYS[keyCode]
        if pick then
            Follow.Select(pick)
            return
        end
    end

    if keyCode == Enum.KeyCode.Nine or keyCode == Enum.KeyCode.KeypadNine then
        AH.Toggle()
        return
    end

    if keyCode == Enum.KeyCode.Eight or keyCode == Enum.KeyCode.KeypadEight then
        AR.Toggle()
        return
    end

    if keyCode == Enum.KeyCode.Five or keyCode == Enum.KeyCode.KeypadFive then
        CB.Toggle()
        return
    end




    local num = NUM_KEYS[keyCode]
    if num then
        for _, data in pairs(playerButtons) do
            if data.Index == num and data.Player then
                TeleportToPlayer(data.Player)
                break
            end
        end
    end

    local fn = Keybinds[keyCode]
    if fn then fn() end
end))
