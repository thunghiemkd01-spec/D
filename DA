-- A companion E tap never owns movement or steals an interaction held by another feature.
function AH.ReleaseTap()
    if not AH.TapDown then return end
    AH.TapDown, AH.TapUntil = false, 0
    Ctl.EUntil = os.clock() + 0.3
    if VIM then pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end) end
end

function AH.TapStep()
    local now = os.clock()
    if AH.TapDown and now >= AH.TapUntil then AH.ReleaseTap() end
    if not AH.Active or unloaded or not FH.MatchOn() or FH.AmBeast() or AH.Down()
        or Fly.Active or Ctl.On() or FH.Prio() or UserInputService:GetFocusedTextBox() then
        AH.ReleaseTap()
        return
    end
    if Follow.Held or Follow.KeyDown or AR.Held or AR.KeyDown or TR.Held or TR.KeyDown
        or remoteHackEvent ~= nil then
        AH.ReleaseTap()
        return
    end
    local danger = AH.Eval().danger
    if not danger then
        AH.ReleaseTap()
        AH.NextTapAt = 0
        return
    end
    if VIM and not AH.TapDown and now >= AH.NextTapAt then
        Ctl.EUntil = now + 0.3
        local ok = pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
        AH.NextTapAt = now + 2
        if ok then AH.TapDown, AH.TapUntil = true, now + 0.06 end
    end
end

TrackConnection(RunService.Heartbeat:Connect(function()
    local ok = pcall(AH.TapStep)
    if not ok then AH.ReleaseTap() end
end))

function AH.SetLabel()
    local b = Btn.AutoHide
    if not b then return end
    if not AH.Active then
        b.Text = "AutoHide [9]"
        b.TextColor3 = Theme.Text
    elseif FH.AmBeast() then
        b.Text = "AutoHide [9]: BEAST"
        b.TextColor3 = Theme.SubText
    elseif AH.State == "idle" then
        b.Text = "AutoHide [9]"
        b.TextColor3 = GREEN
    else
        b.Text = "AutoHide [9]: CHAY!"
        b.TextColor3 = RED
    end
end

function AH.SetState(s)
    if AH.State ~= s then
        AH.State = s
        AH.SetLabel()
    end
end

function AH.Down()
    local hum = GetHumanoid()
    return not hum or hum.Health <= 0 or FH.True(LocalPlayer, FH.RAG) or FH.True(LocalPlayer, FH.CAP)
end

function AH.Unsafe(pos, range)
    if not AH.Active then return false end
    local bp = AH.Last and AH.Last.pos
    if not bp then return false end
    return Flat(pos - bp).Magnitude < (range or AH.AvoidRange)
end

function AH.PodsPending()
    return AR.Active and not FH.AmBeast() and #AR.Pods() > 0
end

function AH.Eval()
    local now = os.clock()
    if now - AH.EvalAt < 0.05 then return AH.Last end
    AH.EvalAt = now
    local res = { danger = false, dist = math.huge, pos = nil, vel = nil }
    local mr = RootNow()
    if mr then
        FH.RefreshFilter()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and FH.True(p, FH.BEASTN) then
                local c = p.Character
                local br = c and c:FindFirstChild("HumanoidRootPart")
                if br then
                    local d = (br.Position - mr.Position).Magnitude
                    if d < res.dist then
                        res.dist, res.pos, res.vel = d, br.Position, br.AssemblyLinearVelocity
                    end
                    local vis = d <= AH.NearRange
                    if not vis and d <= AH.SeeRange then
                        local o = br.Position + Vector3.new(0, 1.5, 0)
                        local hit = Workspace:Raycast(o, (mr.Position + Vector3.new(0, 1, 0)) - o, rayParams)
                        vis = hit == nil
                    end
                    if vis then res.danger = true end
                end
            end
        end
    end
    AH.Last = res
    return res
end

function AH.PickFlee(rp, bp)
    local hum, root = GetHumanoid(), RootNow()
    if not (hum and root) then return nil end
    local feetY = FH.Feet(hum, root)
    FH.RefreshFilter()

    local away = Flat(rp - bp)
    if away.Magnitude < 0.5 then away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
    away = away.Unit

    local function pass(minDot, minClosest)
        local best, bestScore
        for i = 0, 15 do
            local a = i * math.pi / 8
            local dir = Vector3.new(math.cos(a), 0, math.sin(a))
            local dot = dir:Dot(away)
            if dot > minDot then
                local free = 45
                for _, h in ipairs({ 1.2, 3.2 }) do
                    local r = Workspace:Raycast(Vector3.new(rp.X, feetY + h, rp.Z), dir * 45, rayParams)
                    if r and r.Normal.Y <= 0.6 then free = math.min(free, r.Distance) end
                end
                local run = free - 2
                if run >= 10 then
                    local cand = rp + dir * run
                    local g = Workspace:Raycast(Vector3.new(cand.X, feetY + 3, cand.Z), Vector3.new(0, -20, 0), rayParams)
                    if g and g.Position.Y - feetY < 4 and feetY - g.Position.Y < 10 then
                        local gp = Vector3.new(cand.X, g.Position.Y + 1.5, cand.Z)
                        local dB = Flat(gp - bp).Magnitude
                        local seg = Flat(gp - rp)
                        local t = math.clamp(Flat(bp - rp):Dot(seg) / math.max(seg:Dot(seg), 1), 0, 1)
                        local closest = (Flat(rp) + seg * t - Flat(bp)).Magnitude
                        if closest > minClosest then
                            local score = dB + run * 0.4 + dot * 15
                            if not best or score > bestScore then best, bestScore = gp, score end
                        end
                    end
                end
            end
        end
        return best
    end

    local best = pass(-0.35, 14) or pass(-1, 6) or pass(-1.01, -1)
    if best then return best end
    return FH.Ground(rp + away * 40)
end

function AH.Scan(rp, dir, feetY)
    local curY, run, jumps = feetY, 0, 0
    local px, pz = rp.X, rp.Z
    local L = AH.SegLen
    for _ = 1, AH.ScanSegs do
        local ny, j = FH.Seg(px, pz, dir, curY, L)
        if not ny then return run, jumps, j end
        if j then jumps = jumps + 1 end
        run = run + L
        px, pz = px + dir.X * L, pz + dir.Z * L
        curY = ny
    end
    return run, jumps, nil
end

function AH.Steer(rp, bp, bvel, feetY, juke)
    local pred = bp
    if bvel then
        local fv = Flat(bvel)
        if fv.Magnitude > 2 then pred = bp + fv * 0.5 end
    end
    local away = Flat(rp - pred)
    if away.Magnitude < 0.5 then away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
    away = away.Unit

    local prev = AH.Dir
    local full = AH.ScanSegs * AH.SegLen

    local function pass(minDot, closestMin, minRun)
        local best, bestScore, bestRun, bestDir
        for i = 0, 11 do
            local a = i * math.pi / 6
            local dir = Vector3.new(math.cos(a), 0, math.sin(a))
            local dot = dir:Dot(away)
            if dot > minDot then
                local run, jumps = AH.Scan(rp, dir, feetY)
                if run >= minRun then
                    local P = rp + dir * run
                    local ok = true
                    if closestMin then
                        local seg = Flat(P - rp)
                        local t = math.clamp(Flat(pred - rp):Dot(seg) / math.max(seg:Dot(seg), 1), 0, 1)
                        local closest = (Flat(rp) + seg * t - Flat(pred)).Magnitude
                        if closest < closestMin then ok = false end
                    end
                    if ok then
                        local after = Flat(P - pred).Magnitude
                        local sc = after + run * 0.8 + dot * (closestMin and 4 or 10)
                        if juke then
                            sc = sc + jumps * 4 + math.random() * 14
                        else
                            sc = sc - jumps * 1.2
                        end
                        if run >= full then sc = sc + 8 end
                        if run < 12 then sc = sc - (12 - run) * 3 end
                        if prev and not juke then sc = sc + math.max(dir:Dot(prev), 0) * 8 end
                        if not bestScore or sc > bestScore then
                            bestScore, best, bestRun, bestDir = sc, P, run, dir
                        end
                    end
                end
            end
        end
        return best, bestRun, bestDir
    end

    local best, bestRun, bestDir = pass(juke and -0.1 or -0.3, nil, 4)
    if not best or bestRun < 10 then
        local b2, r2, d2 = pass(-0.95, 8, 4)
        if b2 and (not best or r2 > bestRun) then best, bestRun, bestDir = b2, r2, d2 end
    end
    if not best then
        best, bestRun, bestDir = pass(-1.01, nil, 2)
    end

    if not best then return nil, 0, true end
    AH.Dir = bestDir
    return best, bestRun, bestRun < 10
end

function AH.PathEscape(tok)
    local e = AH.Last
    local root = RootNow()
    if not (root and e.pos) then return end
    local goal = AH.PickFlee(root.Position, e.pos)
    if not goal then return end
    local t0 = os.clock()
    Follow.WalkTo(tok, function() return goal end, 3.5,
        function()
            return not tok.ok() or os.clock() - t0 > 2.5 or AH.Down() or AH.PodsPending()
        end,
        { noDoor = true, maxTime = 3, nearOk = 6, evade = true })
end

function AH.Go(tok)
    local safeSince
    local aim, lastSteer, trapN, every = nil, 0, 0, 0.25
    local lastPos, lastChk, stuckN = nil, os.clock(), 0
    AH.Dir = nil

    while TokOK(tok) do
        if Ctl.On() or FH.Prio() then break end
        local hum, root = GetHumanoid(), RootNow()
        if not (hum and root) or hum.Health <= 0 or AH.Down() or Fly.Active then break end
        if FH.AmBeast() then break end
        if AH.PodsPending() then break end

        local e = AH.Eval()
        local now = os.clock()
        if e.danger or e.dist < AH.LeaveRange then
            safeSince = nil
        else
            safeSince = safeSince or now
        end
        if safeSince and now - safeSince >= AH.SafeTime then break end

        local rp = root.Position
        local feetY = FH.Feet(hum, root)
        FH.RefreshFilter()
        FH.Tick(hum, root)

        local juke = e.dist < AH.JukeRange

        if e.pos and (not aim or now - lastSteer > every or Flat(aim - rp).Magnitude < 3) then
            lastSteer = now
            every = juke and (0.2 + math.random() * 0.3) or 0.3
            if juke and math.random() < 0.5 then AH.Dir = nil end
            local a, _, trapped = AH.Steer(rp, e.pos, e.vel, feetY, juke)
            if a then aim = a end
            if trapped then trapN = trapN + 1 else trapN = 0 end
        end

        if trapN >= 1 then
            trapN, aim = 0, nil
            AH.Dir = nil
            AH.PathEscape(tok)
        elseif aim then
            local dv = Flat(aim - rp)
            if dv.Magnitude > 0.5 then
                local dir = dv.Unit
                local kind, sill = FH.Profile(rp.X, rp.Z, dir, feetY, 3.4)
                if kind == "jump" or kind == "jump2" then
                    FH.Jump(hum, kind == "jump2" or sill > Follow.DoubleFrom)
                elseif kind == "wall" or kind == "door" then
                    lastSteer = 0
                end
            end
            FH.Move(tok, hum, aim)

            if now - lastChk >= 0.25 then
                local moved = lastPos and Flat(rp - lastPos).Magnitude or 99
                lastPos, lastChk = rp, now
                if moved < 0.7 then
                    stuckN = stuckN + 1
                    if dv.Magnitude > 0.5 then FH.AddBad(rp + dv.Unit * 3, 6) end
                    AH.Dir = nil
                    aim = nil
                    lastSteer = 0
                    if stuckN >= 2 then
                        stuckN = 0
                        local fleeFrom = e.pos and (rp + Flat(rp - e.pos)) or nil
                        FH.Unstick(hum, root, tok, fleeFrom, 0.45)
                    end
                else
                    stuckN = 0
                end
            end
        end

        task.wait(0.02)
    end

    FH.ReleaseMotion(tok, not Ctl.On())
end

function AH.Step(tok)
    local hum, root = GetHumanoid(), RootNow()
    if not FH.MotionAvailable(tok) then
        AH.BusyFlag = false
        task.wait(0.05)
        return
    end

    if Ctl.On() then
        AH.BusyFlag = false
        task.wait(0.03)
        return
    end

    if FH.Prio() then
        AH.BusyFlag = false
        task.wait(0.05)
        return
    end

    if not (hum and root) or hum.Health <= 0 or Fly.Active or not FH.MatchOn()
        or FH.True(LocalPlayer, FH.BEASTN) or AH.Down() then
        AH.Last = { danger = false, dist = math.huge }
        AH.SetState("idle")
        AH.BusyFlag = false
        task.wait(0.2)
        return
    end

    if AH.PodsPending() then
        AH.Last = { danger = false, dist = math.huge }
        AH.SetState("idle")
        AH.BusyFlag = false
        task.wait(0.08)
        return
    end

    local e = AH.Eval()
    if e.danger and os.clock() > AH.Cool then
        AH.SetState("flee")
        AH.BusyFlag = true
        AH.Go(tok)
        AH.BusyFlag = false
        AH.SetState("idle")
        AH.Cool = 0
    else
        AH.BusyFlag = false
        task.wait(0.05)
    end
end

function AH.Loop(token)
    local tok = { owner = "evade", priority = 80, ok = function() return not unloaded and AH.Active and AH.Token == token end }
    while tok.ok() do
        local ok, err = pcall(AH.Step, tok)
        if not ok then
            warn("[AutoHide] loi: " .. tostring(err))
            AH.SetState("idle")
            AH.BusyFlag = false
            task.wait(0.5)
        end
        task.wait(0.02)
    end
end

function AH.Restart()
    AH.ReleaseTap()
    AH.NextTapAt = 0
    FH.CancelMotion("evade")
    if not AH.Active then return end
    AH.Token = AH.Token + 1
    AH.BusyFlag = false
    AH.Last = { danger = false, dist = math.huge }
    AH.SetState("idle")
    task.spawn(AH.Loop, AH.Token)
end

function AH.Stop()
    AH.ReleaseTap()
    AH.NextTapAt = 0
    FH.CancelMotion("evade")
    AH.Active = false
    AH.Token = AH.Token + 1
    AH.BusyFlag = false
    AH.Last = { danger = false, dist = math.huge }
    AH.State = "idle"
    AH.SetLabel()
end

function AH.Toggle()
    if AH.Active then
        AH.Stop()
    else
        AH.Active = true
        AH.NextTapAt = 0
        AH.Token = AH.Token + 1
        AH.BusyFlag = false
        AH.State = "idle"
        AH.Last = { danger = false, dist = math.huge }
        AH.SetLabel()
        task.spawn(AH.Loop, AH.Token)
    end
end

