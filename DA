function AR.Hold(ev, remoteOnly, token)
    if Ctl.On() or (token and not FH.MotionAvailable(token)) then return false end
    if AH.ReleaseTap then AH.ReleaseTap() end
    if TR.Held or TR.KeyDown then TR.Release() end
    if Follow.Held or Follow.KeyDown then Follow.Release() end
    if AR.HoldToken ~= token and (AR.Held or AR.KeyDown) then AR.Release() end
    AR.HoldToken = token
    local now = os.clock()
    if ev and RemoteEvent and (now - AR.InAt > 0.06 or AR.Held ~= ev) then
        AR.InAt = now
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", true, ev)
            RemoteEvent:FireServer("Input", "Action", true)
        end)
        AR.Held = ev
    end
    if not remoteOnly and VIM and not AR.KeyDown and not UserInputService:GetFocusedTextBox() then
        Ctl.EUntil = os.clock() + 0.5
        pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
        AR.KeyDown = true
    end
end

function AR.Release(token)
    -- Cancellation cleanup may run after token.ok() became false; ownership suffices.
    if token ~= nil and AR.HoldToken ~= token then return false end
    local h, kd = AR.Held, AR.KeyDown
    AR.Held, AR.KeyDown, AR.InAt, AR.HoldToken = nil, false, 0, nil
    if kd and VIM then
        Ctl.EUntil = os.clock() + 0.5
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
    end
    if h and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", false, h)
            RemoteEvent:FireServer("Input", "Action", false)
        end)
    end
end

function AR.Pods()
    local now = os.clock()
    if now - AR.PodAt < 0.4 then return AR.PodList end
    AR.PodAt = now
    local res = {}
    local map = GetCurrentMap() or Workspace
    for _, o in ipairs(map:GetChildren()) do
        if o.Name == "FreezePod" then
            local trig = o:FindFirstChild("PodTrigger", true)
            local ev = trig and trig:FindFirstChild("Event")
            local torso = trig and trig:FindFirstChild("CapturedTorso")
            local tv = torso and torso:IsA("ObjectValue") and torso.Value or nil
            if trig and ev and trig:IsA("BasePart") and tv
                and not (AR.Skip[trig] and AR.Skip[trig] > now) then
                local m = tv:FindFirstAncestorOfClass("Model")
                local owner = m and Players:GetPlayerFromCharacter(m)
                if owner ~= LocalPlayer then
                    res[#res + 1] = { trig = trig, ev = ev, owner = owner }
                end
            end
        end
    end
    AR.PodList = res
    return res
end

function AR.Nearest()
    local mr = RootNow()
    if not mr then return nil end
    local pods = AR.Pods()
    if #pods == 0 then AR.Pick = nil return nil end

    if AR.Pick and os.clock() - AR.PickAt < 2.5 then
        for _, info in ipairs(pods) do
            if info.trig == AR.Pick.trig then return AR.Pick end
        end
    end

    local beastPos
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and FH.True(p, FH.BEASTN) then
            local br = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if br then beastPos = br.Position break end
        end
    end

    local list = {}
    for _, info in ipairs(pods) do
        local straight = (info.trig.Position - mr.Position).Magnitude
        local pen = (beastPos and (info.trig.Position - beastPos).Magnitude < 18) and 120 or 0
        list[#list + 1] = { info = info, straight = straight, pen = pen }
    end
    table.sort(list, function(a, b) return a.straight + a.pen < b.straight + b.pen end)

    local now, from = os.clock(), mr.Position
    AR.PodRoutes = AR.PodRoutes or setmetatable({}, { __mode = "k" })
    local best, bl
    for i = 1, math.min(3, #list) do
        local e = list[i]
        local cached = AR.PodRoutes[e.info.trig]
        local fresh = cached and now - cached.at < 10 and (from - cached.from).Magnitude < 12
        local L = (fresh and cached.length or e.straight * 1.6 + 30) + e.pen
        if not bl or L < bl then best, bl = e.info, L end
    end

    -- Start moving toward the nearest candidate immediately. Route lengths refine
    -- the next pick without blocking the current rescue on ComputeAsync.
    if #list > 1 and AR.Active and not AR.PodRouteJob then
        local job = { token = AR.Token, root = mr, from = from }
        AR.PodRouteJob = job
        local function valid()
            local root = RootNow()
            return not unloaded and AR.Active and AR.Token == job.token
                and AR.PodRouteJob == job and root == job.root
                and (root.Position - job.from).Magnitude < 24
        end
        task.spawn(function()
            pcall(function()
                for i = 1, math.min(3, #list) do
                    if not valid() then break end
                    local e = list[i]
                    local torso = e.info.trig:FindFirstChild("CapturedTorso")
                    if e.info.trig.Parent and torso and torso.Value then
                        local occupant = torso.Value
                        local function routeValid()
                            return valid() and e.info.trig.Parent ~= nil and torso.Value == occupant
                        end
                        local _, len, _, path = FH.PathAny(from, e.info.trig.Position, 1, false, routeValid)
                        if path then path:Destroy() end
                        if routeValid() then
                            AR.PodRoutes[e.info.trig] = { from = from, at = os.clock(),
                                length = len or e.straight * 1.6 + 30 }
                        end
                    end
                end
            end)
            if AR.PodRouteJob == job then AR.PodRouteJob = nil end
        end)
    end
    AR.Pick, AR.PickAt = best, os.clock()
    return best
end

function AR.Rescue(tok, info)
    local res = FH.RescuePod(tok, function() return tok.ok() end, info, nil,
        function(ev, remoteOnly) AR.Hold(ev, remoteOnly, tok) end,
        function() AR.Release(tok) end)
    if res == "far" then
        AR.Skip[info.trig] = os.clock() + 15
        AR.Pick = nil
    end
end

function AR.Step(tok)
    if AR.Request then AR.Release(tok) task.wait(0.03) return end
    if not FH.MotionAvailable(tok) then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.05)
        return
    end
    if Ctl.On() then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.03)
        return
    end

    if FH.Prio() then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.05)
        return
    end

    local hum, root = GetHumanoid(), RootNow()
    if not (hum and root) or hum.Health <= 0 or Fly.Active or not FH.MatchOn()
        or FH.True(LocalPlayer, FH.BEASTN) or AH.Down() then
        if AR.BusyFlag then AR.Release(tok) end
        AR.SetBusy(false)
        task.wait(0.2)
        return
    end
    if AH.BusyFlag or Follow.Rescuing or TR.BusyFlag then
        AR.Release(tok)
        AR.SetBusy(false)
        return
    end
    local pod = AR.Nearest()
    if not pod then
        AR.SetBusy(false)
        task.wait(0.25)
        return
    end
    if not AR.BusyFlag then pcall(Follow.Release) end
    AR.SetBusy(true)
    AR.Rescue(tok, pod)
    if not tok.ok() then AR.Release(tok) end
end

function AR.Loop(token)
    local tok = { owner = "rescue", priority = 50, ok = function()
        return not unloaded and AR.Active and AR.Token == token and not AH.BusyFlag and not TR.BusyFlag and not FH.Prio() and not AR.Request
    end }
    while not unloaded and AR.Active and AR.Token == token do
        local ok, err = pcall(AR.Step, tok)
        if not ok then
            warn("[AutoHelp] loi: " .. tostring(err))
            AR.Release(tok)
            if not AR.Request then AR.SetBusy(false) end
            task.wait(0.4)
        end
        task.wait(0.03)
    end
    if AR.Token == token and not AR.Request then AR.SetBusy(false) end
end

function AR.Stop()
    if AR.CancelRequest then AR.CancelRequest() end
    FH.CancelMotion("rescue")
    AR.Active = false
    AR.Token = AR.Token + 1
    if not AR.HoldToken or (type(AR.HoldToken) == "table" and AR.HoldToken.owner == "rescue") then
