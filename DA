function CB.Clean(raw)
    if type(raw) ~= "string" then return nil end
    local s = string.gsub(raw, "[\r\n]+", " ")
    s = string.gsub(s, "^%s*%[[^%]]*%]%s*:?%s*", "")
    s = string.gsub(s, "^%s*[Tt][Oo][Mm][Mm]?[Yy]?%s*:%s*", "")
    local symbols = { ["×"] = " * ", ["÷"] = " / ", ["−"] = "-", ["π"] = "pi",
        ["²"] = "^2", ["³"] = "^3", ["√"] = "sqrt ", ["≤"] = "<=", ["≥"] = ">=",
        ["≠"] = "!=", ["°"] = " degrees", ["≈"] = " approximately ", ["∞"] = "infinity",
        ["⇒"] = " implies ", ["→"] = " -> ", ["±"] = " +/- ", ["α"] = "alpha",
        ["β"] = "beta", ["θ"] = "theta", ["Ω"] = "ohm", ["Δ"] = "delta",
        ["’"] = "'", ["‘"] = "'", ["“"] = '"', ["”"] = '"', ["–"] = "-", ["—"] = "; " }
    for symbol, replacement in pairs(symbols) do
        s = string.gsub(s, symbol, function() return replacement end)
    end
    s = string.gsub(s, "[^\32-\126]", "")
    -- Remove paired bold words only; retain Python powers such as 2**3 and x**y**z.
    local pieces, cursor = {}, 1
    while true do
        local first, last, inner = string.find(s, "%*%*([^%*]+)%*%*", cursor)
        if not first then pieces[#pieces + 1] = string.sub(s, cursor) break end
        pieces[#pieces + 1] = string.sub(s, cursor, first - 1)
        local before, after = string.sub(s, first - 1, first - 1), string.sub(s, last + 1, last + 1)
        local bold = string.find(inner, "%a") and not string.find(before, "[%w_]")
            and not string.find(after, "[%w_]")
        pieces[#pieces + 1] = bold and inner or string.sub(s, first, last)
        cursor = last + 1
    end
    s = table.concat(pieces)
    s = string.gsub(s, "`", "")
    s = string.gsub(s, "%s+", " ")
    s = string.match(s, "^%s*(.-)%s*$") or ""
    s = string.lower(s)
    s = string.gsub(s, "%f[%a]on it%f[%A]", "got it")
    if s == "" or s == "skip" then return nil end
    for _, bad in ipairs(CB.BadPhrases) do
        if string.find(s, bad, 1, true) then return nil end
    end
    -- Keep complete explanations; an overlong model answer is retried, not cut mid-meaning.
    if #s > 380 then return nil end
    return s ~= "" and s or nil
end

function CB.Split(s)
    local out = {}
    while #s > CB.MaxLen do
        local seg = string.sub(s, 1, CB.MaxLen)
        local p
        for i = #seg, 60, -1 do
            local ch = string.sub(seg, i, i)
            if ch == "." or ch == "?" or ch == "!" then p = i break end
        end
        if not p then
            for i = #seg, 60, -1 do
                if string.sub(seg, i, i) == " " then p = i break end
            end
        end
        p = p or CB.MaxLen
        local part = string.match(string.sub(s, 1, p), "^%s*(.-)%s*$")
        if part and part ~= "" then out[#out + 1] = part end
        s = string.match(string.sub(s, p + 1), "^%s*(.-)%s*$") or ""
    end
    if s ~= "" then out[#out + 1] = s end
    return out
end

function CB.Say(text, prio, onSent, muteNotice, sendGuard)
    if type(text) ~= "string" or text == "" or not CB.Active or CB.Silent or unloaded then return false end
    if not muteNotice and not CB.CanSpeak() then return false end
    text = string.lower(text)
    local q = CB.Out
    if #q >= 6 then
        local dropped = table.remove(q, 1)
        if dropped.onSent then pcall(dropped.onSent, false, dropped.text) end
    end
    local entry = { text = text, onSent = onSent, notice = muteNotice, token = CB.Token, guard = sendGuard }
    if prio then table.insert(q, 1, entry) else q[#q + 1] = entry end
    if CB.Pump then return true end
    CB.Pump = true
    task.spawn(function()
        while not unloaded and #CB.Out > 0 do
            local waitFor = CB.OutAt + CB.OutGap - os.clock()
            if waitFor > 0 then task.wait(waitFor) end
            local item = table.remove(CB.Out, 1)
            if item then
                local allowed = item.token == CB.Token and CB.Active and not CB.Silent
                    and (item.notice or CB.CanSpeak()) and not unloaded
                    and (not item.guard or item.guard())
                local sent = false
                if allowed then
                    sent = FH.Chat(item.text) == true
                    if sent then
                        CB.OutAt = os.clock()
                        CB.LastSend = CB.OutAt
                        CB.LastBotAt = CB.OutAt
                        CB.Push("tom", item.text)
                    end
                end
                if item.onSent then pcall(item.onSent, sent, item.text) end
            end
        end
        CB.Pump = false
    end)
    return true
end

-- Event announcements wait 20 seconds; direct replies keep their current timing.
function CB.SayAuto(text, prio, guard)
    if not CB.CanSpeak() then return false end
    local token = CB.Token
    local function alive()
        return not unloaded and CB.Active and not CB.Silent and CB.Token == token
            and (not guard or guard())
    end
    task.delay(20, function()
        if alive() then CB.Say(text, prio, nil, false, alive) end
    end)
    return true
end

function CB.SayLong(text, prio)
    local parts = CB.Split(text)
    if prio then
        for i = #parts, 1, -1 do CB.Say(parts[i], true) end
    else
        for i = 1, #parts do CB.Say(parts[i], false) end
    end
end

function CB.ResponseText(data)
    if type(data) ~= "table" or type(data.choices) ~= "table" then return nil end
    local choice = data.choices[1]
    if type(choice) ~= "table" or type(choice.message) ~= "table" then return nil end
    local content = choice.message.content
    if type(content) == "string" and content ~= "" then return content end
    if type(content) == "table" then
        local parts = {}
        for _, part in ipairs(content) do
            if type(part) == "table" and type(part.text) == "string" then parts[#parts + 1] = part.text end
        end
        local joined = table.concat(parts, " ")
        if joined ~= "" then return joined end
    end
    return nil
end

function CB.Request(sys, usr, sysShort, conversation, deadline)
    if not requestFunc then CB.LastAIError = "http unavailable" return nil end
    if os.clock() < CB.AIBackoffUntil then return nil end
    deadline = type(deadline) == "number" and deadline or os.clock() + 9
    if os.clock() >= deadline then CB.LastAIError = "ai deadline exceeded" return nil end
    -- Supply an OpenAI-compatible HTTPS chat/completions endpoint locally.
    -- TomBotAI = { Endpoint = "https://.../v1/chat/completions", Model = "...",
    -- ApiKey = "...", MaxTokens = 320, ContextTurns = 24, ContextSeconds = 900 }
    -- Do not put private keys in a shared script or a GitHub file.
    local config = type(TomBotAI) == "table" and TomBotAI or {}
    local custom = type(config.Endpoint) == "string" and config.Endpoint ~= ""
    if custom and (string.sub(config.Endpoint, 1, 8) ~= "https://" or string.find(config.Endpoint, "%s")) then
        CB.LastAIError = "endpoint must be https" return nil
    end
    local headers = { ["Content-Type"] = "application/json" }
    if custom and type(config.ApiKey) == "string" and config.ApiKey ~= "" then
        headers.Authorization = "Bearer " .. config.ApiKey
    end
    local messages = { { role = "system", content = sys } }
    if type(conversation) == "table" then
        for _, message in ipairs(conversation) do
            if (message.role == "user" or message.role == "assistant") and type(message.content) == "string" then
                messages[#messages + 1] = { role = message.role, content = message.content }
            end
        end
    else
        messages[#messages + 1] = { role = "user", content = usr }
    end
    local models = custom and { type(config.Model) == "string" and config.Model or "openai" }
        or { "openai", "mistral" }
    for _, model in ipairs(models) do
        local remaining = deadline - os.clock()
        if remaining < 0.05 then CB.LastAIError = "ai deadline exceeded" break end
        local reasoning = string.match(model, "^o[134]$") or string.match(model, "^o[134]%-") or string.match(model, "^gpt%-5")
        local tokens = type(config.MaxTokens) == "number" and config.MaxTokens or (reasoning and 800 or 320)
        local body = { model = model, messages = messages }
        body[reasoning and "max_completion_tokens" or "max_tokens"] = math.clamp(math.floor(tokens), 128, 1600)
        if not reasoning then
            body.temperature = type(config.Temperature) == "number" and math.clamp(config.Temperature, 0, 1.4) or 0.6
        end
        local ok, result = pcall(function()
            return requestFunc({ Url = custom and config.Endpoint or "https://text.pollinations.ai/openai",
                Method = "POST", Headers = headers, Body = HttpService:JSONEncode(body), Timeout = math.min(8, remaining) })
        end)
        if os.clock() > deadline then CB.LastAIError = "ai deadline exceeded" break end
        if ok and type(result) == "table" then
            local status = tonumber(result.StatusCode)
            if status and status >= 200 and status < 300 and type(result.Body) == "string" then
                local parsed, data = pcall(function() return HttpService:JSONDecode(result.Body) end)
                local reply = parsed and CB.ResponseText(data) or nil
                if reply then CB.LastAIError = nil return reply end
                CB.LastAIError = "invalid model response"
            else
                CB.LastAIError = "ai http " .. tostring(status or "unknown")
                if status == 429 then CB.AIBackoffUntil = os.clock() + 30 break end
                if custom or status == 401 or status == 403 then break end
            end
        else
            CB.LastAIError = "ai connection failed"
        end
    end
    if os.clock() >= CB.AIBackoffUntil then CB.AIBackoffUntil = os.clock() + 10 end
    CB.Dbg(CB.LastAIError or "ai unavailable")
    return nil
end

function CB.IsQuestion(text)
    local l = CB.Lower(text or "")
    if string.find(l, "?", 1, true) then return true end
    for _, w in ipairs({
        "what ", "why ", "how ", "when ", "where ", "who ", "which ", "can you ", "could ", "should ",
        "would ", "is it ", "are you ", "do you ", "does ", "explain", "tell me",
    }) do
        if string.find(l, w, 1, true) then return true end
    end
    return false
end

function CB.Ask(item, deadline)
    deadline = type(deadline) == "number" and deadline or os.clock() + 11
    local mode = CB.IsQuestion(item.text)
        and "answer the player's question accurately with the key reason or example; do not sacrifice meaning for brevity."
        or "react to this player's actual meaning; use one brief relevant joke only if it fits."
    local conversation = item.context or CB.ContextMessages(item)
    local sys = CB.System(false) .. "\n\nthis turn: " .. mode
    local received = false
    for attempt = 1, 2 do
        if unloaded or not CB.Active or item.tok ~= CB.Token then return nil, "none", nil end
        if os.clock() >= deadline then break end
        local instruction = sys
        if attempt == 2 then
            instruction = instruction .. "\nprevious output was unusable. give a complete, meaningful answer under 380 characters in the required json format."
        end
        local raw = CB.Request(instruction, item.text, instruction, conversation, deadline)
        if not raw then break end
        received = true
        if unloaded or not CB.Active or item.tok ~= CB.Token or os.clock() > deadline then return nil, "none", nil end
        local _, text = CB.Parse(raw)
        local reply = CB.Clean(text)
        if reply and not CB.IsFiller(reply) then return reply, "none", nil end
    end
    if item.must then
        local fallback = received and "i couldn't get a clear answer to that. ask it a little more specifically?" or CB.FallbackLines[1]
        return fallback, "none", nil
    end
    return nil, "none", nil
end

function CB.Handle(item)
    if unloaded or not CB.Active or item.tok ~= CB.Token or CB.InFlight >= 3 then return end
    CB.InFlight = CB.InFlight + 1
    CB.SetLabel()
    local deadline = os.clock() + 11
    local done, reply = false, nil
    task.spawn(function()
        local ok, result = pcall(CB.Ask, item, deadline)
        if ok then reply = result else CB.Dbg("ai reply failed") end
        done = true
        -- Keep the slot until the worker actually ends, even if HTTP ignores Timeout.
        CB.InFlight = math.max(0, CB.InFlight - 1)
        CB.SetLabel()
    end)
    while not done and os.clock() < deadline and not unloaded and CB.Active and item.tok == CB.Token do task.wait(0.05) end
    if done and reply and os.clock() <= deadline and CB.Active and not unloaded and item.tok == CB.Token and os.clock() - item.at < 20 then
        CB.First = false
        CB.SayLong(reply)
    end
    -- No action dispatch here: LLM output can never acquire any movement owner.
end

function CB.ShouldReply(player, text)
    local now = os.clock()
    local l = CB.Lower(text)

    if string.find(l, "tommy", 1, true) or string.find(l, "%f[%a]tom%f[%A]") then return true, true end
    for _, n in ipairs({ CB.Lower(LocalPlayer.Name), CB.Lower(LocalPlayer.DisplayName) }) do
        if #n >= 3 and string.find(l, n, 1, true) then return true, true end
    end

    if now - CB.LastSend < 1.5 then return false, false end

    for _, w in ipairs(CB.HelpWords) do
        if string.find(l, w, 1, true) then return math.random() < 0.95, true end
    end
    if CB.IsQuestion(text) then return true, true end
    if CB.LastBotAt > 0 and now - CB.LastBotAt < 25 then return math.random() < 0.9, false end
    return math.random() < CB.ReplyChance, false
end

