function Cmd.Addressed(t)
    local p = " " .. t .. " "
    if string.find(p, " tom ", 1, true) or string.find(p, " tommy ", 1, true) then return true end
    for _, n in ipairs({ Cmd.Norm(LocalPlayer.Name), Cmd.Norm(LocalPlayer.DisplayName) }) do
        if #n >= 3 and string.find(p, " " .. n .. " ", 1, true) then return true end
    end
    return false
end

function Cmd.RequestText(t)
    t = Cmd.Norm(t)
    t = string.gsub(t, "^hey%s+", "")
    local names = { "tom", "tommy", Cmd.Norm(LocalPlayer.Name), Cmd.Norm(LocalPlayer.DisplayName) }
    for _, n in ipairs(names) do
        if n ~= "" then
            if t == n then return "" end
            if string.sub(t, 1, #n + 1) == n .. " " then t = string.sub(t, #n + 2) break end
        end
    end
    for _, prefix in ipairs({ "i want you to ", "would you please ", "could you please ", "can you please ", "would you ", "could you ", "can you ", "please ", "pls ", "plz " }) do
        if string.sub(t, 1, #prefix) == prefix then t = string.sub(t, #prefix + 1) break end
    end
    t = string.gsub(t, "^please%s+", "")
    return t
end

function Cmd.Intent(text)
    local t = Cmd.RequestText(text)
    -- Không chạy hành động chỉ vì một từ xuất hiện trong lời kể hoặc câu hỏi kiến thức.
    for _, k in ipairs(Cmd.Order) do
        for _, w in ipairs(Cmd.Words[k]) do
            if t == w or string.sub(t, 1, #w + 1) == w .. " " then return k, t end
        end
    end
    local mapQuestion = t == "what map" or t == "which map"
        or ((string.match(t, "^what map ") or string.match(t, "^which map "))
            and Cmd.Has(t, { "vote", "choose", "pick", "select" }))
        or string.match(t, "^what should we vote") or string.match(t, "^which should we vote")
        or string.match(t, "^what do you want to vote")
    if mapQuestion then return "vote", t end
    return nil, t
end

-- Tìm người chơi được nhắc tới ("me" = người nói), không đoán nếu tên bị trùng.
function Cmd.FindTarget(text, speaker, hint)
    local skip = {}
    for _, w in ipairs({
        "tom", "tommy", "please", "pls", "plz", "the", "him", "her", "them", "hit", "attack", "smack",
        "punch", "slap", "bonk", "whack", "follow", "come", "with", "here", "now", "and", "stop", "farm",
        "jump", "dance", "wave", "flip", "backflip", "hack", "can", "you", "your", "get", "for", "stick",
    }) do skip[w] = true end
    local function match(str)
        if not str or str == "" then return nil end
        local t = " " .. Cmd.Norm(str) .. " "
        local exact
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                for _, nm in ipairs({ Cmd.Norm(p.Name), Cmd.Norm(p.DisplayName) }) do
                    if #nm >= 2 and string.find(t, " " .. nm .. " ", 1, true) then
                        if exact and exact ~= p then return nil end
                        exact = p
                    end
                end
            end
        end
        if exact then return exact end
        local found
        for tok in string.gmatch(t, "%S+") do
            if #tok >= 3 and not skip[tok] then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        for _, nm in ipairs({ Cmd.Norm(p.Name), Cmd.Norm(p.DisplayName) }) do
                            if string.sub(nm, 1, #tok) == tok then
                                if found and found ~= p then return nil end
                                found = p
                            end
                        end
                    end
                end
            end
        end
        if found then return found end
        if string.find(t, " me ", 1, true) then return speaker end
        return nil
    end
    return match(hint) or match(text)
end

function Cmd.AimUnbind(id)
    if id ~= nil and Cmd.AimToken ~= id then return end
    Cmd.AimToken = nil
    pcall(function() RunService:UnbindFromRenderStep("NovaHitLook") end)
end

-- Used for state restoration; enabled autonomous features do not reject player commands.
function Cmd.FeatureActive()
    if Follow.Target or Follow.AutoFarm or Follow.RandomActive or AH.Active or AR.Active or TR.Active
        or AH.BusyFlag or AR.BusyFlag or AR.Request ~= nil or TR.BusyFlag then return true end
    local motion = FH.Motion
    return motion and motion.token ~= nil
        and (type(motion.token) ~= "table" or motion.token.owner ~= "command")
        and FH.MotionActive() or false
end

function Cmd.CanAct(id)
    return not unloaded and CB.Active and Cmd.Token == id and Cmd.ActiveId == id
        and not Ctl.On() and not Fly.Active
end

function Cmd.MotionFor(id, extra)
    local token = { owner = "command", priority = 100, id = id, ok = function()
        return Cmd.CanAct(id) and (not extra or extra())
    end }
    Cmd.MotionToken = token
    return token
end

function Cmd.HoldInput(token, event)
    if not token.ok() then return false end
    Cmd.InputToken = token
    Follow.Hold(event, false, true, nil, token)
    return true
end

function Cmd.ReleaseInput(id)
    local token = Cmd.InputToken
    if not token or token.id ~= id then return end
    -- A feature that takes the E interaction replaces InputOwner first.
    Follow.Release(token)
    Cmd.InputToken = nil
end

function Cmd.Cleanup(id)
    Cmd.AimUnbind(id)
    if Cmd.PendingHit and Cmd.PendingHit.id == id then Cmd.PendingHit = nil end
    -- Một tác vụ cũ tuyệt đối không được dọn trạng thái của lệnh mới.
    if Cmd.Token ~= id then return end
    local token = Cmd.MotionToken
    if token and token.id == id then
        FH.ReleaseMotion(token, false)
        Cmd.MotionToken = nil
    end
    Cmd.ReleaseInput(id)
    if Cmd.ActiveId == id then Cmd.ActiveId = nil end
end

function Cmd.FollowPlayer(p, speaker)
    if not p or p.Parent ~= Players then return false end
    if Follow.StopRandom then Follow.StopRandom() end
    if Follow.AutoFarm then Follow.StopAutoFarm() end
    if Follow.Target == p then
        Cmd.FollowDirectiveTarget, Cmd.FarmDirective = p, false
        return true
    end
    Follow.Key = nil
    Follow.Refresh()
    for i, pl in ipairs(Follow.List) do
        if pl == p then
            if not Follow.Select(i) then return false end
            Cmd.FollowDirectiveTarget, Cmd.FarmDirective = p, false
            return true
        end
    end
    return false
end

function Cmd.Farm()
    if Follow.StopRandom then Follow.StopRandom() end
    if Follow.Target then Follow.Stop() end
    if not Follow.AutoFarm and not Follow.StartAutoFarm() then return false end
    Cmd.FollowDirectiveTarget, Cmd.FarmDirective = nil, true
    return true
end

function Cmd.Emote(name, secs, id)
    if not Cmd.CanAct(id) then return end
    local hum, root = GetHumanoid(), RootNow()
    local token = Cmd.MotionFor(id)
    if hum and root then FH.Move(token, hum, root.Position) end
    if not Cmd.CanAct(id) then Cmd.Cleanup(id) return end
    local ok, res = false, false
    if hum then ok, res = pcall(function() return hum:PlayEmote(name) end) end
    if not (ok and res) and Cmd.CanAct(id) and not CB.Silent then FH.Chat("/e " .. name) end
    local untilAt = os.clock() + secs
    while Cmd.CanAct(id) and os.clock() < untilAt do task.wait(0.1) end
    Cmd.Cleanup(id)
end

function Cmd.CancelFlip()
    local state = Cmd.FlipState
    if not state then return end
    Cmd.FlipState, Cmd.FlipToken = nil, nil
    pcall(function()
        state.hum.Sit = state.sit
        state.hum.AutoRotate = state.rotate
        if state.root.Parent == LocalPlayer.Character and not Fly.Active then
            state.root.CFrame = CFrame.new(state.root.Position) * state.rotation
        end
        if not state.sit and state.hum.Health > 0 then
            state.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

function Cmd.FlipOnce(id)
    local hum, root = GetHumanoid(), RootNow()
    if not (hum and root) or not Cmd.CanAct(id) then return false end
    -- Same Jump -> Sit -> 360-degree X rotation as FE flips, without 360 delayed callbacks.
    local character, duration = LocalPlayer.Character, 0.5
    local rotation = root.CFrame - root.Position
    local wasSit, wasRotate = hum.Sit, hum.AutoRotate
    local state = { id = id, hum = hum, root = root, sit = wasSit, rotate = wasRotate, rotation = rotation }
    Cmd.FlipState, Cmd.FlipToken = state, id
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    -- Give Jumping one physics frame before Sit; setting both together cancels the jump.
    RunService.Heartbeat:Wait()
    if not Cmd.CanAct(id) or LocalPlayer.Character ~= character or hum.Health <= 0 then
        if Cmd.FlipState == state then Cmd.CancelFlip() end
        return false
    end
    local start = os.clock()
    hum.Sit, hum.AutoRotate = true, false
    local finished = false
    while Cmd.CanAct(id) and LocalPlayer.Character == character and root.Parent and hum.Health > 0 do
        local progress = math.clamp((os.clock() - start) / duration, 0, 1)
        hum.Sit = true
        root.CFrame = CFrame.new(root.Position) * rotation * CFrame.Angles(progress * math.pi * 2, 0, 0)
        if progress >= 1 then finished = true break end
        RunService.Heartbeat:Wait()
    end
    if Cmd.FlipState == state then Cmd.CancelFlip() end
    return finished
end

function Cmd.Backflip(speaker, id)
    if not speaker or speaker.Parent ~= Players or not Cmd.CanAct(id) then return false end
    local function proot()
        local c = speaker.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    if not proot() or AH.Down() or Fly.Active then CB.Say("i can't pull that off right now, ask me again in a moment") return false end
    CB.Say(string.format("you want a backflip, %s? hold tight, i'll walk up in front of you and show you two", speaker.DisplayName))
    local started = os.clock()
    local function front()
        local r = proot()
        if not r then return nil end
        local look = Flat(r.CFrame.LookVector)
        if look.Magnitude < 0.1 then look = Vector3.new(0, 0, 1) end
        return FH.Ground(r.Position + look.Unit * 5)
    end
    local tok = Cmd.MotionFor(id, function()
        return os.clock() - started < 28 and not AH.Down() and speaker.Parent == Players
    end)
    local arrived = false
    while tok.ok() do
        local g, me = front(), RootNow()
        if not (g and me) then break end
        if Flat(g - me.Position).Magnitude <= 2.8 then arrived = true break end
        local res = Follow.Chase(tok, front, 2.2, nil, nil)
        if res == "trapped" then Follow.WalkTo(tok, front, 2.2, nil, { maxTime = 6 }) end
        task.wait(0.03)
    end
    local r, me = proot(), RootNow()
    local near = r and me and Flat(r.Position - me.Position).Magnitude <= 9
    if (arrived or near) and tok.ok() then
        pcall(function() me.CFrame = CFrame.lookAt(me.Position, Vector3.new(r.Position.X, me.Position.Y, r.Position.Z)) end)
        local first = Cmd.FlipOnce(id)
        task.wait(0.35)
        local second = first and tok.ok() and Cmd.FlipOnce(id)
        if second and tok.ok() then CB.Say("ta-da! two backflips, scored by a very biased judge: me") end
    elseif Cmd.CanAct(id) then
        CB.Say("i couldn't get to you, there's a wall in the way. come closer and ask again")
    end
    Cmd.Cleanup(id)
    return true
end

function Cmd.Click()
    local cam = Workspace.CurrentCamera
    local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
    if VIM then
        pcall(function() VIM:SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, true, game, 0) end)
        task.wait(0.05)
        pcall(function() VIM:SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, false, game, 0) end)
    elseif mouse1click then pcall(mouse1click) end
end

function Cmd.AimBind(getPos, id)
    Cmd.AimUnbind()
    Cmd.AimToken = id
    RunService:BindToRenderStep("NovaHitLook", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not Cmd.CanAct(id) then Cmd.AimUnbind(id) return end
        local cam, pos = Workspace.CurrentCamera, getPos()
        if not (cam and pos) then return end
        local cp, aim = cam.CFrame.Position, pos + Vector3.new(0, 1.5, 0)
        if (aim - cp).Magnitude < 1 then return end
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cp, aim), 1 - math.exp(-16 * dt))
    end)
end

function Cmd.OnConsentChat(player, text)
    local p = Cmd.PendingHit
    if not p or p.target ~= player or Cmd.Token ~= p.id then return false end
    if not p.deadline or os.clock() > p.deadline then return false end
    local t = Cmd.Norm(text)
    local decline = Cmd.Has(t, {
        "no", "nope", "nah", "never", "stop", "cancel", "dont", "don t", "do not", "leave me alone",
        "not me", "not now", "i refuse", "i decline", "i don t want", "i do not want", "would rather not", "please don t",
    })
    if decline then
        p.refused = true
        Cmd.AimUnbind(p.id)
        CB.Say("got you, bestie.", true)
        return true
    end
    local answer = Cmd.RequestText(t):gsub(" please$", ""):gsub(" tommy$", ""):gsub(" tom$", "")
    for _, reply in ipairs({ "yes", "yeah", "yep", "sure", "okay", "ok", "go ahead", "i agree",
        "yes please", "yes hit me", "yes you can", "you can hit me", "hit me" }) do
        if answer == reply then
            p.accepted = true
            return true
        end
    end
    return false
end

function Cmd.Hit(speaker, text, id, hint)
    if not Cmd.CanAct(id) then return end
    if not FH.AmBeast() then CB.Say("i can only hit people while i'm the beast, and right now i'm a humble survivor") return end
    local target = Cmd.FindTarget(text, speaker, hint)
    if not target or target == LocalPlayer then CB.Say("who should i hit? say it like 'tom hit <name>'") return end
    if FH.True(target, FH.CAP) then CB.Say(target.DisplayName .. " is already frozen, pick someone who is still running") return end
    -- Silent mode cannot deliver a permission question, so it never starts an attack.
    if CB.Silent or not CB.CanSpeak() then return end
    FH.CancelMotion()
    local function troot()
        local c = target.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function goal() local r = troot() return r and r.Position end
    local pending = { id = id, target = target, refused = false, queuedAt = os.clock() }
    Cmd.PendingHit = pending
    -- Đồng hồ 10 giây chỉ bắt đầu sau khi câu hỏi thực sự được gửi ra chat.
    local function waiting()
        return Cmd.CanAct(id) and not pending.refused and FH.AmBeast() and not AH.Down()
    end
    local question = string.format("%s, may i hit you? say yes or no within 10 seconds. no answer means i cancel.", target.DisplayName)
    local queued = CB.Say(question, true, function(sent)
        if Cmd.PendingHit ~= pending or not Cmd.CanAct(id) or pending.refused then return end
        if sent then pending.deadline = os.clock() + 10 else pending.failed = true end
    end, false, function()
        return Cmd.PendingHit == pending and waiting()
    end)
    if queued == false then pending.failed = true end
    while waiting() and target.Parent == Players do
        if pending.failed or pending.accepted then break end
        if pending.deadline then
            if os.clock() >= pending.deadline then break end
        elseif os.clock() - pending.queuedAt >= 6 then pending.failed = true break end
        task.wait(0.05)
    end
    if not pending.accepted or pending.refused or pending.failed or not pending.deadline or os.clock() > pending.deadline
        or not Cmd.CanAct(id) or not FH.AmBeast()
        or target.Parent ~= Players or AH.Down() or Ctl.On() then
        if pending.failed and Cmd.Token == id then CB.Say("i couldn't send the permission question, so i've cancelled the hit") end
        if not pending.failed and not pending.refused and Cmd.Token == id then CB.Say("no permission received in time; hit cancelled", true) end
        Cmd.Cleanup(id)
        return
    end
    if Cmd.PendingHit == pending then Cmd.PendingHit = nil end
    local started, clicks, hitDone = os.clock(), 0, false
    local initRag, interrupted = FH.True(target, FH.RAG), false
    local tok = Cmd.MotionFor(id, function()
        if not FH.AmBeast() or hitDone or target.Parent ~= Players
            or os.clock() - started > 35 or AH.Down() then return false end
        return true
    end)
    Cmd.AimBind(goal, id)
    CB.Say("heading to " .. target.DisplayName .. " now. say 'tom stop' to cancel")
    while tok.ok() do
        local tr, me = troot(), RootNow()
        if not (tr and me) then task.wait(0.15)
        else
            if FH.True(target, FH.CAP) or (not initRag and FH.True(target, FH.RAG)) then hitDone = true break end
            local d, dy = Flat(tr.Position - me.Position).Magnitude, math.abs(tr.Position.Y - me.Position.Y)
            if d <= Cmd.HitRange and dy < 6 then
                Cmd.Click()
                clicks = clicks + 1
                task.wait(0.4)
                if clicks >= 14 then break end
            else
                local function stopNear()
                    if not tok.ok() then return true end
                    local r2, m2 = troot(), RootNow()
                    return r2 ~= nil and m2 ~= nil and Flat(r2.Position - m2.Position).Magnitude <= Cmd.HitRange - 0.5
                end
                local res = Follow.Chase(tok, goal, 3.2, stopNear, nil)
                if res == "trapped" then Follow.WalkTo(tok, goal, 3.2, stopNear, { maxTime = 6 }) end
                task.wait(0.03)
            end
        end
    end
    interrupted = Ctl.On() or Fly.Active
    Cmd.Cleanup(id)
    if Cmd.Token ~= id then return end
    if hitDone then CB.Say("got them, " .. target.DisplayName .. " is down. who's next?")
    elseif interrupted then CB.Say("movement controls took priority; hit cancelled")
    elseif clicks > 0 then CB.Say("i swung at " .. target.DisplayName .. " but didn't land it, want me to retry?")
    else CB.Say("couldn't reach " .. target.DisplayName .. " in time, they're hiding somewhere tricky") end
end

function Cmd.Escape(id)
    if not Cmd.CanAct(id) then return end
    if FH.AmBeast() or AH.Down() or FH.True(LocalPlayer, FH.ESC) or not GetCurrentMap() then
        CB.Say("i can escape only while i'm an active survivor in a match") return
    end
    local root = RootNow()
    if not root then return end
    local best, score
    for _, door in ipairs(ExitDoors) do
        if IsInWorld(door) then
            local center = FH.ExitArea(door)
            if center then
                local d = (center - root.Position).Magnitude
                if not score or d < score then best, score = door, d end
            end
        end
    end
    if not best then CB.Say("i can't find an exit door in this map yet") return end
    CB.Say("heading to the nearest exit. if it's locked, i'll wait there for it to unlock")
    local started, center = os.clock(), FH.ExitArea(best)
    local approachPos, loiter = root.Position, {}
    local tok = Cmd.MotionFor(id, function()
        return IsInWorld(best) and os.clock() - started < 65 and not AH.Down()
            and not FH.True(LocalPlayer, FH.ESC) and not FH.AmBeast()
    end)
    local function aborted() return not tok.ok() end
    local function blocked()
        local me = RootNow()
        if not me then return true end
        FH.RefreshFilter()
        for _, offset in ipairs({ -1, 1 }) do
            local from = Vector3.new(approachPos.X, me.Position.Y + offset, approachPos.Z)
            local to = Vector3.new(center.X, from.Y, center.Z)
            local hit = Workspace:Raycast(from, to - from, rayParams)
            if hit and hit.Instance:IsDescendantOf(best) and hit.Instance.CanCollide then return true end
        end
        return false
    end
    local triggers = best:IsA("Model") and FH.Triggers(best) or {}
    table.sort(triggers, function(a, b) return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude end)
    local stand = triggers[1]
    local direction = Flat(root.Position - center)
    if direction.Magnitude < 0.5 then direction = Vector3.new(0, 0, 1) end
    local standPos = FH.Ground(stand and stand.Position or (center + direction.Unit * 6))
    approachPos = standPos
    Follow.WalkTo(tok, function() return standPos end, 1.8, aborted, { maxTime = 30, nearOk = 3 })
    while tok.ok() and blocked() do
        if FH.ExitOpen() and stand then
            local me = RootNow()
            if me and Flat(stand.Position - me.Position).Magnitude <= 3.5 then
                if Cmd.HoldInput(tok, stand:FindFirstChild("Event")) then FH.MarkWork(tok, "exit") end
            else
                Cmd.ReleaseInput(id)
                Follow.WalkTo(tok, function() return standPos end, 1.8, aborted, { maxTime = 6, nearOk = 3 })
            end
        else
            Cmd.ReleaseInput(id)
            FH.ExitLoiter(tok, standPos, center, loiter)
        end
        task.wait(0.08)
    end
    Cmd.ReleaseInput(id)
    if tok.ok() then
        local me = RootNow()
        local through = me and Flat(center - me.Position) or -direction
        if through.Magnitude < 0.5 then through = -direction end
        local beyond = FH.Ground(center + through.Unit * 10)
        Follow.WalkTo(tok, function() return beyond end, 1.5, aborted, { maxTime = 12, nearOk = 2.5, noDoor = true })
    end
    local escaped = FH.True(LocalPlayer, FH.ESC)
    Cmd.Cleanup(id)
    if Cmd.Token == id then
        if escaped then CB.Say("made it out. fridge delivery complete")
        elseif not Ctl.On() and not Fly.Active and not AH.Down() then CB.Say("i reached the exit route, but escape isn't confirmed yet. the door may still be locked") end
    end
end

function Cmd.VisibleButton(button)
    if not button:IsA("GuiButton") or not button.Active or button.AbsoluteSize.X < 2 or button.AbsoluteSize.Y < 2 then return false end
    local cur = button
    while cur do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

function Cmd.MapButtons()
    local pg, found = LocalPlayer:FindFirstChildOfClass("PlayerGui"), {}
    if not pg then return found end
    for _, button in ipairs(pg:GetDescendants()) do
        if Cmd.VisibleButton(button) then
            local cur, voting = button, false
            while cur and cur ~= pg do
                local name = Cmd.Norm(cur.Name):gsub(" ", "")
                if name == "mapvote" or name == "mapvoting" or name == "votemap" or name == "mapselection" or name == "voteselection" then voting = true break end
                cur = cur.Parent
            end
            if voting then
                local label = button:IsA("TextButton") and button.Text or ""
                -- Chỉ đọc nhãn cùng nút, không suy đoán từ remote hoặc thứ tự bản đồ.
                if Cmd.Norm(label) == "" or Cmd.Norm(label) == "vote" or Cmd.Norm(label) == "select" then
                    local mapLabel = button:FindFirstChild("MapName", true) or button:FindFirstChild("MapTitle", true)
                        or (button.Parent and button.Parent:FindFirstChild("MapName"))
                    if mapLabel and (mapLabel:IsA("TextLabel") or mapLabel:IsA("TextButton")) then label = mapLabel.Text end
                end
                if Cmd.Norm(label) ~= "" and Cmd.Norm(label) ~= "vote" and Cmd.Norm(label) ~= "select" then
                    found[#found + 1] = { button = button, name = label, norm = Cmd.Norm(label) }
                end
            end
        end
    end
    return found
end

function Cmd.Vote(text, id)
    if GetCurrentMap() and FH.InMatchPlayer(LocalPlayer) then CB.Say("map voting is for the lobby. ask me again between rounds") return end
    local buttons = Cmd.MapButtons()
    local requestText = Cmd.RequestText(text)
    local requested = requestText
    for _, prefix in ipairs({ "vote for map ", "vote for ", "vote map ", "vote ", "choose map ", "pick map ", "select map " }) do
        if string.sub(requested, 1, #prefix) == prefix then requested = string.sub(requested, #prefix + 1) break end
    end
    requested = string.gsub(requested, "%s+please$", "")
    requested = string.gsub(requested, "%s+pls$", "")
    local match
    for _, candidate in ipairs(buttons) do
        if candidate.norm == requested then
            if match and match.button ~= candidate.button then CB.Say("more than one vote button has that name. please choose it manually") return end
            match = candidate
        end
    end
    if not match then
        if #buttons == 0 then CB.Say("i can't access a supported map vote button here. tell me your choice and select it in the lobby voting menu")
        else
            local names = {}
            for _, candidate in ipairs(buttons) do names[#names + 1] = candidate.name end
            CB.SayLong("which map should i vote for? available: " .. table.concat(names, ", ") .. ". say 'tom vote <map name>'")
        end
        return
    end
    if not VIM then CB.Say("i can see " .. match.name .. ", but this runtime cannot click its vote button. please select it manually") return end
    if Cmd.Token ~= id or not Cmd.VisibleButton(match.button) then return end
    local center = match.button.AbsolutePosition + match.button.AbsoluteSize / 2
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
    end)
    if ok then CB.Say("clicked the lobby vote button for " .. match.name)
    else CB.Say("the vote click was unavailable; please choose " .. match.name .. " manually") end
end

