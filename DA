local function BuildPlayerLabelText(p, idx)
    local head = "  <font color='#FFFFFF'>" .. idx .. ".</font> "
    local out = head .. "<font color='#FFFFFF'>[NO]</font> <font color='#888888'>" .. p.Name .. "</font>"

    if not p.Parent then return out end

    local ts = p:FindFirstChild("TempPlayerStatsModule")
    local isBeast = ts and ts:FindFirstChild("IsBeast")
    local isBeastVal = isBeast and isBeast.Value or false
    local ragdoll = ts and ts:FindFirstChild("Ragdoll")
    local isRagdoll = ragdoll and ragdoll.Value == true
    local hp = ts and ts:FindFirstChild("Health")
    local escaped = ts and ts:FindFirstChild("Escaped")
    local captured = ts and (ts:FindFirstChild("Captured") or ts:FindFirstChild("InPodium") or ts:FindFirstChild("InPod"))
    local isCapturedVal = captured and captured.Value == true

    if not isBeastVal then
        if (hp and hp.Value <= 0) or (escaped and escaped.Value == true) or not p.Character then
            return out
        end
    end

    if isBeastVal then
        local perk = (currentPowerValue ~= "None" and currentPowerValue ~= "")
            and (" <font color='#FFDC00'>[" .. tostring(currentPowerValue) .. "]</font>") or ""
        return head .. "<font color='#FF0000'>" .. p.Name .. "</font>" .. perk
    elseif isCapturedVal then
        return head .. "<font color='#00BFFF'>" .. p.Name .. "</font>"
    elseif isRagdoll then
        return head .. "<font color='#FF69B4'>" .. p.Name .. "</font>"
    end
    return head .. "<font color='#00FF64'>" .. p.Name .. "</font>"
end

