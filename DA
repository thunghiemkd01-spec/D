local COLOR_ALIVE = Color3.fromRGB(0, 255, 100)
local COLOR_BEAST = Color3.fromRGB(255, 0, 0)
local COLOR_CAPTURED = Color3.fromRGB(0, 191, 255)
local COLOR_RAGDOLL = Color3.fromRGB(255, 105, 180)

local function UpdatePlayerESP()
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local char = v.Character
            local head = char and char:FindFirstChild("Head")

            if char and head and IsInWorld(char) then
                local ts = v:FindFirstChild("TempPlayerStatsModule")
                local isBeast = ts and ts:FindFirstChild("IsBeast")
                local isBeastVal = isBeast and isBeast.Value or false
                local hp = ts and ts:FindFirstChild("Health")
                local ragdoll = ts and ts:FindFirstChild("Ragdoll")
                local escaped = ts and ts:FindFirstChild("Escaped")
                local captured = ts and (ts:FindFirstChild("Captured") or ts:FindFirstChild("InPodium") or ts:FindFirstChild("InPod"))
                local isCapturedVal = captured and captured.Value == true
                local alive, isRagdoll = true, false

                if not isBeastVal then
                    if (hp and hp.Value <= 0) or (escaped and escaped.Value == true) then alive = false end
                    if ragdoll and ragdoll.Value == true then isRagdoll = true end
                end

                if alive then
                    local roleColor = COLOR_ALIVE
                    if isBeastVal then roleColor = COLOR_BEAST
                    elseif isCapturedVal then roleColor = COLOR_CAPTURED
                    elseif isRagdoll then roleColor = COLOR_RAGDOLL end

                    AttachHighlight(char, roleColor)
                    AttachLabel(head, tostring(playerIndexMap[v] or 1))
                else
                    RemovePlayerESP(char)
                end
            else
                RemovePlayerESP(char)
            end
        end
    end
end

local espTimer, uiTimer = 0, 0
TrackConnection(RunService.Heartbeat:Connect(function(dt)
    if espPlayerActive then
        espTimer = espTimer + dt
        if espTimer >= 0.1 then
            espTimer = 0
            UpdatePlayerESP()
        end
    end

    if Tab2Container.Visible and ScreenGui.Enabled then
        uiTimer = uiTimer + dt
        if uiTimer >= 0.25 then
            uiTimer = 0
            UpdatePlayerButtonColors()
        end
    end
end))

local noclipParts, noclipTimer = {}, 0
TrackConnection(RunService.Stepped:Connect(function(_, dt)
    if noclipActive then
        local char = LocalPlayer.Character
        if char then
            noclipTimer = noclipTimer + dt
            if char ~= noclipChar or noclipTimer >= 1 then
                noclipChar = char
                noclipTimer = 0
                noclipParts = {}
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then noclipParts[#noclipParts + 1] = v end
                end
            end
            for i = 1, #noclipParts do
                local part = noclipParts[i]
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end

    if speedActive then
        local hum = GetHumanoid()
        if hum then
            if hum.WalkSpeed ~= Speed.Run then hum.WalkSpeed = Speed.Run end
            Speed.Owned = true
        end
    elseif Speed.Owned then
        Speed.Owned = false
        local hum = GetHumanoid()
        if hum then hum.WalkSpeed = 16 end
    end
end))

TrackConnection(UserInputService.JumpRequest:Connect(function()
    if infJumpActive then
        local humanoid = GetHumanoid()
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

-- ================= UNLOAD =================
local function UnloadHack()
    if unloaded then return end
    unloaded = true

    remoteHackActive = false
    espPlayerActive = false
    noclipActive = false
    speedActive = false
    infJumpActive = false

    pcall(Fly.Stop)
    pcall(Follow.Stop)
    pcall(Follow.Release)
    pcall(AH.Stop)
    pcall(AR.Stop)
    pcall(TR.Stop)
    pcall(CB.Stop)
    pcall(function() RunService:UnbindFromRenderStep("NovaBeastLook") end)

    for _, conn in ipairs(activeConnections) do
        pcall(function() conn:Disconnect() end)
    end
    if shiftLockConn then pcall(function() shiftLockConn:Disconnect() end) end
    if crosshairConn then pcall(function() crosshairConn:Disconnect() end) end

    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == ESP_TAG or d.Name == BB_TAG then
            pcall(function() d:Destroy() end)
        end
    end

    pcall(function() ScreenGui:Destroy() end)
    pcall(function() CrosshairGui:Destroy() end)
    pcall(InvisBody.Hide)

    local hum = GetHumanoid()
    if hum then
        hum.WalkSpeed = 16
        hum.AutoRotate = true
    end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default

    if invis_on then
        invis_on = false
        pcall(function() setCharacterTransparency(0) end)
    end
    pcall(function() Workspace:FindFirstChild("invischair"):Destroy() end)
end

CloseBtn.MouseButton1Click:Connect(UnloadHack)

