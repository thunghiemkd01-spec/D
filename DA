-- Target troll owns only the collision flags it changes; manual noclip keeps its ownership.
function TR.SetNoclip(on)
    if not on then
        for part, canCollide in pairs(TR.CollisionParts) do
            if part.Parent and not noclipActive then
                pcall(function() part.CanCollide = canCollide end)
            end
        end
        TR.CollisionParts = {}
        TR.CollisionChar = nil
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    if char ~= TR.CollisionChar then
        TR.SetNoclip(false)
        TR.CollisionChar, TR.CollisionAt = char, -math.huge
    end
    if os.clock() - TR.CollisionAt >= 1 then
        TR.CollisionAt = os.clock()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and TR.CollisionParts[part] == nil then
                TR.CollisionParts[part] = part.CanCollide
            end
        end
    end
    for part in pairs(TR.CollisionParts) do
        if part.Parent then part.CanCollide = false end
    end
end

