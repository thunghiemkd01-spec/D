local ESP_TAG = "NovaESP"
local BB_TAG = ESP_TAG .. "_BB"

local function AttachHighlight(target, color)
    local hl = target:FindFirstChild(ESP_TAG)
    if hl and not hl:IsA("Highlight") then hl:Destroy() hl = nil end
    if not hl then
        hl = New("Highlight", target, {
            Name = ESP_TAG, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency = 0.5, OutlineTransparency = 0,
        })
    end
    if hl.FillColor ~= color then hl.FillColor = color end
    if hl.OutlineColor ~= color then hl.OutlineColor = color end
    if not hl.Enabled then hl.Enabled = true end
    return hl
end

local function RemoveHighlight(target)
    if not target then return end
    local hl = target:FindFirstChild(ESP_TAG)
    if hl then hl:Destroy() end
end

local function AttachLabel(head, text)
    local bb = head:FindFirstChild(BB_TAG)
    if bb and not bb:IsA("BillboardGui") then bb:Destroy() bb = nil end
    if not bb then
        bb = New("BillboardGui", nil, {
            Name = BB_TAG, Size = UDim2.new(0, 40, 0, 16),
            StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Adornee = head,
        })
        New("TextLabel", bb, {
            Name = "Text", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            TextSize = 10, Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.5,
            TextColor3 = Color3.fromRGB(255, 215, 0),
        })
        bb.Parent = head
    end
    local t = bb:FindFirstChild("Text")
    if t and t.Text ~= text then t.Text = text end
    if not bb.Enabled then bb.Enabled = true end
