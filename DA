function Cmd.FriendshipStatus()
    return false, "roblox exposes no supported public client api to automatically accept incoming friend requests; accept them in the roblox friends menu"
end

function Cmd.Exec(player, intent, silent, text, target)
    local featureRequest = intent == "follow" or intent == "farm" or intent == "stop" or intent == "vote"
    if unloaded or not CB.Active or not player or player.Parent ~= Players then return end
    if not featureRequest and (Ctl.On() or Fly.Active) then
        if not silent then CB.Say("manual controls are active; finish controlling me before that command") end
        return
    end
    -- The newest explicit request wins; autonomous features keep their settings and paths.
    Cmd.Cleanup(Cmd.Token)
    Cmd.Token = Cmd.Token + 1
    local id = Cmd.Token
    Cmd.AimUnbind()
    Cmd.CancelFlip()
    Cmd.PendingHit = nil
    Cmd.FollowDirectiveTarget, Cmd.FarmDirective = nil, false
    if AR.CancelRequest then AR.CancelRequest() end
    Cmd.ActiveId = id
    FH.CancelMotion()
    pcall(Follow.Release)
    pcall(AR.Release)
    pcall(TR.Release)
    local function say(s) if not silent and s then CB.Say(s) end end
    local ok, err = pcall(function()
        if intent == "stop" then
            if Follow.Target or Follow.RandomActive then Follow.Stop() elseif Follow.AutoFarm then Follow.StopAutoFarm() end
            say("okay, stopping. say 'tom follow me' or 'tom farm' when you need me again")
        elseif intent == "follow" then
            local request = Cmd.RequestText(text or ""):gsub(" please$", ""):gsub(" pls$", ""):gsub(" now$", "")
            local selfRequest = request == "follow" or request == "folow" or request == "follow me" or request == "folow me"
                or request == "come here" or request == "come with me" or request == "stick with me"
            local who = selfRequest and player or Cmd.FindTarget(text or "", player, target)
            if not who or who == LocalPlayer then
                CB.Say("i can't identify that player uniquely. say 'tom follow me' or use their exact username")
                return
            end
            if Cmd.FollowPlayer(who, player) then
                if who == player then say("sure, i'm following you now. say 'tom stop' when you want me to stop")
                else say("sure, following " .. who.DisplayName .. " now. say 'tom stop' to cancel") end
            end
        elseif intent == "farm" then
            if Cmd.Farm() then
                say("got it, i'll hack the remaining computers and free anyone who gets frozen. say 'tom stop' to cancel")
            else CB.Say("i can only farm during a match as a survivor, ask me again next round") end
        elseif intent == "escape" then Cmd.Escape(id)
        elseif intent == "vote" then Cmd.Vote(text or "", id)
        elseif intent == "dance" then say("alright, time for some moves") Cmd.Emote("dance2", 12, id)
        elseif intent == "wave" then Cmd.Emote("wave", 3, id)
        elseif intent == "backflip" then Cmd.Backflip(player, id)
        elseif intent == "hit" then Cmd.Hit(player, text or "", id, target)
        elseif intent == "jump" then
            say("sure, a few jumps coming up")
            for _ = 1, 3 do
                if not Cmd.CanAct(id) then break end
                local hum = GetHumanoid()
                if hum then FH.Jump(hum, true) end
                task.wait(0.7)
            end
            Cmd.Cleanup(id)
        end
    end)
    if Cmd.FlipState and Cmd.FlipState.id == id then Cmd.CancelFlip() end
    Cmd.Cleanup(id)
    if not ok then warn("[Tommy command] " .. tostring(err)) end
end

function Cmd.Process(player, text)
    local intent = Cmd.Intent(text)
    if not intent then return false end
    local now = os.clock()
    local request = Cmd.RequestText(text)
    if intent ~= "stop" and Cmd.LastSpeaker == player and Cmd.LastText == request
        and now - Cmd.LastAt < 0.75 then return true end
    Cmd.LastAt = now
    Cmd.LastSpeaker, Cmd.LastText = player, request
    task.spawn(Cmd.Exec, player, intent, false, text, nil)
    return true
end

