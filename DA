function CB.Parse(raw)
    if type(raw) ~= "string" then return "none", nil, nil end
    local trimmed = string.match(raw, "^%s*(.-)%s*$") or ""
    local candidate = string.match(trimmed, "^```[%w_]*%s*(.-)%s*```$") or trimmed
    local a, b = string.find(candidate, "{.*}")
    if a then
        local ok, data = pcall(function() return HttpService:JSONDecode(string.sub(candidate, a, b)) end)
        if ok and type(data) == "table" then
            if type(data.action) == "string" and CB.Lower(data.action) ~= "none" then
                return "none", nil, nil -- Reject false action confirmations as well as control fields.
            end
            return "none", type(data.reply) == "string" and data.reply or nil, nil
        end
        return "none", nil, nil
    end
    if string.sub(candidate, 1, 1) == "{" then return "none", nil, nil end
    return "none", candidate, nil
end

