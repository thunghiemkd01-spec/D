-- Rescue can cross a low obstruction instead of following the native path's
-- walking detour. Every shoulder lane still needs floor, headroom and landing.
function Follow.RescueJumpLane(rp, point, feetY)
    local delta = Flat(point - rp)
    local distance = delta.Magnitude
    if distance < 3 or distance > 18 or math.abs(point.Y - feetY) > 2.5 then return nil end
    local hum = GetHumanoid()
    local singleJump, doubleJump = FH.NativeJumpLimits(hum)
    if doubleJump <= 0 then return nil end
    local direction = delta.Unit
    local across = Vector3.new(-direction.Z, 0, direction.X)
    local radius = FH.BodyRadius()
    local steps = math.ceil(distance / 3)
    local length = distance / steps
    local centerJumps, centerBig = 0, 0
    for _, offset in ipairs({ 0, radius, -radius }) do
        local origin, floorY = rp + across * offset, feetY
        local jumps, big = 0, 0
        for i = 0, steps - 1 do
            local x, z = origin.X + direction.X * length * i, origin.Z + direction.Z * length * i
            local floor, jump, sill = FH.Seg(x, z, direction, floorY, length)
            if not floor then return nil end
            if jump then
                jumps = jumps + 1
                if (sill or 0) > doubleJump then return nil end
                if jump == "jump2" or (sill or 0) > singleJump then big = big + 1 end
                if jumps > 3 or big > 1 then return nil end
                local rise = (sill or 0) + 0.5
                local head = Vector3.new(x, floorY + Follow.BodyH + 0.1, z)
                if Workspace:Raycast(head, Vector3.new(0, rise, 0), rayParams) then return nil end
                local crest = Vector3.new(x, floorY + (sill or 0) + 0.2, z) + direction * (length * 0.5)
                if Workspace:Raycast(crest, Vector3.new(0, Follow.BodyH, 0), rayParams) then return nil end
            end
            floorY = floor
        end
        if math.abs(floorY - point.Y) > 1.5 then return nil end
        local landing = point + across * offset
        local floor =
            Workspace:Raycast(Vector3.new(landing.X, point.Y + 3, landing.Z), Vector3.new(0, -6, 0), rayParams)
        if not floor or floor.Normal.Y < 0.6 or math.abs(floor.Position.Y - point.Y) > 1.5 then return nil end
        local feet = Vector3.new(landing.X, floor.Position.Y + 0.2, landing.Z)
        if Workspace:Raycast(feet, Vector3.new(0, Follow.BodyH, 0), rayParams) then return nil end
        if offset == 0 then
            centerJumps, centerBig = jumps, big
        end
    end
    if centerJumps == 0 then return nil end
    return centerJumps, centerBig
end
function Follow.RescueShortcut(rp, feetY, wps, index, blockedAt, goal)
    if not (wps and wps[index] and goal) then return nil end
    local routeLength = (wps[index].Position - Vector3.new(rp.X, feetY, rp.Z)).Magnitude
    local candidates = {}
    local goalDistance = Flat(goal - rp).Magnitude
    local last = math.min(#wps, index + 10, blockedAt and blockedAt - 1 or #wps)
    for i = index + 1, last do
        local point = wps[i].Position
        routeLength = routeLength + (point - wps[i - 1].Position).Magnitude
        local distance = Flat(point - rp).Magnitude
        local saved = routeLength - distance
        if
            distance >= 3
            and distance <= 18
            and saved > 2
            and math.abs(point.Y - feetY) <= 2.5
            and wps[i].Action ~= Enum.PathWaypointAction.Jump
            and Flat(goal - point).Magnitude < goalDistance - 1
        then
            candidates[#candidates + 1] = { index = i, point = point, saved = saved }
        end
    end
    table.sort(candidates, function(a, b) return a.saved > b.saved end)
    local hum = GetHumanoid()
    local speed = hum and math.max(hum.WalkSpeed, 1) or 16
    -- Bound ray work even if a native path contains many small detour points.
    for i = 1, math.min(2, #candidates) do
        local candidate = candidates[i]
        local jumps, big = Follow.RescueJumpLane(rp, candidate.point, feetY)
        if jumps and candidate.saved > 2 + speed * (jumps * 0.16 + big * 0.18) then return candidate.index end
    end
    return nil
end
-- A native fall can outlast the short scripted-jump record. Keep the current
-- route while physically airborne, then resume floor checks on landing.
function Follow.Airborne(hum, root)
    if not hum or not root or hum.Sit or hum.PlatformStand or hum.FloorMaterial ~= Enum.Material.Air then
        return false
    end
    local state = hum:GetState()
    local velocity = root.AssemblyLinearVelocity
    return state == Enum.HumanoidStateType.Freefall
        or (state == Enum.HumanoidStateType.Jumping and velocity ~= nil and math.abs(velocity.Y) > 0.5)
end
function Follow.AirClear(hum, root, point, reachLimit)
    local delta = Flat(point - root.Position)
    if delta.Magnitude <= 0.1 then return true end
    local direction = delta.Unit
    local across = Vector3.new(-direction.Z, 0, direction.X)
    local reach = math.min(delta.Magnitude, reachLimit or 3.4)
    local feetY, radius = FH.Feet(hum, root), FH.BodyRadius(root)
    for _, offset in ipairs({ 0, radius, -radius }) do
        for _, height in ipairs({ 0.7, 2.7, Follow.BodyH - 0.15 }) do
            local origin = Vector3.new(root.Position.X, feetY + height, root.Position.Z) + across * offset
            if Workspace:Raycast(origin, direction * reach, rayParams) then return false end
        end
    end
    return true
end
-- Root/trigger heights can differ on the same floor, or nearly match across
-- two floors. Only a real supporting floor can confirm arrival/contact.
function Follow.GoalGround(goal, ignoreModel)
    local params = rayParams
