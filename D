        and blocked.hum == hum
        and blocked.root == root
        and now - blocked.at < 0.2
        and Flat(rp - blocked.pos).Magnitude < 0.2
        and math.abs(feetY - blocked.feetY) < 0.2
        and blockedStep.Magnitude > 0.1
        and dv.Magnitude > 0.1
        and blockedStep.Unit:Dot(dv.Unit) > 0.8
        and hum.FloorMaterial ~= Enum.Material.Air
