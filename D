                    not root
                    or FH.True(player, FH.CAP)
                    or FH.True(player, FH.RAG)
                    or not center
                    or Flat(root.Position - center).Magnitude > Follow.ExitTeamRange
                    or math.abs(root.Position.Y - center.Y) > Follow.MaxDY + 1.5
