function FH.Nav.PortalFrame(door, prior)
    local nav = FH.Nav
    local fixed
    pcall(function() fixed = door:FindFirstChild("DoorFrame", true) or door:FindFirstChild("Frame", true) end)
    if fixed and fixed:IsA("BasePart") and fixed:IsDescendantOf(door) then
        local size, cf = fixed.Size, fixed.CFrame
        local thinX = size.X <= size.Z
        local depth, width = thinX and size.X or size.Z, thinX and size.Z or size.X
        local direction = Flat(thinX and cf.RightVector or cf.LookVector)
        if depth <= width * 0.7 and direction.Magnitude > 0.9 then
            return {
                center = cf.Position,
                normal = direction.Unit,
                reach = depth * 0.5 + 3.2,
                source = fixed,
            }
        end
    end
    -- A previously validated opening remains fixed while its leaf swings.
    -- Changing map generation already clears prior portals in OnReset.
    local saved = prior and prior.frame
    if saved and (not saved.source or (saved.source.Parent and saved.source:IsDescendantOf(door))) then
        local unchanged = true
        if saved.triggerA then
            local a, b = saved.triggerA, saved.triggerB
            unchanged = a.Parent and b and b.Parent and a:IsDescendantOf(door) and b:IsDescendantOf(door)
            if unchanged then
                local midpoint, delta = (a.Position + b.Position) * 0.5, Flat(b.Position - a.Position)
                unchanged = (midpoint - saved.center).Magnitude <= 0.12
                    and delta.Magnitude >= 1.25
                    and math.abs(delta.Unit:Dot(saved.normal)) >= 0.9995
                    and (not saved.triggerLength or math.abs(delta.Magnitude - saved.triggerLength) <= 0.12)
            end
        end
        if unchanged then return saved end
    end
    local center, size = FH.DoorBounds(door)
    if not center or not size then return nil end
    local info = FH.DoorInfo(door)
    local triggers = type(info) == "table" and info.Triggers or {}
    local pick, bestCost
    for i = 1, #triggers - 1 do
        local a = triggers[i]
        if a.Parent and a:IsDescendantOf(door) then
            for j = i + 1, #triggers do
                local b = triggers[j]
                if b.Parent and b:IsDescendantOf(door) and math.abs(a.Position.Y - b.Position.Y) < 1.5 then
                    local delta = Flat(b.Position - a.Position)
                    local length = delta.Magnitude
