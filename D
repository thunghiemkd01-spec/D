function FH.ExitThreat(center, stand, origin, door)
    if not center then return false end
    FH.RefreshFilter()
    local target = stand or center
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Parent == Players and FH.True(player, FH.BEASTN) then
            local character = player.Character
            local beast = character and character:FindFirstChild("HumanoidRootPart")
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            if beast and hum and hum.Health > 0 and FH.InMatchPlayer(player) then
                local pos = beast.Position
                -- Doorway capture risk is independent of AutoHide's red range.
                for _, point in ipairs({ center, target }) do
                    if
                        math.abs(pos.Y - point.Y) <= Follow.MaxDY + 1.5
                        and Flat(pos - point).Magnitude <= 32
                        and FH.ApproachClear(pos, point, door)
                    then
                        return true
                    end
                end
                if origin then
                    local lane = Flat(target - origin)
                    local length2 = lane:Dot(lane)
                    if length2 > 1 then
                        local along = Flat(pos - origin):Dot(lane) / length2
                        -- A chase behind us must not reject every exit ahead.
                        if along > 0.05 and along < 1 then
