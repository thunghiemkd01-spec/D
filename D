    if flight and flight.hum == hum and flight.root == root and now - flight.t <= 1.2 then state.jumped = true end
    if hum.FloorMaterial == Enum.Material.Air and not FH.TakeoffSupported(hum, root) then
        state.anchor, state.at = rp, now
        return false
    end
    if state.jumped or now - state.at < 0.8 then return false end
    if not FH.NormalJump(hum) then return false end
