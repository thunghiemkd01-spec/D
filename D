function FH.Unstick(hum, root, token, goal, dur)
    if not (hum and root) then return end
    local rp = root.Position
    local feetY = FH.Feet(hum, root)
    FH.RefreshFilter()
    local toGoal = goal and Flat(goal - rp) or nil
    if toGoal and toGoal.Magnitude > 0.5 then
        toGoal = toGoal.Unit
    else
        toGoal = nil
    end
    local bestDir, bestScore, bestReach
    local base = math.random() * math.pi * 2
    for i = 0, 11 do
        local a = base + i * math.pi / 6
        local dir = Vector3.new(math.cos(a), 0, math.sin(a))
        local free = 12
        for _, h in ipairs({ 1.2, 3.2 }) do
            local r = Workspace:Raycast(Vector3.new(rp.X, feetY + h, rp.Z), dir * 12, rayParams)
            if r and r.Normal.Y <= 0.6 then free = math.min(free, r.Distance) end
        end
        local sc = free + math.random()
        if toGoal then sc = sc + dir:Dot(toGoal) * 3 end
        if FH.IsBad(rp.X + dir.X * 5, rp.Z + dir.Z * 5, 2.5) then sc = sc - 15 end
        if free > 4 then
            local gp = rp + dir * math.min(free, 8)
            local g = Workspace:Raycast(Vector3.new(gp.X, feetY + 3, gp.Z), Vector3.new(0, -14, 0), rayParams)
            if not g then sc = sc - 20 end
        end
        local reach = math.min(8, free - 1.2)
        local safe = reach >= 2.5
        if safe then
            local across = Vector3.new(-dir.Z, 0, dir.X)
            for _, off in ipairs({ 0, 0.75, -0.75 }) do
                local origin, floorY = rp + across * off, feetY
                for j = 0, 1 do
                    local floor, jump = FH.Seg(
                        origin.X + dir.X * reach * 0.5 * j,
                        origin.Z + dir.Z * reach * 0.5 * j,
                        dir,
                        floorY,
                        reach * 0.5
                    )
                    if not floor or jump or math.abs(floor - feetY) > 2.5 then
                        safe = false
                        break
                    end
                    floorY = floor
                end
                if not safe then break end
            end
        end
        if safe and (not bestScore or sc > bestScore) then
            bestDir, bestScore, bestReach = dir, sc, reach
        end
    end
    if not bestDir then return end
    local aim = rp + bestDir * bestReach
    local t0 = os.clock()
    local limit = dur or 0.9
    while TokOK(token) and os.clock() - t0 < limit do
        if Ctl.On() then break end
        Follow.Beat = os.clock()
        FH.Move(token, hum, aim)
        task.wait(0.04)
    end
end
function FH.Ground(pos, settings)
