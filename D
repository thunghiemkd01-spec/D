function CB.PerformanceStep()
    local now = os.clock()
    if now < (CB.PerformanceCheckAt or 0) then return end
    CB.PerformanceCheckAt = now + 2
    local pending = CB.PerformancePending
    if pending then
        if
            pending.tok ~= CB.Token
            or pending.cmdToken ~= Cmd.Token
            or now >= pending.deadline
            or not CB.PerformancePlayer(pending.player)
            or pending.player.Character ~= pending.character
        then
            CB.PerformancePending = nil
        end
        return
    end
    if
        CB.PerformanceRequest
        or CB.PerformanceFlight
        or now < CB.PerformanceNextAt
        or not CB.ProactiveReady()
        or not CB.PerformanceIdle()
        or not CB.CanSpeak()
    then
        return
    end
    local root, choices = RootNow(), {}
    for _, player in ipairs(Players:GetPlayers()) do
        local other = CB.PerformancePlayer(player)
        if other and (other.Position - root.Position).Magnitude <= 48 then choices[#choices + 1] = player end
    end
    CB.PerformanceNextAt = now + 30
    if #choices == 0 then return end
    local player, kind = choices[math.random(1, #choices)], math.random(1, 2) == 1 and "magic" or "dance"
    local tok, cmdToken, character = CB.Token, Cmd.Token, player.Character
    local function guard()
        local other, me = CB.PerformancePlayer(player), RootNow()
        return tok == CB.Token
            and cmdToken == Cmd.Token
            and player.Character == character
            and other ~= nil
            and me ~= nil
            and (other.Position - me.Position).Magnitude <= 48
            and not CB.PerformancePending
            and CB.PerformanceIdle()
    end
    local name = player.DisplayName ~= "" and player.DisplayName or player.Name
    local invitation =
        string.format("%s, want to see %s? say yes or no", name, kind == "magic" and "a magic trick" or "a dance")
    CB.ProactiveSay(invitation, "performance", guard, function(sent)
        if sent and guard() then
            CB.PerformancePending = {
                player = player,
                character = character,
                kind = kind,
                tok = tok,
                cmdToken = cmdToken,
                deadline = os.clock() + 60,
            }
        end
        if tok == CB.Token then CB.PerformanceNextAt = os.clock() + math.random(240, 360) end
    end)
end
