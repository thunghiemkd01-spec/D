        end
    end
    if not kind then
        kind, sill = FH.MotionProfile(hum, root, aim, feetY, reach)
    end
    if not kind then
        FH.RefreshFilter()
        local low = Workspace:Raycast(Vector3.new(rp.X, feetY + 0.35, rp.Z), delta.Unit * reach, rayParams)
        if low and low.Normal.Y < 0.55 then
            local upper = Workspace:Raycast(Vector3.new(rp.X, feetY + 2.8, rp.Z), delta.Unit * reach, rayParams)
            local floor = Workspace:Raycast(
                Vector3.new(rp.X, feetY + 3, rp.Z) + delta.Unit * reach,
                Vector3.new(0, -5, 0),
                rayParams
            )
