function Cmd.Hit(speaker, text, id, hint)
    if not Cmd.CanAct(id) then return end
    if not FH.AmBeast() then
        CB.Say("i can only hit people while i'm the beast, and right now i'm a humble survivor")
        return
    end
    local target = Cmd.FindTarget(text, speaker, hint)
    if not target or target == LocalPlayer then
        CB.Say("who should i hit? say it like 'tom hit <name>'")
        return
    end
    if FH.True(target, FH.CAP) then
        CB.Say(target.DisplayName .. " is already frozen, pick someone who is still running")
        return
    end
    -- Silent mode cannot deliver a permission question, so it never starts an attack.
    if CB.Silent or not CB.CanSpeak() then return end
    FH.CancelMotion()
    local function troot()
        local c = target.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function goal()
        local r = troot()
        return r and r.Position
    end
    local pending = { id = id, target = target, refused = false, queuedAt = os.clock() }
    Cmd.PendingHit = pending
    -- Đồng hồ 10 giây chỉ bắt đầu sau khi câu hỏi thực sự được gửi ra chat.
    local function waiting() return Cmd.CanAct(id) and not pending.refused and FH.AmBeast() and not AH.Down() end
    local question = string.format(
        "%s, may i hit you? say yes or no within 10 seconds. no answer means i cancel.",
        target.DisplayName
    )
    local replyItem = CB.ReplyContext() or { at = pending.queuedAt }
    pending.sendBy = math.max(
        os.clock(),
        CB.ReplyReadyAt(replyItem, question),
        CB.OutAt + CB.ReplyWaitDuration(question)
    ) + 30
    local queued = CB.Say(question, true, function(sent)
        if Cmd.PendingHit ~= pending or not Cmd.CanAct(id) or pending.refused then return end
        if sent then
            pending.deadline = os.clock() + 10
        else
            pending.failed = true
        end
    end, false, function() return Cmd.PendingHit == pending and waiting() end)
    if queued == false then pending.failed = true end
    while waiting() and target.Parent == Players do
        if pending.failed or pending.accepted then break end
        if pending.deadline then
            if os.clock() >= pending.deadline then break end
        elseif os.clock() >= pending.sendBy then
            pending.failed = true
            break
        end
        task.wait(0.05)
    end
    if
        not pending.accepted
        or pending.refused
        or pending.failed
        or not pending.deadline
        or os.clock() > pending.deadline
        or not Cmd.CanAct(id)
        or not FH.AmBeast()
        or target.Parent ~= Players
        or AH.Down()
        or Ctl.On()
    then
        if pending.failed and Cmd.Token == id then
            CB.Say("i couldn't send the permission question, so i've cancelled the hit")
        end
        if not pending.failed and not pending.refused and Cmd.Token == id then
            CB.Say("no permission received in time; hit cancelled", true)
        end
        Cmd.Cleanup(id)
        return
    end
    if Cmd.PendingHit == pending then Cmd.PendingHit = nil end
    local started, clicks, hitDone = os.clock(), 0, false
    local initRag, interrupted = FH.True(target, FH.RAG), false
    local tok = Cmd.MotionFor(id, function()
        if not FH.AmBeast() or hitDone or target.Parent ~= Players or os.clock() - started > 35 or AH.Down() then
            return false
        end
        return true
    end)
    Cmd.AimBind(goal, id)
    CB.Say("heading to " .. target.DisplayName .. " now. say 'tom stop' to cancel")
    while tok.ok() do
        local tr, me = troot(), RootNow()
        if not (tr and me) then
            task.wait(0.15)
        else
            if FH.True(target, FH.CAP) or (not initRag and FH.True(target, FH.RAG)) then
                hitDone = true
                break
            end
            local d, dy = Flat(tr.Position - me.Position).Magnitude, math.abs(tr.Position.Y - me.Position.Y)
            if d <= Cmd.HitRange and dy < 6 then
                Cmd.Click()
                clicks = clicks + 1
                task.wait(0.4)
                if clicks >= 14 then break end
            else
                local function stopNear()
                    if not tok.ok() then return true end
                    local r2, m2 = troot(), RootNow()
                    return r2 ~= nil and m2 ~= nil and Flat(r2.Position - m2.Position).Magnitude <= Cmd.HitRange - 0.5
                end
                local res = Follow.Chase(tok, goal, 3.2, stopNear, nil)
                if res == "trapped" then Follow.WalkTo(tok, goal, 3.2, stopNear, { maxTime = 6 }) end
                task.wait(0.03)
            end
        end
    end
    interrupted = Ctl.On() or Fly.Active
    Cmd.Cleanup(id)
    if Cmd.Token ~= id then return end
    if hitDone then
        CB.Say("got them, " .. target.DisplayName .. " is down. who's next?")
    elseif interrupted then
        CB.Say("movement controls took priority; hit cancelled")
    elseif clicks > 0 then
        CB.Say("i swung at " .. target.DisplayName .. " but didn't land it, want me to retry?")
    else
        CB.Say("couldn't reach " .. target.DisplayName .. " in time, they're hiding somewhere tricky")
    end
end
function Cmd.Escape(id)
    if not Cmd.CanAct(id) then return end
    if FH.AmBeast() or AH.Down() or FH.True(LocalPlayer, FH.ESC) or not GetCurrentMap() then
        CB.Say("i can escape only while i'm an active survivor in a match")
        return
    end
    local root = RootNow()
    if not root then return end
    local best, score
    for _, door in ipairs(ExitDoors) do
        if IsInWorld(door) then
            local center = FH.ExitArea(door)
            if center then
                local d = (center - root.Position).Magnitude
                if not score or d < score then
                    best, score = door, d
                end
            end
        end
    end
    if not best then
        CB.Say("i can't find an exit door in this map yet")
        return
    end
    CB.Say("heading to the nearest exit. if it's locked, i'll wait there for it to unlock")
    local started, center = os.clock(), FH.ExitArea(best)
    local approachPos, loiter = root.Position, {}
    local tok = Cmd.MotionFor(
        id,
        function()
            return IsInWorld(best)
                and os.clock() - started < 65
                and not AH.Down()
                and not FH.True(LocalPlayer, FH.ESC)
                and not FH.AmBeast()
        end
    )
    local function aborted() return not tok.ok() end
    local function blocked()
        local me = RootNow()
        if not me then return true end
        FH.RefreshFilter()
        for _, offset in ipairs({ -1, 1 }) do
            local from = Vector3.new(approachPos.X, me.Position.Y + offset, approachPos.Z)
            local to = Vector3.new(center.X, from.Y, center.Z)
            local hit = Workspace:Raycast(from, to - from, rayParams)
            if hit and hit.Instance:IsDescendantOf(best) and hit.Instance.CanCollide then return true end
        end
        return false
    end
    local triggers = best:IsA("Model") and FH.Triggers(best) or {}
    table.sort(
        triggers,
        function(a, b) return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude end
    )
    local stand = triggers[1]
    local direction = Flat(root.Position - center)
    if direction.Magnitude < 0.5 then direction = Vector3.new(0, 0, 1) end
    local standPos = FH.Ground(stand and stand.Position or (center + direction.Unit * 6))
    approachPos = standPos
    Follow.WalkTo(tok, function() return standPos end, 1.8, aborted, { maxTime = 30, nearOk = 3 })
    while tok.ok() and blocked() do
        if FH.ExitOpen() and stand then
            local me = RootNow()
            if me and (stand.Position - me.Position).Magnitude <= 3.5 then
                if Cmd.HoldInput(tok, stand:FindFirstChild("Event")) then FH.MarkWork(tok, "exit") end
            else
                Cmd.ReleaseInput(id)
                Follow.WalkTo(tok, function() return standPos end, 1.8, aborted, { maxTime = 6, nearOk = 3 })
            end
        else
            Cmd.ReleaseInput(id)
            FH.ExitLoiter(tok, standPos, center, loiter)
        end
        task.wait(0.08)
    end
    Cmd.ReleaseInput(id)
    if tok.ok() then
        local me = RootNow()
        local through = me and Flat(center - me.Position) or -direction
        if through.Magnitude < 0.5 then through = -direction end
        local beyond = FH.Ground(center + through.Unit * 10)
        Follow.WalkTo(tok, function() return beyond end, 1.5, aborted, { maxTime = 12, nearOk = 2.5, noDoor = true })
    end
    local escaped = FH.True(LocalPlayer, FH.ESC)
    Cmd.Cleanup(id)
    if Cmd.Token == id then
        if escaped then
            CB.Say("made it out. fridge delivery complete")
        elseif not Ctl.On() and not Fly.Active and not AH.Down() then
            CB.Say("i reached the exit route, but escape isn't confirmed yet. the door may still be locked")
        end
    end
end
