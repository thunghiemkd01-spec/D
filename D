        end
        if crossingTraversal then
            local crossing = crossingTraversal
            local delta = Flat(crossing.aim - rp)
            local along = delta:Dot(crossing.dir)
            local lateral = (delta - crossing.dir * along).Magnitude
            local passed = along <= 0.8 and lateral <= 2.2
            local grounded = hum.FloorMaterial ~= Enum.Material.Air
            if
                crossing.hum ~= hum
                or crossing.root ~= root
                or now >= crossing.untilAt
                or lateral > 2.2
                or passed
                or (grounded and crossing.airborne)
            then
                if Follow.CrossingTraversal == crossing then Follow.CrossingTraversal = nil end
                crossingTraversal = nil
                if passed and mode == "path" and crossing.index and wps and wps[crossing.index + 1] then
                    wpi, laIdx = math.max(wpi, crossing.index + 1), nil
                end
                pendingSteer.aim = nil
            elseif not grounded or now - crossing.t < 0.25 then
                crossing.airborne = crossing.airborne or not grounded
                FH.Move(token, hum, crossing.aim)
                task.wait(0.03)
                continue
            else
                -- Default game input declined takeoff; release the proof.
                if Follow.CrossingTraversal == crossing then Follow.CrossingTraversal = nil end
                crossingTraversal = nil
            end
        end
        if not dropTraversal and Follow.ActiveDrop(token, hum, root) then dropTraversal = Follow.DropTraversal end
        if dropTraversal then
            local drop = dropTraversal
            if
                drop.hum ~= hum
                or drop.root ~= root
                or now >= drop.untilAt
                or (hum.FloorMaterial ~= Enum.Material.Air and math.abs(feetY - drop.aim.Y) < 1.5)
            then
                if Follow.DropTraversal == drop then Follow.DropTraversal = nil end
                dropTraversal = nil
            elseif
                Follow.Airborne(hum, root)
                or (drop.jump and now - drop.t < 0.25)
                or Follow.DropLane(hum, root, drop.aim, feetY)
            then
                FH.Move(token, hum, drop.aim)
                task.wait(0.03)
                continue
            else
                if Follow.DropTraversal == drop then Follow.DropTraversal = nil end
                dropTraversal = nil
            end
        end
        if flying and FH.JumpFlight and FH.JumpFlight.normal and FH.JumpFlight.feetY then
            feetY = FH.JumpFlight.feetY
        end
        if routeProgress and hum.FloorMaterial ~= Enum.Material.Air then groundedFeetY = feetY end
        if jumpTraversal then
            local traversal = jumpTraversal
            local takeoff = wps and wps[traversal.index]
            local offset = takeoff and Flat(rp - takeoff.Position)
            local along = offset and offset:Dot(traversal.dir)
            if
                traversal.hum ~= hum
                or traversal.root ~= root
                or now - traversal.t > 1.2
                or not offset
                or (offset - traversal.dir * along).Magnitude > 2.2
                or (blockedAt and blockedAt <= traversal.index + 1)
                or Flat(traversal.aim - rp):Dot(traversal.dir) <= 0
            then
                jumpTraversal = nil
            elseif flying then
                traversal.airborne = true
                -- Recheck the committed ground lane for a newly closed door,
                -- without treating the rising avatar's feet as a new floor.
                if now - traversal.checkAt >= 0.12 then
                    traversal.checkAt = now
                    if not clearLane(rp, traversal.aim, traversal.feetY) then jumpTraversal = nil end
                end
            elseif traversal.airborne or now - traversal.t > 0.3 then
                jumpTraversal = nil
            end
        end
        if FH.ForceUnstick then
            FH.ForceUnstick = false
            FH.Unstick(hum, root, token, goal, 0.6)
            reset()
            continue
        end
        if
            flatDist <= sd
            and dyg < Follow.MaxDY
            and Follow.GoalOnFloor(hum, root, goal, opts.approachModel)
            and FH.ApproachClear(rp, goal, opts.approachModel)
        then
            if not (keep and flatDist > 5 and keep()) then return finish("arrived", true) end
        end
        if job and not job.done and now - job.at > 8 then return finish("timeout", true) end
        if Follow.ActiveEscape(token, hum, root) then
            FH.Move(token, hum, goal)
            task.wait(0.03)
            continue
        end
        if job and job.done and not flying then
            local j = job
            job = nil
            local fresh = true
            if stableFollow and j.goal and (goal - j.goal).Magnitude > 5 and j.res then
                local from = j.res.mode == "direct" and rp or (j.res.mode == "path" and j.res.wps[#j.res.wps].Position)
                if from then
                    local groundY = Follow.GoalGround(goal, opts.approachModel).Y - 0.5
                    local fromY = j.res.mode == "direct" and feetY or from.Y
                    fresh = (j.res.mode ~= "direct" or dyg < Follow.MaxDY)
                        and FH.Line(from, goal, fromY, groundY, 1.5)
                        and clearLane(from, goal, fromY)
                end
            end
            if j.gen == gen and fresh then
                local res = applyRes(j.res, rp, goal)
                if not alive() then return finish("abort", false) end
                if res == "door" then
                    reset()
                    rescueDoorTried = false
                    stuck, fails = 0, 0
                    continue
                end
                if res then
                    fails = 0
                else
                    fails = fails + 1
                    if mode ~= "path" then mode = nil end
                    nextPlan = os.clock() + math.min(0.15 * fails, 0.6)
                    if fails >= 3 and mode == nil then
                        FH.BanDirect = os.clock() + 2
                        return finish("nopath", true)
                    end
                end
            else
                dispose(j.res)
                if j.gen == gen then
                    planAt, nextPlan = 0, 0
                end
            end
        end
        local need = false
        if mode == nil then
            need = (job == nil) and now >= nextPlan
        elseif not flying and now - planAt > 0.3 and not job then
            local moved = (goal - planGoal).Magnitude
            if mode == "direct" then
                if now - chkAt > 0.25 then
                    chkAt = now
                    local ok = FH.Line(rp, goal, feetY, Follow.GoalGround(goal, opts.approachModel).Y - 0.5, 1.5)
                    if not ok then need = true end
                end
            else
                if blockedAt then
                    need = true
                elseif moved > 5 and now - planAt > 0.6 then
                    need = true
                elseif not wpFull and now - planAt > 1.2 then
                    need = true
                elseif wpi >= #wps and Flat(wps[#wps].Position - rp).Magnitude < 3 then
                    need = true
                end
            end
        end
        if need then
            planAt, planGoal = now, goal
            local lineOk, jumps, big = false, 0, 0
            if
                (now > banDirect and now > FH.BanDirect or flatDist < 18)
                and flatDist < 70
                and (not stableFollow or dyg < Follow.MaxDY)
            then
                lineOk, jumps, big = FH.Line(rp, goal, feetY, Follow.GoalGround(goal, opts.approachModel).Y - 0.5, 1.5)
            end
            lineOk = lineOk and clearLane(rp, goal, feetY)
            if lineOk and (jumps == 0 or evade or (windows and jumps <= 3 and big <= 1)) then
                clearPath()
                mode, wps = "direct", nil
                fails = 0
            else
                gen = gen + 1
                local myGen = gen
                local j = { gen = myGen, done = false, at = now, goal = goal }
                job = j
                local pre = { lineOk = lineOk, jumps = jumps, big = big, straight = flatDist }
                local r0, g0, f0 = rp, goal, feetY
                if not mode then Follow.PlanStep(token, hum, root, goal, feetY, pendingSteer, opts.rescueJuke, opts.approachModel) end
                task.spawn(function()
                    local ok, res = pcall(planner, r0, g0, f0, myGen, pre)
                    if res and (myGen ~= gen or not alive()) then
                        dispose(res)
                        res = nil
                    end
                    j.res = ok and res or nil
                    j.done = true
                end)
            end
        end
        if not mode then
            if not Follow.PlanStep(token, hum, root, goal, feetY, pendingSteer, opts.rescueJuke, opts.approachModel) then
                -- Only stop if every locally scanned direction is obstructed.
                FH.Move(token, hum, rp, false, goal)
            end
            task.wait(0.03)
            continue
        end
        local aim
        if mode == "direct" then
            aim = goal
        else
            local fp = Vector3.new(rp.X, feetY, rp.Z)
            if physicalRoute and not flying then
                for i = wpi, math.min(#wps, wpi + 2, blockedAt and blockedAt - 1 or #wps) do
                    local landing, crossing = Follow.DropLane(hum, root, wps[i].Position, feetY)
                    local drop = landing and Follow.StartDrop(token, hum, root, landing, crossing, i)
                    if drop then
                        wpi, laIdx, dropTraversal = i, nil, drop
                        FH.Move(token, hum, landing)
                        task.wait(0.03)
                        break
                    end
                end
                if dropTraversal then continue end
            end
            if
                opts.rescueJuke
                and hum.FloorMaterial ~= Enum.Material.Air
                and not FH.JumpFlight
                and now - rescueShortcutAt >= 0.25
            then
                rescueShortcutAt = now
                local shortcut = Follow.RescueShortcut(rp, feetY, wps, wpi, blockedAt, opts.rescueJuke)
                if shortcut then
                    -- Commit the verified landing. Keeping old detour indices
                    -- would turn the character back after it crossed the obstacle.
                    wpi, laIdx = shortcut, nil
                    laAt = now
                end
            end
            -- A committed lookahead can pass intermediate waypoints. Once we
            -- reach its destination, continue there instead of turning back.
            if routeProgress and laIdx and laIdx > wpi and laIdx <= #wps and (not blockedAt or laIdx < blockedAt) then
                local committed = wps[laIdx].Position
                if (committed - fp).Magnitude < 1.2 then
                    wpi, laIdx = laIdx, nil
                elseif laIdx < #wps and math.abs(committed.Y - feetY) < 1.5 then
                    local incoming = Flat(committed - wps[laIdx - 1].Position)
                    local nextWaypoint = wps[laIdx + 1]
                    local noJump = nextWaypoint.Action ~= Enum.PathWaypointAction.Jump
                    for i = wpi, laIdx do
                        if wps[i].Action == Enum.PathWaypointAction.Jump then
                            noJump = false
                            break
                        end
                    end
                    if noJump and incoming.Magnitude > 0.1 then
                        local offset = Flat(rp - committed)
                        local along = offset:Dot(incoming.Unit)
                        if along >= 0 and (offset - incoming.Unit * along).Magnitude <= 2.2 then
                            local clear, jumps = FH.Line(rp, nextWaypoint.Position, feetY, nextWaypoint.Position.Y)
                            if clear and (jumps or 0) == 0 and clearLane(rp, nextWaypoint.Position, feetY) then
                                wpi, laIdx = laIdx + 1, nil
                            end
                        end
                    end
                end
            end
            while wpi < #wps do
                local current, following = wps[wpi], wps[wpi + 1]
                local distance = (current.Position - fp).Magnitude
                local jumping = current.Action == Enum.PathWaypointAction.Jump
                local crossedJump = false
                local passed = false
                if routeProgress and wpi > 1 then
                    local incoming = Flat(current.Position - wps[wpi - 1].Position)
                    if incoming.Magnitude > 0.1 then
                        local offset = Flat(rp - current.Position)
                        local along = offset:Dot(incoming.Unit)
                        passed = along >= 0
                            and (offset - incoming.Unit * along).Magnitude <= 2.2
                            and (
                                flying
                                or math.abs(current.Position.Y - feetY) < 1.5
                                or (current.Position.Y > feetY + 1.5 and math.abs(following.Position.Y - feetY) < 1.5)
                            )
                        crossedJump = jumping and jumpIndex == wpi and passed
                    end
                end
                if not jumping and distance > (routeProgress and 1.2 or 3) and not passed then break end
                if jumping then
                    if distance > 4.5 and not crossedJump then break end
                    if jumpIndex ~= wpi and not waypointJump(wpi, hum, root, now) then break end
                    if distance > 1.2 and not crossedJump then break end
                end
                if distance > 1.2 and not jumping then
                    local clear, jumps = true, 0
                    if not flying then
                        clear, jumps = FH.Line(rp, following.Position, feetY, following.Position.Y)
                    end
                    if
                        not clear
                        or jumps > 0
                        or following.Action == Enum.PathWaypointAction.Jump
                        or not clearLane(rp, following.Position, feetY)
                    then
                        break
                    end
                end
                wpi = wpi + 1
                if not routeProgress or not laIdx or laIdx < wpi then laIdx = nil end
            end
            if blockedAt and wpi >= blockedAt then
                mode = nil
                if not Follow.PlanStep(token, hum, root, goal, feetY, pendingSteer, opts.rescueJuke, opts.approachModel) then
                    FH.Move(token, hum, rp, false, goal)
                end
                task.wait(0.03)
                continue
            end
            local wp = wps[wpi]
            aim = wp.Position
            if wp.Action == Enum.PathWaypointAction.Jump then
                if Flat(wp.Position - rp).Magnitude < 4.5 then waypointJump(wpi, hum, root, now) end
            elseif routeProgress then
                local function laneClear(index, wide)
                    if index < wpi or index > #wps or (blockedAt and index >= blockedAt) then return false end
                    local point = wps[index].Position
                    for i = wpi, index do
                        if
                            wps[i].Action == Enum.PathWaypointAction.Jump
                            or math.abs(wps[i].Position.Y - wp.Position.Y) > 1.5
                        then
                            return false
                        end
                    end
                    local clear, jumps = true, 0
                    if not flying then
                        clear, jumps = FH.Line(rp, point, feetY, point.Y)
                    end
                    if not clear or (jumps or 0) > 0 or not clearLane(rp, point, feetY) then return false end
                    if wide and not flying then
                        local delta = Flat(point - rp)
                        if delta.Magnitude > 0.1 then
                            local perpendicular = Vector3.new(-delta.Unit.Z, 0, delta.Unit.X)
                            local radius = FH.BodyRadius(root)
                            for _, offset in ipairs({ radius, -radius }) do
                                for _, height in ipairs({ 1.3, 3 }) do
                                    local origin = Vector3.new(rp.X, feetY + height, rp.Z) + perpendicular * offset
                                    if Workspace:Raycast(origin, delta, rayParams) then return false end
                                end
                            end
                        end
                    end
                    return true
                end
                -- Keep the selected destination through harmless wider-ray
                -- changes, but immediately reject a blocked body lane or drop.
                if
                    laIdx
                    and laIdx > wpi
                    and not Follow.RecheckLane(
                        lookaheadCheck,
                        root,
                        laIdx,
                        wps[laIdx].Position,
                        feetY,
                        function() return laneClear(laIdx, false) end
                    )
                then
                    -- This route lost its forward lane. Replan from here rather
                    -- than alternating between its old corner and lookahead.
                    banDirect = math.max(banDirect, now + 0.5)
                    reset()
                    nextPlan = 0
                    if not Follow.PlanStep(token, hum, root, goal, feetY, pendingSteer, opts.rescueJuke, opts.approachModel) then
                        FH.Move(token, hum, rp, false, goal)
                    end
                    task.wait(0.03)
                    continue
                end
                if (not laIdx or laIdx <= wpi) and now - laAt > 0.08 then
                    laAt, laIdx = now, wpi
                    for j = wpi + 1, math.min(#wps, wpi + 3, blockedAt and blockedAt - 1 or #wps) do
                        if Flat(wps[j].Position - rp).Magnitude > LA + 4 or not laneClear(j, true) then break end
                        laIdx = j
                    end
                end
                if laIdx and laIdx > wpi then aim = wps[laIdx].Position end
            else
                if now - laAt > 0.08 then
                    laAt = now
                    laIdx = wpi
                    for j = wpi + 1, math.min(#wps, wpi + 3, blockedAt and blockedAt - 1 or #wps) do
                        local nw = wps[j]
                        if nw.Action == Enum.PathWaypointAction.Jump then break end
                        if math.abs(nw.Position.Y - wp.Position.Y) > 1.5 then break end
                        local v = Flat(nw.Position - rp)
                        if v.Magnitude > LA + 4 then break end
                        local vd = v.Magnitude > 0.1 and v.Unit or nil
                        local clear = true
                        if vd then
                            local perp = Vector3.new(-vd.Z, 0, vd.X)
                            for _, off in ipairs({ 0, 1.2, -1.2 }) do
                                local o1 = Vector3.new(rp.X, feetY + 1.3, rp.Z) + perp * off
                                local o2 = Vector3.new(rp.X, feetY + 3, rp.Z) + perp * off
                                if Workspace:Raycast(o1, v, rayParams) or Workspace:Raycast(o2, v, rayParams) then
                                    clear = false
                                    break
                                end
                            end
                        end
                        if not clear then break end
                        local mid = rp + v * 0.5
                        local g =
                            Workspace:Raycast(Vector3.new(mid.X, feetY + 3, mid.Z), Vector3.new(0, -10, 0), rayParams)
                        if not g or math.abs(g.Position.Y - feetY) > 2.5 then break end
                        laIdx = j
                    end
                end
                if laIdx and laIdx > wpi and laIdx <= #wps and (not blockedAt or laIdx < blockedAt) then
                    aim = wps[laIdx].Position
                end
            end
        end
        if routeProgress and jumpTraversal then
            if wpi > jumpTraversal.index and Flat(jumpTraversal.aim - rp).Magnitude <= 1.5 then
                -- MoveTo considers a near destination reached; hand back to the
                -- route before a short continuation can stop us in midair.
                jumpTraversal = nil
            else
                aim = jumpTraversal.aim
            end
        end
        local dir = Flat(aim - rp)
        local kind, pdoor
        if dir.Magnitude > 0.1 then
            dir = dir.Unit
            local sill, inst
            local profileFeet = flying and groundedFeetY or feetY
            if flying then
                if not Follow.AirClear(hum, root, aim) then
                    -- The forward route is retained; a real body collision is
                    -- the only reason to stop steering during an existing fall.
                    FH.Move(token, hum, rp, false, goal)
                    task.wait(0.03)
                    continue
                end
            else
                kind, sill, inst, pdoor = Follow.RouteProfile(token, hum, root, aim, profileFeet, 3.4, physicalRoute)
            end
            if not flying and (physicalRoute or kind == "jump" or kind == "jump2") then
                local crossing = physicalRoute
                    and Follow.CrossingPlan(token, hum, root, aim, feetY, mode == "path" and wpi or nil, wps)
                if FH.TryJump(hum, root, aim, feetY, kind, sill, token) then
                    crossingTraversal = Follow.CommitCrossing(crossing)
                end
            end
            if kind == "door" and pdoor and not noDoor then
                local oa = DoorOpenedAt[pdoor]
                if oa and now - oa < 2.5 then DoorOpenedAt[pdoor] = nil end
                if DoorFail[pdoor] and now < DoorFail[pdoor] then
                    banDirect = math.max(banDirect, now + 1.2)
                    FH.Move(token, hum, rp, false, goal)
                    reset()
                    task.wait(0.03)
                    continue
                elseif doorTries < 10 and now - doorAt > 1.0 then
                    doorAt = now
                    doorTries = doorTries + 1
                    local g = FH.DoorGeom(pdoor, rp)
                    if g and FH.DoorOnFloor(g, rp, feetY) then
                        local passed = Follow.PassDoor(token, g, abort, nil, opts.rescueJuke, pendingSteer)
                        if not alive() then return finish("abort", false) end
                        if not passed then
                            banDirect = math.max(banDirect, os.clock() + 2)
                            if stableFollow then FH.RejectLane(token, hum, g.FarPos) end
                        end
                        reset()
                        stuck = 0
                        task.wait()
                        continue
                    elseif not g then
                        DoorFail[pdoor] = now + 20
                    end
                end
            elseif (kind == "wall" or kind == "door") and mode == "direct" then
                if routeProgress and not flying then FH.RejectLane(token, hum, aim) end
                banDirect = now + 4
                reset()
                continue
            end
        end
        if routeProgress and not flying and (kind == "wall" or kind == "door") then
            FH.RejectLane(token, hum, aim)
            -- Native paths can become blocked without a Path.Blocked signal.
            -- Reject the collision aim now and keep walking a verified local lane.
            banDirect = math.max(banDirect, now + 1)
            reset()
            nextPlan = 0
            if not Follow.PlanStep(token, hum, root, goal, feetY, pendingSteer, opts.rescueJuke, opts.approachModel) then
                FH.Move(token, hum, rp, false, goal)
            end
            task.wait(0.03)
            continue
        end

        if opts.rescueJuke then aim = FH.RescueJuke(token, root, aim, opts.rescueJuke, feetY) end
        FH.Move(token, hum, aim)
        task.wait(0.03)
    end
    return finish("abort", false)
end
function FH.PodRay(trig)
    local now = os.clock()
    local c = FH.PodRayCache[trig]
    if c and now - c.at < 0.8 then return c.p end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    pcall(function() p.RespectCanCollide = true end)
    local f = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then f[#f + 1] = pl.Character end
    end
    if InvisBody.Model then f[#f + 1] = InvisBody.Model end
    local anc = trig
    while anc and anc ~= Workspace do
        if anc.Name == "FreezePod" then
            f[#f + 1] = anc
            break
        end
        anc = anc.Parent
    end
    p.FilterDescendantsInstances = f
    FH.PodRayCache[trig] = { at = now, p = p }
    return p
end
function FH.PodApproach(trig, rp)
    local params = FH.PodRay(trig)
    local cands = {}
    local offset = Flat(rp - trig.Position)
    local bearing = offset.Magnitude > 0.1 and math.atan2(offset.Z, offset.X) or 0
    -- Begin on the player's side of the pod. A fixed compass ring can first
    -- send the player behind it even when the straight approach is open.
    for _, rad in ipairs({ 4.4, 3.0, 5.0 }) do
        for i = 0, 7 do
            local a = bearing + i * math.pi / 4
            local p = trig.Position + Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad)
            local gp, floor = FH.Ground(p, params)
            if floor and floor.Normal.Y > 0.6 and math.abs(gp.Y - trig.Position.Y) < 6 then
                local o = Vector3.new(gp.X, gp.Y + 2, gp.Z)
                local blocked = Workspace:Raycast(o, trig.Position - o, params)
                if not blocked and not FH.IsBad(gp.X, gp.Z, 1.5) then
                    cands[#cands + 1] = { p = gp, d = Flat(gp - rp).Magnitude }
                end
            end
        end
    end
    table.sort(cands, function(a, b) return a.d < b.d end)
    return cands
end
-- Brief zigzags retain the pod route; no waits, path resets, or sidesteps in rescue range.
function FH.RescueJuke(tok, root, aim, podGoal, feetY)
    local now = os.clock()
    local state = AR.Juke
    local rp = root.Position
    local podDist = Flat(podGoal - rp).Magnitude
    if podDist <= Follow.HelpDist + 4 or math.abs(podGoal.Y - rp.Y) > Follow.MaxDY then
        AR.Juke = nil
        return aim
    end
    local beast, beastPos, beastDist
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and FH.True(player, FH.BEASTN) then
            local br = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if br and math.abs(br.Position.Y - rp.Y) < Follow.MaxDY then
                local dist = (br.Position - rp).Magnitude
                if dist < AH.JukeRange and (not beastDist or dist < beastDist) then
                    beast, beastPos, beastDist = player, br.Position, dist
                end
            end
        end
    end
    if not beastPos then
        AR.Juke = nil
        return aim
    end
    local forward = Flat(aim - rp)
    if forward.Magnitude < 2 then return aim end
    forward = forward.Unit
    local function clearStep(candidate)
        local step = Flat(candidate - rp)
        if
            step.Magnitude <= 1.5
            or step.Unit:Dot(forward) < 0.35
            or Flat(candidate - podGoal).Magnitude >= podDist - 0.1
            or FH.IsBad(candidate.X, candidate.Z, 1.5)
        then
            return false
        end
        local toBeast = Flat(beastPos - rp)
        local along = math.clamp(toBeast:Dot(step) / step:Dot(step), 0, 1)
        if Flat(beastPos - (rp + step * along)).Magnitude < math.min(toBeast.Magnitude, 4) - 0.1 then
            return false -- A clear endpoint must not hide a dodge that cuts across the beast.
        end
        local direction, half = step.Unit, step.Magnitude * 0.5
        local across = Vector3.new(-direction.Z, 0, direction.X)
        -- Scan the body's width and the midpoint so a dodge cannot cross a wall or gap.
        for _, off in ipairs({ 0, 0.75, -0.75 }) do
            local origin, floorY = rp + across * off, feetY
            for i = 0, 1 do
                local floor, jump = FH.Seg(
                    origin.X + direction.X * half * i,
                    origin.Z + direction.Z * half * i,
                    direction,
                    floorY,
                    half
                )
                if not floor or jump or math.abs(floor - feetY) >= 1.5 then return false end
                floorY = floor
            end
        end
        return true
    end
    if
        not (
            state
            and state.token == tok
            and state.root == root
            and state.beast == beast
            and (state.podGoal - podGoal).Magnitude < 0.5
        )
    then
        state = nil
    end
    if state then
        if now < state.untilAt and clearStep(state.aim) then return state.aim end
        state.untilAt = 0
        if now < state.nextAt then return aim end
    end
    local side = Vector3.new(-forward.Z, 0, forward.X)
    local choices = {}
    for _, sign in ipairs({ 1, -1 }) do
        local candidate = rp + forward * 4 + side * (3.5 * sign)
        if clearStep(candidate) then
            choices[#choices + 1] = { aim = candidate, sign = sign, clearance = Flat(candidate - beastPos).Magnitude }
        end
    end
    local pick = choices[1]
    if #choices == 2 then
        local other = choices[2]
        if math.abs(pick.clearance - other.clearance) > 2.5 then
            if other.clearance > pick.clearance then pick = other end
        else
            -- When both lanes are equally safe, vary the first dodge and alternate the next.
            local sign = state and state.sign and -state.sign or (math.random(0, 1) == 0 and 1 or -1)
            if other.sign == sign then pick = other end
        end
    end
    AR.Juke = {
        token = tok,
        root = root,
        beast = beast,
        podGoal = podGoal,
        aim = pick and pick.aim or nil,
        sign = pick and pick.sign or (state and state.sign),
        untilAt = pick and now + 0.22 or 0,
        nextAt = now + (pick and 0.85 or 0.3),
    }
    return pick and pick.aim or aim
end
function FH.RescuePod(tok, alive, info, stopFn, hold, release, travel, contactRange)
    local trig, ev = info.trig, info.ev
    local pod = trig:FindFirstAncestor("FreezePod")
    local closeContact = contactRange ~= nil
    local HR = closeContact and contactRange or Follow.HelpDist + 1.6
    local holdRange = HR + 0.5
    local contactHeight = 4.5
    local routeState = { rescueTarget = trig }
    local function holds()
        local t = trig:FindFirstChild("CapturedTorso")
        return t ~= nil
            and t:IsA("ObjectValue")
            and t.Value ~= nil
            and (info.occupant == nil or t.Value == info.occupant)
    end
    local function flatDist()
        local r = RootNow()
        return r and Flat(trig.Position - r.Position).Magnitude or math.huge
    end
    local function sees()
        local r, hum = RootNow(), GetHumanoid()
        if not r or not Follow.GoalOnFloor(hum, r, trig.Position, pod) then return false end
        return Workspace:Raycast(r.Position, trig.Position - r.Position, FH.PodRay(trig)) == nil
    end
    local function near()
        local r = RootNow()
        return r ~= nil
            and Flat(trig.Position - r.Position).Magnitude <= HR
            and math.abs(trig.Position.Y - r.Position.Y) <= contactHeight
            and sees()
    end
    local function acknowledged()
        if not FH.Stat then return nil end
        local input, event = FH.Stat(LocalPlayer, FH.HACK_INPUT), FH.Stat(LocalPlayer, FH.HACK_EVENT)
        if not input or not event then return nil end
        return input.Value == true and (event.Value == trig or (ev ~= nil and event.Value == ev))
    end
    local function stop()
        return not alive()
            or not TokOK(tok)
            or AH.Down()
            or not trig.Parent
            or not holds()
            or (stopFn ~= nil and stopFn())
    end
    local function moving(value)
        -- Releasing an old rescue hold lets the movement controller keep steering.
        if value then release() end
        if travel then travel(value) end
    end
    local function contactAdvance()
        if not closeContact or stop() or near() then return near() end
        local started, checked, anchor = os.clock(), 0, RootNow()
        anchor = anchor and anchor.Position
        local params = FH.PodRay(trig)
        local function finish(value)
            FH.ReleaseMotion(tok, false)
            return value
        end
        while not stop() and os.clock() - started < 1.2 do
            if near() then return finish(true) end
            local hum, root = GetHumanoid(), RootNow()
            if
                not hum
                or not root
                or hum.Health <= 0
                or hum.Sit
                or hum.PlatformStand
                or Ctl.On()
                or Fly.Active
                or EM.ComboState
                or UserInputService:GetFocusedTextBox()
                or math.abs(root.Position.Y - trig.Position.Y) > contactHeight
            then
                return finish(false)
            end
            local delta = Flat(trig.Position - root.Position)
            if delta.Magnitude <= 0.1 or delta.Magnitude > 8 then return finish(false) end
            local now, direction = os.clock(), delta.Unit
            if now >= checked then
                checked = now + 0.12
                local feetY, radius = FH.Feet(hum, root), FH.BodyRadius()
                local across = Vector3.new(-direction.Z, 0, direction.X)
                local advance = direction * math.max(delta.Magnitude - HR + 0.1, 0.15)
                for _, offset in ipairs({ 0, radius, -radius }) do
                    for _, height in ipairs({ 0.7, 2.7, Follow.BodyH - 0.2 }) do
                        local origin = Vector3.new(root.Position.X, feetY + height, root.Position.Z) + across * offset
                        if Workspace:Raycast(origin, advance, params) then return finish(false) end
                    end
                end
                for _, fraction in ipairs({ 0.5, 1 }) do
                    local point = root.Position + advance * fraction
                    local floor =
                        Workspace:Raycast(Vector3.new(point.X, feetY + 1.25, point.Z), Vector3.new(0, -3.5, 0), params)
                    if not floor or floor.Normal.Y < 0.6 or math.abs(floor.Position.Y - feetY) > 1.5 then
                        return finish(false)
                    end
                end
            end
            -- Aim through the contact radius so the controller's 0.5-stud stop
            -- tolerance cannot strand us outside it. Native pod collision stays on.
            if not FH.Move(tok, hum, Vector3.new(trig.Position.X, root.Position.Y, trig.Position.Z)) then
                return finish(false)
            end
            Follow.Beat = now
            if anchor and now - started > 0.45 and Flat(root.Position - anchor).Magnitude < 0.1 then
                return finish(false)
            end
            task.wait(0.04)
        end
        return finish(near())
    end

    if stop() then
        release()
        return "stop"
    end

    local t0 = os.clock()
    local attempts = 0
    while not stop() and os.clock() - t0 < 75 do
        Follow.Beat = os.clock()
        Ctl.Gate()

        if not near() then
            local root = RootNow()
            local cands = root and FH.PodApproach(trig, root.Position) or {}
            local approach = cands[1] and cands[1].p or trig.Position
            moving(true)
            Follow.WalkTo(
                tok,
                function() return approach end,
                0.8,
                function() return stop() or near() end,
                {
                    maxTime = 8,
                    nearOk = 1,
                    approachModel = pod,
                    windows = true,
                    rescueJuke = trig.Position,
                    rescueSteer = routeState,
                }
            )
            contactAdvance()
            moving(false)
            if stop() then
                release()
                return "stop"
            end
            if not near() and flatDist() < 22 then
                attempts = attempts + 1
                local r = RootNow()
                cands = r and FH.PodApproach(trig, r.Position) or {}
                local reached, tried = false, 0
                local triedPoints = { approach }
                for _, c in ipairs(cands) do
                    if stop() or tried >= 3 then break end
                    local repeated = false
                    for _, point in ipairs(triedPoints) do
                        if Flat(c.p - point).Magnitude < 2.2 then
                            repeated = true
                            break
                        end
                    end
                    if repeated then continue end
                    triedPoints[#triedPoints + 1] = c.p
                    tried = tried + 1
                    -- WalkTo plans in the background while steering; do not wait for
                    -- another ComputeAsync here before starting the approach.
                    moving(true)
                    Follow.WalkTo(
                        tok,
                        function() return c.p end,
                        0.8,
                        function() return stop() or near() end,
                        {
                            maxTime = 4,
                            nearOk = 1,
                            approachModel = pod,
                            windows = true,
                            rescueJuke = trig.Position,
                            rescueSteer = routeState,
                        }
                    )
                    contactAdvance()
                    moving(false)
                    if near() then
                        reached = true
                        break
                    end
                end
                if not reached and not stop() and attempts >= 3 then
                    release()
                    return "far"
                end
            end
        end
        if near() and not stop() then
            local retryAt, lost, contactStopped = os.clock() + 0.45, nil, false
            while not stop() and os.clock() - t0 < 75 do
                Follow.Beat = os.clock()
                if Ctl.Gate() then break end
                local r = RootNow()
                local hum = GetHumanoid()
                if not r then break end
                local d = Flat(trig.Position - r.Position).Magnitude
                if d <= holdRange and math.abs(trig.Position.Y - r.Position.Y) <= contactHeight and sees() then
                    lost = nil
                    -- Cancel the previous engine destination on first contact;
                    -- its cached MoveTo must not carry us away while E is held.
                    if hum and FH.Move(tok, hum, r.Position, not contactStopped) then
                        contactStopped = true
                        local now = os.clock()
                        -- Refresh a missed E at the same contact point. The
                        -- game-selected trigger keeps one uninterrupted hold.
                        if now >= retryAt and acknowledged() ~= true then
                            release()
                            -- Give InputEnded a frame before the next E press.
                            -- Keep an acknowledged rescue held without pulses.
                            task.wait(0.04)
                            if stop() or not near() then break end
                            retryAt = os.clock() + 0.45
                        end
                        hold(ev)
                    end
                else
                    contactStopped = false
                    lost = lost or os.clock()
                    release()
                    -- Navigation must find a supported approach again; raw
                    -- MoveTo toward the trigger can ram a newly closed wall.
                    break
                end
                task.wait(0.04)
            end
            release()
            if not stop() and near() then
                -- A delayed interaction retries E from the valid contact point.
                -- Only lost contact needs another approach, not a walk around the pod.
                task.wait(0.04)
            end
        end
    end
    release()
    return "done"
end
-- ================= FOLLOW: ĐIỀU HƯỚNG KIỂU AUTOHIDE =================
-- Quét 12 hướng + hướng thẳng tới mục tiêu bằng FH.Seg (raycast), chấm điểm,
-- nhớ vết đã đi để không quay lại ngõ cụt. Kẹt thật sự mới trả "trapped"
-- để WalkTo (pathfinding + mở cửa) xử lý.
-- Tường rộng: 3 tia (giữa, trái, phải) x 2 độ cao. Trả khoảng cách gần nhất tới vật chắn (nil = thoáng)
function FH.Blocked(rp, dir, feetY, reach)
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local hitD
    for _, off in ipairs({ 0, 0.75, -0.75 }) do
        for _, h in ipairs({ 1.2, 3.0 }) do
            local o = Vector3.new(rp.X, feetY + h, rp.Z) + perp * off
            local r = Workspace:Raycast(o, dir * reach, rayParams)
            if r and r.Normal.Y <= 0.6 and not FH.DoorOf(r.Instance) then
                if not hitD or r.Distance < hitD then hitD = r.Distance end
            end
        end
    end
    return hitD
end
-- Né dọc theo tường: chọn bên trái/phải thoáng hơn
function FH.SlideAim(rp, dir, feetY)
    local perp = Vector3.new(-dir.Z, 0, dir.X)
    local best, bestFree
    for _, s in ipairs({ 1, -1 }) do
        local d = (perp * s + dir * 0.35).Unit
        local free = 8
        for _, h in ipairs({ 1.2, 3.0 }) do
            local r = Workspace:Raycast(Vector3.new(rp.X, feetY + h, rp.Z), d * 8, rayParams)
            if r and r.Normal.Y <= 0.6 then free = math.min(free, r.Distance) end
        end
        if not bestFree or free > bestFree then
            best, bestFree = d, free
        end
    end
    return rp + best * math.min(bestFree, 6)
end
function Follow.Pick(rp, goal, feetY, flatDist, trail, prev)
    local toGoal = Flat(goal - rp)
    local gdir = toGoal.Magnitude > 0.1 and toGoal.Unit or Vector3.new(0, 0, 1)
    local full = AH.ScanSegs * AH.SegLen
    local dirs = { gdir }
    for i = 0, 11 do
        local a = i * math.pi / 6
        dirs[#dirs + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
    end
    local best, bestScore, bestDir
    for _, d in ipairs(dirs) do
        local run, jumps = AH.Scan(rp, d, feetY)
        if run >= 4 then
            local step = math.min(run, math.max(flatDist, 4))
            local P = rp + d * step
            local after = Flat(goal - P).Magnitude
            local sc = -after + run * 0.35 + d:Dot(gdir) * 4 - jumps * 1.0
            if run >= full then sc = sc + 2 end
            if prev then sc = sc + math.max(d:Dot(prev), 0) * 5 end
            local pen = 0
            for i = 1, #trail do
                local dx, dz = trail[i].x - P.X, trail[i].z - P.Z
                if dx * dx + dz * dz < 16 then pen = pen + 1 end
            end
            sc = sc - pen * 4
            if FH.IsBad(P.X, P.Z, 2.4) then sc = sc - 25 end
            if not bestScore or sc > bestScore then
                best, bestScore, bestDir = P, sc, d
            end
        end
    end
    return best, bestDir
end
function Follow.Chase(token, getGoal, stopDist, abort, keep)
    -- Ordinary follow/farm owns a stable lane; command tokens keep their existing steering.
    local stable = FH.TraversalOwned(token)
    local function clearLane(from, point, y, reach)
        local hum, root = GetHumanoid(), RootNow()
        if stable then reach = math.min(reach or Flat(point - from).Magnitude, 6) end
        return Follow.OwnedLaneClear(token, hum, root, from, point, y, reach, stable)
    end
    local function alive() return TokOK(token) end
    local function finish(result, stop)
        local crossing = Follow.CrossingTraversal
        if crossing and crossing.token == token then Follow.CrossingTraversal = nil end
        FH.ReleaseMotion(token, stop)
        return result
    end
    local trail, trailAt = {}, 0
    local aim, lastSteer, prevDir = nil, 0, nil
    local steerGoal, laneAt, clearProbes = nil, 0, 0
    local lineAt, lineOk = 0, false
    local lastPos, lastChk, stuckN = nil, os.clock(), 0
    local wdAt, wdDist, wdGoal, stall = os.clock(), nil, nil, 0
    local blockedN = 0
    while alive() do
        if abort and abort() then return finish("abort", false) end
        Follow.Beat = os.clock()
        if Ctl.Gate() then
            lastPos, aim = nil, nil
            if stable then
                steerGoal, prevDir, clearProbes = nil, nil, 0
            end
        end
        local hum, root, goal = GetHumanoid(), RootNow(), getGoal()
        if not (hum and root and goal) or hum.Health <= 0 or Fly.Active then
            task.wait(0.15)
            continue
        end
        local rp = root.Position
        local now = os.clock()
        local feetY = FH.Feet(hum, root)
        local flatDist = Flat(goal - rp).Magnitude
        local dyg = math.abs(goal.Y - rp.Y)
        local ownedJump = stable and (FH.JumpFlight or FH.Jmp)
        local inOwnedJump = ownedJump
            and ownedJump.hum == hum
            and ownedJump.root == root
            and (ownedJump.token == nil or ownedJump.token == token)
            and now - ownedJump.t <= 1.2
            and hum.FloorMaterial == Enum.Material.Air
        -- khác tầng / quá xa: để pathfinding lo
        if
            flatDist > 90
            or (dyg > Follow.MaxDY + 2 and not inOwnedJump)
            or (hum.FloorMaterial ~= Enum.Material.Air and dyg > 1.5 and not Follow.GoalOnFloor(hum, root, goal))
        then
            return finish("trapped", false)
        end
        local sd = type(stopDist) == "function" and stopDist() or stopDist
        FH.RefreshFilter()
        FH.Tick(hum, root)
        local flight = FH.JumpFlight
        local jump = (flight and (stable or flight.normal) and flight) or FH.Jmp
        local jumping = hum.FloorMaterial == Enum.Material.Air and jump and jump.hum == hum and jump.root == root
        if jumping and jump.normal and jump.feetY then feetY = jump.feetY end
        local crossing = Follow.ActiveCrossing(token, hum, root) and Follow.CrossingTraversal
        if crossing then
            local along = Flat(crossing.aim - rp):Dot(crossing.dir)
            if
                along <= 0.8
                or now >= crossing.untilAt
                or (crossing.airborne and hum.FloorMaterial ~= Enum.Material.Air)
            then
                Follow.CrossingTraversal = nil
            elseif hum.FloorMaterial == Enum.Material.Air or now - crossing.t < 0.25 then
                crossing.airborne = crossing.airborne or hum.FloorMaterial == Enum.Material.Air
                FH.Move(token, hum, crossing.aim)
                task.wait(0.03)
                continue
            else
                Follow.CrossingTraversal = nil
            end
        end
        local escaping = Follow.ActiveEscape(token, hum, root)
        if FH.Motion.replanToken == token and not escaping then return finish("trapped", false) end
        if
            flatDist <= sd
            and dyg < Follow.MaxDY
            and Follow.GoalOnFloor(hum, root, goal)
            and (sd <= 3.5 or flatDist <= 2.5 or sd >= 20 or FH.Sight(rp, goal))
        then
            if not (keep and flatDist > 5 and keep()) then return finish("arrived", true) end
        end

        if escaping then
            FH.Move(token, hum, goal)
            task.wait(0.03)
            continue
        end

        if FH.ForceUnstick then
            FH.ForceUnstick = false
            FH.Unstick(hum, root, token, goal, 0.6)
            aim = nil
            continue
        end
        -- vết đường đã đi
        local lastTrail = trail[#trail]
        if now - trailAt > 0.5 and (not lastTrail or (rp.X - lastTrail.x) ^ 2 + (rp.Z - lastTrail.z) ^ 2 >= 0.64) then
            trailAt = now
            trail[#trail + 1] = { x = rp.X, z = rp.Z }
            if #trail > 24 then table.remove(trail, 1) end
        end
        -- đường thẳng tới mục tiêu có đi được không (cho phép nhảy qua vật thấp)
        if now - lineAt > 0.25 and not jumping then
            lineAt = now
            local ok, jumps, big = FH.Line(rp, goal, feetY, FH.Ground(goal).Y - 0.5, 1.5)
            local clear = ok and jumps <= 3 and (big == 0 or big == 1) and clearLane(rp, goal, feetY)
            if stable then
                clearProbes = clear and math.min(clearProbes + 1, 2) or 0
                -- A single doorway-edge probe must not switch a committed detour back and forth.
                lineOk = clear and (aim == nil or clearProbes >= 2)
            else
                lineOk = clear
            end
            -- Closed doors and solid walls need a route, not repeated local
            -- attempts to approach a target through the same obstruction.
            if not clear and not FH.ApproachClear(rp, goal) then return finish("trapped", false) end
        end
        local aimNow
        if lineOk then
            aimNow, aim = goal, nil
            if stable then
                local toward = Flat(goal - rp)
                if toward.Magnitude > 0.1 then prevDir = toward.Unit end
            else
                prevDir = nil
            end
        else
            local choose = aim == nil
            if aim and not jumping then
                if stable then
                    choose = Flat(aim - rp).Magnitude < 2.5 or (steerGoal and Flat(goal - steerGoal).Magnitude > 8)
                    if not choose and now >= laneAt then
                        laneAt = now + 0.12
                        local reach = math.clamp((hum.WalkSpeed or 16) * 0.2, 3.4, 6)
                        -- A real obstruction hands off to routing immediately, without another side turn.
                        if not clearLane(rp, aim, feetY, reach) then return finish("trapped", false) end
                    end
                else
                    choose = now - lastSteer > 0.3 or Flat(aim - rp).Magnitude < 2.5
                end
            end
            if choose then
                lastSteer = now
                local a, d = Follow.Pick(rp, goal, feetY, flatDist, trail, prevDir)
                if stable and a and not clearLane(rp, a, feetY) then a = nil end
                if a then
                    aim, prevDir, blockedN = a, d, 0
                    steerGoal, laneAt, clearProbes = goal, now + 0.12, 0
                else
                    aim = nil
                    blockedN = blockedN + 1
                    if blockedN >= 2 then return finish("trapped", false) end
                end
            end
            aimNow = aim
        end
        if aimNow then
            local dv = Flat(aimNow - rp)
            if dv.Magnitude > 0.5 then
                local reach = math.min(dv.Magnitude, math.clamp((hum.WalkSpeed or 16) * 0.2, 3.4, 6))
                local kind, sill = Follow.RouteProfile(token, hum, root, aimNow, feetY, reach, stable)
                if stable or kind == "jump" or kind == "jump2" then
                    local crossing = stable and Follow.CrossingPlan(token, hum, root, aimNow, feetY)
                    if FH.TryJump(hum, root, aimNow, feetY, kind, sill, token) then Follow.CommitCrossing(crossing) end
                end
                if kind == "wall" or kind == "door" then
                    if lineOk then
                        lineOk, lineAt = false, now
                    end
                    lastSteer = 0
                    if not jumping then return finish("trapped", false) end
                end
            end
            FH.Move(token, hum, aimNow)
        end
        -- kẹt cứng
        local progress = lastPos and Flat((aimNow or goal) - lastPos)
        if not lastPos or (progress.Magnitude > 0.1 and Flat(rp - lastPos):Dot(progress.Unit) >= 0.8) then
            lastPos, lastChk, stuckN = rp, now, 0
        elseif now - lastChk >= 1.2 then
            lastChk = now
            if aimNow then
                stuckN = stuckN + 1
                local dv = Flat(aimNow - rp)
                if dv.Magnitude > 0.5 then FH.AddBad(rp + dv.Unit * 3, 8) end
                aim, lastSteer, lineOk, lineAt = nil, 0, false, now + 0.5
                if stuckN >= 2 then FH.Unstick(hum, root, token, goal, 0.45) end
                if stuckN >= 4 then return finish("trapped", false) end
            end
        end

        -- không tiến gần hơn dù mục tiêu đứng yên => ngõ cụt
        if now - wdAt >= 2.5 then
            if wdDist and flatDist > wdDist - 2 and wdGoal and Flat(goal - wdGoal).Magnitude < 3 then
                stall = stall + 1
            else
                stall = 0
            end
            wdAt, wdDist, wdGoal = now, flatDist, goal
            if stall >= 2 then return finish("trapped", false) end
        end

        task.wait(0.03)
    end
    return finish("abort", false)
end

-- Exit readiness and waiting share one movement owner; opening does not imply escaping.
function FH.ExitDoorOpen(door, center, triggers)
    if not door or not IsInWorld(door) then return false end
    center = center or FH.ExitArea(door)
    triggers = triggers or (door:IsA("Model") and FH.Triggers(door) or {})
    if not center or #triggers == 0 then return false end
    FH.ExitDoorParams = FH.ExitDoorParams or setmetatable({}, { __mode = "k" })
    local cached, now = FH.ExitDoorParams[door], os.clock()
    if not cached or now - cached.at >= 0.25 then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        local _, _, area = FH.ExitArea(door)
        local solids = {}
        for _, part in ipairs(door:GetDescendants()) do
            -- Escape volumes and interaction triggers are not gate panels.
            -- Include the actual parts so a panel's live CanCollide still wins.
            if part:IsA("BasePart") and part ~= area and not string.find(string.lower(part.Name), "trigger", 1, true) then
                solids[#solids + 1] = part
            end
        end
        params.FilterDescendantsInstances = solids
        pcall(function() params.RespectCanCollide = true end)
        cached = { params = params, at = now }
        FH.ExitDoorParams[door] = cached
    end
    local params = cached.params
    local tested = false
    for _, trigger in ipairs(triggers) do
        if trigger.Parent then
            local delta = Flat(center - trigger.Position)
            if delta.Magnitude >= 1 then
                tested = true
                local across = Vector3.new(-delta.Unit.Z, 0, delta.Unit.X)
                -- A second trigger can lie beyond a closed gate. Its clear
                -- outside segment must not override a blocked room-side lane.
                for _, offset in ipairs({ 0, 0.65, -0.65 }) do
                    for _, height in ipairs({ -1, 1 }) do
                        local from = trigger.Position + Vector3.new(0, height, 0) + across * offset
                        local hit = Workspace:Raycast(from, delta, params)
                        if hit and hit.Instance.CanCollide and hit.Normal.Y < 0.6 then return false end
                    end
                end
            end
        end
    end
    return tested
end
-- The escape volume may end at the map boundary, beyond the navigation mesh.
-- Commit only the short, physically clear lane from the exit's room-side trigger.
function FH.ExitTraversalClear(token, hum, root, point)
    local crossing = FH.ExitTraversal
    return crossing ~= nil
        and crossing.token == token
        and crossing.hum == hum
        and crossing.root == root
        and os.clock() < crossing.untilAt
        and Flat(point - crossing.aim).Magnitude < 0.2
