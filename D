function CB.PlayerProfane(line)
    local bad = {
        fuck = true,
        fucking = true,
        fucker = true,
        fucked = true,
        motherfucker = true,
        shit = true,
        shitty = true,
        bullshit = true,
        bitch = true,
        bastard = true,
        damn = true,
        dammit = true,
        crap = true,
        piss = true,
        asshole = true,
        dick = true,
        cock = true,
        cunt = true,
        hell = true,
        wtf = true,
        omfg = true,
        stfu = true,
        lmfao = true,
        fck = true,
        fuk = true,
        fk = true,
    }
    local normalized = string.gsub(line, "(%a)!(%a)", "%1i%2")
    normalized = string.gsub(
        normalized,
        "[013457@$]",
        { ["0"] = "o", ["1"] = "i", ["3"] = "e", ["4"] = "a", ["5"] = "s", ["7"] = "t", ["@"] = "a", ["$"] = "s" }
    )
    local letters = ""
    for token in string.gmatch(normalized, "%S+") do
        local plain = string.gsub(token, "[^%a]", "")
        if bad[plain] then return true end
        if #plain == 1 then
            letters = letters .. plain
        else
            if bad[letters] then return true end
            letters = ""
        end
    end
    return bad[letters] == true
end
