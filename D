local Ctl = {
    Down = {},
    ReleaseAt = 0,
    Grace = 0.2,
    EUntil = 0,
    SpaceUntil = 0,
    Ignore = {},
}
for _, k in ipairs({
    Enum.KeyCode.Q,
    Enum.KeyCode.B,
    Enum.KeyCode.Y,
    Enum.KeyCode.M,
    Enum.KeyCode.H,
    Enum.KeyCode.J,
    Enum.KeyCode.L,
    Enum.KeyCode.P,
    Enum.KeyCode.U,
    Enum.KeyCode.F,
    Enum.KeyCode.G,
    Enum.KeyCode.X,
    Enum.KeyCode.C,
    Enum.KeyCode.V,
    Enum.KeyCode.Z,
    Enum.KeyCode.N,
    Enum.KeyCode.K,
    Enum.KeyCode.R,
    Enum.KeyCode.T,
    Enum.KeyCode.Tab,
    Enum.KeyCode.Zero,
    Enum.KeyCode.Nine,
    Enum.KeyCode.Eight,
    Enum.KeyCode.Five,
    Enum.KeyCode.KeypadZero,
    Enum.KeyCode.KeypadNine,
    Enum.KeyCode.KeypadEight,
    Enum.KeyCode.KeypadFive,
    Enum.KeyCode.Space,
    Enum.KeyCode.LeftShift,
    Enum.KeyCode.RightShift,
}) do
    Ctl.Ignore[k] = true
end
function Ctl.IsSelf(key)
    local now = os.clock()
    if key == Enum.KeyCode.E then
        return Follow.KeyDown or AR.KeyDown or TR.KeyDown or AH.TapDown or now < Ctl.EUntil
    elseif key == Enum.KeyCode.Space then
        return now < Ctl.SpaceUntil
    elseif key == Enum.KeyCode.W then
        return now < (Ctl.ForwardUntil or 0)
    end
    return false
end
function Ctl.On()
    local now = os.clock()
    for k in pairs(Ctl.Down) do
        if not UserInputService:IsKeyDown(k) then
            Ctl.Down[k] = nil
            Ctl.ReleaseAt = now
        end
    end
    if next(Ctl.Down) ~= nil then return true end
    return now - Ctl.ReleaseAt < Ctl.Grace
end
function Ctl.Gate()
    if not Ctl.On() then return false end
    pcall(Follow.Release)
    pcall(AR.Release)
    while Ctl.On() and not unloaded do
        Follow.Beat = os.clock()
        task.wait(0.03)
    end
    return true
end
TrackConnection(UserInputService.InputBegan:Connect(function(input)
