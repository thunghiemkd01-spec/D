            end
        end
    end
end
function FH.Nav.ProcessLinks()
    local nav = FH.Nav
    local job = nav.PriorityLinks[nav.PriorityLinkHead]
    if job then
        nav.PriorityLinkHead = nav.PriorityLinkHead + 1
    else
        nav.PriorityLinks, nav.PriorityLinkHead = {}, 1
        job = nav.Links[nav.LinkHead]
        if job then nav.LinkHead = nav.LinkHead + 1 end
    end
    if not job then
        nav.Links, nav.LinkHead = {}, 1
        return false
    end
    if job.done then return true end
    job.done = true
    nav.UnindexLink(job)
    if nav.QueuedLinks[job.key] == job then nav.QueuedLinks[job.key] = nil end
    if not nav.Valid(job.from) or not nav.Valid(job.to) then return true end
    local existing = job.from.edges[job.to.id]
    if existing and existing.to == job.to and existing.door == job.door and existing.version == nav.Version then
        return true
    end
    local clear, jumps, big = nav.Probe(job.from.pos, job.to.pos, job.from.pos.Y, job.door)
    if clear then
        nav.Topology = (nav.Topology or 0) + 1
        job.from.edges[job.to.id] = {
            to = job.to,
            door = job.door,
            cost = (job.to.pos - job.from.pos).Magnitude + jumps * 4 + big * 4,
            jumps = jumps,
            big = big,
            jump = jumps > 0 and (big > 0 and "jump2" or "jump") or nil,
            version = nav.Version,
        }
        -- Flat, jump-free body-clear lanes are symmetric. Drops and climbs
        -- still require a separate directed probe, so no reverse climb is invented.
        if jumps == 0 and math.abs(job.from.pos.Y - job.to.pos.Y) < 0.3 then
