                                and Flat(pos - closest).Magnitude <= 22
                                and FH.ApproachClear(origin, target, door)
                                and FH.ApproachClear(pos, closest, door)
                            then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end
function FH.ExitPriority()
    if not FH.ExitOpen() then return false end
    local map, root = GetCurrentMap(), RootNow()
    if not (map and root) then return false end
    local state, now = AH.ExitState, os.clock()
    local failures = state and state.map == map and state.character == LocalPlayer.Character and state.fail
    -- A safe alternative takes priority immediately, including after an
    -- interrupted opening; an evade retry timer must not block that handoff.
    for _, door in ipairs(ExitDoors) do
        if
            IsInWorld(door)
            and door:IsDescendantOf(map)
            and not (failures and failures[door] and failures[door] > now)
        then
            local center = FH.ExitArea(door)
            local triggers = door:IsA("Model") and FH.Triggers(door) or {}
            local stand, distance
            for _, trigger in ipairs(triggers) do
                local d = (trigger.Position - root.Position).Magnitude
                if trigger.Parent and (not distance or d < distance) then
                    stand, distance = trigger.Position, d
                end
            end
