function CB.OnChatReceived(player, msg)
    if unloaded or player == LocalPlayer or type(msg) ~= "string" then return end
    local text = string.match(msg, "^%s*(.-)%s*$") or ""
    if #text < 1 or string.sub(text, 1, 1) == "/" then return end
    if CB.Mode == "player" then
        local length = utf8.len(text)
        if not length then return end
        if length > 200 then text = string.sub(text, 1, utf8.offset(text, 201) - 1) end
    elseif #text > 200 then
        text = string.sub(text, 1, 200)
    end
    local key = player.UserId .. ":" .. text
    local now = os.clock()
    if CB.Seen[key] and now - CB.Seen[key] < 2 then return end
    CB.Seen[key] = now
    if math.random() < 0.1 then
        for k, t in pairs(CB.Seen) do
            if now - t > 10 then CB.Seen[k] = nil end
        end
    end

    local name = (player.DisplayName ~= "" and player.DisplayName) or player.Name
    local inbound = CB.Push(name, text, player)
    CB.LastHumanAt = now
    if not CB.Active then return end
    if CB.ChatOnly() then
        if not CB.CanSpeak() then return end
        local should, must = CB.ShouldReply(player, text)
        local item = {
            name = name,
            text = text,
            at = now,
            tok = CB.Token,
            must = must,
            player = player,
            mode = CB.Mode,
            inbound = inbound,
            direct = true,
        }
        -- Consent, rejection and annoyance must be read even when normal chatter is skipped.
        if CB.Mode == "funny" and CB.FunnyRoute(item) then return end
        if should then CB.PlayerStart(item) end
        return
    end
    if Cmd.OnConsentChat and Cmd.OnConsentChat(player, text) then return end
    if CB.SpecialChat(player, text) then return end
    if CB.PerformanceOnChat(player, text) then return end
    if MG.Active and MG.Player == player and not string.find(Cmd.Norm(text), " ", 1, true) then
        MG.OnChat(player, text)
        return
    end
    if Cmd.Process(player, text) then
        if CB.Mode == "normal" then CB.FunnyPause() end
        return
    end
    if not CB.CanSpeak() then return end
    if MG.OnChat(player, text) then return end
    if MG.TryStart(player, text) then return end
    local should, must = CB.ShouldReply(player, text)
    CB.Dbg("nghe:", name, text, should and "-> tra loi" or "-> bo qua")
    if not should then return end
    local item = {
        name = name,
        text = text,
        at = now,
        tok = CB.Token,
        must = must,
        player = player,
        mode = CB.Mode,
        direct = true,
    }
    if CB.Mode == "normal" and CB.FunnyRoute(item) then return end
    CB.ReplyStart(item)
end
