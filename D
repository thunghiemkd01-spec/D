function CB.PlayerStep()
    if unloaded or not CB.Active or CB.Silent or CB.Mode ~= "player" then return end
    if not CB.PlayerRuntime or CB.PlayerRuntime.token ~= CB.Token then CB.PlayerResetRuntime() end
    local snapshot, events = CB.PlayerObserve(false)
    local runtime, now = CB.PlayerRuntime, os.clock()
    if runtime.introPending then
        runtime.introPending = false
        events = {
            snapshot.on and snapshot.role and "[EVENT] you are " .. snapshot.role
                or snapshot.on and "[STATE] round is running, role unknown"
                or "[EVENT] in lobby",
        }
        if snapshot.map then events[#events + 1] = "[STATE] current map: " .. snapshot.map end
    end
    if #events > 0 then
        runtime.pending, runtime.pendingAt = events, now
    end
    if #runtime.pending > 0 and now - (runtime.pendingAt or now) > 20 then runtime.pending = {} end
    if CB.PlayerBusy() or not CB.PlayerQueueEvent then return end
    if #runtime.pending > 0 then
        if now < (runtime.queueRetryAt or 0) then return end
        local event = table.concat(runtime.pending, "\n")
        local accepted = CB.PlayerQueueEvent({
            name = "game context",
            text = event,
            event = event,
            at = runtime.pendingAt or now,
            tok = CB.Token,
            mode = "player",
            must = false,
        })
        if accepted ~= false then runtime.pending = {} end
        runtime.queueRetryAt = accepted == false and now + 1 or 0
        return
    end
    local lastActivity = math.max(CB.LastHumanAt or 0, CB.LastBotAt or 0, runtime.startedAt, runtime.lastIdleAt)
    if now - lastActivity >= 180 and now >= (runtime.idleRetryAt or 0) then
        local seconds = math.floor(now - math.max(CB.LastHumanAt or 0, CB.LastBotAt or 0, runtime.startedAt))
        local event = "[EVENT] idle: " .. seconds .. " since last chat"
        local accepted = CB.PlayerQueueEvent({
            name = "game context",
            text = event,
            event = event,
            at = now,
            tok = CB.Token,
            mode = "player",
            must = false,
            idle = true,
        })
        if accepted ~= false then runtime.lastIdleAt = now end
        runtime.idleRetryAt = accepted == false and now + 20 or 0
    end
end
