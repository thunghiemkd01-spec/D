    EM.ComboState, EM.CurrentData, EM.LastError = state, data, nil
    if not EM.ComboLease(state) then
        EM.Stop()
        return false
    end
    FH.Jmp, FH.JumpFlight = nil, nil
    pcall(Follow.Release)
    pcall(AH.ReleaseTap)
    pcall(AR.Release)
    pcall(TR.Release)
    EM.SaveProperty(state, "walk", hum, "WalkSpeed", EM.CircleSpeed)
    EM.WatchDeath(hum, state.generation)
    EM.WatchCrawl()
    EM.CircleBound = true
    RunService:BindToRenderStep("NovaCircleEmote", Enum.RenderPriority.Input.Value + 2, function()
        local ok = pcall(EM.CircleStep, state)
        if not ok and EM.ComboState == state then
            EM.Stop()
            EM.LastError = "Circle interrupted"
            EM.Changed()
        end
    end)
    EM.Changed()
    return true
end
function EM.ComboBlocked(hum)
    return Ctl.On()
        or Fly.Active
        or AH.Down()
        or hum.WalkSpeed <= 0
        or FH.Prio()
        or Follow.Held
        or Follow.KeyDown
        or FH.IsHacking(FH.Motion.token)
end
function EM.Toggle(group, index)
    if unloaded then return false end
    if CB.BeastLoaded then CB.BeastClear() end
    local items = EM.Groups[group]
    local data = items and items[index]
    if not data then return false end
    local wasCurrent = EM.CurrentData == data
    EM.Stop()
    EM.LastError = nil
    if wasCurrent then return true end
    return EM.Start(data)
end
function EM.Start(data, position)
    if unloaded then return false end
    if EM.PauseRequired() or os.clock() < (EM.CrawlRestoreAt or 0) then
        local paused = EM.PauseForCrawl(data)
        if paused and not EM.PauseRequired() then EM.PausedState.resumeAt = EM.CrawlRestoreAt end
        return paused
    end
    if data.Type == "Circle" then return EM.PlayCircle(data) end
    if data.Type == "Combo" then return EM.PlayCombo(data) end
    if data.Layers then return EM.PlayLayers(data) end
    return EM.Play(data, position)
end
