function AR.Hold(ev, remoteOnly, token)
    if Ctl.On() or (token and not FH.MotionAvailable(token)) then return false end
    Speed.ClearRescue(token)
    if AH.ReleaseTap then AH.ReleaseTap() end
    if TR.Held or TR.KeyDown then TR.Release() end
    if Follow.Held or Follow.KeyDown then Follow.Release() end
    if
        (AR.HoldToken ~= token or (ev ~= nil and AR.Held ~= nil and AR.Held ~= ev))
        and (AR.Held or AR.KeyDown)
    then
        AR.Release()
    end
    AR.HoldToken = token
    local now = os.clock()
    if ev and RemoteEvent and (now - AR.InAt > 0.06 or AR.Held ~= ev) then
        AR.InAt = now
        local sent = pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", true, ev)
            RemoteEvent:FireServer("Input", "Action", true)
        end)
        if sent then AR.Held = ev end
    end
    if not remoteOnly and not AR.KeyDown and not UserInputService:GetFocusedTextBox() then
        -- Do not claim or later release a physical E hold belonging to the player.
        local heldOK, held = pcall(function() return UserInputService:IsKeyDown(Enum.KeyCode.E) end)
        if (heldOK and held) or (Ctl.Down and Ctl.Down[Enum.KeyCode.E]) then return true end
        Ctl.EUntil = now + 0.5
        local pressed = false
        if type(keypress) == "function" and type(keyrelease) == "function" then
            local ok, result = pcall(keypress, 0x45)
            pressed = ok and result ~= false
            if pressed then AR.ERelease = keyrelease end
        end
        if not pressed and VIM then
            local ok, result = pcall(function() return VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
            pressed = ok and result ~= false
            if pressed then AR.EVim = VIM end
        end
        AR.KeyDown = pressed
    end
    -- Silent Help remains usable when an executor has no keyboard backend.
    return AR.KeyDown == true or AR.Held ~= nil
end
function AR.Release(token)
    -- Cancellation cleanup may run after token.ok() became false; ownership suffices.
    if token ~= nil and AR.HoldToken ~= token then return false end
    Speed.ClearRescue(token)
    local h, kd, keyUp, vim = AR.Held, AR.KeyDown, AR.ERelease, AR.EVim
    AR.Held, AR.KeyDown, AR.InAt, AR.HoldToken = nil, false, 0, nil
    AR.ERelease, AR.EVim = nil, nil
    if kd and not (Ctl.Down and Ctl.Down[Enum.KeyCode.E]) then
        Ctl.EUntil = os.clock() + 0.5
        if keyUp then
            pcall(keyUp, 0x45)
        elseif vim then
            pcall(function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
        end
    end
    if h and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", false, h)
            RemoteEvent:FireServer("Input", "Action", false)
        end)
    end
end
function AR.PodInfo(trig, map)
    if not map or not trig.Parent or not trig:IsDescendantOf(map) or not trig:FindFirstAncestor("FreezePod") then
        return nil
    end
    local ev, torso = trig:FindFirstChild("Event"), trig:FindFirstChild("CapturedTorso")
    local occupant = torso and torso:IsA("ObjectValue") and torso.Value or nil
    if not ev or not occupant or not occupant.Parent then return nil end
    local character = occupant:IsA("Model") and occupant or occupant:FindFirstAncestorOfClass("Model")
    local owner = character and Players:GetPlayerFromCharacter(character)
    if not owner then
        -- A torso can be nested in an accessory/model; resolve the actual character.
        for _, player in ipairs(Players:GetPlayers()) do
            local ch = player.Character
            if ch and (occupant == ch or occupant:IsDescendantOf(ch)) then
                owner = player
                break
            end
        end
    end
    if not owner or owner == LocalPlayer or owner.Parent ~= Players or FH.True(owner, FH.BEASTN) then return nil end
    return { trig = trig, ev = ev, owner = owner, occupant = occupant }
end
function AR.Pods(ignoreSkip)
    local now, map = os.clock(), GetCurrentMap()
    if AR.PodMap ~= map then
        AR.PodMap, AR.Pick, AR.PodRouteJob = map, nil, nil
        AR.PodRoutes = nil
        table.clear(AR.Skip)
    end
    -- The existing world-event cache covers nested pods without repeated map scans.
    -- Read the few live ObjectValues on every check so capture/release is immediate.
    local res = {}
    for _, trig in ipairs(AR.PodTriggers) do
        local info = AR.PodInfo(trig, map)
        if info then
            local skipped = AR.Skip[trig]
            if ignoreSkip or not (skipped and skipped.occupant == info.occupant and skipped.untilAt > now) then
                res[#res + 1] = info
            end
        end
    end
    AR.PodAt, AR.PodList = now, res
    return res
end
function AR.Pending()
    if
        not AR.Active
        or AR.Request ~= nil
        or Ctl.On()
        or Fly.Active
        or FH.Prio()
        or not FH.MatchOn()
        or FH.AmBeast()
        or not FH.ActiveSurvivor(LocalPlayer)
        or AH.Down()
    then
        return false
    end
    local now, map = os.clock(), GetCurrentMap()
    local cached = AR.PendingPick
    if cached and AR.PendingMap == map then
        local info = AR.PodInfo(cached.trig, map)
        if info and info.occupant == cached.occupant then return true end
        -- Release/recapture is live, even inside the discovery cache window.
        AR.PendingPick, AR.PendingAt = nil, nil
    elseif AR.PendingMap == map and AR.PendingAt and now - AR.PendingAt < 0.05 then
        local unchanged = AR.PendingCount == #AR.PodTriggers
        if unchanged then
            for _, binding in ipairs(AR.PendingSources or {}) do
                if
                    not binding.trig.Parent
                    or binding.torso.Parent ~= binding.trig
                    or binding.torso.Value ~= binding.value
                then
                    unchanged = false
                    break
                end
            end
        end
        if unchanged then return false end
    end
    -- Route retry backoff chooses between pods; it must not send a lone
    -- captive back to the escape controller before another rescue attempt.
    AR.PendingPick = AR.Pods(true)[1]
    AR.PendingMap, AR.PendingAt = map, now
    AR.PendingSources, AR.PendingCount = {}, #AR.PodTriggers
    if not AR.PendingPick then
        for _, trig in ipairs(AR.PodTriggers) do
            local torso = trig:FindFirstChild("CapturedTorso")
            if torso and torso:IsA("ObjectValue") then
                AR.PendingSources[#AR.PendingSources + 1] = { trig = trig, torso = torso, value = torso.Value }
            end
        end
    end
    return AR.PendingPick ~= nil
end
function AR.Nearest()
    local mr, hum = RootNow(), GetHumanoid()
    if not mr then return nil end
    local pods = AR.Pods()
    if #pods == 0 then pods = AR.Pods(true) end
    if #pods == 0 then
        AR.Pick = nil
        return nil
    end
    if AR.Pick and os.clock() - AR.PickAt < 2.5 then
        for _, info in ipairs(pods) do
            if info.trig == AR.Pick.trig and info.occupant == AR.Pick.occupant then return info end
        end
    end
    local list = {}
    for _, info in ipairs(pods) do
        local straight = (info.trig.Position - mr.Position).Magnitude
        local pod = info.trig:FindFirstAncestor("FreezePod")
        local direct = Follow.GoalOnFloor(hum, mr, info.trig.Position, pod)
            and FH.ApproachClear(mr.Position, info.trig.Position, pod)
        -- Rescue urgency is independent of the escape warning. Euclidean
        -- distance is the lower bound; measured feasible routes refine it.
        list[#list + 1] = { info = info, straight = straight, direct = direct, pod = pod }
    end
    table.sort(list, function(a, b) return a.straight < b.straight end)
    local now, from = os.clock(), mr.Position
    AR.PodRoutes = AR.PodRoutes or setmetatable({}, { __mode = "k" })
    local best, bl
    for i = 1, #list do
        local e = list[i]
        local cached = AR.PodRoutes[e.info.trig]
        local fresh = cached
            and now - cached.at < (cached.failed and 2 or 5)
            and (from - cached.from).Magnitude < 6
            and (cached.occupant == nil or cached.occupant == e.info.occupant)
            and (cached.map == nil or cached.map == GetCurrentMap())
        local L = e.direct and e.straight or (fresh and math.max(e.straight, cached.length) or e.straight)
        if not bl or L < bl then
            best, bl = e.info, L
        end
    end
    -- Start moving toward the nearest candidate immediately. Route lengths refine
    -- the next pick without blocking the current rescue on ComputeAsync.
    if #list > 1 and AR.Active and not AR.PodRouteJob then
        local job = { token = AR.Token, root = mr, from = from }
        AR.PodRouteJob = job
        local function valid()
            local root = RootNow()
            return not unloaded
                and AR.Active
                and AR.Token == job.token
                and AR.PodRouteJob == job
                and root == job.root
                and (root.Position - job.from).Magnitude < 24
        end
        task.spawn(function()
            pcall(function()
                for i = 1, math.min(3, #list) do
                    if not valid() then break end
                    local e = list[i]
                    local torso = e.info.trig:FindFirstChild("CapturedTorso")
                    if e.info.trig.Parent and torso and torso.Value then
                        local occupant = torso.Value
                        local function routeValid()
                            return valid() and e.info.trig.Parent ~= nil and torso.Value == occupant
                        end
                        if e.direct then
                            AR.PodRoutes[e.info.trig] = {
                                from = from,
                                at = os.clock(),
                                length = e.straight,
                                occupant = occupant,
                                map = GetCurrentMap(),
                            }
                            continue
                        end
                        local wps, len, path, routeAux
                        local nav, map = FH.Nav, GetCurrentMap()
                        local cands = FH.PodApproach(e.info.trig, from)
                        local goal = cands[1] and cands[1].p or e.info.trig.Position
                        if nav and nav.Map == map and nav.Route then
                            local start = FH.Ground(from)
                            local meta
                            wps, len, routeAux, meta = nav.Route(start, goal, start.Y - 0.5, routeValid, {
                                allowDoors = true,
                                approachModel = e.pod,
                                rescue = true,
                                liveLanes = true,
                                budget = 0.2,
                                maxNodes = 2048,
                                maxAnchors = 4,
                            })
                            if not (
                                meta
                                and meta.complete
                                and meta.map == map
                                and meta.generation == nav.Generation
                                and meta.version == nav.Version
                            ) then
                                wps, len = nil, nil
                            end
                        end
                        if not wps and routeValid() then
                            wps, len, routeAux, path =
                                FH.PathAny(from, goal, 1, false, routeValid, nil, true, true)
                            -- One side can lie in a narrow alcove. Test other
                            -- supported interaction sides before marking a failure.
                            for side = 2, math.min(3, #cands) do
                                if wps or not routeValid() then break end
                                if path then path:Destroy() end
                                wps, len, routeAux, path =
                                    FH.PathAny(from, cands[side].p, 1, false, routeValid, nil, true, true)
                            end
                        end
                        if path then path:Destroy() end
                        if routeValid() then
                            AR.PodRoutes[e.info.trig] = {
                                from = from,
                                at = os.clock(),
                                length = len or math.huge,
                                failed = len == nil,
                                occupant = occupant,
                                map = map,
                            }
                            -- Consume a newly measured route on the next pick,
                            -- instead of keeping the old Euclidean choice cached.
                            AR.PickAt = 0
                        end
                    end
                end
            end)
            if AR.PodRouteJob == job then AR.PodRouteJob = nil end
        end)
    end
    AR.Pick, AR.PickAt = best, os.clock()
    return best
end
function AR.Rescue(tok, info, alive)
    local res = FH.RescuePod(
        tok,
        alive or function() return tok.ok() end,
        info,
        nil,
        function(ev, remoteOnly) return AR.Hold(ev, remoteOnly, tok) end,
        function() AR.Release(tok) end,
        function(moving)
            if moving then
                Speed.BeginRescue(tok, info)
            else
                Speed.ClearRescue(tok)
            end
        end,
        Follow.HelpDist + 1.6 -- Reach the pod's interaction side, outside its collision shell.
    )
    FH.ReleaseMotion(tok, false)
    if res == "far" then
        -- Briefly try another pod/side; a later capture in this pod is never skipped.
        AR.Skip[info.trig] = { occupant = info.occupant, untilAt = os.clock() + 2 }
        AR.Pick = nil
    end
end

function AR.ThreatPreempts() return AH.Active == true and AH.Eval().danger == true end
function AR.Step(tok)
    if AR.Request then
        AR.Release(tok)
        task.wait(0.03)
        return
    end
    if AR.Pending() and AH.BusyFlag and not AR.ThreatPreempts() then
        -- A previous flee/exit lease may be busy after its reduced rescue
        -- threat has gone. Release that lease before the rescue claims it.
        AH.BusyFlag = false
        AH.SetState("idle")
        if AH.ReleaseTap then AH.ReleaseTap() end
        FH.CancelMotion("evade")
    end
    if not FH.MotionAvailable(tok) then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.05)
        return
    end
    if Ctl.On() then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.03)
        return
    end
    if FH.Prio() then
        AR.Release(tok)
        AR.SetBusy(false)
        task.wait(0.05)
        return
    end
    local hum, root = GetHumanoid(), RootNow()
    if
        not (hum and root)
        or hum.Health <= 0
        or Fly.Active
        or not FH.MatchOn()
        or FH.True(LocalPlayer, FH.BEASTN)
        or AH.Down()
    then
        if AR.BusyFlag then AR.Release(tok) end
        AR.SetBusy(false)
        task.wait(0.2)
        return
    end
    if AR.ThreatPreempts() or Follow.Rescuing then
        AR.Release(tok)
        FH.ReleaseMotion(tok, false)
        AR.SetBusy(false)
        task.wait(0.03)
        return
    end
    local pod = AR.Nearest()
    if not pod then
        AR.SetBusy(false)
        task.wait(0.25)
        return
    end
    AR.SetBusy(true)
    if Follow.Held or Follow.KeyDown then pcall(Follow.Release) end
    if TR.BusyFlag or TR.Held or TR.KeyDown then
        TR.BusyFlag = false
        pcall(TR.Release)
        pcall(TR.SetNoclip, false)
    end
    AR.Rescue(tok, pod)
    if not tok.ok() then AR.Release(tok) end
end
function AR.Loop(token)
    local tok = {
        owner = "rescue",
        priority = 50,
        ok = function()
            return not unloaded
                and AR.Active
                and AR.Token == token
                and not AR.ThreatPreempts()
                and not FH.Prio()
                and not AR.Request
        end,
    }
    while not unloaded and AR.Active and AR.Token == token do
        local ok, err = pcall(AR.Step, tok)
        if not ok then
            warn("[AutoHelp] loi: " .. tostring(err))
            AR.Release(tok)
            if not AR.Request then AR.SetBusy(false) end
            task.wait(0.4)
        end
        task.wait(0.03)
    end
    if AR.Token == token and not AR.Request then AR.SetBusy(false) end
end
function AR.Stop()
    if AR.CancelRequest then AR.CancelRequest() end
    FH.CancelMotion("rescue")
    AR.Active = false
    AR.Token = AR.Token + 1
    if not AR.HoldToken or (type(AR.HoldToken) == "table" and AR.HoldToken.owner == "rescue") then AR.Release() end
    AR.PendingPick, AR.PendingAt, AR.PendingMap = nil, nil, nil
    AR.PendingSources, AR.PendingCount = nil, nil
    AR.BusyFlag = false
    AR.SetLabel()
end
function AR.Restart()
    if AR.CancelRequest then AR.CancelRequest() end
    FH.CancelMotion("rescue")
    if not AR.Active then return end
    AR.Token = AR.Token + 1
    if not AR.HoldToken or (type(AR.HoldToken) == "table" and AR.HoldToken.owner == "rescue") then AR.Release() end
    AR.PendingPick, AR.PendingAt, AR.PendingMap = nil, nil, nil
    AR.PendingSources, AR.PendingCount = nil, nil
