function EX.Select(index)
    if EX.Mode == "emote" then
        EM.Toggle(EX.Group, index)
    elseif EX.Mode == "spectate" then
        if index < 1 or index > 4 then return false end
        local player = EX.List[index]
        local subject = EX.SubjectFor(player)
        if subject then
            if EX.Target == player and EX.TargetSubject == subject then return EX.ReturnCamera() end
            EX.Target, EX.TargetSubject = player, subject
            EX.ApplyCamera()
        end
    end
    EX.Refresh()
end
function EX.CycleSection()
    if EX.Mode ~= "emote" then return false end
