    local choices = {}
    for i, p in ipairs(Follow.List) do
        if p ~= exclude and p.Parent == Players then choices[#choices + 1] = i end
    end
    if #choices == 0 then
        -- Stay enabled so a player joining an otherwise empty server can be selected.
        if FH and FH.CancelMotion then FH.CancelMotion("follow") end
        pcall(Follow.Release, Follow.Token)
        Follow.Token = Follow.Token + 1
        Follow.Target = nil
        if Follow.TConn then
            pcall(function() Follow.TConn:Disconnect() end)
            Follow.TConn = nil
        end
        Follow.ResetButton()
        return false
    end
    return Follow.Select(choices[math.random(1, #choices)], true)
