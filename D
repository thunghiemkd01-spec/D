-- Movement is owned by one feature at a time; chat only submits feature tokens.
-- Manual input / flight always wins. Expiring leases cannot strand a stopped task.
FH.Motion = { token = nil, priority = 0, untilAt = 0, aim = nil, sentAt = 0, hum = nil }
function FH.MotionPriority(token)
    if type(token) == "table" then
        if
            token.owner == "rescue"
            and not token.userRequest
            and AR.Pending
            and AR.Pending()
            and not AR.ThreatPreempts()
        then
            return math.max(token.priority or 50, 90)
        end
        return token.priority or 70
    end
    return 20
end
function FH.MotionValid(token)
    if unloaded or token == nil then return false end
    if type(token) == "table" then
        if type(token.ok) ~= "function" or not token.ok() then return false end
        if token.owner == "evade" and AR.Pending and AR.Pending() and not AR.ThreatPreempts() then return false end
        if token.owner ~= "command" and not token.userRequest and FH.Prio and FH.Prio() then return false end
        return true
    end
    return Follow.Token == token
        and os.clock() >= Follow.PauseUntil
        and not (FH.Prio and FH.Prio())
        and not AH.BusyFlag
        and not AR.BusyFlag
        and not TR.BusyFlag
end
function FH.MotionActive()
    local m = FH.Motion
    return m.token ~= nil and os.clock() < m.untilAt and FH.MotionValid(m.token)
end
function FH.MotionAvailable(token)
    if not FH.MotionValid(token) then return false end
    local m = FH.Motion
    return m.token == token or not FH.MotionActive() or FH.MotionPriority(token) > FH.MotionPriority(m.token)
end
-- Only a live, owned computer/exit interaction may intentionally stand for a long time.
function FH.MarkWork(token, kind)
    if (kind ~= "hack" and kind ~= "exit") or Follow.InputOwner ~= token or not (Follow.Held or Follow.KeyDown) then
        return false
    end
    FH.Work = { token = token, kind = kind, untilAt = os.clock() + 0.4 }
    return true
end
function FH.IsWorking(token)
    local work = FH.Work
    return work ~= nil
        and work.token == token
        and os.clock() < work.untilAt
        and (work.kind == "hack" or work.kind == "exit")
        and Follow.InputOwner == token
        and (Follow.Held ~= nil or Follow.KeyDown == true)
end
-- Watch the attempted destination even when a blocked lane refuses MoveTo.
-- A short, expiring intent covers rejected moves without reviving finished tasks.
function FH.NoteStallIntent(token, hum, goal, intentGoal)
    local root = hum.RootPart
    if not root then return end
    local desired, now = intentGoal or goal, os.clock()
    if
        Flat(desired - root.Position).Magnitude <= 0.8
        and (math.abs(desired.Y - root.Position.Y) <= Follow.MaxDY or Flat(goal - root.Position).Magnitude <= 0.8)
    then
        -- A vertical-only lease waits for its floor/platform; there is no
        -- horizontal instruction for a jump or sidestep to unblock.
        if FH.StallIntent and FH.StallIntent.token == token then FH.StallIntent = nil end
        return
    end
    local state = FH.StallIntent
    if not state or state.token ~= token or state.hum ~= hum or state.root ~= root or now - state.seen > 1.2 then
        state = { token = token, hum = hum, root = root, anchor = root.Position, at = now, jumped = false }
        FH.StallIntent = state
    end
    state.goal, state.seen = desired, now
    state.progressGoal = Flat(goal - root.Position).Magnitude > 0.8 and goal or desired
end
-- Feature toggles do not imply hacking: check the live interaction or game state.
function FH.IsHacking(token)
    if FH.IsWorking(token) and FH.Work.kind == "hack" then return true end
    -- A retained remote target is not proof that this movement owner is
    -- hacking. It may be on another floor, already finished, or belong to
    -- Follow while rescue/evasion has taken over the avatar.
    if remoteHackActive and remoteHackEvent and remoteHackEvent.Parent and (type(token) ~= "table" or token.owner == "follow") then
        local trigger, root = remoteHackEvent.Parent, RootNow()
        local computer = trigger.Parent
        while computer and computer ~= Workspace and computer.Name ~= "ComputerTable" do computer = computer.Parent end
        if
            root
            and trigger:IsA("BasePart")
            and trigger.Name:sub(1, 15) == "ComputerTrigger"
            and computer
            and IsRealComputer(computer, GetCurrentMap())
            and not IsComputerDone(computer)
            and (trigger.Position - root.Position).Magnitude <= REMOTE_HACK_RANGE
            and math.abs(trigger.Position.Y - root.Position.Y) <= Follow.MaxDY
        then
            return true
        end
    end
    if FH.True(LocalPlayer, FH.HACK_TYPING) then return true end
    local input, event = FH.Stat(LocalPlayer, FH.HACK_INPUT), FH.Stat(LocalPlayer, FH.HACK_EVENT)
    local target = event and event.Value
    if not target or not input or input.Value ~= true then return false end
    local trigger = target.Name:sub(1, 15) == "ComputerTrigger" and target or target.Parent
    return trigger ~= nil and trigger.Name:sub(1, 15) == "ComputerTrigger"
end
-- Shared render callback samples at most ten times per second, with no raycasts.
-- One grounded jump belongs to each stationary period; only real progress rearms it.
function FH.AwaitingFloorRoute(token, hum, root)
    local wait = FH.VerticalRouteWait
    return wait ~= nil
        and wait.token == token
        and wait.hum == hum
        and wait.root == root
        and hum ~= nil
        and root ~= nil
        and os.clock() < wait.untilAt
        and math.abs(wait.floorY - FH.Feet(hum, root)) > 1.5
end
function FH.CommittedTraversal(token, hum, root, point)
    if not (hum and root and point) then return false end
    if FH.ExitTraversalClear and FH.ExitTraversalClear(token, hum, root, point) then return true end
    local crossing = Follow.CrossingTraversal
    if
        Follow.ActiveCrossing
        and Follow.ActiveCrossing(token, hum, root)
        and Flat(point - crossing.aim).Magnitude < 0.2
        and math.abs(point.Y - crossing.aim.Y) <= 1.5
    then
        return os.clock() - crossing.t < 0.25 or Follow.AirClear(hum, root, point)
    end
    local drop = Follow.DropTraversal
    if
        Follow.ActiveDrop
        and Follow.ActiveDrop(token, hum, root)
        and Flat(point - drop.aim).Magnitude < 0.2
        and math.abs(point.Y - drop.aim.Y) <= 1.5
    then
        return drop.jump and os.clock() - drop.t < 0.25 or Follow.AirClear(hum, root, point)
    end
    return AH.ActiveDrop and AH.ActiveDrop(token, hum, root) and AH.DropClear(token, hum, root, point) or false
end
function FH.StallJumpStep()
    local state = FH.StallIntent
    if not state then return false end
    local now = os.clock()
    if now < (FH.StallCheckAt or 0) then return false end
    FH.StallCheckAt = now + 0.1
    local token, hum, root = state.token, state.hum, state.root
    if FH.ExitTraversalClear and FH.ExitTraversalClear(token, hum, root, state.goal) then return false end
    if FH.AwaitingFloorRoute(token, hum, root) then return false end
    if
        unloaded
        or now - state.seen > 1.2
        or (not FH.MotionActive() and now - state.seen > 0.2)
        or hum ~= GetHumanoid()
        or root ~= RootNow()
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
        or Ctl.On()
        or Fly.Active
        or EM.ComboState
        or UserInputService:GetFocusedTextBox()
        or now < Follow.PauseUntil
        or not FH.MotionAvailable(token)
        or FH.True(LocalPlayer, FH.CAP)
        or FH.True(LocalPlayer, FH.RAG)
        or FH.IsWorking(token)
        or FH.IsHacking(token)
        or (Follow.InputOwner == token and (Follow.Held or Follow.KeyDown))
        or AR.Held
        or AR.KeyDown
        or TR.Held
        or TR.KeyDown
