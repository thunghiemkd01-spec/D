    local length = reach / count
    for i = 1, count do
        local point = rp + dir * (length * i)
        local center =
            Workspace:Raycast(Vector3.new(point.X, floorY + 1.25, point.Z), Vector3.new(0, -2.3, 0), rayParams)
        if not center or FH.DoorOf(center.Instance) or center.Normal.Y <= 0.25 then return nil end
