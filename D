        if FH.AmBeast() then
            t[#t + 1] = "you are the beast hunting survivors"
        elseif FH.True(LocalPlayer, FH.CAP) then
            t[#t + 1] = "you are locked in a freezer pod waiting for rescue"
        elseif FH.True(LocalPlayer, FH.RAG) then
            t[#t + 1] = "you just got hit by the beast"
        elseif FH.True(LocalPlayer, FH.ESC) then
            t[#t + 1] = "you already escaped the map"
        else
            local hp = FH.Stat(LocalPlayer, FH.HP)
            if hp and type(hp.Value) == "number" and hp.Value <= 0 then
                t[#t + 1] = "you are out of the round"
            else
                t[#t + 1] = "you are a surviving player"
            end
        end
        local total, undone = FH.UndoneCount()
        if total > 0 then
            if undone > 0 then
                t[#t + 1] = undone .. " of " .. total .. " computers are still not hacked"
            else
                t[#t + 1] = "all computers are hacked, the exits can be opened"
            end
        end
        if CB.ChatOnly() and FH.ExitOpen and FH.ExitOpen() then t[#t + 1] = "an exit door is already open" end
        local plist = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and #plist < 8 then
                local tag
                if FH.True(p, FH.BEASTN) then
                    tag = "beast"
                elseif FH.True(p, FH.CAP) then
                    tag = "frozen in a pod"
                elseif FH.True(p, FH.ESC) then
                    tag = "escaped"
                else
                    local hp = FH.Stat(p, FH.HP)
                    if hp and type(hp.Value) == "number" and hp.Value <= 0 then
                        tag = "out"
                    elseif FH.True(p, FH.RAG) then
                        tag = "hit"
                    else
                        tag = "alive"
                    end
                end
                plist[#plist + 1] = p.DisplayName .. " (" .. tag .. ")"
            end
        end
        if #plist > 0 then t[#t + 1] = "other players: " .. table.concat(plist, ", ") end
    end
