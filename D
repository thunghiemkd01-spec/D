function Follow.AutoBeastVoteStep()
    if unloaded or not Follow.AutoBeastActive then return false end
    local active = CB.PlayerRepValue and CB.PlayerRepValue({ "GameActive", "GameActiveBool", "RoundActive" }, "boolean")
    local map = GetCurrentMap()
    if active ~= false and map and FH.MatchOn() and FH.InMatchPlayer(LocalPlayer) then
        Follow.ResetAutoBeastVote()
        return false
    end
    local now = os.clock()
    if now < (Follow.AutoBeastVoteScanAt or 0) then return false end
    Follow.AutoBeastVoteScanAt = now + 0.75
    local ok, buttons = pcall(Cmd.MapButtons)
    if not ok or type(buttons) ~= "table" then return false end
    if #buttons == 0 then
        -- Disabling vote buttons after a click is not a new ballot.
        local previous = Follow.AutoBeastVote
        if previous and not previous.closed and Follow.AutoBeastVoteRootVisible(previous.root) then return false end
        Follow.ResetAutoBeastVote()
        Follow.AutoBeastVoteScanAt = now + 0.75
        return false
    end
    local root = Follow.AutoBeastVoteRoot(buttons[1].button)
    if not root then return false end
    local ballot, known = Follow.AutoBeastVote, false
    local same = ballot and not ballot.closed and ballot.token == Follow.AutoBeastToken and ballot.root == root
    if same then
        for _, entry in ipairs(buttons) do
            local previous = ballot.buttons[entry.button]
            if previous then
                known = true
                if previous ~= entry.norm then
                    same = false
                    break
                end
            end
        end
        same = same and known
    end
    if not same then
        Follow.ResetAutoBeastVote()
        Follow.AutoBeastVoteScanAt = now + 0.75
        ballot = {
            root = root,
            token = Follow.AutoBeastToken,
            buttons = {},
            connections = {},
            openedAt = now,
            attempts = 0,
            nextAt = 0,
            voted = false,
        }
        Follow.AutoBeastVote = ballot
        -- Reused menus can hide and reopen with exactly the same map names.
        -- Observe the menu visibility as well as changes in button identity/text.
        local pg, cur = LocalPlayer:FindFirstChildOfClass("PlayerGui"), root
        while cur and cur ~= pg do
            local property = cur:IsA("GuiObject") and "Visible" or cur:IsA("ScreenGui") and "Enabled" or nil
            if property then
                local watched, connection = pcall(function()
                    return cur:GetPropertyChangedSignal(property):Connect(function()
                        if Follow.AutoBeastVote == ballot and not Follow.AutoBeastVoteRootVisible(root) then
                            ballot.closed = true
                        end
                    end)
                end)
                if watched and connection then ballot.connections[#ballot.connections + 1] = connection end
            end
            cur = cur.Parent
        end
    end
    for _, entry in ipairs(buttons) do
        ballot.buttons[entry.button] = entry.norm
    end
    -- A player's explicit vote wins, including a command that already completed.
    if Cmd.LastText and (Cmd.LastAt or 0) >= ballot.openedAt then
        local intent = Cmd.Intent(Cmd.LastText)
        if intent == "vote" then
            ballot.voted = true
            return false
        end
    end
    if ballot.voted or ballot.attempts >= 3 or now < ballot.nextAt or not VIM or Follow.AutoBeastVoteBlocked() then
        return false
    end
    local chosen
    for _, entry in ipairs(buttons) do
        if
            Follow.AutoBeastVoteRoot(entry.button) == root
            and (not chosen or Follow.AutoBeastMapRank(entry.name) < Follow.AutoBeastMapRank(chosen.name))
        then
            chosen = entry
        end
    end
    if not chosen or not Cmd.VisibleButton(chosen.button) then return false end
    ballot.attempts, ballot.nextAt = ballot.attempts + 1, now + 1.5
    local token, center = Follow.AutoBeastToken, chosen.button.AbsolutePosition + chosen.button.AbsoluteSize / 2
    local clicked = pcall(function()
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
    end)
    if not clicked then
        -- Always release a partial click, including on shutdown or UI errors.
        pcall(function() VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0) end)
    end
    if
        clicked
        and not unloaded
        and Follow.AutoBeastActive
        and Follow.AutoBeastToken == token
        and Follow.AutoBeastVote == ballot
    then
        ballot.voted = true
        return true
    end
    return false
end
function Cmd.Vote(text, id)
    if GetCurrentMap() and FH.InMatchPlayer(LocalPlayer) then
        CB.Say("map voting is for the lobby. ask me again between rounds")
        return
    end
    local buttons = Cmd.MapButtons()
    local requestText = Cmd.RequestText(text)
    local requested = requestText
    for _, prefix in ipairs({
        "vote for map ",
        "vote for ",
        "vote map ",
        "vote ",
        "choose map ",
        "pick map ",
        "select map ",
    }) do
        if string.sub(requested, 1, #prefix) == prefix then
            requested = string.sub(requested, #prefix + 1)
            break
        end
    end
    requested = string.gsub(requested, "%s+please$", "")
    requested = string.gsub(requested, "%s+pls$", "")
    local match
    for _, candidate in ipairs(buttons) do
        if candidate.norm == requested then
            if match and match.button ~= candidate.button then
                CB.Say("more than one vote button has that name. please choose it manually")
                return
            end
            match = candidate
        end
    end
    if not match then
        if #buttons == 0 then
            CB.Say(
                "i can't access a supported map vote button here. tell me your choice and select it in the lobby voting menu"
            )
        else
            local names = {}
            for _, candidate in ipairs(buttons) do
                names[#names + 1] = candidate.name
            end
            CB.SayLong(
                "which map should i vote for? available: " .. table.concat(names, ", ") .. ". say 'tom vote <map name>'"
            )
        end
        return
    end
    if not VIM then
        CB.Say(
            "i can see " .. match.name .. ", but this runtime cannot click its vote button. please select it manually"
        )
        return
    end
    if Cmd.Token ~= id or not Cmd.VisibleButton(match.button) then return end
    local center = match.button.AbsolutePosition + match.button.AbsoluteSize / 2
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
    end)
    if ok then
        CB.Say("clicked the lobby vote button for " .. match.name)
    else
        CB.Say("the vote click was unavailable; please choose " .. match.name .. " manually")
    end
end
