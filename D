        if d.Parent and d.Parent:IsA("BasePart") and (d.Name == "Event" or d.Name == "RemoteEvent") then return true end
        if d:IsA("BasePart") and string.find(string.lower(d.Name), "trigger", 1, true) then return true end
    end
    return false
end
function HideTP.InCharacter(v)
