function EX.RestoreCamera()
    local saved = EX.CameraState
    EX.CameraState = nil
    if not saved then return end
    pcall(function()
        local subject = saved.subject
        if
            saved.localSubject
            or not subject
            or not subject.Parent
            or not IsInWorld(subject)
            or subject:IsA("Humanoid") and subject.Health <= 0
        then
            subject = GetHumanoid()
        end
        saved.camera.CameraSubject = subject
        saved.camera.CameraType = saved.kind
        saved.camera.CFrame = saved.cf
    end)
end
function EX.StopSpectate()
    EX.RestoreCamera()
    EX.Target, EX.TargetSubject = nil, nil
    if EX.SelfCharacter then RemoveHighlight(EX.SelfCharacter) end
    EX.SelfCharacter = nil
end
function EX.ApplyCamera()
    if EX.Mode ~= "spectate" or unloaded then return false end
    local subject, camera = EX.SubjectFor(EX.Target), Workspace.CurrentCamera
    if not subject or subject ~= EX.TargetSubject or not camera then return false end
    if EX.CameraState and EX.CameraState.camera ~= camera then EX.RestoreCamera() end
    if not EX.CameraState then
        EX.CameraState = {
            camera = camera,
            subject = camera.CameraSubject,
            kind = camera.CameraType,
            cf = camera.CFrame,
            localSubject = camera.CameraSubject == GetHumanoid(),
        }
    end
    if camera.CameraType ~= Enum.CameraType.Custom then camera.CameraType = Enum.CameraType.Custom end
    if camera.CameraSubject ~= subject then camera.CameraSubject = subject end
    return true
end
function EX.RebuildPlayers(skip)
    local list = {}
    -- Number keys match the numbered TP rows, including joins and departures.
    for _, player in ipairs(EX.TPList or Players:GetPlayers()) do
        if player ~= LocalPlayer and player ~= skip then list[#list + 1] = player end
    end
    EX.List = list
    if EX.Mode ~= "spectate" or not EX.Target then return end
    local subject = EX.SubjectFor(EX.Target)
    local valid = EX.Target ~= skip and subject ~= nil and subject == EX.TargetSubject
    if valid then
        valid = false
        for _, player in ipairs(list) do
            if player == EX.Target then
                valid = true
                break
            end
        end
    end
    if valid then
        EX.ApplyCamera()
    else
        EX.RestoreCamera()
        EX.Target, EX.TargetSubject = nil, nil
    end
end
function EX.Refresh()
    if not EX.Panel then return end
    EX.Panel.Visible = EX.Mode == "emote"
    EX.Extra.Visible = false
    -- Spectate keeps camera/key handling active without covering the main UI.
    if EX.Mode == "spectate" then return end
    if EX.Mode == "closed" then return end
    EX.Title.Text = EX.Mode == "emote" and "EMOTE [6]" or "SPECTATE [7]"
    EX.Extra.Visible = EX.Mode == "spectate"
    if EX.Mode == "emote" then
        local group = EM.Groups[EX.Group]
        EX.Section.Text = group.Name .. " [" .. EX.Group .. "/" .. #EM.Groups .. "]  Q >"
        for i, row in ipairs(EX.Rows) do
