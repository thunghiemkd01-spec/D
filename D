-- Share repeated obstacle probes within a small movement/time window. The
-- planner/scanner still uses fresh FH.Profile calls and independent ray filters.
function FH.MotionProfile(hum, root, aim, feetY, maxReach)
    local rp, now = root.Position, os.clock()
    local delta = Flat(aim - rp)
    if delta.Magnitude <= 0.1 then return nil end
    local dir, reach = delta.Unit, math.min(delta.Magnitude, maxReach or 3.4)
    local sample = FH.MotionProbe
    if
        sample
        and sample.hum == hum
        and sample.root == root
        and sample.material == hum.FloorMaterial
        and sample.filterAt == rayFilterAt
        and now - sample.at < 0.1
        and Flat(rp - sample.pos).Magnitude < 0.75
        and math.abs(feetY - sample.feetY) < 0.2
        and math.abs(reach - sample.reach) < 0.2
        and dir:Dot(sample.dir) > 0.995
    then
        return sample.kind, sample.sill, sample.instance, sample.door
    end
    local kind, sill, instance, door = FH.Profile(rp.X, rp.Z, dir, feetY, reach)
    FH.MotionProbe = {
        hum = hum,
        root = root,
        material = hum.FloorMaterial,
        filterAt = rayFilterAt,
        at = now,
        pos = rp,
        feetY = feetY,
        dir = dir,
        reach = reach,
        kind = kind,
        sill = sill,
        instance = instance,
        door = door,
    }
    return kind, sill, instance, door
end
