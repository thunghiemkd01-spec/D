function Follow.Refresh()
    local list, keys = {}, {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            list[#list + 1] = p
            keys[#keys + 1] = tostring(p.UserId)
        end
    end
    local k = table.concat(keys, ",")
    if k ~= Follow.Key then
        Follow.Key = k
        for _, r in ipairs(Follow.Rows) do
            r:Destroy()
        end
        Follow.Rows = {}
        for i = 1, #list do
            local b = New("TextButton", Follow.Frame, {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundColor3 = Theme.ElementBg,
                BackgroundTransparency = 0.85,
                RichText = true,
                Text = "",
                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = i,
            })
            New("UICorner", b, { CornerRadius = UDim.new(0, 4) })
            b.MouseButton1Click:Connect(function() Follow.Select(i) end)
            Follow.Rows[i] = b
        end
    end
    Follow.List = list
    for i, b in ipairs(Follow.Rows) do
        local t = BuildPlayerLabelText(list[i], i)
        if b.Text ~= t then b.Text = t end
    end
    if Follow.RandomRow then
        Follow.RandomRow.Text = Follow.RandomActive and "Random [5]: ON (3 min)" or "Random [5]: OFF (3 min)"
        Follow.RandomRow.TextColor3 = Follow.RandomActive and GREEN or Theme.Text
    end
    if Follow.BeastRow then
        Follow.BeastRow.Text = Follow.AutoBeastActive and "Auto Beast [6]: ON" or "Auto Beast [6]: OFF"
        Follow.BeastRow.TextColor3 = Follow.AutoBeastActive and GREEN or Theme.Text
    end
