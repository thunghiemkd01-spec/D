            row.TextColor3 = EM.CurrentData == data and GREEN or Theme.Text
        end
        EX.Extra.Text = ""
        EX.Footer.Text = EM.LastError or "Same key: stop emote"
    else
        EX.Section.Text = "Players [1-4]"
        for i, row in ipairs(EX.Rows) do
            row.Visible = i <= 4
            local player = i <= 4 and EX.List[i] or nil
            local name = player and (player.DisplayName ~= "" and player.DisplayName or player.Name)
            row.Text = player and i .. ". " .. name or (i == 1 and #EX.List == 0 and "No players available" or "")
            row.TextColor3 = player and player == EX.Target and GREEN
                or EX.SubjectFor(player) and Theme.Text
