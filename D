function CB.FunnyMemory()
    if not CB.FunnySession then
        CB.FunnySession = { sent = {}, queued = {}, topics = {}, pivots = {}, recent = {}, lastRevivalAt = -math.huge }
    end
    local memory = CB.FunnySession
    memory.lastRevivalAt = memory.lastRevivalAt or -math.huge
    memory.ignored = memory.ignored or 0
    for text, entry in pairs(memory.queued) do
        if type(entry) ~= "table" or entry.token ~= CB.Token then memory.queued[text] = nil end
    end
    return memory
end

