    local head = root.Parent and root.Parent.FindFirstChild and root.Parent:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        bodyHeight = math.max(bodyHeight, head.Position.Y + head.Size.Y * 0.5 - feetY)
    end
