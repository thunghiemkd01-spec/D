        Nav.GeometryPending = setmetatable({}, { __mode = "k" })
        Nav.GeometryQueue, Nav.GeometryHead = {}, 1
        Nav.DirtyRegions, Nav.DirtyRegionHead = {}, 1
        Nav.PartSnapshots = setmetatable({}, { __mode = "k" })
        Nav.BoundsParts, Nav.BoundsAt, Nav.FullCursor = nil, nil, nil
        Nav.FullVisited, Nav.ScanColumns, Nav.TotalColumns = 0, 0, 0
        Nav.FullFinished, Nav.Limited, Nav.LinksIdle = false, false, false
        Nav.MaxColumns = Nav.MaxColumns or 24000
        Nav.PortalIndex, Nav.PortalAt, Nav.AreaAt = 1, 0, 0
        if not map or not map.Parent then
            Nav.Status = "waiting"
            if Nav.OnReset then Nav.OnReset(nil) end
            return
        end
        Nav.Map, Nav.Status = map, "scanning"
        Nav.RefreshParams(true)
        local generation = Nav.Generation
        -- Enumerating loaded descendants is native; inspecting them is budgeted in Step.
        Nav.BoundsParts, Nav.BoundsAt = map:GetDescendants(), 1
        local added = map.DescendantAdded:Connect(function(part)
            if Nav.Generation ~= generation then return end
            if Nav.FilterSplitParents[part.Parent] then Nav.FilterDirty = true end
            if Nav.IsIgnored(part) then return end
            Nav.IgnoreCache = {}
            if not part:IsA("BasePart") then return end
            navTrackPart(part, generation)
            local changed = navExpand(part)
            if changed and not Nav.BoundsParts then navGridBounds() end
            if part.CanCollide then
                if not Nav.GeometryPending[part] then Nav.GeometryQueue[#Nav.GeometryQueue + 1] = part end
                Nav.GeometryPending[part] = { before = nil, at = navClock() + 0.18, generation = generation }
            end
        end)
        local removed = map.DescendantRemoving:Connect(function(part)
            if Nav.Generation ~= generation then return end
            if Nav.FilterSplitParents[part.Parent] then Nav.FilterDirty = true end
            if not Nav.IsIgnored(part) then Nav.IgnoreCache = {} end
            if not part:IsA("BasePart") then return end
            local old = not Nav.IsIgnored(part) and (Nav.PartSnapshots[part] or navSnapshot(part))
            if old and old.collide then
                if not Nav.GeometryPending[part] then Nav.GeometryQueue[#Nav.GeometryQueue + 1] = part end
                Nav.GeometryPending[part] =
                    { before = old, removed = true, at = navClock() + 0.04, generation = generation }
            else
                Nav.GeometryPending[part] = nil
            end
            local connection = Nav.PartConnections[part]
            if connection then pcall(function() connection:Disconnect() end) end
            Nav.PartConnections[part], Nav.PartSnapshots[part] = nil, nil
        end)
        Nav.Connections[#Nav.Connections + 1] = added
        Nav.Connections[#Nav.Connections + 1] = removed
        if Nav.OnReset then Nav.OnReset(map) end
    end
    function Nav.QueueArea(position, radius)
        if not Nav.Map or not navPosition(position) then return end
        if Nav.PromoteArea then Nav.PromoteArea(position) end
        local cell, r = Nav.Cell, math.clamp(radius or 24, 0, 64)
        local ix, iz = math.floor(position.X / cell + 0.5), math.floor(position.Z / cell + 0.5)
        local now = navClock()
        if now >= (Nav.AreaQueuedAt or 0) then Nav.AreaQueued, Nav.AreaQueuedAt = {}, now + 5 end
        local area = ix .. ":" .. iz .. ":" .. math.floor(position.Y / cell) .. ":" .. r
        if now < (Nav.AreaQueued[area] or 0) then return end
        Nav.AreaQueued[area] = now + 0.6
        local reach = math.ceil(r / cell)
        -- Center first: urgent corridors become available before the far map perimeter.
        for ring = 0, reach do
            for x = -ring, ring do
                if math.abs(x) == ring then
                    for z = -ring, ring do
                        if x * x + z * z <= reach * reach then navQueueColumn(ix + x, iz + z, false) end
                    end
                elseif x * x + ring * ring <= reach * reach then
                    navQueueColumn(ix + x, iz - ring, false)
                    navQueueColumn(ix + x, iz + ring, false)
                end
            end
        end
    end
    local function navInvalidateColumn(column)
        local changed = false
        for _, node in ipairs(column.nodes or {}) do
            if node.live then
                changed = true
                node.live = false
                Nav.NodeCount = math.max(0, Nav.NodeCount - 1)
                if node.id and Nav.Nodes[node.id] == node then Nav.Nodes[node.id] = nil end
            end
        end
        column.nodes, column.scanned, column.unknown = {}, false, false
        if changed then Nav.Topology = (Nav.Topology or 0) + 1 end
    end
    -- One downward surface per invocation, retaining a job across task ticks.
    function Nav.ScanColumn(ix, iz)
        local b = Nav.Bounds
        if not b or not Nav.Map then return true end
        local key = navColumnKey(ix, iz)
        local job = Nav.ColumnJob
        if not job or job.key ~= key or job.generation ~= Nav.Generation then
            local column = Nav.Columns[key]
            if not column then
                column = { nodes = {} }
                Nav.Columns[key] = column
            end
            navInvalidateColumn(column)
            job = {
                key = key,
                ix = ix,
                iz = iz,
                column = column,
                y = b.maxY + 2,
                bottom = b.minY - 2,
                surfaces = 0,
                generation = Nav.Generation,
            }
            Nav.ColumnJob = job
        end
        local function complete()
            job.column.scanned, job.column.at = true, navClock()
            job.column.unknown = job.surfaces == 0
            Nav.ScanColumns = (Nav.ScanColumns or 0) + 1
            Nav.PendingColumns[key], Nav.ColumnJob = nil, nil
            return true
        end
        if job.y <= job.bottom then return complete() end
        local origin = Vector3.new(ix * Nav.Cell, job.y, iz * Nav.Cell)
        local hit = Workspace:Raycast(origin, Vector3.new(0, job.bottom - job.y, 0), Nav.Params)
        if not hit then return complete() end
        job.y = math.min(job.y - 0.2, hit.Position.Y - 0.2)
        job.surfaces = job.surfaces + 1
        if hit.Normal.Y > 0.6 then
            local point = Vector3.new(origin.X, hit.Position.Y, origin.Z)
            if Nav.Space(point) then
                local node = Nav.Add(point, key)
                if node then
                    local found = false
                    for _, existing in ipairs(job.column.nodes) do
                        if existing == node then
                            found = true
                            break
                        end
                    end
                    if not found then job.column.nodes[#job.column.nodes + 1] = node end
                    Nav.Link(node)
                    Nav.LinksIdle = false
                end
            end
        end
        if job.surfaces >= 32 then
            Nav.Limited = true
            return complete()
        end
        return false
    end
    local function navNextColumn(onlyPriority)
        if Nav.ColumnJob then return Nav.ColumnJob.ix, Nav.ColumnJob.iz end
        local skipped = 0
        while Nav.PriorityHead <= #Nav.PriorityColumns and skipped < 32 do
            local entry = Nav.PriorityColumns[Nav.PriorityHead]
            Nav.PriorityHead = Nav.PriorityHead + 1
            skipped = skipped + 1
            if Nav.PendingColumns[entry.key] == entry then return entry.ix, entry.iz end
        end
        if Nav.PriorityHead <= #Nav.PriorityColumns then return false end
        if Nav.PriorityHead > 256 then
            Nav.PriorityColumns, Nav.PriorityHead = {}, 1
        end
        if onlyPriority then return end
        local b, cursor = Nav.Bounds, Nav.FullCursor
        if not b or not cursor or Nav.FullFinished or Nav.NodeCount >= Nav.MaxNodes then return end
        if (Nav.FullVisited or 0) >= Nav.MaxColumns then
            Nav.Limited, Nav.FullFinished, Nav.Status = true, true, "limited"
            return
        end
        local ix, iz = cursor.ix, cursor.iz
        cursor.ix = cursor.ix + 1
        if cursor.ix > b.maxIX then
            cursor.ix, cursor.iz = b.minIX, cursor.iz + 1
        end
        if cursor.iz > b.maxIZ then Nav.FullFinished = true end
        Nav.FullVisited = (Nav.FullVisited or 0) + 1
        local key, column = navColumnKey(ix, iz), Nav.Columns[navColumnKey(ix, iz)]
        if (column and column.scanned) or Nav.PendingColumns[key] then return false end
        Nav.PendingColumns[key] = { ix = ix, iz = iz, key = key }
        return ix, iz
    end
    local function navFlushGeometry(now, deadline)
        local changed, examined = false, 0
        local last = #Nav.GeometryQueue
        while Nav.GeometryHead <= last do
            if examined >= 24 or navClock() >= deadline then break end
            local part = Nav.GeometryQueue[Nav.GeometryHead]
            Nav.GeometryHead = Nav.GeometryHead + 1
            local pending = Nav.GeometryPending[part]
            examined = examined + 1
            if not pending then
            -- This queued key was superseded by a removal/reset.
            elseif pending.generation ~= Nav.Generation then
                Nav.GeometryPending[part] = nil
            elseif now >= pending.at then
                Nav.GeometryPending[part] = nil
                local before = pending.before
                local after = not pending.removed
                    and part.Parent
                    and part:IsDescendantOf(Nav.Map)
                    and not Nav.IsIgnored(part)
                    and navSnapshot(part)
                if
                    ((before and before.collide) or (after and after.collide))
                    and (pending.removed or (after and navChanged(before, after)))
                then
                    if before then navDirtyGeometry(before) end
                    if after then
                        navDirtyGeometry(after)
                        local expanded = navExpand(part)
                        if expanded and not Nav.BoundsParts then navGridBounds() end
                    end
                    changed = true
                end
                if after then Nav.PartSnapshots[part] = after end
            else
                Nav.GeometryQueue[#Nav.GeometryQueue + 1] = part
            end
        end
        if Nav.GeometryHead > 256 then
            local remaining = {}
            for index = Nav.GeometryHead, #Nav.GeometryQueue do
                remaining[#remaining + 1] = Nav.GeometryQueue[index]
            end
            Nav.GeometryQueue, Nav.GeometryHead = remaining, 1
        end
        if changed then
            -- Settled geometry affects only nearby columns. Unrelated doors or
            -- decorations do not cancel every in-flight route on the map.
            -- Selected routes still receive live clearance probes before use.
            Nav.GeometryRevision = (Nav.GeometryRevision or 0) + 1
            if Nav.Status == "ready" then Nav.Status = "scanning" end
        end
    end
    function Nav.Step(budget)
        if not Nav.Map or not Nav.Map.Parent or unloaded then return end
        local started, steps = navClock(), 0
        local deadline = started + (budget or 0.0015)
        Nav.RefreshParams()
        -- This list is also used to attach settled-geometry listeners incrementally.
        if Nav.BoundsParts then
            local list, index = Nav.BoundsParts, Nav.BoundsAt
            while index <= #list and steps < 96 and navClock() < deadline do
                local part = list[index]
                if part.Parent and part:IsA("BasePart") then
                    navTrackPart(part, Nav.Generation)
                    navExpand(part)
                end
                index, steps = index + 1, steps + 1
            end
            Nav.BoundsAt = index
            if index > #list then
                Nav.BoundsParts, Nav.BoundsAt = nil, nil
                navGridBounds()
            end
        end
        if not Nav.Bounds then return end
        navFlushGeometry(started, deadline)
        if started >= (Nav.AreaAt or 0) and navClock() < deadline then
            Nav.AreaAt = started + 0.25
            local root = RootNow()
            if root then Nav.QueueArea(root.Position, 24) end
            if Nav.CurrentGoal then Nav.QueueArea(Nav.CurrentGoal, 20) end
            if AH.Active and AH.Dir and root then Nav.QueueArea(root.Position + AH.Dir * 20, 16) end
            local rescue = AR.Active and (AR.Pick or AR.PendingPick)
            if rescue and rescue.trig and rescue.trig.Parent then Nav.QueueArea(rescue.trig.Position, 20) end
            local target = Follow.Target
            local character = target and target.Character
            local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
            if targetRoot then Nav.QueueArea(targetRoot.Position, 20) end
        end
        Nav.ProcessPromotions(deadline)
        -- One portal per tick; moving doors are refreshed without a synchronous map walk.
        if started >= (Nav.PortalAt or 0) and navClock() < deadline then
            local index = Nav.PortalIndex or 1
            local door = Doors[index]
            if door then
                Nav.PortalIndex = index + 1
                if door.Parent and door:IsDescendantOf(Nav.Map) then
                    Nav.Portal(door)
                    Nav.LinksIdle = false
                end
            else
                Nav.PortalIndex, Nav.PortalAt = 1, started + 0.8
            end
        end
        while steps < 96 and navClock() < deadline do
            local dirty = navDirtyStep()
            local ix, iz = navNextColumn(Nav.PendingEdges() > 0)
            local scanned = type(ix) == "number"
            if scanned then Nav.ScanColumn(ix, iz) end
            local linked = false
            if navClock() < deadline then
                linked = Nav.ProcessLinks()
                Nav.LinksIdle = not linked and Nav.PendingEdges() == 0
            end
            steps = steps + 1
            if not dirty and not scanned and not linked and ix ~= false then break end
        end
        local finished = not Nav.BoundsParts
            and Nav.FullFinished
            and not Nav.ColumnJob
            and next(Nav.PendingColumns) == nil
            and Nav.DirtyRegionHead > #Nav.DirtyRegions
            and next(Nav.GeometryPending) == nil
            and Nav.PendingEdges() == 0
        if Nav.Limited then
            Nav.Status = "limited"
        elseif finished then
            Nav.Status = "ready"
        else
            Nav.Status = "scanning"
        end
    end
    function Nav.Start()
        if Nav.Running then return end
        Nav.Running = true
        Nav.WorkerGeneration = (Nav.WorkerGeneration or 0) + 1
        local workerGeneration = Nav.WorkerGeneration
        Nav.LastMapCheck = 0
        task.spawn(function()
            while not unloaded and Nav.Running and Nav.WorkerGeneration == workerGeneration do
                local now = navClock()
                local active = Follow.Target ~= nil
                    or Follow.AutoFarm
                    or AH.Active
                    or AR.Active
                    or (FH.MotionActive and FH.MotionActive())
                if (active or Nav.Map) and now >= (Nav.LastMapCheck or 0) then
                    Nav.LastMapCheck = now + 0.5
                    local map = GetCurrentMap()
                    if map ~= Nav.Map or (Nav.Map and not Nav.Map.Parent) then Nav.Reset(active and map or nil) end
                end
                -- Build the complete atlas when navigation needs it; an idle UI
                -- does not trace the map or attach thousands of part listeners.
                -- Retain a warm same-map graph and settled changes while paused.
                if active and Nav.Map then Nav.Step(0.0015) end
                task.wait(active and 0.03 or 0.25)
            end
            if Nav.WorkerGeneration == workerGeneration then Nav.Stop() end
        end)
    end
end
