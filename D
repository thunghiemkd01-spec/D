-- Sloping/moving support can leave FloorMaterial at Air even while the avatar
-- is resting on it. A nearby floor and low vertical velocity permit a native
-- takeoff; actual falling bodies never obtain a jump from this contact test.
function FH.TakeoffSupported(hum, root)
    if not hum then return false end
    if hum.FloorMaterial ~= Enum.Material.Air then return true end
    root = root or hum.RootPart
    if not root then return false end
    local ok, state = pcall(function() return hum:GetState() end)
    if not ok or state == Enum.HumanoidStateType.Jumping then return false end
    if state == Enum.HumanoidStateType.Freefall then
        local watch = FH.MoveWatch
        if
            not watch
            or watch.hum ~= hum
            or watch.root ~= root
            or not watch.slideSupported
            or os.clock() - watch.at < 0.8
            or os.clock() - watch.seen > 0.7
        then
            return false
        end
    end
    FH.RefreshFilter()
    local feetY = FH.Feet(hum, root)
    local floor =
        Workspace:Raycast(Vector3.new(root.Position.X, feetY + 0.35, root.Position.Z), Vector3.new(0, -1, 0), FH.SupportRays)
