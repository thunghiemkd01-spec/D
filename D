function Cmd.Exec(player, intent, silent, text, target, modeToken)
    if CB.ChatOnly() or (modeToken ~= nil and modeToken ~= CB.Token) then return end
    local featureRequest = intent == "follow" or intent == "farm" or intent == "stop" or intent == "vote"
    if unloaded or not CB.Active or not player or player.Parent ~= Players then return end
    if not featureRequest and (Ctl.On() or Fly.Active) then
        if not silent then CB.Say("manual controls are active; finish controlling me before that command") end
        return
    end
    if (intent == "show_magic" or intent == "show_dance") and not CB.PerformanceStartAllowed(player, target) then
        return
    end
    -- Restore the combo before a new command snapshots or changes body properties.
    if EM.ComboState then EM.Stop() end
    -- The newest explicit request wins; autonomous features keep their settings and paths.
    Cmd.Cleanup(Cmd.Token)
    Cmd.Token = Cmd.Token + 1
    local id = Cmd.Token
    Cmd.AimUnbind()
    Cmd.CancelFlip()
    Cmd.PendingHit = nil
    Cmd.FollowDirectiveTarget, Cmd.FarmDirective = nil, false
    if AR.CancelRequest then AR.CancelRequest() end
    Cmd.ActiveId = id
    FH.CancelMotion()
    pcall(Follow.Release)
    pcall(AR.Release)
    pcall(TR.Release)
    local function say(s)
        if not silent and s then CB.Say(s) end
    end
    local ok, err = pcall(function()
        if intent == "stop" then
            if Follow.Target or Follow.RandomActive or Follow.AutoBeastActive then
                Follow.Stop()
            elseif Follow.AutoFarm then
                Follow.StopAutoFarm()
            end
            say("okay, stopping. say 'tom follow me' or 'tom farm' when you need me again")
        elseif intent == "follow" then
            local request = Cmd.RequestText(text or ""):gsub(" please$", ""):gsub(" pls$", ""):gsub(" now$", "")
            local selfRequest = request == "follow"
                or request == "folow"
                or request == "follow me"
                or request == "folow me"
                or request == "come here"
                or request == "come with me"
                or request == "stick with me"
            local who = selfRequest and player or Cmd.FindTarget(text or "", player, target)
            if not who or who == LocalPlayer then
                CB.Say("i can't identify that player uniquely. say 'tom follow me' or use their exact username")
                return
            end
            if Cmd.FollowPlayer(who, player) then
                if who == player then
                    say("sure, i'm following you now. say 'tom stop' when you want me to stop")
                else
                    say("sure, following " .. who.DisplayName .. " now. say 'tom stop' to cancel")
                end
