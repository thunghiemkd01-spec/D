function Follow.Select(i, keepRandom, keepAutoBeast)
    local p = Follow.List[i]
    if not p or p.Parent ~= Players then return false end
    if not keepRandom then Follow.StopRandom() end
    if not keepAutoBeast then Follow.StopAutoBeast() end
    if FH and FH.CancelMotion then FH.CancelMotion("follow") end
    -- Autonomous reselection must not release E owned by an active chat command.
    pcall(Follow.Release, Follow.Token)
    Follow.Close()
    Follow.AutoFarm = false
    Follow.Token = Follow.Token + 1
    Follow.Target = p
    Follow.Beat = os.clock()
    Follow.ResetIdleTimer()
    local token = Follow.Token
    if Follow.TConn then pcall(function() Follow.TConn:Disconnect() end) end
    Follow.TConn = p.CharacterAdded:Connect(function()
        task.delay(1.5, function()
            if not unloaded and Follow.Target == p then Follow.Restart() end
        end)
    end)
    Follow.SetLabel("Follow [0]: " .. string.sub(p.Name, 1, 8))
    task.spawn(Follow.Main, token, p)
    return true
end
function Follow.Restart(keep)
    local p = Follow.Target
    if unloaded then return end
    if Follow.AutoFarm and not p then
        Follow.Token = Follow.Token + 1
        pcall(Follow.Release)
        task.spawn(Follow.Main, Follow.Token, nil)
        return
    end
    if not p then return end
    local now = os.clock()
    if now - Follow.RestartAt < 1 then return end
    Follow.RestartAt = now
    Follow.Token = Follow.Token + 1
    pcall(Follow.Release)
    pcall(function() FH.ResetCaches(keep) end)
    Follow.Beat = now
    task.spawn(Follow.Main, Follow.Token, p)
end
function Follow.Toggle()
    if Follow.Target or Follow.RandomActive or Follow.AutoBeastActive then
        Follow.Stop()
    elseif Follow.Picking then
        Follow.Close()
        Follow.ResetButton()
    else
        Follow.Open()
    end
end
