local shiftLockConn
local function ShiftLockStep()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = GetHumanoid()
    local cam = Workspace.CurrentCamera
    if hrp and hum and cam then
        if EX.Mode == "spectate" or EM.ComboState then return end
        if FH and FH.IsFlipActive and FH.IsFlipActive() then return end
        if FH and FH.MotionActive and FH.MotionActive() and not Ctl.On() then
