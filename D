                    local memory = CB.PlayerOutputMemory()
                    if CB.DirectReplies and CB.DirectReplies.token == CB.Token then
                        due = math.max(due, CB.DirectReplies.nextAt or 0)
                    end
                    if not item.turn or memory.lastTurnId ~= item.turn.id then
                        due = math.max(due, (memory.lastTurnAt or -math.huge) + CB.PlayerOutputGap())
                    end
                elseif item.mode == "funny" then
                    local memory = CB.FunnyMemory()
                    if not item.turn or memory.lastTurnId ~= item.turn.id then
                        due = math.max(due, (memory.lastTurnAt or -math.huge) + CB.PlayerOutputGap())
                    end
                end
                local waiting = os.clock() < due
                local busy = CB.ChatSendBusy ~= nil
                    or (item.mode == "player" or item.mode == "funny") and CB.PlayerBusy and CB.PlayerBusy()
                if item.mode == "funny" and not busy and item.guard and not item.guard() then break end
                if not waiting and not busy then break end
                if item.expiresAt and os.clock() >= item.expiresAt then break end
                task.wait(waiting and math.min(0.1, due - os.clock()) or 0.1)
            end
            if CB.Out[1] == item then
                table.remove(CB.Out, 1)
                local allowed = item.token == CB.Token
                    and CB.Active
                    and not CB.Silent
                    and item.mode == CB.Mode
                    and (item.notice or CB.CanSpeak())
                    and not unloaded
                    and (not item.guard or item.guard())
                    and (not item.expiresAt or os.clock() < item.expiresAt)
                if item.mode == "player" then
                    local memory = CB.PlayerOutputMemory()
                    allowed = allowed
                        and not memory.sent[item.text]
                        and not (CB.PlayerBusy and CB.PlayerBusy())
                        and (not item.turn or (not item.turn.failed and item.part == item.turn.sent + 1))
                elseif item.mode == "funny" then
                    local memory = CB.FunnyMemory()
                    allowed = allowed
                        and not memory.sent[item.text]
                        and not (CB.PlayerBusy and CB.PlayerBusy())
                        and (not item.turn or (not item.turn.failed and item.part == item.turn.sent + 1))
                end
                local sent = false
                if allowed then
                    local message = item.text
                    if CB.ChatOnly() then message = CB.PersonaText(message) end
                    if message then
                        if item.mode == "player" then CB.PlayerSendingTurn = item.turn end
                        if item.mode == "funny" then CB.FunnySendingTurn = item.turn end
                        CB.ChatSendBusy = item
                        sent = FH.Chat(message) == true
                        if CB.ChatSendBusy == item then CB.ChatSendBusy = nil end
                        if item.mode == "player" and CB.PlayerSendingTurn == item.turn then
                            CB.PlayerSendingTurn = nil
                        end
                        if item.mode == "funny" and CB.FunnySendingTurn == item.turn then CB.FunnySendingTurn = nil end
                    end
                    if sent then
                        if item.mode == "funny" then
                            local memory = CB.FunnyMemory()
                            memory.sent[message] = true
                            memory.recent[#memory.recent + 1] = message
                            if #memory.recent > 60 then table.remove(memory.recent, 1) end
                            memory.lastTurnAt, memory.lastTurnId = os.clock(), item.turn and item.turn.id or nil
                            if item.turn then item.turn.sent = item.turn.sent + 1 end
                        elseif item.mode == "player" then
                            local memory = CB.PlayerOutputMemory()
                            memory.sent[message] = true
                            memory.recent[#memory.recent + 1] = message
                            if #memory.recent > 60 then table.remove(memory.recent, 1) end
                            memory.lastTurnAt, memory.lastTurnId = os.clock(), item.turn and item.turn.id or nil
                            if item.turn then item.turn.sent = item.turn.sent + 1 end
                            if CB.PlayerRememberLine then pcall(CB.PlayerRememberLine, message, os.clock()) end
                        end
                        item.text = message
                        CB.OutAt = os.clock()
                        CB.LastSend, CB.LastBotAt = CB.OutAt, CB.OutAt
                        CB.Push("tom", item.text, nil, item.mode)
                    end
                end
                if item.mode == "funny" then
                    local memory = CB.FunnyMemory()
                    if memory.queued[item.text] == item then memory.queued[item.text] = nil end
                    if item.turn and not sent then item.turn.failed = true end
                elseif item.mode == "player" then
                    local memory = CB.PlayerOutputMemory()
                    if memory.queued[item.text] == item then memory.queued[item.text] = nil end
                    if item.turn and not sent then item.turn.failed = true end
                end
                if item.onSent then pcall(item.onSent, sent, item.text) end
            end
        end
        CB.Pump = false
    end)
end
function CB.Say(text, prio, onSent, muteNotice, sendGuard, chatKind, playerTurn, playerPart, expiresAt, replyItem)
    if type(text) ~= "string" or text == "" or not CB.Active or CB.Silent or unloaded then return false end
    replyItem = replyItem or CB.ReplyContext()
    if replyItem and (replyItem.tok ~= CB.Token or replyItem.mode ~= CB.Mode) then return false end
    if not muteNotice and not CB.CanSpeak() then return false end
    if CB.ChatOnly() then
        text = CB.PersonaText(text)
    else
        text = string.lower(text)
    end
    if not text or (CB.ChatOnly() and string.find(text, "\n", 1, true)) then return false end
    local q = CB.Out
    local funnyMemory = CB.Mode == "funny" and CB.FunnyMemory() or nil
    local playerMemory = CB.Mode == "player" and CB.PlayerOutputMemory() or nil
    if funnyMemory and (funnyMemory.sent[text] or funnyMemory.queued[text]) then return false end
    if playerMemory and (playerMemory.sent[text] or playerMemory.queued[text]) then return false end
    if #q >= 6 then
        local dropped =
            table.remove(q, playerMemory and CB.PlayerPriorityIndex(q) or funnyMemory and CB.FunnyPriorityIndex(q) or 1)
        if dropped.mode == "funny" then
            local memory = CB.FunnyMemory()
            if memory.queued[dropped.text] == dropped then memory.queued[dropped.text] = nil end
            if dropped.turn then dropped.turn.failed = true end
        elseif dropped.mode == "player" then
            local memory = CB.PlayerOutputMemory()
            if memory.queued[dropped.text] == dropped then memory.queued[dropped.text] = nil end
            if dropped.turn then dropped.turn.failed = true end
        end
        if dropped.onSent then pcall(dropped.onSent, false, dropped.text) end
    end
    local entry = {
        text = text,
        onSent = onSent,
        notice = muteNotice,
        token = CB.Token,
        mode = CB.Mode,
        guard = sendGuard,
        kind = chatKind or "chat",
        turn = playerTurn,
        part = playerPart,
        readyAt = replyItem and (replyItem.outputReadyAt or CB.ReplyReadyAt(replyItem, text)) or nil,
        typingDelay = replyItem and CB.ReplyWaitDuration(text) or nil,
        expiresAt = CB.ChatOnly() and (expiresAt or os.clock() + 120) or nil,
    }
    if funnyMemory and not entry.turn then
        funnyMemory.serial = (funnyMemory.serial or 0) + 1
        entry.turn, entry.part = { id = funnyMemory.serial, sent = 0, failed = false }, 1
    end
    if funnyMemory then funnyMemory.queued[text] = entry end
    if playerMemory then playerMemory.queued[text] = entry end
    if prio then
        table.insert(
            q,
            playerMemory and CB.PlayerPriorityIndex(q) or funnyMemory and CB.FunnyPriorityIndex(q) or 1,
            entry
        )
    else
        q[#q + 1] = entry
    end
    CB.StartOutPump()
    return true
end
-- Event announcements wait 20 seconds; direct replies keep their current timing.
function CB.SayAuto(text, prio, guard)
    if CB.ChatOnly() or not CB.CanSpeak() then return false end
    local token = CB.Token
    local function alive()
        return not unloaded
            and CB.Active
            and not CB.Silent
            and not CB.ChatOnly()
            and CB.Token == token
            and (not guard or guard())
    end
    task.delay(20, function()
        if alive() then CB.Say(text, prio, nil, false, alive) end
    end)
    return true
end
-- Funny story state advances only after delivery, including a partially delivered two-line turn.
function CB.FunnyDeliver(item, text, onSent, sendGuard)
    item = item or {}
    if item.direct then return CB.DirectDeliver(item, text, onSent, sendGuard) end
    local parts = CB.FunnyLines(text)
    local token = item.tok or item.token or CB.Token
    local expiry = item.expiresAt or (item.at or os.clock()) + (item.must and 120 or 20)
    local total, callbacks, sentCount, finished = parts and #parts or 0, 0, 0, false
    local normalized = parts and table.concat(parts, "\n") or nil
    local function complete(sent)
        if finished then return end
        callbacks = callbacks + 1
        if sent then sentCount = sentCount + 1 end
        if not sent or callbacks >= total then
            finished = true
            if onSent then pcall(onSent, sentCount > 0, normalized, sentCount, total) end
        end
    end
    if
        not parts
        or not CB.FunnyEnabled()
        or item.mode and item.mode ~= CB.Mode
        or token ~= CB.Token
        or os.clock() >= expiry
        or not CB.Active
        or CB.Silent
        or unloaded
        or not CB.CanSpeak()
    then
        complete(false)
        return false
    end
    local memory = CB.FunnyMemory()
    for _, line in ipairs(parts) do
        if memory.sent[line] or memory.queued[line] then
            complete(false)
            return false
        end
    end
    -- Reserve both positions first; a priority burst never evicts its own second line.
    while #CB.Out + total > 6 do
