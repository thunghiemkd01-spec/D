function FH.TryJump(hum, root, aim, feetY, kind, sill, owner)
    local token = owner or (FH.Motion and FH.Motion.token)
    if owner ~= nil and not FH.MotionAvailable(owner) then return false end
    if FH.ExitTraversalClear and FH.ExitTraversalClear(token, hum, root, aim) then return false end
    if FH.AwaitingFloorRoute(token, hum, root) then return false end
    local scoped = FH.TraversalOwned(token)
    if
        not hum
        or not root
        or not aim
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
        or Ctl.On()
        or Fly.Active
        or EM.ComboState
        or UserInputService:GetFocusedTextBox()
        or FH.IsWorking(token)
        or FH.IsHacking(token)
        or FH.True(LocalPlayer, FH.CAP)
        or FH.True(LocalPlayer, FH.RAG)
        or (Follow.InputOwner == token and (Follow.Held or Follow.KeyDown))
        or AR.Held
        or AR.KeyDown
        or TR.Held
        or TR.KeyDown
        or (hum.FloorMaterial == Enum.Material.Air and not (scoped and FH.TakeoffSupported(hum, root)))
        or os.clock() - FH.LastJump < 0.5
    then
        return false
    end
    local rp = root.Position
    local delta = Flat(aim - rp)
    if delta.Magnitude <= 0.5 then return false end
    feetY = feetY or FH.Feet(hum, root)
    local reach = math.min(delta.Magnitude, math.clamp((hum.WalkSpeed or 16) * 0.2, 3.4, 6))
    local scopedSafe = false
    if scoped then
        local safe, traversal, height = FH.TraversalLane(token, hum, root, aim, feetY, reach, false)
        if not safe then return false end
        if safe then
            kind, sill, scopedSafe = traversal, height, true
        end
        if kind == "stairs" then
            local recovery = FH.MoveWatch
            if recovery and recovery.token == token and not recovery.escape and (recovery.stairAttempts or 0) >= 3 then
                return false
            end
            if not FH.NormalJump(hum) then return false end
            FH.JumpFlight = {
                t = os.clock(),
                hum = hum,
                root = root,
                token = token,
                airborne = false,
                normal = true,
                feetY = feetY,
            }
            FH.ConfirmNormalTakeoff(hum, root, token)
            if recovery and recovery.token == token then recovery.stairAttempts = (recovery.stairAttempts or 0) + 1 end
