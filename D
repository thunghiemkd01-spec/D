            local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
            if not ok or not track then
                animation:Destroy()
                CB.BeastClear()
                return false
            end
            track.Priority, track.Looped = Enum.AnimationPriority.Action4, false
            CB.BeastLoaded[#CB.BeastLoaded + 1] = { track = track, animation = animation, speed = data.Speed }
        end
    end
    -- Leave the game's attack input/remotes intact; replace only the visible pose.
    EM.Stop()
    local selected = CB.BeastLoaded[math.random(1, #CB.BeastLoaded)]
    for _, clip in ipairs(CB.BeastLoaded) do
