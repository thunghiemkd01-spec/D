function FH.Move(token, hum, goal, force, intentGoal)
    if not (hum and goal) or hum.Health <= 0 or Ctl.On() or Fly.Active or not FH.MotionAvailable(token) then
        if FH.MoveWatch and FH.MoveWatch.token == token then FH.MoveWatch = nil end
        return false
    end
    FH.NoteStallIntent(token, hum, goal, intentGoal)
    local root = hum.RootPart
    local function rejected(point)
        if
            not (type(token) == "number" or type(token) == "table" and token.owner == "rescue")
            or not root
            or FH.CommittedTraversal(token, hum, root, point)
            or (Follow.ActiveDrop and Follow.ActiveDrop(token, hum, root) and Follow.AirClear(hum, root, point))
            or hum.FloorMaterial == Enum.Material.Air
            or FH.IsWorking(token)
            or not FH.LaneRejected(root.Position, point, FH.Feet(hum, root))
        then
            return false
        end
        local current = FH.Motion
        if current.token == token then
            current.replanToken = token
            if current.aim and FH.LaneRejected(root.Position, current.aim, FH.Feet(hum, root)) then
                current.aim, current.sentAim, current.sentAt = root.Position, root.Position, os.clock()
                hum:MoveTo(root.Position)
            end
        end
        return true
    end
    -- A rejected forward lane still needs its horizontal-progress watch;
    -- recovery may safely choose a different lane before this final check.
    goal = FH.RecoveryAim(token, hum, goal, intentGoal)
    if rejected(goal) then return false end
    local m, now = FH.Motion, os.clock()
    if m.token ~= token or m.hum ~= hum then
        if FH.NormalConfirm and FH.NormalConfirm.token ~= token then FH.NormalConfirm = nil end
        m.token, m.hum, m.priority = token, hum, FH.MotionPriority(token)
        m.aim, m.sentAim, m.sentAt = nil, nil, 0
    end
    m.untilAt = now + 0.35
    hum.AutoRotate = true
    -- Render steering follows every accepted destination. Only engine MoveTo
    -- orders are throttled, so a short next waypoint cannot leave Move(0) at
    -- the previous cached point while waiting for its refresh timer.
    m.aim = goal
    local flight = FH.JumpFlight
    if
        flight
        and flight.token == token
        and flight.hum == hum
        and flight.root == root
        and now - flight.t <= 0.08
        and not FH.NormalConfirm
    then
        -- A takeover may request its jump just before its first Move. Confirm
        -- only that task's new takeoff once its accepted lease exists.
        FH.ConfirmNormalTakeoff(hum, root, token)
    end
    if force or not m.sentAim or (goal - m.sentAim).Magnitude >= 0.7 or now - m.sentAt >= 0.45 then
        m.sentAim, m.sentAt = goal, now
        hum:MoveTo(goal)
    end
    if
        FH.TryJump
        and root
        and hum.FloorMaterial ~= Enum.Material.Air
        and not hum.Sit
        and not FH.IsWorking(token)
        and now >= (m.obstacleAt or 0)
        and Flat(goal - root.Position).Magnitude > 2
    then
        m.obstacleAt = now + 0.2
        -- Optional jump geometry may disappear during a map/door update.
        -- Keep the accepted movement and its controller alive on probe failure.
        pcall(FH.TryJump, hum, root, goal, FH.Feet(hum, root))
    end
    return true
end
-- Keep an already proved leg moving during an asynchronous route request.
-- This cannot acquire an owner's motion, revive an expired lease, or drive
-- beyond the current destination while its replacement is being calculated.
function FH.CarryMotion(token, hum, root, seconds)
    local m = FH.Motion
    if
        not (hum and root)
        or m.token ~= token
        or m.hum ~= hum
        or hum.RootPart ~= root
        or not m.aim
        or not FH.MotionActive()
        or Ctl.On()
        or Fly.Active
        or FH.IsWorking(token)
        or FH.IsHacking(token)
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
    then
        return false
    end
    local distance = Flat(m.aim - root.Position).Magnitude
    if distance <= 0.5 then return false end
    local reach = math.min(distance, 6)
    local safe, kind = FH.TraversalLane(token, hum, root, m.aim, FH.Feet(hum, root), reach, true, true)
    if not safe or kind == "jump" or kind == "jump2" then return false end
    m.untilAt = math.max(m.untilAt, os.clock() + math.clamp(seconds or 0.75, 0, 0.9))
    return true
end
function FH.ReleaseMotion(token, stop)
    if FH.ExitTraversal and FH.ExitTraversal.token == token then FH.ExitTraversal = nil end
    if FH.ForwardPulse and FH.ForwardPulse.token == token then FH.ReleaseForward() end
    if FH.VerticalRouteWait and FH.VerticalRouteWait.token == token then FH.VerticalRouteWait = nil end
    if Follow.CrossingTraversal and Follow.CrossingTraversal.token == token then Follow.CrossingTraversal = nil end
    if Follow.DropTraversal and Follow.DropTraversal.token == token then Follow.DropTraversal = nil end
    if AH.DropTraversal and AH.DropTraversal.token == token then AH.DropTraversal = nil end
    if FH.BlockedIntent and FH.BlockedIntent.token == token then FH.BlockedIntent = nil end
    if FH.StallIntent and FH.StallIntent.token == token then FH.StallIntent = nil end
    if FH.NormalConfirm and FH.NormalConfirm.token == token then FH.NormalConfirm = nil end
    local m = FH.Motion
    if m.token ~= token then return false end
    if stop and not Ctl.On() and not Fly.Active then
        local root = RootNow()
        if m.hum and root and m.hum.Parent == LocalPlayer.Character then
            pcall(function() m.hum:MoveTo(root.Position) end)
        end
    end
    if FH.StairWatch and FH.StairWatch.hum == m.hum then FH.StairWatch = nil end
    m.token, m.aim, m.sentAim, m.hum, m.priority, m.untilAt, m.replanToken = nil, nil, nil, nil, 0, 0, nil
    if FH.JumpFlight and FH.JumpFlight.token == token then FH.JumpFlight = nil end
    if FH.MoveWatch and FH.MoveWatch.token == token then FH.MoveWatch = nil end
    return true
end
function FH.CancelMotion(owner)
    local pulse = FH.ForwardPulse
    if pulse then
        local name = type(pulse.token) == "table" and (pulse.token.owner or "command") or "follow"
        if owner == nil or owner == name then FH.ReleaseForward(pulse) end
    end
    for _, entry in ipairs({
        { FH, "ExitTraversal" },
        { FH, "VerticalRouteWait" },
        { FH, "BlockedIntent" },
        { Follow, "CrossingTraversal" },
        { Follow, "DropTraversal" },
        { AH, "DropTraversal" },
    }) do
        local state = entry[1][entry[2]]
        if state then
            local name = type(state.token) == "table" and (state.token.owner or "command") or "follow"
            if owner == nil or owner == name then entry[1][entry[2]] = nil end
        end
    end
    local intent = FH.StallIntent
    if intent then
        local name = type(intent.token) == "table" and (intent.token.owner or "command") or "follow"
        if owner == nil or owner == name then FH.StallIntent = nil end
    end
    local token = FH.Motion.token
    if token == nil then return end
    local name = type(token) == "table" and (token.owner or "command") or "follow"
    if owner == nil or owner == name then FH.ReleaseMotion(token, true) end
end
local function TokOK(token) return FH.MotionValid(token) and FH.MotionAvailable(token) end
function FH.ResetCaches(keep)
    FH.ExitTraversal = nil
    FH.VerticalRouteWait, Follow.CrossingTraversal, Follow.DropTraversal = nil, nil, nil
    if FH.ForwardPulse then FH.ReleaseForward() end
    FH.Jmp = nil
    FH.JumpFlight = nil
    FH.NormalConfirm = nil
    FH.MotionProbe = nil
    FH.StairWatch = nil
    FH.StallIntent = nil
    FH.StallCheckAt = nil
    if keep then return end
    table.clear(DoorFail)
    table.clear(DoorTries)
    table.clear(DoorOpenedAt)
    table.clear(DoorInfo)
    table.clear(DoorB)
    table.clear(FH.Bad)
    table.clear(FH.CompTrigCache)
    FH.BanDirect = 0
    FH.GridBan = 0
end
function FH.ResetMatch()
    FH.Endgame = { on = false }
    FH.ExitFails, FH.HackFail, FH.SoftBan, FH.ChangedN = 0, 0, 0, 0
    FH.ValObjs = nil
    FH.InfoAt, FH.EndAt = 0, 0
    FH.BoundsCache = nil
    FH.DoneSet = setmetatable({}, { __mode = "k" })
    table.clear(FH.ExitBase)
end
function FH.Done(comp)
    if FH.DoneSet[comp] then return true end
    if IsComputerDone(comp) then
        FH.DoneSet[comp] = true
        return true
    end
    return false
end
function FH.CompTriggers(comp)
    local now = os.clock()
    local c = FH.CompTrigCache[comp]
    if c and now - c.at < 10 then return c.list end
    local list = {}
    for _, t in ipairs(comp:GetDescendants()) do
        if t:IsA("BasePart") and t.Name:sub(1, 15) == "ComputerTrigger" and t:FindFirstChild("Event") then
            list[#list + 1] = t
        end
    end
    FH.CompTrigCache[comp] = { at = now, list = list }
    return list
end
-- Physical collision evidence belongs to the live follow controller, not the
-- permanent map atlas. Directed, floor-specific marks leave retreat lanes open.
function FH.BodyRadius(root)
    root = root or RootNow()
    local size = root and root.Size
    return size and math.clamp(math.max(size.X, size.Z) * 0.5 + 0.1, 0.9, 1.3) or 1.1
end
function FH.LaneRevision()
    local state = FH.LiveLanes
    if not state then
        state = { lanes = {}, revision = 0 }
        FH.LiveLanes = state
    end
    local now, root, nav = os.clock(), RootNow(), FH.Nav
    for i = #state.lanes, 1, -1 do
        local lane = state.lanes[i]
        if
            now >= lane.untilAt
            or lane.root ~= root
            or (lane.map and (not nav or nav.Map ~= lane.map or nav.Generation ~= lane.generation))
        then
            table.remove(state.lanes, i)
            state.revision = state.revision + 1
        end
    end
    return state.revision
end
function FH.RejectLane(token, hum, goal, seconds)
    local root = hum and hum.RootPart
    if
        (type(token) ~= "number" and not (type(token) == "table" and token.owner == "rescue"))
        or not FH.MotionValid(token)
        or not root
        or not goal
        or hum.Health <= 0
        or hum.Sit
        or hum.FloorMaterial == Enum.Material.Air
        or Ctl.On()
        or Fly.Active
        or FH.IsWorking(token)
        or (FH.Motion and FH.Motion.token ~= token)
    then
        return false
    end
    local delta = Flat(goal - root.Position)
    if delta.Magnitude <= 0.8 then return false end
    FH.LaneRevision()
    local state, nav, now = FH.LiveLanes, FH.Nav, os.clock()
    local origin, dir, floorY = root.Position, delta.Unit, FH.Feet(hum, root)
    local reach = math.min(delta.Magnitude, 2.2)
    local lane
    for _, prior in ipairs(state.lanes) do
        if
            prior.root == root
            and math.abs(prior.floorY - floorY) < 1.5
            and Flat(prior.origin - origin).Magnitude < 1
            and prior.dir:Dot(dir) > 0.95
        then
            lane = prior
            break
        end
    end
    if not lane then
        lane = {}
        state.lanes[#state.lanes + 1] = lane
        if #state.lanes > 24 then table.remove(state.lanes, 1) end
    end
    lane.root, lane.origin, lane.dir, lane.floorY = root, origin, dir, floorY
    lane.point, lane.radius = origin + dir * reach, FH.BodyRadius(root)
    lane.untilAt = now + (seconds or 8)
    lane.map, lane.generation = nav and nav.Map, nav and nav.Generation
    state.revision = state.revision + 1
    if nav then nav.LastRoute = nil end
    return true
end
function FH.LaneRejected(from, to, feetY)
    FH.LaneRevision()
    local delta = Flat(to - from)
    if delta.Magnitude <= 0.1 then return false end
    local direction, floorY = delta.Unit, feetY or from.Y
    for _, lane in ipairs(FH.LiveLanes.lanes) do
        if math.abs(floorY - lane.floorY) <= 2.5 and direction:Dot(lane.dir) > 0.65 then
            local along = math.clamp(Flat(lane.point - from):Dot(direction), 0, delta.Magnitude)
            local nearest = from + direction * along
            if Flat(nearest - lane.point).Magnitude <= lane.radius then return true end
        end
    end
    return false
end
function FH.PathLaneRejected(wps, feetY)
    for i = 2, #(wps or {}) do
        local from, to = wps[i - 1].Position, wps[i].Position
        local y = i == 2 and feetY or from.Y
        if FH.LaneRejected(from, to, y) then return true end
    end
    return false
end
