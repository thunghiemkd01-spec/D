-- A slow ComputeAsync used to block movement while selecting a door.
function Follow.PlanDoor(token, rp, goal, abort, choose, rescueGoal, rescueState)
    local done, cancelled, result = false, false, nil
    local stableDoor = type(token) == "number" or (type(token) == "table" and token.owner == "rescue")
    local state, started = {}, os.clock()
    local doors = Follow.RescueDoorState(rescueState, rescueGoal)
    local doorVersion = doors and doors.version
    local steeringGoal = goal
    local function active()
        return not cancelled
            and TokOK(token)
            and not (abort and abort())
            and (not doors or doors.version == doorVersion)
    end
    local function valid() return active() and os.clock() - started < 8 end
    local function step()
        if not valid() or Ctl.On() or Fly.Active then return end
        local hum, root = GetHumanoid(), RootNow()
        if hum and root and hum.Health > 0 and steeringGoal then
            Follow.Beat = os.clock()
            FH.RefreshFilter()
            FH.Tick(hum, root)
            -- Once an accepted portal is in interaction range, wait at this
            -- valid stand; provisional exploration must not leave the door.
            if stableDoor and type(result) == "table" and result.Door then
                local stand = (rescueGoal and result.RescueStand) or result.ApproachStand
                local trig = (rescueGoal and result.RescueTrig) or result.ApproachTrig or result.NearTrig
                if
                    stand
                    and Flat(root.Position - stand).Magnitude <= 0.65
                    and FH.DoorCanHold(result, trig, root.Position, stand, FH.Feet(hum, root))
                then
                    FH.Move(token, hum, root.Position, true)
                    return
                end
            end
            if not Follow.PlanStep(token, hum, root, steeringGoal, FH.Feet(hum, root), state, rescueGoal) then
                FH.Move(token, hum, root.Position, false, steeringGoal)
            end
        end
    end
    step()
    local function accept(pick)
        if not (valid() and pick) then return end
        if stableDoor and type(result) == "table" and result.Door and result ~= pick then
            local root = RootNow()
            local stand = (rescueGoal and result.RescueStand) or result.ApproachStand or result.NearPos
            if
                root
                and stand
                and Flat(root.Position - stand).Magnitude <= 6
                and FH.DoorOnFloor(result, root.Position)
            then
                return
            end
        end
        if doors and result and type(result) == "table" and type(pick) == "table" then
            local oldRank, newRank = result.RescueRank or 3, pick.RescueRank or 3
            if
                newRank > oldRank
                or (newRank == oldRank and (pick.RescueCost or math.huge) >= (result.RescueCost or math.huge))
            then
                return
            end
        end
        if type(pick) == "table" and pick.NearPos then
            if doors or not result then
                steeringGoal = (rescueGoal and pick.RescueStand) or pick.ApproachStand or pick.NearPos
            end
        end
        result = pick
    end
    task.spawn(function()
        local ok, pick = pcall(choose, valid, function(point)
            if valid() and point and (not doors or not result) then steeringGoal = point end
        end, accept)
        if ok and valid() then accept(pick) end
        done = true
    end)
    -- Match the existing planner/watchdog deadline even while steering refreshes Beat.
    while not done and valid() and os.clock() - started < 8 do
        -- A usable door stays usable while comparing alternatives. Do not wait
        -- for a slower later ComputeAsync once a short search budget is spent.
        local budget = 2
        if doors and type(result) == "table" then
            if result.RescueRank == 0 then
                budget = 0
            elseif result.RescueRank == 1 then
                budget = 0.35
            end
        end
        if type(result) == "table" and result.Door then
            local stand = (rescueGoal and result.RescueStand) or result.ApproachStand
            local trig = (rescueGoal and result.RescueTrig) or result.ApproachTrig or result.NearTrig
            local hum, root = GetHumanoid(), RootNow()
            if
                stand
                and hum
                and root
                and Flat(root.Position - stand).Magnitude <= 0.65
                and FH.DoorCanHold(result, trig, root.Position, stand, FH.Feet(hum, root))
            then
                budget = 0 -- A usable door is already in range; start opening it now.
            end
        end
        if result and os.clock() - started >= budget then break end
        step()
        task.wait(0.03)
    end
    local ready = (done or result ~= nil) and active()
    cancelled = true
    return ready and result or nil
end
function Follow.EscapeRoom(token, rp, abort, goal, maxDist, rescueGoal, rescueState)
    local now = os.clock()
    local lim = maxDist or 60
    if rescueGoal and rescueState then
        local g = Follow.PlanDoor(
            token,
            rp,
            goal,
            abort,
            function(valid, steer, offer)
                return Follow.FindDoorRoute(token, rp, goal, nil, valid, steer, offer, rescueGoal, rescueState, lim)
            end,
            rescueGoal,
            rescueState
        )
        if not g or g.escape then return false end
        local state = Follow.RescueDoorState(rescueState, rescueGoal)
        state.committed = g
        local passed = Follow.PassDoor(token, g, abort, nil, rescueGoal, rescueState)
        if not passed then state.committed = nil end
        return passed
    end
    local cands = {}
    for _, d in ipairs(Doors) do
        if IsInWorld(d) and not (DoorFail[d] and DoorFail[d] > now) and FH.DoorInfo(d) then
            local g = FH.DoorGeom(d, rp)
            if g and FH.DoorOnFloor(g, rp) then
                local approach = g.NearPos
                if rescueGoal then
                    if FH.DoorBlocked(g) then approach = FH.RescueDoorStand(g, rp) end
                    g.RescueStand = approach
                end
                local dist = approach and (Flat(approach - rp).Magnitude + math.abs(approach.Y - rp.Y) * 2) or math.huge
                if dist < lim then
                    local s = dist + (DoorTries[d] or 0) * 25
                    if goal then s = s + Flat(g.FarPos - goal).Magnitude * 0.15 end
                    cands[#cands + 1] = { g = g, s = s, approach = approach }
                end
            end
        end
    end
    table.sort(cands, function(a, b) return a.s < b.s end)
    for i = 1, math.min(3, #cands) do
        if not TokOK(token) or (abort and abort()) then return false end
        local g = cands[i].g
        local approach = cands[i].approach
        local reach = (approach - rp).Magnitude < 5 and Follow.PlanClear(rp, approach, FH.Ground(rp).Y - 0.5)
        if not reach then
            reach = Follow.PlanDoor(token, rp, approach, abort, function(valid)
                local w, _, _, path = FH.PathAny(rp, approach, 2, false, valid)
                if path then path:Destroy() end
                return w ~= nil and valid()
            end, rescueGoal) == true
        end
        if reach then
            DoorTries[g.Door] = (DoorTries[g.Door] or 0) + 1
            if Follow.PassDoor(token, g, abort, nil, rescueGoal) then return true end
        end
    end
    return false
end
function Follow.FindDoorRoute(
    token,
    rp,
    goal,
    limitLen,
    valid,
    steer,
    offer,
    rescueGoal,
    rescueState,
    maxDist,
    costLimit
)
    local now = os.clock()
    local doors = Follow.RescueDoorState(rescueState, rescueGoal)
    local hum = GetHumanoid()
    local speed = hum and math.max(hum.WalkSpeed, 1) or 16
    local root = hum and hum.RootPart
    local feetY = root and (FH.Feet(hum, root) + rp.Y - root.Position.Y) or (FH.Ground(rp).Y - 0.5)
    local cands = {}
    for _, d in ipairs(Doors) do
        if IsInWorld(d) and not (DoorFail[d] and DoorFail[d] > now) and FH.DoorInfo(d) then
            local g = FH.DoorGeom(d, rp)
            if g and FH.DoorOnFloor(g, rp, feetY) then
                local dist = (g.Center - rp).Magnitude
                local approach = g.NearPos
                if rescueGoal then
                    if FH.DoorBlocked(g) then
                        approach, g.RescueTrig = FH.RescueDoorStand(g, rp)
                    end
                    g.RescueStand = approach
                elseif FH.DoorBlocked(g) then
                    local stand, trig = FH.DoorStand(g, g.NearTrig, rp, 0), g.NearTrig
                    if not stand then
                        stand, trig = FH.RescueDoorStand(g, rp)
                    end
                    approach, g.ApproachStand, g.ApproachTrig = stand, stand, trig
                end
                if dist < (maxDist or 130) and approach then
                    local kind = doors and Follow.RescueDoorKind(doors, g, false, rp)
                    cands[#cands + 1] = {
                        g = g,
                        approach = approach,
                        s = dist
                            + (g.FarPos - goal).Magnitude
                            + (doors and (kind == 2 and speed * 2 or 0) or (DoorTries[d] or 0) * 2),
                    }
                end
            end
        end
    end
    table.sort(cands, function(a, b) return a.s < b.s end)
    local pick, fallback, bestCost, fallbackCost, fallbackRank, steering
    for i = 1, math.min(doors and 12 or 4, #cands) do
        if not valid() then return nil end
        if pick and os.clock() - now >= (doors and 3 or 2) then break end
        local g = cands[i].g
        local approach = cands[i].approach
        local nearDist = Flat(approach - rp).Magnitude
        local directNear = nearDist < 5
            and math.abs(approach.Y - rp.Y) < Follow.MaxDY
            and Follow.PlanClear(rp, approach, feetY)
        local w1, l1 = nil, nearDist
        if not directNear then
            local full, path
            w1, l1, full, path = FH.PathAny(rp, approach, 2, false, valid)
            if path then path:Destroy() end
        end
        if not valid() then return nil end
        if w1 or directNear then
            if steer and not steering and not doors then
                steer(approach)
                steering = true
            end
            local w2, l2, partial, path, farCost
            local nav, far = FH.Nav, FH.Ground(g.FarPos)
            if doors and nav and nav.Map == GetCurrentMap() and nav.Route then
                local target = rescueState and rescueState.rescueTarget
                local model = target and target:FindFirstAncestor("FreezePod")
                local portal, meta
                w2, l2, portal, meta = nav.Route(far, goal, far.Y - 0.5, valid, {
                    allowDoors = true,
                    approachModel = model,
                    budget = 0.3,
                    maxNodes = 2048,
                    maxAnchors = 4,
                    rescue = true,
                })
                if
                    meta
                    and meta.complete
                    and meta.map == nav.Map
                    and meta.map == GetCurrentMap()
                    and meta.generation == nav.Generation
                    and meta.version == nav.Version
                then
                    farCost = meta.cost
                else
                    w2, l2, farCost = nil, nil, nil
                end
            end
            if not valid() then return nil end
            if not w2 then
                w2, l2, partial, path = FH.PathAny(far, goal, 2, false, valid, nil, nil, rescueGoal ~= nil)
            end
            if path then path:Destroy() end
            local completeKind = doors and w2 and Follow.RescueDoorKind(doors, g, true, rp)
            if doors and w2 and Follow.RescueRouteReturns(g, w2) then completeKind = nil end
            if w2 and (not doors or completeKind ~= nil) then
                local total = (l1 or 0) + l2 + 8
                local cost = FH.RouteCost(w1, l1 or 0, rescueGoal ~= nil)
                    + (farCost or FH.RouteCost(w2, l2, rescueGoal ~= nil))
                    + (rescueGoal and (g.FarPos - approach).Magnitude or 8)
                    + (FH.DoorBlocked(g) and speed * 1.2 or 0)
                    + (not doors and (DoorTries[g.Door] or 0) * 2 or 0)
                if
                    (not limitLen or total < limitLen)
                    and (not costLimit or cost < costLimit)
                    and (not bestCost or cost < bestCost)
                then
                    pick, bestCost = cands[i], cost
                    if doors then
                        g.RescueRank, g.RescueCost = 0, cost
                    end
                    if offer then offer(g) end
                end
            elseif not limitLen and not costLimit then
                if rescueGoal then
                    -- A second closed door can hide the rest of the route. Open
                    -- a reachable room exit first, penalizing doors already used.
                    local cost = FH.RouteCost(w1, l1 or 0, true)
                        + Flat(g.FarPos - goal).Magnitude
                        + (FH.DoorBlocked(g) and speed * 1.2 or 0)
                        + (not doors and (DoorTries[g.Door] or 0) * speed * 3 or 0)
                    local rank = 1
                    if doors then rank = Follow.RescueDoorKind(doors, g, false, rp) end
                    if
                        rank ~= nil
                        and (not fallbackCost or rank < fallbackRank or (rank == fallbackRank and cost < fallbackCost))
                    then
                        fallback, fallbackCost, fallbackRank = cands[i], cost, rank
                        if doors then
                            g.RescueRank, g.RescueCost = rank, cost
                        end
                        if not pick and offer then offer(g) end
                    end
                elseif not fallback and Flat(g.FarPos - goal).Magnitude < Flat(rp - goal).Magnitude - 4 then
                    fallback = cands[i]
                elseif type(token) == "number" and FH.DoorBlocked(g) then
                    -- A sealed room can require leaving through a door behind
                    -- us before turning toward the goal. Reachability of its
                    -- stand, not straight-line progress, permits this exit.
                    local cost = FH.RouteCost(w1, l1 or 0)
                        + Flat(g.FarPos - goal).Magnitude
                        + (DoorTries[g.Door] or 0) * speed * 3
                    if not fallbackCost or cost < fallbackCost then
                        fallback, fallbackCost = cands[i], cost
                    end
                end
            end
        end
    end
    pick = pick or fallback
    if not pick then
        if limitLen or costLimit then return nil end
        return { escape = true }
    end
    if not valid() then return nil end
    if steer and not doors then steer(pick.approach) end
    if doors and offer then offer(pick.g) end
    return pick.g
end
function Follow.DoorRoute(token, rp, goal, abort, limitLen, rescueGoal, rescueState, costLimit)
    local g = Follow.PlanDoor(
        token,
        rp,
        goal,
        abort,
        function(valid, steer, offer)
            return Follow.FindDoorRoute(
                token,
                rp,
                goal,
                limitLen,
                valid,
                steer,
                offer,
                rescueGoal,
                rescueState,
                nil,
                costLimit
            )
        end,
        rescueGoal,
        rescueState
    )
    if not g then return false end
    if g.escape then
        if rescueGoal and rescueState then return false end
        return Follow.EscapeRoom(token, rp, abort, goal, 60, rescueGoal)
    end
    local state = Follow.RescueDoorState(rescueState, rescueGoal)
    if state then
        state.committed = g
    else
        DoorTries[g.Door] = (DoorTries[g.Door] or 0) + 1
    end
    local passed = Follow.PassDoor(token, g, abort, nil, rescueGoal, rescueState)
    if state and not passed then state.committed = nil end
    return passed
end
-- Adopt a path at our current position, rather than walking back to its old start.
function Follow.PathIndex(wps, rp, feetY, bodyClear)
    local index, closest = 2, math.huge
    if bodyClear then index = nil end
    local feet = Vector3.new(rp.X, feetY, rp.Z)
    for i = 2, #wps do
        local point = wps[i].Position
        local distance = (point - feet).Magnitude
        if distance < closest then
            -- Height alone cannot reject a supported staircase/ramp. Trace
            -- the rise to the waypoint, but require its actual landing floor:
            -- sharing X/Z with an upstairs point is not a clear route entry.
            local clear, jumps = FH.Line(rp, point, feetY, point.Y, 1.5)
            -- Do not adopt beyond a still-untraversed window/gap jump.
            if
                clear
                and (jumps or 0) == 0
                and (
                    not bodyClear
                    or (
                        not FH.LaneRejected(rp, point, feetY)
                        and Follow.PlanClear(rp, point, feetY, nil, nil, nil, FH.BodyRadius())
                    )
                )
            then
                index, closest = i, distance
            end
        end
    end
    if not index and bodyClear and wps[2] then
        local point = wps[2].Position
        local clear = FH.Line(rp, point, feetY, point.Y, 1.5)
        -- The first route leg may need a jump even on a native Walk stair
        -- waypoint. Retain that verified entry without skipping later jumps.
        if
            clear
            and not FH.LaneRejected(rp, point, feetY)
            and Follow.PlanClear(rp, point, feetY, nil, nil, nil, FH.BodyRadius())
        then
            index = 2
        end
    end
    return index
end
-- Recheck a committed lookahead on a bounded schedule; changed avatar,
