    return table.concat(t, "; ")
end
function CB.Clean(raw)
    if CB.Mode == "funny" then return CB.FunnyText(raw) end
    if CB.Mode == "player" then return CB.PlayerText(raw) end
    if type(raw) ~= "string" then return nil end
    local s = string.gsub(raw, "[\r\n]+", " ")
    s = string.gsub(s, "^%s*%[[^%]]*%]%s*:?%s*", "")
    s = string.gsub(s, "^%s*[Tt][Oo][Mm][Mm]?[Yy]?%s*:%s*", "")
    local symbols = {
        ["×"] = " * ",
        ["÷"] = " / ",
        ["−"] = "-",
        ["π"] = "pi",
        ["²"] = "^2",
        ["³"] = "^3",
        ["√"] = "sqrt ",
        ["≤"] = "<=",
        ["≥"] = ">=",
        ["≠"] = "!=",
        ["°"] = " degrees",
        ["≈"] = " approximately ",
        ["∞"] = "infinity",
        ["⇒"] = " implies ",
        ["→"] = " -> ",
        ["±"] = " +/- ",
        ["α"] = "alpha",
        ["β"] = "beta",
        ["θ"] = "theta",
        ["Ω"] = "ohm",
        ["Δ"] = "delta",
        ["’"] = "'",
        ["‘"] = "'",
        ["“"] = '"',
        ["”"] = '"',
        ["–"] = "-",
        ["—"] = "; ",
    }
    for symbol, replacement in pairs(symbols) do
        s = string.gsub(s, symbol, function() return replacement end)
    end
    s = string.gsub(s, "[^\32-\126]", "")
    -- Remove paired bold words only; retain Python powers such as 2**3 and x**y**z.
    local pieces, cursor = {}, 1
    while true do
        local first, last, inner = string.find(s, "%*%*([^%*]+)%*%*", cursor)
        if not first then
            pieces[#pieces + 1] = string.sub(s, cursor)
            break
        end
        pieces[#pieces + 1] = string.sub(s, cursor, first - 1)
        local before, after = string.sub(s, first - 1, first - 1), string.sub(s, last + 1, last + 1)
        local bold = string.find(inner, "%a") and not string.find(before, "[%w_]") and not string.find(after, "[%w_]")
        pieces[#pieces + 1] = bold and inner or string.sub(s, first, last)
        cursor = last + 1
    end
    s = table.concat(pieces)
    s = string.gsub(s, "`", "")
    s = string.gsub(s, "%s+", " ")
    s = string.match(s, "^%s*(.-)%s*$") or ""
    s = string.lower(s)
    s = string.gsub(s, "%f[%a]on it%f[%A]", "got it")
    if s == "" or s == "skip" then return nil end
    for _, bad in ipairs(CB.BadPhrases) do
        if string.find(s, bad, 1, true) then return nil end
    end
    -- Keep complete explanations; an overlong model answer is retried, not cut mid-meaning.
    if #s > 380 then return nil end
    return s ~= "" and s or nil
end
function CB.Split(s)
    if CB.Mode == "player" then return CB.PlayerLines(s) or {} end
    if CB.Mode == "funny" then return CB.FunnyLines(s) or {} end
    if CB.ChatOnly() then
        local text = CB.PersonaText(s)
        return text and { text } or {}
    end
    local out = {}
    while #s > CB.MaxLen do
        local seg = string.sub(s, 1, CB.MaxLen)
        local p
        for i = #seg, 60, -1 do
            local ch = string.sub(seg, i, i)
            if ch == "." or ch == "?" or ch == "!" then
                p = i
                break
            end
        end
        if not p then
            for i = #seg, 60, -1 do
                if string.sub(seg, i, i) == " " then
                    p = i
                    break
                end
            end
        end
        p = p or CB.MaxLen
        local part = string.match(string.sub(s, 1, p), "^%s*(.-)%s*$")
        if part and part ~= "" then out[#out + 1] = part end
        s = string.match(string.sub(s, p + 1), "^%s*(.-)%s*$") or ""
    end
    if s ~= "" then out[#out + 1] = s end
    return out
end
-- Player turns are queued atomically so a two-line answer cannot be reversed or interleaved.
function CB.StartOutPump()
    if CB.Pump or CB.BatchOut then return end
