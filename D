    if not j then return end
    local el = os.clock() - j.t
    if
        el > 1.2
        or j.hum ~= hum
        or (j.root and j.root ~= root)
        or not hum
        or not root
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
        or unloaded
        or (j.character and j.character ~= LocalPlayer.Character)
        or (j.token and (not FH.Motion or FH.Motion.token ~= j.token or not FH.MotionActive()))
        or Ctl.On()
        or Fly.Active
        or EM.ComboState
        or FH.IsWorking(j.token)
        or FH.IsHacking(j.token)
        or FH.True(LocalPlayer, FH.CAP)
        or FH.True(LocalPlayer, FH.RAG)
        or (Follow.InputOwner == j.token and (Follow.Held or Follow.KeyDown))
        or AR.Held
        or AR.KeyDown
        or TR.Held
        or TR.KeyDown
        or UserInputService:GetFocusedTextBox()
