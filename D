}
function Cmd.Addressed(t)
    local p = " " .. t .. " "
    if string.find(p, " tom ", 1, true) or string.find(p, " tommy ", 1, true) then return true end
    for _, n in ipairs({ Cmd.Norm(LocalPlayer.Name), Cmd.Norm(LocalPlayer.DisplayName) }) do
        if #n >= 3 and string.find(p, " " .. n .. " ", 1, true) then return true end
    end
    return false
end
function Cmd.RequestText(t)
    t = Cmd.Norm(t)
    t = string.gsub(t, "^hey%s+", "")
    local names = { "tom", "tommy", Cmd.Norm(LocalPlayer.Name), Cmd.Norm(LocalPlayer.DisplayName) }
    for _, n in ipairs(names) do
        if n ~= "" then
            if t == n then return "" end
            if string.sub(t, 1, #n + 1) == n .. " " then
                t = string.sub(t, #n + 2)
                break
            end
        end
    end
    for _, prefix in ipairs({
        "i want you to ",
        "would you please ",
        "could you please ",
        "can you please ",
        "would you ",
        "could you ",
        "can you ",
        "please ",
        "pls ",
        "plz ",
    }) do
        if string.sub(t, 1, #prefix) == prefix then
            t = string.sub(t, #prefix + 1)
            break
        end
    end
    t = string.gsub(t, "^please%s+", "")
    return t
end
function Cmd.Intent(text)
    local t = Cmd.RequestText(text)
    -- Không chạy hành động chỉ vì một từ xuất hiện trong lời kể hoặc câu hỏi kiến thức.
    for _, k in ipairs(Cmd.Order) do
        for _, w in ipairs(Cmd.Words[k]) do
            if t == w or string.sub(t, 1, #w + 1) == w .. " " then return k, t end
        end
    end
    local mapQuestion = t == "what map"
        or t == "which map"
        or ((string.match(t, "^what map ") or string.match(t, "^which map ")) and Cmd.Has(
            t,
            { "vote", "choose", "pick", "select" }
        ))
        or string.match(t, "^what should we vote")
        or string.match(t, "^which should we vote")
        or string.match(t, "^what do you want to vote")
    if mapQuestion then return "vote", t end
    return nil, t
end
-- Tìm người chơi được nhắc tới ("me" = người nói), không đoán nếu tên bị trùng.
function Cmd.FindTarget(text, speaker, hint)
    local skip = {}
    for _, w in ipairs({
        "tom",
        "tommy",
        "please",
        "pls",
        "plz",
        "the",
        "him",
        "her",
        "them",
        "hit",
        "attack",
        "smack",
        "punch",
        "slap",
        "bonk",
        "whack",
        "follow",
        "come",
        "with",
        "here",
        "now",
        "and",
        "stop",
        "farm",
        "jump",
        "dance",
        "wave",
        "flip",
        "backflip",
        "hack",
        "can",
        "you",
        "your",
        "get",
        "for",
        "stick",
    }) do
        skip[w] = true
    end
    local function match(str)
        if not str or str == "" then return nil end
        local t = " " .. Cmd.Norm(str) .. " "
        local exact
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                for _, nm in ipairs({ Cmd.Norm(p.Name), Cmd.Norm(p.DisplayName) }) do
                    if #nm >= 2 and string.find(t, " " .. nm .. " ", 1, true) then
                        if exact and exact ~= p then return nil end
                        exact = p
                    end
                end
            end
        end
        if exact then return exact end
        local found
        for tok in string.gmatch(t, "%S+") do
            if #tok >= 3 and not skip[tok] then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        for _, nm in ipairs({ Cmd.Norm(p.Name), Cmd.Norm(p.DisplayName) }) do
                            if string.sub(nm, 1, #tok) == tok then
                                if found and found ~= p then return nil end
                                found = p
                            end
                        end
                    end
                end
            end
        end
        if found then return found end
        if string.find(t, " me ", 1, true) then return speaker end
        return nil
    end
    return match(hint) or match(text)
end
function Cmd.AimUnbind(id)
    if id ~= nil and Cmd.AimToken ~= id then return end
    Cmd.AimToken = nil
    pcall(function() RunService:UnbindFromRenderStep("NovaHitLook") end)
end
-- Used for state restoration; enabled autonomous features do not reject player commands.
function Cmd.FeatureActive()
    if
        Follow.Target
        or Follow.AutoFarm
        or Follow.RandomActive
        or Follow.AutoBeastActive
        or AH.Active
        or AR.Active
        or TR.Active
        or AH.BusyFlag
        or AR.BusyFlag
        or AR.Request ~= nil
        or TR.BusyFlag
    then
        return true
    end
    local motion = FH.Motion
    return motion
            and motion.token ~= nil
            and (type(motion.token) ~= "table" or motion.token.owner ~= "command")
            and FH.MotionActive()
        or false
end
function Cmd.CanAct(id)
    return not unloaded and CB.Active and Cmd.Token == id and Cmd.ActiveId == id and not Ctl.On() and not Fly.Active
end
function Cmd.MotionFor(id, extra)
    local token = {
        owner = "command",
        priority = 100,
        id = id,
        ok = function() return Cmd.CanAct(id) and (not extra or extra()) end,
    }
    Cmd.MotionToken = token
    return token
end
function Cmd.HoldInput(token, event)
    if not token.ok() then return false end
    Cmd.InputToken = token
    Follow.Hold(event, false, true, nil, token)
    return true
end
function Cmd.ReleaseInput(id)
    local token = Cmd.InputToken
    if not token or token.id ~= id then return end
    -- A feature that takes the E interaction replaces InputOwner first.
    Follow.Release(token)
    Cmd.InputToken = nil
end
function Cmd.Cleanup(id)
    Cmd.AimUnbind(id)
    if Cmd.PendingHit and Cmd.PendingHit.id == id then Cmd.PendingHit = nil end
    -- Một tác vụ cũ tuyệt đối không được dọn trạng thái của lệnh mới.
    if Cmd.Token ~= id then return end
    if Cmd.PerformanceCleanup then Cmd.PerformanceCleanup(id) end
    local token = Cmd.MotionToken
    if token and token.id == id then
        FH.ReleaseMotion(token, false)
        Cmd.MotionToken = nil
    end
    Cmd.ReleaseInput(id)
    if Cmd.ActiveId == id then Cmd.ActiveId = nil end
end
function Cmd.FollowPlayer(p, speaker)
    if not p or p.Parent ~= Players then return false end
    if Follow.StopRandom then Follow.StopRandom() end
    if Follow.StopAutoBeast then Follow.StopAutoBeast() end
    if Follow.AutoFarm then Follow.StopAutoFarm() end
    if Follow.Target == p then
        Cmd.FollowDirectiveTarget, Cmd.FarmDirective = p, false
        return true
    end
    Follow.Key = nil
    Follow.Refresh()
    for i, pl in ipairs(Follow.List) do
        if pl == p then
            if not Follow.Select(i) then return false end
            Cmd.FollowDirectiveTarget, Cmd.FarmDirective = p, false
            return true
        end
    end
    return false
end
function Cmd.Farm()
    if Follow.StopRandom then Follow.StopRandom() end
    if Follow.StopAutoBeast then Follow.StopAutoBeast() end
    if Follow.Target then Follow.Stop() end
    if not Follow.AutoFarm and not Follow.StartAutoFarm() then return false end
    Cmd.FollowDirectiveTarget, Cmd.FarmDirective = nil, true
    return true
end
function Cmd.Emote(name, secs, id)
    if not Cmd.CanAct(id) then return end
    local hum, root = GetHumanoid(), RootNow()
    local token = Cmd.MotionFor(id)
    if hum and root then FH.Move(token, hum, root.Position) end
    if not Cmd.CanAct(id) then
        Cmd.Cleanup(id)
        return
    end
    local ok, res = false, false
    if hum then
        ok, res = pcall(function() return hum:PlayEmote(name) end)
    end
    if not (ok and res) and Cmd.CanAct(id) and not CB.Silent then FH.Chat("/e " .. name) end
    local untilAt = os.clock() + secs
    while Cmd.CanAct(id) and os.clock() < untilAt do
        task.wait(0.1)
    end
    Cmd.Cleanup(id)
end
function Cmd.CancelFlip()
    local state = Cmd.FlipState
    if not state then return end
    Cmd.FlipState, Cmd.FlipToken = nil, nil
    pcall(function()
        state.hum.Sit = state.sit
        state.hum.AutoRotate = state.rotate
        if state.root.Parent == LocalPlayer.Character and not Fly.Active then
            state.root.CFrame = CFrame.new(state.root.Position) * state.rotation
        end
        if not state.sit and state.hum.Health > 0 then state.hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end
function Cmd.FlipOnce(id)
    local hum, root = GetHumanoid(), RootNow()
    if not (hum and root) or not Cmd.CanAct(id) then return false end
    -- Same Jump -> Sit -> 360-degree X rotation as FE flips, without 360 delayed callbacks.
    local character, duration = LocalPlayer.Character, 0.5
    local rotation = root.CFrame - root.Position
    local wasSit, wasRotate = hum.Sit, hum.AutoRotate
    local state = { id = id, hum = hum, root = root, sit = wasSit, rotate = wasRotate, rotation = rotation }
    Cmd.FlipState, Cmd.FlipToken = state, id
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    -- Give Jumping one physics frame before Sit; setting both together cancels the jump.
    RunService.Heartbeat:Wait()
    if not Cmd.CanAct(id) or LocalPlayer.Character ~= character or hum.Health <= 0 then
        if Cmd.FlipState == state then Cmd.CancelFlip() end
        return false
    end
    local start = os.clock()
    hum.Sit, hum.AutoRotate = true, false
    local finished = false
    while Cmd.CanAct(id) and LocalPlayer.Character == character and root.Parent and hum.Health > 0 do
        local progress = math.clamp((os.clock() - start) / duration, 0, 1)
        hum.Sit = true
        root.CFrame = CFrame.new(root.Position) * rotation * CFrame.Angles(progress * math.pi * 2, 0, 0)
        if progress >= 1 then
            finished = true
            break
        end
        RunService.Heartbeat:Wait()
    end
    if Cmd.FlipState == state then Cmd.CancelFlip() end
    return finished
end

function Cmd.Backflip(speaker, id)
    if not speaker or speaker.Parent ~= Players or not Cmd.CanAct(id) then return false end
    local function proot()
        local c = speaker.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    if not proot() or AH.Down() or Fly.Active then
        CB.Say("i can't pull that off right now, ask me again in a moment")
        return false
    end
    CB.Say(
        string.format(
            "you want a backflip, %s? hold tight, i'll walk up in front of you and show you two",
            speaker.DisplayName
        )
    )
    local started = os.clock()
    local function front()
        local r = proot()
        if not r then return nil end
        local look = Flat(r.CFrame.LookVector)
        if look.Magnitude < 0.1 then look = Vector3.new(0, 0, 1) end
        return FH.Ground(r.Position + look.Unit * 5)
    end
    local tok = Cmd.MotionFor(
        id,
        function() return os.clock() - started < 28 and not AH.Down() and speaker.Parent == Players end
    )
    local arrived = false
    while tok.ok() do
        local g, me = front(), RootNow()
        if not (g and me) then break end
        if Flat(g - me.Position).Magnitude <= 2.8 then
            arrived = true
            break
        end
        local res = Follow.Chase(tok, front, 2.2, nil, nil)
        if res == "trapped" then Follow.WalkTo(tok, front, 2.2, nil, { maxTime = 6 }) end
        task.wait(0.03)
    end
    local r, me = proot(), RootNow()
    local near = r and me and Flat(r.Position - me.Position).Magnitude <= 9
    if (arrived or near) and tok.ok() then
        pcall(
            function() me.CFrame = CFrame.lookAt(me.Position, Vector3.new(r.Position.X, me.Position.Y, r.Position.Z)) end
        )
        local first = Cmd.FlipOnce(id)
        task.wait(0.35)
        local second = first and tok.ok() and Cmd.FlipOnce(id)
