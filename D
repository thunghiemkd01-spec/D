            not TokOK(token)
            or Ctl.On()
            or Fly.Active
            or FH.Prio()
            or not FH.MotionAvailable(token)
            or AH.Down()
            or FH.AmBeast()
            or not FH.ExitOpen()
            or escaped()
            or (abort ~= nil and abort())
        then
            return true
        end
        if state.redirect then return true end
        if type(token) == "table" and token.owner == "evade" then AH.SetState(AH.Eval().danger and "flee" or "idle") end
        if state.map == GetCurrentMap() and state.character == LocalPlayer.Character then
            if state.solo == false then
                local _, active = FH.ExitPolicy()
                if active == 1 and FH.ActiveSurvivor(LocalPlayer) then
                    state.solo = true
                    state.redirect = "solo"
                    return true
                end
            end
            local root = RootNow()
            if
                state.door
                and FH.ExitThreat(
                    state.center,
                    state.stand and state.stand.Position,
                    root and root.Position,
                    state.door
