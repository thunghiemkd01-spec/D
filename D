local currentMapObj, mapObjTry, podTry = nil, 0, 0
local mapCache, mapCacheAt = nil, 0
local function GetCurrentMap()
    local now = os.clock()
    if now - mapCacheAt < 0.5 and (mapCache == nil or mapCache.Parent) then return mapCache end
    mapCacheAt = now
    local map
    if not (currentMapObj and currentMapObj.Parent) and now - mapObjTry > 5 then
        mapObjTry = now
        currentMapObj = RepStore:FindFirstChild("CurrentMap", true)
    end
    local ov = currentMapObj
    if ov and ov:IsA("ObjectValue") then
        local v = ov.Value
        if v and v.Parent then map = v end
    end

    if not map then
        for _, comp in ipairs(Computers) do
            if IsInWorld(comp) then
                map = comp.Parent
                break
            end
        end
    end
    if not map and now - podTry > 10 then
        podTry = now
        local pod = Workspace:FindFirstChild("FreezePod", true)
        if pod and pod.Parent then map = pod.Parent end
    end
    mapCache = map
    return map
end
