    nav.PriorityLinks, nav.PriorityLinkHead, nav.PriorityAt, nav.PriorityPoints = {}, 1, 0, {}
    nav.IgnoreCache, nav.Portals, nav.PortalIds, nav.NextPortal, nav.LastRoute = {}, {}, {}, 0, nil
