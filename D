        if escaped() then return "escaped" end
        if state.redirect then
            Follow.Release(token)
            if state.redirect == "closed" and state.door then state.fail[state.door] = os.clock() + 3 end
            state.door, state.opening, state.escaping, state.redirect = nil, nil, nil, nil
            return "redirect"
        end
        return nil
    end
    if stopped() then return interrupted() end
    local root, hum, map = RootNow(), GetHumanoid(), GetCurrentMap()
    if not (root and hum and map) then return nil end
    if state.map ~= map or state.character ~= LocalPlayer.Character then
        table.clear(state)
        state.map, state.character, state.fail, state.loiter = map, LocalPlayer.Character, {}, {}
    end
    local now = os.clock()
    local _, active = FH.ExitPolicy()
    local solo = active == 1 and FH.ActiveSurvivor(LocalPlayer)
    if solo and state.solo ~= true then state.door = nil end
    state.solo = solo
    if not state.door or not IsInWorld(state.door) then
        local best, score, chosenCenter, chosenTriggers, chosenSize, chosenArea, threatened
        for _, door in ipairs(ExitDoors) do
            if IsInWorld(door) and door:IsDescendantOf(map) and not (state.fail[door] and state.fail[door] > now) then
