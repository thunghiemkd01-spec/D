function Follow.AutoBeastStep(exclude)
    if unloaded or not Follow.AutoBeastActive then return false end
    local ready = Follow.Target ~= exclude and Follow.AutoBeastReady(Follow.Target)
    if not ready then Follow.ClearAutoBeastTarget() end
    if FH.Prio and FH.Prio() then return ready end
    if Follow.AutoBeastVoteStep then Follow.AutoBeastVoteStep() end
    local map = GetCurrentMap()
    local role = FH.Stat(LocalPlayer, FH.BEASTN)
    if not map or not FH.MatchOn() or not role or role.Value ~= false or not FH.InMatchPlayer(LocalPlayer) then
        return false -- Lobby, missing role data, and our own Beast rounds keep the mode waiting.
    end
    local beast
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p ~= exclude and p.Parent == Players and FH.True(p, FH.BEASTN) then
            if beast then
                Follow.ClearAutoBeastTarget()
                return false -- Do not guess while role data is changing between rounds.
            end
            beast = p
        end
    end
    local char = beast and beast.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not FH.InMatchPlayer(beast) then
        Follow.ClearAutoBeastTarget()
        return false
    end
    if ready and Follow.Target == beast then return true end
    Follow.ClearAutoBeastTarget()
    Follow.Key = nil
    Follow.Refresh()
    for i, p in ipairs(Follow.List) do
        if p == beast then
            Follow.AutoBeastMap = map
            return Follow.Select(i, false, true)
        end
    end
    return false
end
