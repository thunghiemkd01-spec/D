        -- the same frame's jump trying the original rejected wall direction.
        return false
    end
    if Flat(state.goal - rp).Magnitude <= 0.8 and math.abs(state.goal.Y - rp.Y) <= Follow.MaxDY then
        FH.StallIntent = nil
        return false
    end
    local progress = Flat((state.progressGoal or state.goal) - state.anchor)
    if progress.Magnitude > 0.1 and Flat(rp - state.anchor):Dot(progress.Unit) >= 0.35 then
        state.anchor, state.at, state.jumped = rp, now, false
    end
