    -- that same uphill route as blocked; a proven obstruction reroutes sooner.
    if
        not retry
        and not confirmedBlock
        and (state.stairAttempts or 0) < 3
        and FH.TakeoffSupported(hum, root)
        and FH.StairProbe(hum, root, goal)
    then
        state.stairRetryUntil = state.stairRetryUntil or now + 0.9
        if now < state.stairRetryUntil then return goal end
