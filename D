    return pcall(
        function()
            return Workspace:Blockcast(
                CFrame.lookAt(origin + Vector3.new(0, height * 0.5, 0), origin + dir + Vector3.new(0, height * 0.5, 0)),
                Vector3.new(radius * 2, height, depth or math.min(root.Size.X, root.Size.Z)),
                movement or dir * reach,
                rayParams
            )
        end
    )
end
