                if center then
                    local triggers = door:IsA("Model") and FH.Triggers(door) or {}
                    local open = FH.ExitDoorOpen(door, center, triggers)
                    local distance = (center - root.Position).Magnitude
                    local stand, standDistance
                    for _, trigger in ipairs(triggers) do
                        local d = (trigger.Position - root.Position).Magnitude
                        if trigger.Parent and (not standDistance or d < standDistance) then
                            stand, standDistance = trigger.Position, d
                        end
