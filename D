            if not (nav.ExcludeSet and nav.ExcludeSet[instance]) then changed = true end
        end
    end
    for instance in pairs(nav.ExcludeSet or {}) do
        if not set[instance] then changed = true end
    end
    if changed or nav.FilterDirty then
        local previous = nav.Exclusions
        nav.Exclusions, nav.ExcludeSet = exclusions, set
