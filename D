        end
    end
    local dir = n * -mySide
    return {
        Door = d,
        Center = c,
        Dir = dir,
        Size = size,
        FloorY = c.Y - size.Y / 2,
        NearTrig = near or far or trigs[1],
        NearPos = near and near.Position or (c - dir * 3.5),
        FarPos = far and far.Position or (c + dir * 3.5),
    }
end
function FH.DoorBlocked(g)
    local perp = Vector3.new(-g.Dir.Z, 0, g.Dir.X)
    local a = g.Center - g.Dir * 3.2
    local radius = FH.BodyRadius and FH.BodyRadius() or 1.1
    for _, h in ipairs({ 1.5, 3.5 }) do
        for _, off in ipairs({ 0, radius, -radius }) do
            local o = Vector3.new(a.X, g.FloorY + h, a.Z) + perp * off
            local r = Workspace:Raycast(o, g.Dir * 6.4, rayParams)
            if r and r.Instance:IsDescendantOf(g.Door) then return true end
        end
    end
    return false
end
-- X/Z proximity alone does not put a character on the doorway's floor.
function FH.DoorOnFloor(g, position, feetY)
    if not (g and g.FloorY and position) then return false end
    if feetY == nil then
        local hum = GetHumanoid()
        local root = hum and hum.RootPart
        feetY = root and (FH.Feet(hum, root) + position.Y - root.Position.Y) or (FH.Ground(position).Y - 0.5)
