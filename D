local GRID_DIRS = {}
for i = 0, 7 do
    local a = i * math.pi / 4
    GRID_DIRS[#GRID_DIRS + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
end
function FH.Grid(rp, goal, feetY, maxNodes, alive)
    local CS, KC = 4, 2
    local gFeet = FH.Ground(goal).Y - 0.5
    local start = Vector3.new(rp.X, feetY, rp.Z)
    local function key(p)
        return math.floor(p.X / KC + 0.5) .. "," .. math.floor(p.Z / KC + 0.5) .. "," .. math.floor(p.Y / 3 + 0.5)
    end
    local function hcost(p) return Flat(goal - p).Magnitude + math.abs(p.Y - gFeet) * 1.3 end
    local s = { pos = start, g = 0, f = hcost(start) }
    local nodes = { [key(start)] = s }
    local open = { s }
    local expanded = 0
    while #open > 0 and expanded < maxNodes do
        local bi, bn = 1, open[1]
        for i = 2, #open do
            if open[i].f < bn.f then
                bi, bn = i, open[i]
            end
        end
        open[bi] = open[#open]
        open[#open] = nil
        bn.closed = true
        expanded = expanded + 1
        local p = bn.pos
        local nearGoal = Flat(goal - p).Magnitude < 5 and math.abs(p.Y - gFeet) < Follow.MaxDY
        local goalClear, goalJumps = false, 0
        if nearGoal then
            goalClear, goalJumps = FH.Line(p, goal, p.Y, gFeet)
        end
        if nearGoal and goalClear and Follow.PlanClear(p, goal, p.Y) then
            local list = {}
            local cur = bn
            while cur do
                table.insert(list, 1, {
                    Position = cur.pos,
                    Action = cur.jump and Enum.PathWaypointAction.Jump or Enum.PathWaypointAction.Walk,
                })
                cur = cur.parent
            end
            local goalPos = Vector3.new(goal.X, gFeet, goal.Z)
            if (goalPos - list[#list].Position).Magnitude > 0.3 then
                list[#list + 1] = {
                    Position = goalPos,
                    Action = goalJumps > 0 and Enum.PathWaypointAction.Jump or Enum.PathWaypointAction.Walk,
                }
            end
            if #list >= 2 then return list end
            return nil, false
        end
        for _, dv in ipairs(GRID_DIRS) do
            local ny, j = FH.Seg(p.X, p.Z, dv, p.Y, CS)
            if ny and Follow.PlanClear(p, Vector3.new(p.X + dv.X * CS, ny, p.Z + dv.Z * CS), p.Y) then
                local np = Vector3.new(p.X + dv.X * CS, ny, p.Z + dv.Z * CS)
                local k = key(np)
                local cost = bn.g + CS + (j == "jump" and 4 or (j == "jump2" and 8 or 0))
                local ex = nodes[k]
                if not ex then
                    local node = { pos = np, g = cost, f = cost + hcost(np), parent = bn, jump = j }
                    nodes[k] = node
                    open[#open + 1] = node
                elseif not ex.closed and cost < ex.g then
                    ex.g, ex.f, ex.parent, ex.pos, ex.jump = cost, cost + hcost(np), bn, np, j
                end
            end
        end

        if expanded % 30 == 0 then
            task.wait()
            if alive and not alive() then return nil, false end
        end
    end
    return nil, (#open == 0)
end

function Follow.Hold(ev, minigame, key, fast, owner)
    owner = owner or (FH.Motion and FH.Motion.token)
    if Ctl.On() or (owner and not FH.MotionAvailable(owner)) then return false end
    -- Hand the shared physical E key over before claiming a new interaction.
    if AH.ReleaseTap then AH.ReleaseTap() end
    if TR.Held or TR.KeyDown then TR.Release() end
    if AR.Held or AR.KeyDown then AR.Release(AR.HoldToken) end
    if Follow.InputOwner ~= owner and (Follow.Held or Follow.KeyDown) then Follow.Release() end
    local now = os.clock()
    local useRemote = ev and RemoteEvent
    if useRemote then
        if now - Follow.InAt > (fast and 0.06 or 0.2) or Follow.Held ~= ev then
            Follow.InAt = now
            pcall(function()
                RemoteEvent:FireServer("Input", "Trigger", true, ev)
                RemoteEvent:FireServer("Input", "Action", true)
            end)
        end
        if minigame then pcall(function() RemoteEvent:FireServer("SetPlayerMinigameResult", true) end) end
        Follow.Held, Follow.InputOwner = ev, owner
    end
    if (key or not useRemote) and not Follow.KeyDown and not UserInputService:GetFocusedTextBox() then
        -- Claim only our injected E hold; a physical player press stays theirs.
        local heldOK, held = pcall(function() return UserInputService:IsKeyDown(Enum.KeyCode.E) end)
        if (heldOK and held) or (Ctl.Down and Ctl.Down[Enum.KeyCode.E]) then return true end
        Ctl.EUntil = now + 0.5
        local pressed = false
        if type(keypress) == "function" and type(keyrelease) == "function" then
            local ok, result = pcall(keypress, 0x45)
            pressed = ok and result ~= false
            if pressed then Follow.ERelease = keyrelease end
        end
        if not pressed and VIM then
            local ok, result = pcall(function() return VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
            pressed = ok and result ~= false
            if pressed then Follow.EVim = VIM end
        end
        Follow.KeyDown = pressed
        if pressed then
            Follow.InputOwner = owner
            if not Follow.Held then Follow.Held = "key" end
        end
    end
    return Follow.KeyDown == true or Follow.Held ~= nil
end
function Follow.Release(owner)
    if owner ~= nil and Follow.InputOwner ~= owner then return false end
    local h, kd, keyUp, vim = Follow.Held, Follow.KeyDown, Follow.ERelease, Follow.EVim
    if FH.Work and FH.Work.token == Follow.InputOwner then FH.Work = nil end
    Follow.InputOwner = nil
    Follow.ERelease, Follow.EVim = nil, nil
    if not h and not kd then return true end
    Follow.Held = nil
    Follow.KeyDown = false
    Follow.InAt = 0
    if kd and not (Ctl.Down and Ctl.Down[Enum.KeyCode.E]) then
        Ctl.EUntil = os.clock() + 0.5
        if keyUp then
            pcall(keyUp, 0x45)
        elseif vim then
            pcall(function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
        end
    end
    if h and h ~= "key" and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Input", "Trigger", false, h)
            RemoteEvent:FireServer("Input", "Action", false)
        end)
    end
    return true
end
function Follow.Push(token, point, secs, abort, stopD, door)
    local t0 = os.clock()
    local lastPos, lastChk, stuckAt = nil, t0, nil
    while TokOK(token) and os.clock() - t0 < secs do
        if abort and abort() then break end
        if Ctl.Gate() then break end
        Follow.Beat = os.clock()
        local hum = GetHumanoid()
        local root = hum and hum.RootPart
        if not (hum and root) or hum.Health <= 0 then break end
        local rp = root.Position
        local flat = Flat(point - rp)
        if door and not FH.DoorOnFloor(door, rp, FH.Feet(hum, root)) then return false end
        if not door and flat.Magnitude < (stopD or 1.8) and math.abs(point.Y - rp.Y) < Follow.MaxDY then return true end
        -- Once the body has cleared the far side, a closing panel is behind us.
        if door then
            local size = door.Size
            local depth = size and (math.abs(door.Dir.X) * size.X + math.abs(door.Dir.Z) * size.Z) * 0.5 or 0
            local clearance = math.max(2.8, depth + (FH.BodyRadius and FH.BodyRadius(root) or 1.1) + 0.5)
            if door.Dir:Dot(Flat(rp - door.Center)) >= clearance then return true end
        end
        if door and FH.DoorBlocked(door) then break end
        FH.RefreshFilter()
        FH.Tick(hum, root)
        local feetY = FH.Feet(hum, root)
        FH.Move(token, hum, point)

        local kind, sill = FH.Profile(rp.X, rp.Z, flat.Unit, feetY, 3.0)
        if kind == "jump" or kind == "jump2" then FH.Jump(hum, kind == "jump2" or sill > Follow.DoubleFrom, token) end

        local now = os.clock()
        if now - lastChk > 0.4 then
            if lastPos and Flat(rp - lastPos).Magnitude < 0.2 then
                if door then
                    stuckAt = stuckAt or lastChk
                    if now - stuckAt >= 0.8 then break end
                elseif kind ~= "door" and kind ~= "wall" then
                    FH.Jump(hum, true, token)
                end
            else
                stuckAt = nil
            end
            lastPos, lastChk = rp, now
        end
        task.wait(0.03)
    end
    return false
end
-- Rescue exploration belongs to one pod, not to global door retry counters.
-- Each directed crossing is recorded only after the body has reached the far side.
function Follow.RescueDoorState(rescueState, goal)
    if not (rescueState and goal) then return nil end
    local root = RootNow()
    local state = rescueState.doors
    if
        not state
        or state.target ~= rescueState.rescueTarget
        or state.root ~= root
        or (state.goal - goal).Magnitude > 1
    then
        state = { goal = goal, target = rescueState.rescueTarget, root = root, crossed = {}, stack = {}, version = 0 }
        rescueState.doors = state
    end
    return state
end
function Follow.RescueDoorDir(g)
    if g.Dir then return g.Dir end
    local delta = Flat(g.FarPos - g.NearPos)
    return delta.Magnitude > 0.1 and delta.Unit or Vector3.new(0, 0, 1)
end
-- A far-side path that immediately recrosses this same portal is not a useful
-- door route. Taking it would open/cross the door just to return to this room.
function Follow.RescueRouteReturns(g, wps)
    local dir = Follow.RescueDoorDir(g)
    local across = Vector3.new(-dir.Z, 0, dir.X)
    local halfWidth = g.Width and g.Width * 0.5 or 3
    for i = 2, #wps do
        local a, b = wps[i - 1].Position, wps[i].Position
        local da, db = dir:Dot(Flat(a - g.Center)), dir:Dot(Flat(b - g.Center))
        if da > 0 and db < 0 then
            local point = a + (b - a) * (da / (da - db))
            if
                math.abs(across:Dot(Flat(point - g.Center))) <= halfWidth + 1
                and math.abs(point.Y - g.Center.Y) <= 4
            then
                return true
            end
        end
    end
    return false
end
function Follow.RescueDoorKind(state, g, complete, from)
    if not state then return complete and 0 or 1 end
    local dir = Follow.RescueDoorDir(g)
    local seen
    for _, entry in ipairs(state.crossed[g.Door] or {}) do
        if entry.dir:Dot(dir) > 0.5 then
            seen = entry
            break
        end
    end
    if complete then
