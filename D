function FH.ApproachClear(from, goal, ignoreModel)
    if not (from and goal) then return false end
    local step = Flat(goal - from)
    if step.Magnitude < 0.05 then return true end
    local params = rayParams
    if ignoreModel then
        FH.ApproachRays = FH.ApproachRays or setmetatable({}, { __mode = "k" })
        local cached = FH.ApproachRays[ignoreModel]
        if not cached or cached.filterAt ~= rayFilterAt then
            params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            pcall(function() params.RespectCanCollide = true end)
            local exclude = table.clone(rayParams.FilterDescendantsInstances)
            exclude[#exclude + 1] = ignoreModel
            params.FilterDescendantsInstances = exclude
            cached = { params = params, filterAt = rayFilterAt }
            FH.ApproachRays[ignoreModel] = cached
        end
        params = cached.params
    end
    local side = Vector3.new(-step.Unit.Z, 0, step.Unit.X)
    for _, offset in ipairs({ 0, 0.65, -0.65 }) do
        for _, height in ipairs({ -1, 1 }) do
