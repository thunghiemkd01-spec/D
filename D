function TR.SetNoclip(on)
    if not on then
        for part, canCollide in pairs(TR.CollisionParts) do
            if part.Parent and not noclipActive then pcall(function() part.CanCollide = canCollide end) end
        end
        TR.CollisionParts = {}
        TR.CollisionChar = nil
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    if char ~= TR.CollisionChar then
        TR.SetNoclip(false)
        TR.CollisionChar, TR.CollisionAt = char, -math.huge
    end
