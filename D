function FH.Nav.BuildParams(ignore)
    local nav = FH.Nav
    local blocked, split, included = {}, {}, {}
    local function exclude(instance)
        if not instance or not instance.Parent or not instance:IsDescendantOf(nav.Map) then return end
        blocked[instance] = true
        local parent = instance.Parent
        while parent do
            split[parent] = true
            if parent == nav.Map then break end
            parent = parent.Parent
        end
    end
    for _, instance in ipairs(nav.Exclusions or {}) do exclude(instance) end
    exclude(ignore)
    -- Split only ancestors of excluded computers/characters. Whole unaffected
    -- map branches stay included without enumerating every part or other maps.
    local stack = { nav.Map }
    while #stack > 0 do
        local current = table.remove(stack)
        if not blocked[current] then
            if split[current] then
                for _, child in ipairs(current:GetChildren()) do stack[#stack + 1] = child end
            else
                included[#included + 1] = current
            end
        end
    end
    local settings = RaycastParams.new()
    settings.FilterType = Enum.RaycastFilterType.Include
    settings.FilterDescendantsInstances = included
    settings.RespectCanCollide = true
    return settings, blocked, split
end
function FH.Nav.RefreshParams(force)
