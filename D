function Cmd.MapButtons()
    local pg, found = LocalPlayer:FindFirstChildOfClass("PlayerGui"), {}
    if not pg then return found end
    for _, button in ipairs(pg:GetDescendants()) do
        if Cmd.VisibleButton(button) then
            local cur, voting = button, false
            while cur and cur ~= pg do
                local name = Cmd.Norm(cur.Name):gsub(" ", "")
                if
                    name == "mapvote"
                    or name == "mapvoting"
                    or name == "votemap"
                    or name == "mapselection"
                    or name == "voteselection"
                then
                    voting = true
                    break
                end
                cur = cur.Parent
            end
            if voting then
                local label = button:IsA("TextButton") and button.Text or ""
                -- Chỉ đọc nhãn cùng nút, không suy đoán từ remote hoặc thứ tự bản đồ.
                if Cmd.Norm(label) == "" or Cmd.Norm(label) == "vote" or Cmd.Norm(label) == "select" then
                    local mapLabel = button:FindFirstChild("MapName", true)
                        or button:FindFirstChild("MapTitle", true)
                        or (button.Parent and button.Parent:FindFirstChild("MapName"))
                    if mapLabel and (mapLabel:IsA("TextLabel") or mapLabel:IsA("TextButton")) then
                        label = mapLabel.Text
                    end
                end
                if Cmd.Norm(label) ~= "" and Cmd.Norm(label) ~= "vote" and Cmd.Norm(label) ~= "select" then
                    found[#found + 1] = { button = button, name = label, norm = Cmd.Norm(label) }
                end
            end
        end
    end
    return found
end
