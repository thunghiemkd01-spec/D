    if
        choice
        and (EX.Mode == "emote" or EX.Mode == "spectate" and choice <= 4 and not TR.Picking and not Follow.Picking)
    then
        return
    end
    if Ctl.Ignore[k] or Ctl.IsSelf(k) then return end
    Ctl.Down[k] = true
    if EM.ComboState then
        if EM.PauseRequired and EM.PauseRequired() then
            EM.PauseForCrawl()
        else
            EM.Stop()
        end
    end
end))
