-- A companion E tap never owns movement or steals an interaction held by another feature.
function AH.ReleaseTap()
    if not AH.TapDown then return end
    local backend = AH.TapBackend or "vim"
    AH.TapDown, AH.TapUntil = false, 0
    AH.TapBackend, AH.TapCharacter = nil, nil
    AH.TapSerial = (AH.TapSerial or 0) + 1
    -- A later interaction or a real E hold owns its release. Never lift their key.
    if Follow.KeyDown or AR.KeyDown or TR.KeyDown or Ctl.Down[Enum.KeyCode.E] then return end
    Ctl.EUntil = os.clock() + 0.3
    local released = false
    if backend == "keys" and type(keyrelease) == "function" then
        released = pcall(keyrelease, 0x45)
    elseif VIM then
        released = pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
    end
    -- Keep the cleanup paired with its press backend; only use a fallback if it failed.
    if not released and backend ~= "keys" and type(keyrelease) == "function" then released = pcall(keyrelease, 0x45) end
    if not released and backend ~= "vim" and VIM then
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
    end
end
function AH.RedAlert() return AH.Active and not FH.AmBeast() and AH.State ~= "idle" end
function AH.TapStep()
    local now = os.clock()
    if AH.TapDown and (now >= AH.TapUntil or AH.TapCharacter ~= LocalPlayer.Character) then AH.ReleaseTap() end
    local red = AH.RedAlert()
    if not red then
        AH.ReleaseTap()
        AH.TapRed, AH.NextTapAt = false, 0
        return
    end
    if not AH.TapRed then AH.NextTapAt = 0 end
    AH.TapRed = true
    if
        not AH.Active
        or unloaded
        or not FH.MatchOn()
        or FH.AmBeast()
        or AH.Down()
        or Fly.Active
        or Ctl.Down[Enum.KeyCode.E]
        or UserInputService:GetFocusedTextBox()
    then
        AH.ReleaseTap()
        return
    end
    if
        Follow.Held
        or Follow.KeyDown
        or AR.Held
        or AR.KeyDown
        or TR.Held
        or TR.KeyDown
        or remoteHackEvent ~= nil
        or FH.IsHacking(FH.Motion and FH.Motion.token)
    then
        AH.ReleaseTap()
        return
    end
    if not AH.TapDown and now >= AH.NextTapAt then
        -- Walking or a movement command is not an E owner. Only a physical E
        -- hold, text input or a live interaction pauses these independent taps.
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then return end
        Ctl.EUntil = now + 0.3
        local ok, backend = false, nil
        -- Executor keyboard injection follows the same path as a normal key;
        -- some environments expose VIM but silently ignore its synthetic press.
        if type(keypress) == "function" and type(keyrelease) == "function" then
            ok = pcall(keypress, 0x45)
            if ok then backend = "keys" end
        end
        if not ok and VIM then
            ok = pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
            if ok then backend = "vim" end
        end
        AH.NextTapAt = now + (ok and 1 or 0.25)
        if ok then
            AH.TapDown, AH.TapUntil, AH.TapBackend = true, now + 0.06, backend
            AH.TapCharacter = LocalPlayer.Character
        end
    end
end

