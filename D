function CB.FunnyLines(raw)
    if type(raw) ~= "string" then return nil end
    local text = string.match(raw, "^%s*(.-)%s*$") or ""
    local lower = string.lower(text)
    if text == "" or lower == "[skip]" or lower == "skip" then return nil end
    if string.find(text, "[^\32-\126\r\n\t]") or string.find(text, '[`"{}]') then return nil end
    text = string.gsub(string.gsub(text, "\r\n", "\n"), "\r", "\n")
    local lines = {}
    for rawLine in string.gmatch(text .. "\n", "([^\n]*)\n") do
        local line = string.lower(string.match(rawLine, "^%s*(.-)%s*$") or "")
        if line == "" or CB.PlayerProfane(line) then return nil end
        -- Reject markup and masking before punctuation cleanup can disguise either.
        if string.find(line, "[^%w%s,.'?!]") or string.find(line, "%d%.%d") or string.find(line, "^%d+[%.%)]%s") then
            return nil
        end
        line = string.gsub(line, "'", "")
        line = string.gsub(line, "[%.?!]+", ", ")
        line = string.gsub(line, "%s+", " ")
        line = string.gsub(line, "%s*,%s*", ", ")
        line = string.gsub(line, ",[%s,]*", ", ")
        line = string.gsub(line, "^[%s,]+", "")
        line = string.gsub(line, "[%s,]+$", "")
        if line == "" or line == "skip" or not string.find(line, "%a") then return nil end
        local identity = string.gsub(line, "^yeah%s+", "")
        identity = string.gsub(identity, "^nah%s+", "")
        identity = string.gsub(identity, "^no%s+", "")
        for _, claim in ipairs({
            "im human",
            "i am human",
            "im a human",
            "i am a human",
            "im a real human",
            "i am a real human",
            "im a real kid",
            "i am a real kid",
            "im a real player",
            "i am a real player",
            "im not an ai",
            "i am not an ai",
            "im not a bot",
            "i am not a bot",
            "not an ai",
            "not a bot",
        }) do
            if
                string.sub(identity, 1, #claim) == claim
                and (
                    string.sub(identity, #claim + 1, #claim + 1) == ""
                    or string.find(string.sub(identity, #claim + 1, #claim + 1), "[%s,]")
                )
            then
                return nil
            end
        end
        for _, opener in ipairs({ "hello everyone", "how can i help", "great question", "of course" }) do
            if string.sub(line, 1, #opener) == opener then return nil end
        end
        local plain = string.gsub(line, "[^%w]", "")
        if string.find(plain, "yosquadreadytododgebonks", 1, true) then return nil end
        local words = 0
        for _ in string.gmatch(line, "%S+") do
            words = words + 1
        end
        if words < 3 or words > CB.FunnyMaxWords or #line > CB.FunnyMaxLen then return nil end
        lines[#lines + 1] = line
        if #lines > 2 then return nil end
    end
    if #lines == 0 or (#lines == 2 and lines[1] == lines[2]) then return nil end
    return lines
end
function CB.FunnyText(raw)
    local lines = CB.FunnyLines(raw)
    return lines and table.concat(lines, "\n") or nil
end
function CB.FunnyPriorityIndex(q)
    local index, memory = 1, CB.FunnyMemory()
    for i, entry in ipairs(q) do
        if
            entry.mode == "funny"
            and entry.turn
            and ((entry.turn.id == memory.lastTurnId and entry.turn.sent > 0) or entry.turn == CB.FunnySendingTurn)
            and entry.part > entry.turn.sent
            and not entry.turn.failed
        then
            index = i + 1
        else
            break
        end
    end
    return index
end
