                                or (math.abs(normal.Z) > math.abs(normal.X) and normal.Z < 0)
                            then
                                normal = -normal
                            end
                            pick = {
                                center = midpoint,
                                normal = normal,
                                reach = math.max(3.2, length * 0.5 + 1.2),
                                triggerA = a,
                                triggerB = b,
                                triggerLength = length,
                            }
