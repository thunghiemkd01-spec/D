        if rise < -0.85 then return nil end
        local highest, lowest = nextY, nextY
        for _, offset in ipairs({ radius, -radius }) do
            local p = point + across * offset
            -- A diagonal ascent puts the two feet beside different treads.
            -- Support follows the centre; side treads only lift its native hop
            -- corridor, never replace that centre by a wall or a ceiling top.
            local floor = Workspace:Raycast(Vector3.new(p.X, nextY + 2.45, p.Z), Vector3.new(0, -3.3, 0), rayParams)
            if not floor or FH.DoorOf(floor.Instance) or floor.Normal.Y <= 0.25 then return nil end
            highest, lowest = math.max(highest, floor.Position.Y), math.min(lowest, floor.Position.Y)
        end
        if lowest - nextY < -0.85 or highest - nextY > 2.2 then return nil end
        if rise > 0.05 then raised = true end
        local previous = rp + dir * (length * (i - 1))
        local ok, blocked = FH.TraversalSweep(
            root,
            Vector3.new(previous.X + dir.X * 0.025, math.max(floorY, highest) + 0.15, previous.Z + dir.Z * 0.025),
            dir,
            math.max(0.001, length - 0.05),
            bodyHeight,
            radius,
            0.05
        )
