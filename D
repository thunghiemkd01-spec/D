function CB.PlayerLines(raw)
    if type(raw) ~= "string" or not utf8.len(raw) then return nil end
    local text = string.match(raw, "^%s*(.-)%s*$") or ""
    local lower = string.lower(text)
    if lower == "[skip]" or lower == "skip" or text == "" then return nil end
    if string.sub(text, 1, 1) == "{" or string.find(text, '"action"%s*:') then return nil end
    if string.find(text, "```", 1, true) then return nil end
    text = string.gsub(text, "\r\n", "\n")
    text = string.gsub(text, "\r", "\n")
    local lines, questions = {}, 0
    for rawLine in string.gmatch(text .. "\n", "([^\n]*)\n") do
        local line = string.match(rawLine, "^%s*(.-)%s*$") or ""
        if line == "" then return nil end
        line = CB.PlayerLower(line)
        if
            string.find(line, "^%[.*%]")
            or string.find(line, "^[#>%-%*]%s")
            or string.find(line, "^%d+[%.%)]%s")
            or string.find(line, "[`]")
            or string.find(line, "**", 1, true)
        then
            return nil
        end
        for _, label in ipairs({ "assistant", "system", "user", "chat", "event", "state", "tom", "tommy", "reply" }) do
            if string.find(line, "^" .. label .. "%s*:") then return nil end
        end
        line = string.match(line, '^"(.*)"$') or string.match(line, "^'(.*)'$") or line
        line = line:gsub("’", "'")
        line = string.gsub(line, "%s+", " ")
        line = string.match(line, "^%s*(.-)%s*$") or ""
        if line == "" or line == "skip" or line == "[skip]" then return nil end
        if CB.PlayerProfane(line) or CB.PlayerServiceNotice(line) then return nil end
        if line:find("[^%z\1-\127]") then return nil end -- English chat, no emoji.
        for _, opener in ipairs({
            "hello everyone",
            "how can i help",
            "great question",
            "as an ai",
        }) do
            if string.sub(line, 1, #opener) == opener then return nil end
        end
        local emojis, content = 0, false
        for _, code in utf8.codes(line) do
            if (code >= 127744 and code <= 129791) or (code >= 127462 and code <= 127487) then emojis = emojis + 1 end
            if code == 63 then questions = questions + 1 end
            if (code >= 48 and code <= 57) or (code >= 97 and code <= 122) or (code >= 192 and code < 127462) then
                content = true
            end
        end
        if not content or emojis > 1 or questions > 1 or utf8.len(line) > CB.PlayerMaxLen then return nil end
        lines[#lines + 1] = line
        if #lines > 2 then return nil end
    end
    if #lines == 0 or (#lines == 2 and lines[1] == lines[2]) then return nil end
    return lines
end
function CB.PlayerText(raw)
    local lines = CB.PlayerLines(raw)
    return lines and table.concat(lines, "\n") or nil
end
function CB.PlayerOutputMemory()
    if not CB.PlayerOutputSession then CB.PlayerOutputSession = { sent = {}, queued = {}, recent = {}, serial = 0 } end
    local memory = CB.PlayerOutputSession
    for text, entry in pairs(memory.queued) do
        if entry.token ~= CB.Token then memory.queued[text] = nil end
    end
    return memory
end
function CB.PlayerOutputClear()
    CB.PlayerOutputMemory().queued = {}
    CB.PlayerSendingTurn = nil
end
function CB.PlayerOutputGap() return FH.MatchOn and FH.MatchOn() and 8 or 4 end
function CB.PlayerPriorityIndex(q)
    local index, memory = 1, CB.PlayerOutputMemory()
    for i, entry in ipairs(q) do
        if
            entry.mode == "player"
            and entry.turn
            and ((entry.turn.id == memory.lastTurnId and entry.turn.sent > 0) or entry.turn == CB.PlayerSendingTurn)
            and entry.part > entry.turn.sent
            and not entry.turn.failed
        then
            index = i + 1
        else
            break
        end
    end
    return index
end
