function Speed.Restore()
    local hum = Speed.Humanoid
    if hum and Speed.Base ~= nil and Speed.Applied ~= nil then
        pcall(function()
            -- Keep a newer game-written speed instead of replacing it on disable.
            if math.abs(hum.WalkSpeed - Speed.Applied) < 0.0001 then hum.WalkSpeed = Speed.Base end
        end)
    end
    Speed.Humanoid, Speed.Base, Speed.Applied = nil, nil, nil
    Speed.Owned, Speed.Mode = false, nil
end
function Speed.ClearRescue(token)
    local travel = Speed.RescueTravel
    if token ~= nil and (not travel or travel.token ~= token) then return false end
    Speed.RescueTravel = nil
    if Speed.Mode == "rescue" then Speed.Restore() end
    return true
end
function Speed.BeginRescue(token, info)
    if type(token) ~= "table" or token.owner ~= "rescue" then return false end
    local owner, trig = info and info.owner, info and info.trig
    if not owner or owner == LocalPlayer or owner.Parent ~= Players or not trig or not trig.Parent then return false end
    local ownerCharacter = owner.Character
    if not ownerCharacter then return false end
    local travel = Speed.RescueTravel
    if travel and travel.token == token and travel.info == info and travel.character == LocalPlayer.Character then
        return true
    end
    local torso = trig:FindFirstChild("CapturedTorso")
    local occupant = torso and torso:IsA("ObjectValue") and torso.Value
    if not occupant or occupant:FindFirstAncestorOfClass("Model") ~= ownerCharacter then return false end
    Speed.ClearRescue()
    Speed.RescueTravel = {
        token = token,
        info = info,
        torso = torso,
        occupant = occupant,
        owner = owner,
        ownerCharacter = ownerCharacter,
        ownerHumanoid = ownerCharacter:FindFirstChildOfClass("Humanoid"),
        character = LocalPlayer.Character,
        health = FH.Stat(owner, FH.HP),
    }
    return true
end
function Speed.RescueActive(hum)
    local travel = Speed.RescueTravel
    if not travel then return false end
    if
        unloaded
        or travel.character ~= LocalPlayer.Character
        or travel.owner.Parent ~= Players
        or travel.owner.Character ~= travel.ownerCharacter
        or travel.ownerHumanoid and (travel.ownerHumanoid.Parent ~= travel.ownerCharacter or travel.ownerHumanoid.Health <= 0)
        or not travel.info.trig.Parent
        or travel.torso.Parent ~= travel.info.trig
        or travel.torso.Value ~= travel.occupant
        or travel.health and (not travel.health.Parent or travel.health.Value <= 0)
        or not FH.MotionValid(travel.token)
    then
        Speed.ClearRescue(travel.token)
        return false
    end
    local motion = FH.Motion
    if
        not hum
        or hum.Parent ~= travel.character
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
        or Ctl.On()
        or Fly.Active
        or EM.ComboState
        or UserInputService:GetFocusedTextBox()
        or AR.Held
        or AR.KeyDown
        or Follow.Held
        or Follow.KeyDown
        or TR.Held
        or TR.KeyDown
        or AH.Down()
        or FH.IsHacking(travel.token)
        or motion.token ~= travel.token
        or motion.hum ~= hum
        or not motion.aim
        or not FH.MotionActive()
        or not hum.RootPart
    then
        return false
    end
    local delta = motion.aim - hum.RootPart.Position
    return delta.X * delta.X + delta.Z * delta.Z > 0.64
end
function Speed.Step(hum)
    local mode = speedActive and Speed.Level > 0 and "fast" or Speed.RescueActive(hum) and "rescue"
    if not mode then
        Speed.Restore()
        return
    end
    if hum ~= Speed.Humanoid then
        Speed.Restore()
        if not hum then return end
        Speed.Humanoid, Speed.Base = hum, hum.WalkSpeed
    end
    if not hum then return end
    local current = hum.WalkSpeed
    if Speed.Applied == nil or math.abs(current - Speed.Applied) >= 0.0001 then Speed.Base = current end
    -- AutoHelp's small boost follows game-written slows and a stop at zero.
    -- Manual Fast keeps priority over the temporary rescue boost.
    local target = mode == "rescue" and math.max(0, Speed.Base) * Speed.LightScale or Speed.Run
    if math.abs(current - target) >= 0.0001 then hum.WalkSpeed = target end
    Speed.Applied, Speed.Owned, Speed.Mode = target, true, mode
end
