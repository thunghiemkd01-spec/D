-- ================= INVISIBILITY =================
local invisParts = { Saved = setmetatable({}, { __mode = "k" }) }
local function setCharacterTransparency(transparency)
    if transparency == 0 then
        if invisParts.Connection then invisParts.Connection:Disconnect() end
        invisParts.Connection, invisParts.Character = nil, nil
        for part, saved in pairs(invisParts.Saved) do
            pcall(function()
                if part.Parent and math.abs(part.Transparency - saved.applied) < 0.0001 then
                    part.Transparency = saved.original
                end
            end)
        end
        table.clear(invisParts.Saved)
        return
    end
    local character = LocalPlayer.Character
    if not character then return end
    if invisParts.Character ~= character then
        setCharacterTransparency(0)
        invisParts.Character = character
    end
    local function apply(part)
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local saved = invisParts.Saved[part]
            if not saved then
                saved = { original = part.Transparency }
                invisParts.Saved[part] = saved
            end
            -- Invisible collision helpers stay invisible during and after the effect.
            saved.applied = math.max(saved.original, transparency)
            part.Transparency = saved.applied
        end
    end
    for _, part in ipairs(character:GetDescendants()) do
        apply(part)
    end
    if not invisParts.Connection then
        invisParts.Connection = character.DescendantAdded:Connect(function(part)
            if invis_on and LocalPlayer.Character == character then apply(part) end
        end)
    end
end
