    local id = key .. ":" .. math.floor(pos.Y * 2 + 0.5)
    local current = nav.Nodes[id]
    if nav.Valid(current) then return current end
    if nav.NodeCount >= nav.MaxNodes then
        nav.Limited = true
        nav.Status = "limited"
        return nil
    end
    local _, x, z = nav.ColumnKey(pos)
    local node = { id = id, pos = pos, x = x, z = z, live = true, generation = nav.Generation, edges = {} }
    nav.Nodes[id], nav.NodeCount = node, nav.NodeCount + 1
    nav.Topology = (nav.Topology or 0) + 1
