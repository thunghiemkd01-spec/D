-- AI chỉ phân loại hội thoại; các hành động dưới đây chỉ nhận lệnh trực tiếp từ người chơi.
function Cmd.Norm(s)
    s = string.lower(s or "")
    s = string.gsub(s, "[^%w]+", " ")
    s = string.gsub(s, "%s+", " ")
    return string.match(s, "^%s*(.-)%s*$") or ""
end
function Cmd.Has(t, list)
    local p = " " .. t .. " "
    for _, kw in ipairs(list) do
        if string.find(p, " " .. kw .. " ", 1, true) then return true end
    end
    return false
end
Cmd.Order = { "stop", "hit", "escape", "vote", "dance", "wave", "backflip", "follow", "farm", "jump" }
Cmd.Words = {
    stop = { "stop", "unfollow", "cancel", "stay", "halt", "freeze", "enough" },
    hit = { "hit", "attack", "smack", "punch", "slap", "bonk", "whack" },
    escape = { "escape", "leave the map", "go to exit", "go to the exit", "go to exitdoor", "go to the exitdoor" },
    vote = { "vote", "vote map", "choose map", "pick map", "select map" },
    dance = { "dance", "dance2", "emote" },
    wave = { "wave" },
    backflip = { "backflip", "back flip", "flip", "somersault" },
    follow = { "follow", "folow", "come with me", "come here", "stick with me" },
    farm = {
        "farm",
