                    if math.abs(offset.Y) > 3.6 or not Follow.GoalOnFloor(hum, r2, trig.Position, comp) then
                        Follow.Release(token)
                        routeLost = true
                        break
                    end
                    local dist = math.abs(offset.Y) <= 3.6 and Flat(offset).Magnitude or math.huge
                    if not FH.ApproachClear(r2.Position, trig.Position, comp) then
                        Follow.Release(token)
                        routeLost = true
                        break
                    end
                    -- Enter interaction range once, then keep its wider contact
                    -- margin. Driving to the trigger center first causes jitter
                    -- against the keyboard and an unnecessary one-second delay.
                    st.on = dist <= (st.on and 4.2 or 3.2)
                    if st.on then
                        FH.Move(token, hum, r2.Position)
                        Follow.Hold(ev, Follow.HackSendResult, true, false, token)
                        FH.MarkWork(token, "hack")
                        fwPos, fwAt = r2.Position, os.clock()
                    else
                        Follow.Release(token)
                        FH.Move(token, hum, trig.Position)
                    end
                end
                task.wait(0.04)
            end
            Follow.Release(token)
            if compDone(comp) then
                doneComputers[comp] = true
                hackSkip[comp] = math.huge
                FH.HackFail = 0
                task.wait(0.08)
                return
            end
            if stop() then return end
            if routeLost then continue end
            timedOut[comp] = os.clock() + 45
            hackSkip[comp] = os.clock() + 10
            FH.HackFail = FH.HackFail + 1
            return
        end
        hackSkip[comp] = os.clock() + (farmMode and 4 or 6)
    end
    local function farmWatch()
        local r = myRoot()
        if not r then return end
        local now = os.clock()
        if
            not fwPos
            or (r.Position - fwPos).Magnitude >= 0.8
            or FH.IsWorking(token)
            or Ctl.On()
            or Fly.Active
            or not go()
        then
            fwPos, fwAt = r.Position, now
            return
        end
        if now - fwAt > Follow.StandMax then
            fwAt = now
            Follow.Release(token)
            FH.GridBan = 0
            local hum = GetHumanoid()
            if hum and TokOK(token) then FH.Unstick(hum, r, token, nil, 0.35) end
            fwPos, fwAt = r.Position, os.clock()
        end
    end
    local function capturedPods()
        local now = os.clock()
        local res = {}
        for _, info in ipairs(AR.Pods(true)) do
            local skipped = podSkip[info.trig]
            if
                not (skipped and skipped.occupant == info.occupant and skipped.untilAt > now)
                and not AH.Unsafe(info.trig.Position, 16)
            then
                res[#res + 1] = info
            end
        end
        return res
    end

    local function nearestPod(owner)
        local mr = myRoot()
        if not mr then return nil end
        local best, bd
        for _, info in ipairs(capturedPods()) do
            if not owner or info.owner == owner then
                local d = (info.trig.Position - mr.Position).Magnitude
                if not bd or d < bd then
                    best, bd = info, d
                end
            end
        end
        return best
    end

    local function rescuePod(info, stopFn)
        Follow.Rescuing = true
        local ok, res = pcall(
            FH.RescuePod,
            token,
            go,
            info,
            stopFn,
            function(ev, ro) return Follow.Hold(ev, false, not ro, true, token) end,
            function() return Follow.Release(token) end
        )
        Follow.Rescuing = false
        if not ok then error(res, 0) end
        if res == "far" then podSkip[info.trig] = { occupant = info.occupant, untilAt = os.clock() + 2 } end
    end

    local function exitRun(extraAbort)
        local result = FH.ExitRoute(
            token,
            exitState,
            function()
                return not go()
                    or meBad()
                    or meOut()
                    or not FH.ExitOpen()
                    or AH.PodsPending()
                    or (extraAbort ~= nil and extraAbort())
            end
        )
        if result == "escaped" then return true end
        if result == "retry" then return false end
        return result
    end
    local function onExitResult(result)
        if result == true then FH.ExitFails = 0 end
        if result == false then FH.ExitFails = FH.ExitFails + 1 end
    end
    local function exitStage()
        setLabel("Follow [0]: EXIT")
        Follow.Release(token)
        local result = exitRun()
        onExitResult(result)
        if result == "waiting" then setLabel("Follow [0]: EXIT-WAIT") end
        task.wait(result == false and 0.12 or 0.03)
        return true
    end
    -- Có máy ĐÃ hack xong trong bán kính `radius` quanh `pos` không?
    local function nearDoneComputer(pos, radius)
        local map = GetCurrentMap()
        for _, comp in ipairs(Computers) do
            if IsRealComputer(comp, map) and compDone(comp) then
                local p = comp:GetPivot().Position
                if Flat(p - pos).Magnitude < radius and math.abs(p.Y - pos.Y) < 8 then return comp, p end
            end
        end
        return nil
    end
    -- Không có việc để làm: KHÔNG đứng gần máy đã xong.
    local function parkStep()
        local mr, hum = myRoot(), GetHumanoid()
        if not (mr and hum) or hum.Health <= 0 then
            task.wait(0.2)
            return
        end
        local rp = mr.Position
        local dc, dp = nearDoneComputer(rp, 12)
        if not dc then
            task.wait(0.15)
            return
        end

        local goal, stopD
        local pend = nearestUndoneComputer(true)
        if pend then
            -- chờ gần máy CHƯA hack (đợi hết skip)
            local pp = pend:GetPivot().Position
            if Flat(pp - rp).Magnitude <= 10 then
                task.wait(0.25)
                return
            end
            local v = Flat(rp - pp)
            v = v.Magnitude > 0.5 and v.Unit or Vector3.new(1, 0, 0)
            goal, stopD = FH.Ground(pp + v * 8), 2.5
        else
            -- không còn máy nào: chạy ra xa máy đã xong
            local feetY = FH.Feet(hum, mr)
            FH.RefreshFilter()
            local away = Flat(rp - dp)
            away = away.Magnitude > 0.5 and away.Unit or Vector3.new(1, 0, 0)
            local bestDir, bestRun, bestSc
            for i = 0, 7 do
                local a = i * math.pi / 4
                local d = Vector3.new(math.cos(a), 0, math.sin(a))
                local run = AH.Scan(rp, d, feetY)
                local sc = run + d:Dot(away) * 10
                if run >= 8 and (not bestSc or sc > bestSc) then
                    bestDir, bestRun, bestSc = d, run, sc
                end
            end
            if bestDir then
                goal, stopD = FH.Ground(rp + bestDir * math.min(bestRun, 18)), 3
            end
        end
        if not goal then
            task.wait(0.2)
            return
        end
        local g = goal
        Follow.WalkTo(
            token,
            function() return g end,
            stopD,
            function() return not go() or meBad() end,
            { maxTime = 8, nearOk = 5 }
        )
        task.wait(0.1)
    end

    local function farmStep(afk)
        Follow.Farming = true
        local hum = GetHumanoid()
        if not myRoot() or not hum or hum.Health <= 0 or Fly.Active then
            task.wait(0.2)
            return
        end
        if meBad() then
            task.wait(0.3)
            return
        end
        FH.RefreshFilter()
        setLabel("Follow [0]: FARM")
        farmWatch()
        local function hasCaptured() return #capturedPods() > 0 end
        local function targetBack() return afk and targetActive() end
        if targetBack() then return end
        if FH.ExitOpen() and FH.ExitDanger() and FH.AnyExitOpen() then
            exitStage()
            return
        end
        local pod = nearestPod(nil)
        if pod then
            if AR.Active then
                -- AutoHelp owns the close-contact rescue and rescue-only speed.
                Follow.Release(token)
                FH.ReleaseMotion(token, false)
                task.wait(0.05)
            else
                rescuePod(pod, targetBack)
            end
            return
        end
        -- Rescue captured teammates before opening or waiting at an exit.
        if FH.ExitOpen() then
            exitStage()
            return
        end
        table.clear(exitState)
        local comp = nearestUndoneComputer()
        if comp then
            hackComputer(comp, function() return hasCaptured() or targetBack() end, nil, true)
            if not compDone(comp) then task.wait(0.15) end
            return
        end
        parkStep()
    end
    local dangerAt, dangerV = 0, false
    local function beastNear(tp)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p ~= player and FH.True(p, FH.BEASTN) then
                local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if
                    r
                    and math.abs(r.Position.Y - tp.Y) <= Follow.MaxDY
                    and Flat(r.Position - tp).Magnitude < Follow.DangerRange
                then
                    return true
                end
            end
        end
        return false
    end
    local function targetDanger()
        local now = os.clock()
        if now - dangerAt < 0.2 then return dangerV end
        dangerAt = now
        dangerV = false
        if amBeast() then return false end
        local tr = troot()
        if not tr then return false end
        if targetCaptured() or isTrue(player, FH.RAG) or beastNear(tr.Position) then dangerV = true end
        return dangerV
    end
    local function followStep(beast)
        Follow.Farming = false
        fwPos, fwAt = nil, os.clock()
        local hum = GetHumanoid()
        local root = myRoot()
        local tr = troot()
        if not (root and hum and tr) or hum.Health <= 0 or Fly.Active then
            task.wait(0.2)
            return
        end
        if meBad() then
            task.wait(0.3)
            return
        end
        setLabel("Follow [0]: " .. string.sub(player.Name, 1, 8))
        FH.RefreshFilter()
        local tp = tr.Position
        local still = stillFor(tp)
        local endg = FH.ExitOpen()
        if not endg then table.clear(exitState) end
        local range, moving = Follow.TargetRange(tr, spacingStill(tp))
        local danger = (not beast) and targetDanger()
        if not beast and endg and FH.ExitDanger() and FH.AnyExitOpen() and matchOn() and not meOut() then
            exitStage()
            return
        end
        if not beast then
            if targetCaptured() then
                local info = nearestPod(player) or nearestPod(nil)
                if info then
                    if AR.Active then
                        Follow.Release(token)
                        FH.ReleaseMotion(token, false)
                        task.wait(0.05)
                    else
                        rescuePod(info, function() return targetState() ~= "ok" end)
                    end
                    return
                end
            end
        end
        if not beast and endg and matchOn() and not meOut() then
            exitStage()
            return
        end
        if not beast and not danger and still >= Follow.AfkFarmTime and matchOn() then
            farmStep(true)
            return
        end
        if not beast and not danger and not afkSent and still >= Follow.AfkTime and not matchOn() then
            afkSent = true
            FH.Emote()
        end
        if not beast and not danger and not endg and still >= Follow.StillTime then
            local comp = findComputer(tp)
            if comp then
                local startT = tp
                hackComputer(comp, function()
                    local r = troot()
                    if not r or targetCaptured() or targetState() ~= "ok" then return true end
                    return Flat(r.Position - startT).Magnitude > 4.5
                end, tp, false)
                return
            end
        end
        local rp = root.Position
        local dist = Flat(tp - rp).Magnitude
        local safe = Follow.SafeDistance
        if danger and dist < safe - 10 then
            local dv = Flat(rp - tp)
            if dv.Magnitude > 0.5 then
                local dir = dv.Unit
                local feetY = FH.Feet(hum, root)
                if FH.Seg(rp.X, rp.Z, dir, feetY, 6) then
                    FH.Move(token, hum, rp + dir * 8)
                    task.wait(0.06)
                    return
                end
            end
        end
        local blocked = not FH.ApproachClear(rp, tp) or not Follow.GoalOnFloor(hum, root, tp)
        local far
        if danger then
            far = dist > safe + 4 or math.abs(tp.Y - rp.Y) > Follow.MaxDY or blocked
        else
            far = dist > range + (moving and 0.8 or Follow.Resume) or math.abs(tp.Y - rp.Y) > Follow.MaxDY or blocked
        end
        local function ab()
            if not go() or meBad() or targetState() ~= "ok" then return true end
            if beast then return false end
            if targetCaptured() and (nearestPod(player) or nearestPod(nil)) then return true end
            if targetDanger() then
                local r, m = troot(), myRoot()
                if
                    r
                    and m
                    and Flat(r.Position - m.Position).Magnitude <= safe
                    and Follow.GoalOnFloor(GetHumanoid(), m, r.Position)
                then
                    return true
                end
                return false
            end
            if FH.Endgame.on then return false end
            local r = troot()
            return r ~= nil and stillFor(r.Position) >= Follow.StillTime and findComputer(r.Position) ~= nil
        end
        if far then
            local function getGoal()
                local r = troot()
                if not r then return nil end
                return r.Position
            end
            local function stopD()
                if not beast and targetDanger() then return Follow.SafeDistance end
                local r = troot()
                return Follow.TargetRange(r, r and spacingStill(r.Position))
            end
            local function keepFn()
                local r, m = troot(), myRoot()
                if not r or not m or targetDanger() then return false end
                local desired, running = Follow.TargetRange(r, spacingStill(r.Position))
                -- Keep moving with a running target without letting the old
                -- five-stud override pull us into their body.
                return running and Flat(r.Position - m.Position).Magnitude >= desired - 1
            end
            -- Blocked targets and different floors go straight to route planning.
            -- Clear lanes retain the existing follow steering and spacing.
            local otherFloor = math.abs(tp.Y - rp.Y) > Follow.MaxDY
            local res = (otherFloor or blocked) and "trapped" or Follow.Chase(token, getGoal, stopD, ab, keepFn)
            if res == "trapped" then
                res = Follow.WalkTo(token, getGoal, stopD, ab, {
                    windows = true,
                    keep = keepFn,
                    maxTime = 10,
                })
            end
            if res == "arrived" then
                followFails = 0
            elseif res == "stuck" then
                followFails = followFails + 1
                local h2, r2 = GetHumanoid(), myRoot()
                local trr = troot()
                if h2 and r2 then FH.Unstick(h2, r2, token, trr and trr.Position, 0.6) end
            elseif res == "nopath" or res == "timeout" then
                followFails = followFails + 1
                task.wait(0.2)
            end
        else
            followFails = 0
            task.wait(0.03)
        end
    end
    while alive() do
        Follow.Beat = os.clock()
        Ctl.Gate()
        if os.clock() < Follow.PauseUntil then
            -- AI chat báo tạm nghỉ (emote...): nhả E và đứng yên
            if Follow.Held or Follow.KeyDown then pcall(Follow.Release, token) end
            task.wait(0.1)
        elseif AH.BusyFlag or AR.BusyFlag or TR.BusyFlag or not FH.MotionAvailable(token) then
            if not wasBusy then
                wasBusy = true
                if Follow.Held or Follow.KeyDown then pcall(Follow.Release, token) end
            end
            task.wait(0.04)
        else
            wasBusy = false
            local ok, err = pcall(function()
                if matchOn() and meOut() then
                    task.wait(0.4)
                    return
                end
                local beast = amBeast()
                -- AutoFarm tự động chạy độc lập khi chưa có người yêu cầu Follow.
                -- Tuyệt đối không chạy đồng thời với Follow mục tiêu.
                if Follow.AutoFarm and not Follow.Target then
                    if matchOn() and not beast and not meOut() then
                        farmStep(false)
                    else
                        Follow.Release(token)
                        task.wait(0.25)
                    end
                    return
                end
                local st = targetState()
                if st == "left" then
                    if matchOn() and not beast and not meOut() then
                        farmStep(false)
                    else
                        Follow.Stop()
                    end
                    return
                end
                if st == "nochar" then
                    task.wait(0.3)
                    return
                end
                if st == "dead" or st == "escaped" then
                    if not beast and not meOut() then
                        farmStep(false)
                    else
                        task.wait(0.4)
                    end
                    return
                end
                if not beast and not Follow.RandomActive and matchOn() and isTrue(player, FH.BEASTN) then
                    farmStep(false)
                    return
                end
                followStep(beast)
            end)
            if not ok then
                warn("[Follow] loi: " .. tostring(err))
                pcall(Follow.Release, token)
                task.wait(0.3)
            end
            task.wait(0.02)
        end
    end
end
