function FH.Nav.Link(node)
    local nav = FH.Nav
    if not nav.Valid(node) then return end
    for x = node.x - 1, node.x + 1 do
        for z = node.z - 1, node.z + 1 do
            local column = nav.Columns[x .. ":" .. z]
            if column then
                for _, other in ipairs(column.nodes) do
                    local horizontal = Flat(other.pos - node.pos).Magnitude
                    if
                        other ~= node
                        and horizontal > 0.8
                        and horizontal <= nav.Cell * 1.5
                        and math.abs(other.pos.Y - node.pos.Y) <= Follow.MaxDrop
                    then
                        nav.QueueLink(node, other)
                        nav.QueueLink(other, node)
