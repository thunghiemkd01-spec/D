function MG.PickBot(letter)
    local cands = {}
    local list = MG.Chain[letter]
    if list then
        for w in string.gmatch(list, "%a+") do
            if not MG.Used[w] then cands[#cands + 1] = w end
        end
    end
    if #cands > 0 then
        local best, bs
        for _, w in ipairs(cands) do
            local ll = MG.Chain[string.sub(w, -1)]
            local n = 0
            if ll then
                for x in string.gmatch(ll, "%a+") do
                    if not MG.Used[x] then n = n + 1 end
                end
            end
            local sc = n + math.random() * 3
            if not bs or sc < bs then
                best, bs = w, sc
            end
        end
        return best
    end
    local used = {}
    for w in pairs(MG.Used) do
        used[#used + 1] = w
    end
    local r = MG.LLM(
        MG.Prompt
            .. "\n\nright now reply with exactly ONE common standard english word (lowercase letters only, 3 to 10 letters) that starts with the requested letter and is not in the used list. no punctuation, no explanation.",
        "letter: " .. letter .. "\nused words: " .. table.concat(used, ", "),
        8
    )
    if r then
        local w = string.match(string.lower(r), "%a+") or ""
        if #w >= 3 and string.sub(w, 1, 1) == letter and not MG.Used[w] then return w end
    end
    return nil
end
function MG.FirstWord()
    local keys = { "a", "b", "c", "d", "f", "g", "h", "l", "m", "n", "p", "r", "s", "t", "w" }
    for _ = 1, 10 do
        local list = MG.Chain[keys[math.random(1, #keys)]]
        local words = {}
        for w in string.gmatch(list, "%a+") do
            if not MG.Used[w] then words[#words + 1] = w end
        end
        if #words > 0 then return words[math.random(1, #words)] end
    end
    return "garden"
end
function MG.End(tok, msg)
    if tok and MG.Token ~= tok then return end
    MG.Active = false
    MG.Busy = false
    MG.Token = MG.Token + 1
    if msg and not CB.ChatOnly() then CB.Say(msg, true) end
    CB.SetLabel()
end
function MG.Abort()
    MG.Active = false
    MG.Busy = false
    MG.Token = MG.Token + 1
end
function MG.SayWord(w, text)
    if not MG.Active or CB.ChatOnly() then return end
    local token, serial = MG.Token, (MG.OutputSerial or 0) + 1
    MG.OutputSerial = serial
    MG.BotWord, MG.BotAt = w, nil
    local function current()
        return MG.Active and MG.Token == token and MG.OutputSerial == serial and MG.BotWord == w and not CB.ChatOnly()
    end
    return CB.Say(
        text,
        true,
        function(sent)
            if not current() then return end
            if sent then
                MG.BotAt, MG.LastAct = os.clock(), os.clock()
            else
                MG.BotWord, MG.BotAt = nil, nil
            end
        end,
        false,
        function()
            if not current() then return false end
            -- Own tagged-message events can arrive inside SendAsync, before onSent.
            MG.BotAt = os.clock()
            return true
        end
    )
end
-- Tin của CHÍNH MÌNH bị filter thành ####: chọn từ khác
function MG.OnOwn(text)
    if CB.ChatOnly() or not (MG.Active and MG.BotWord and MG.BotAt and os.clock() - MG.BotAt < 12) then return end
    if not string.find(text, "#", 1, true) then return end
    MG.BotWord = nil
    local tok = MG.Token
    task.spawn(function()
        local nw = MG.NeedLetter and MG.PickBot(MG.NeedLetter) or MG.FirstWord()
        if not (MG.Active and nw) or MG.Token ~= tok or CB.ChatOnly() then return end
        MG.Used[nw] = true
        MG.Last = nw
        MG.SayWord(
            nw,
            string.format(
                "oops, my word got tagged by the filter. new word: %s. your turn, start with '%s'",
                nw,
                string.sub(nw, -1)
            )
        )
    end)
end
function MG.Watch(tok)
    while not unloaded and MG.Active and MG.Token == tok do
        task.wait(1)
        if not MG.Active or MG.Token ~= tok then return end
        if not MG.Player or MG.Player.Parent ~= Players then
            MG.End(tok)
            return
        end
        local idle = os.clock() - MG.LastAct
        if not MG.Replied and idle > 60 then
            MG.End(tok) -- không ai phản hồi: im lặng kết thúc
            return
        elseif MG.Replied and idle > 75 and not MG.Busy then
            MG.End(
                tok,
                string.format(
                    "time's up, %s! no valid word means you lose this round. chain length: %d. rematch? type 'wordchain'",
                    MG.Player.DisplayName,
                    MG.Round
                )
            )
            return
        end
    end
end
function MG.Start(p)
    if CB.ChatOnly() then return false end
    if not p or p.Parent ~= Players then return false end
    if MG.Active then
        if MG.Player ~= p then
            CB.Say(
                string.format(
                    "i'm in a game with %s right now, give us a minute",
                    MG.Player and MG.Player.DisplayName or "someone"
                )
            )
        end
        return false
    end
    MG.Token = MG.Token + 1
    local tok = MG.Token
    MG.Active, MG.Player, MG.Busy = true, p, false
    MG.Used, MG.Round, MG.Replied, MG.NeedLetter = {}, 0, false, nil
    MG.StartCount = MG.StartCount + 1
    MG.LastAct = os.clock()
    local w = MG.FirstWord()
    if unloaded or not MG.Active or MG.Token ~= tok or CB.ChatOnly() then return false end
    MG.Used[w] = true
    MG.Last = w
    CB.Say(
        "word chain rule: start your word with the last letter of the previous word, no repeats, and no tagged words",
        true
    )
    MG.SayWord(w, string.format("my word is '%s'. your turn, %s: start with '%s'", w, p.DisplayName, string.sub(w, -1)))
    CB.SetLabel()
    task.spawn(MG.Watch, tok)
    return true
end
function MG.ChainTurn(p, w)
    if MG.Busy or not MG.Active then return end
    MG.Busy = true
    local tok = MG.Token
    MG.LastAct = os.clock()
    MG.Replied = true
    local last = string.sub(MG.Last, -1)
    local function lose(why)
        MG.End(
            tok,
            string.format(
                "you lose this round, %s: %s. chain length: %d. rematch? type 'wordchain'",
                p.DisplayName,
                why,
                MG.Round
            )
        )
    end
    if #w < 3 then return lose("'" .. w .. "' has fewer than 3 letters") end
    if string.sub(w, 1, 1) ~= last then return lose("'" .. w .. "' doesn't start with '" .. last .. "'") end
    if MG.Used[w] then return lose("'" .. w .. "' was already used") end
    if not MG.Valid(w) then return lose("'" .. w .. "' isn't a valid standard english word") end
    if not MG.Active or MG.Token ~= tok then
        MG.Busy = false
        return
    end
    MG.Used[w] = true
    MG.Round = MG.Round + 1
    MG.NeedLetter = string.sub(w, -1)
    local bw = MG.PickBot(MG.NeedLetter)
    if not MG.Active or MG.Token ~= tok then
        MG.Busy = false
        return
    end
    if not bw then
        return MG.End(
            tok,
            string.format(
                "i'm out of words starting with '%s', you win this round, %s! well played. rematch? type 'wordchain'",
                MG.NeedLetter,
                p.DisplayName
            )
        )
    end
    MG.Used[bw] = true
    MG.Last = bw
    MG.Round = MG.Round + 1
    MG.LastAct = os.clock()
    MG.Busy = false
    local praise = { "good one", "solid word", "not bad", "sneaky", "nice pick" }
    MG.SayWord(
        bw,
        string.format(
            "%s! mine is '%s'. your turn, start with '%s'",
            praise[math.random(1, #praise)],
            bw,
            string.sub(bw, -1)
        )
    )
end
function MG.OnChat(p, text)
    if not MG.Active then return false end
    if p ~= MG.Player then return false end
    -- từ bị filter thành ####: bắt nói lại, không tính thua
    if string.find(text, "#", 1, true) and not MG.Busy then
        MG.LastAct = os.clock()
        MG.Replied = true
        CB.Say("that word got tagged by the chat filter, so it doesn't count. say a clean word instead", true)
        return true
    end
    local t = Cmd.Norm(text)
    if t == "" then return false end
    if t == "quit" or t == "stop" or t == "give up" or t == "end" or t == "exit" or t == "surrender" then
        MG.End(MG.Token, "okay, game over. type 'wordchain' whenever you want a rematch")
        return true
    end
    local w = string.match(t, "^(%a+)$")
        or string.match(t, "^my word is (%a+)$")
        or string.match(t, "^word (%a+)$")
        or string.match(t, "^next (%a+)$")
    if not w or MG.Chatty[w] then return false end
    local replyItem = CB.ReplyContext() or { at = os.clock(), tok = CB.Token, mode = CB.Mode }
    task.spawn(function() CB.WithReplyContext(replyItem, MG.ChainTurn, p, w) end)
    return true
end
function MG.TryStart(player, text)
    if CB.ChatOnly() then return false end
    local t = Cmd.Norm(text)
    if t == "" then return false end
    local p = " " .. t .. " "
    local want = string.find(p, " wordchain ", 1, true) or string.find(p, " word chain ", 1, true)
    local ask = string.find(p, " minigame ", 1, true)
        or string.find(p, " minigames ", 1, true)
        or string.find(p, " mini game ", 1, true)
        or string.find(p, " play a game ", 1, true)
    if not (want or ask) then return false end
    local n = 0
    for _ in string.gmatch(t, "%S+") do
        n = n + 1
    end
    if n > 8 and not Cmd.Addressed(t) then return false end
    if not want then
        CB.Say("i only have one game, wordchain. type 'wordchain' and i'll host it")
        return true
    end
    MG.Start(player)
    return true
end
