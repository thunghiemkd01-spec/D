    line("===== BAT DAU v3 (map: " .. root:GetFullName() .. ") =====")
    line("ung vien chinh: " .. #HideCandidates .. " | phu: " .. #HideExtra .. " | tu hop le: " .. #spots)
    line("--- TU HOP LE (toi da 60) ---")
    for i = 1, math.min(#spots, 60) do
        local inst = spots[i].Inst
        line((HideTP.HasInteraction(inst) and "OK[T] | " or "OK[-] | ") .. inst:GetFullName())
    end
    local skipName = { "door", "computertable", "freezepod" }
    local function skip(name)
        local l = string.lower(name)
        for _, k in ipairs(skipName) do
            if string.find(l, k, 1, true) then return true end
        end
        return false
    end
    local function hist(title, keyFn, maxCount, maxLines)
        local counts, ex, keys = {}, {}, {}
        for _, d in ipairs(root:GetDescendants()) do
            local key = keyFn(d)
            if key then
                if not counts[key] then
                    counts[key] = 0
                    ex[key] = d:GetFullName()
                    keys[#keys + 1] = key
                end
                counts[key] = counts[key] + 1
            end
        end
        table.sort(keys)
        line("--- " .. title .. " ---")
        local n = 0
        for _, k in ipairs(keys) do
            if counts[k] <= maxCount then
                n = n + 1
                if n <= maxLines then line(string.format("%s x%d | %s", k, counts[k], ex[k])) end
            end
        end
        if n > maxLines then line("... con " .. (n - maxLines) .. " muc nua") end
    end
    hist("PROXIMITYPROMPT / CLICKDETECTOR (theo ten vat chua)", function(d)
        if (d:IsA("ProximityPrompt") or d:IsA("ClickDetector")) and d.Parent and not skip(d.Parent.Name) then
            return d.Parent.Name .. " <- " .. d.ClassName
        end
    end, 9999, 60)
    hist("PART TEN CO 'trigger' (bo cua/may tinh)", function(d)
        if
            d:IsA("BasePart")
            and string.find(string.lower(d.Name), "trigger", 1, true)
            and not skip(d.Name)
            and not skip(d.Parent and d.Parent.Name or "")
        then
            return d.Name
        end
    end, 9999, 60)
    line("===== KET THUC v3 =====")
    for _, t in ipairs(out) do
        print(t)
    end
    FlashText(Btn.Hide, "TP Hide [Q] (xem F9)", "TP Hide [Q]", 1.5)
end
local function TeleportToHideSpot()
    if TeleportBlocked() then
        FlashText(Btn.Hide, "Tat che do tu dong!", "TP Hide [Q]", 1)
        return
    end
    local char = LocalPlayer.Character
    local root = char and char.PrimaryPart
    if not root then return end
    local spots = HideTP.GetSpots()
    local n = #spots
    if n == 0 then
        FlashText(Btn.Hide, "TP Hide [Q] (0)", "TP Hide [Q]", 1)
        return
    end
    for _ = 1, n do
        if hideIndex > n then hideIndex = 1 end
        local s = spots[hideIndex]
        hideIndex = hideIndex + 1

        if (s.Pos - root.Position).Magnitude > 1.5 then
            DisableInvisForTeleport()
            if TeleportBlocked() or not char.Parent or not char.PrimaryPart then return end
            root = char.PrimaryPart
            char:PivotTo(s.Goal)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if HideTP.Debug then
                local sz = select(2, HideTP.Bounds(s.Inst))
                print("[HideTP]", s.Inst:GetFullName(), s.Inst.ClassName, sz, (hideIndex - 1) .. "/" .. n)
            end
            task.spawn(function()
                for _ = 1, 3 do
                    RunService.Heartbeat:Wait()
                    if TeleportBlocked() or not char.Parent or not char.PrimaryPart then return end
                    if (char.PrimaryPart.Position - s.Pos).Magnitude > 2 then
                        char:PivotTo(s.Goal)
                        char.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end)
            return
        end
    end
end
