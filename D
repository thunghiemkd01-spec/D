-- Share a short, verified uphill sample between navigation and the render
-- recovery loop. Flat walking needs only the coarse profile and one floor ray.
function FH.StairProbe(hum, root, aim)
    local delta = Flat(aim - root.Position)
    if delta.Magnitude <= 0.5 then return false end
    local now, feetY = os.clock(), FH.Feet(hum, root)
    local dir, reach = delta.Unit, math.min(delta.Magnitude, 3.4)
    local state = FH.StairWatch
    if
        state
        and state.hum == hum
        and state.root == root
        and state.filterAt == rayFilterAt
        and now - state.at < 0.15
        and Flat(root.Position - state.pos).Magnitude < 0.75
        and math.abs(feetY - state.feetY) < 0.2
        and math.abs(reach - state.reach) < 0.2
        and dir:Dot(state.dir) > 0.99
    then
        return state.stairs, state.feetY
    end
    FH.RefreshFilter()
    local token = FH.Motion and FH.Motion.token
    local physical = FH.TraversalOwned(token)
    local safe, traversal
    if physical then
        safe, traversal = FH.TraversalLane(token, hum, root, aim, feetY, reach, false)
    end
    local kind = safe == true and traversal
        or physical and safe == false and "wall"
        or FH.MotionProfile(hum, root, aim, feetY, reach)
    local stairs = safe == true and traversal == "stairs" or kind == "stairs"
    local verified = safe == true and traversal == "stairs"
    if physical and safe ~= false and not stairs then
        verified = FH.TraversalStairs(root, dir, feetY, reach, math.max(root.Size.X, root.Size.Z) * 0.5, Follow.BodyH)
            ~= nil
        stairs = verified
    end
    if kind == nil and not stairs then
        -- The final low riser may be below the lowest horizontal profile ray.
        -- Confirm raised support before paying for the full stair/body trace.
        local distance = math.min(reach, 1.3)
        local point = root.Position + dir * distance
        local floor = Workspace:Raycast(Vector3.new(point.X, feetY + 1.25, point.Z), Vector3.new(0, -2.3, 0), rayParams)
        if floor and floor.Normal.Y > 0.6 and floor.Position.Y > feetY + 0.1 then
            stairs = FH.StairLane(root.Position.X, root.Position.Z, dir, feetY, reach) ~= nil
        end
    end
    if stairs and not verified then
        stairs =
            Follow.PlanClear(root.Position, root.Position + dir * reach, feetY, reach, nil, nil, FH.BodyRadius(root))
    end
    FH.StairWatch = {
        hum = hum,
        root = root,
        filterAt = rayFilterAt,
        at = now,
        pos = root.Position,
        feetY = feetY,
        reach = reach,
        dir = dir,
        stairs = stairs,
    }
    return stairs, feetY
end
-- Supported upward stairs need repeated ordinary takeoffs, including when a
-- single failed hop makes no progress. Steering continues in this same frame.
function FH.StairJumpStep()
    local motion = FH.Motion
    if not motion or motion.token == nil or not motion.aim then return false end
    local now = os.clock()
    local hum, root = GetHumanoid(), RootNow()
    if FH.ExitTraversalClear and FH.ExitTraversalClear(motion.token, hum, root, motion.aim) then return false end
    if FH.AwaitingFloorRoute(motion.token, hum, root) then return false end
    if
        unloaded
        or not hum
        or not root
        or motion.hum ~= hum
        or hum.RootPart ~= root
        or hum.Health <= 0
        or hum.Sit
        or hum.PlatformStand
        or FH.JumpFlight
        or FH.Jmp
        or now - FH.LastJump < 0.55
        or Ctl.On()
        or Fly.Active
        or EM.ComboState
        or UserInputService:GetFocusedTextBox()
        or not FH.MotionActive()
        or FH.IsWorking(motion.token)
        or FH.IsHacking(motion.token)
        or FH.True(LocalPlayer, FH.CAP)
        or FH.True(LocalPlayer, FH.RAG)
        or (Follow.InputOwner == motion.token and (Follow.Held or Follow.KeyDown))
        or AR.Held
        or AR.KeyDown
        or TR.Held
        or TR.KeyDown
        or not FH.TakeoffSupported(hum, root)
    then
        return false
    end
    local recovery = FH.MoveWatch
    if
        recovery
        and recovery.token == motion.token
        and recovery.hum == hum
        and recovery.root == root
        and now - recovery.seen <= 0.7
        and (recovery.escape or (recovery.stairAttempts or 0) >= 3)
    then
        -- A hop without forward progress must hand back to sideways routing
        -- instead of starting another flight on every landing indefinitely.
        return false
    end
    local stairs, feetY = FH.StairProbe(hum, root, motion.aim)
    if not stairs or not FH.NormalJump(hum) then return false end
    -- This records steering/ground geometry only. It schedules no airborne
    -- second jump and leaves the game's speed and jump properties untouched.
    FH.JumpFlight = {
        t = os.clock(),
        hum = hum,
        root = root,
        token = motion.token,
        airborne = false,
        normal = true,
        feetY = feetY,
    }
    FH.ConfirmNormalTakeoff(hum, root, motion.token)
    if recovery and recovery.token == motion.token and recovery.hum == hum and recovery.root == root then
        recovery.stairAttempts = (recovery.stairAttempts or 0) + 1
    end
    return true
end
-- Periodic Space uses the event-maintained computer cache. Read positions at
-- the due press, including finished machines, without a world/descendant scan.
function FH.PeriodicComputerBlocked(root)
    local map = GetCurrentMap()
    if not map then return true end
    local known = false
    local function near(part)
        return part and part.Parent and part:IsA("BasePart") and (part.Position - root.Position).Magnitude <= 12
    end
    for _, comp in ipairs(Computers) do
        if comp.Parent and comp:IsDescendantOf(map) then
            -- An incomplete map/cache must not be treated as clear of computers.
            if not IsRealComputer(comp, map) then return true end
            known = true
            if near(comp:FindFirstChild("Screen")) then return true end
            for _, name in ipairs({ "ComputerTrigger", "ComputerTrigger1", "ComputerTrigger2", "ComputerTrigger3" }) do
                if near(comp:FindFirstChild(name)) then return true end
            end
            local cached = FH.CompTrigCache[comp]
            for _, trigger in ipairs(cached and cached.list or {}) do
                if trigger.Parent and trigger:IsDescendantOf(comp) and near(trigger) then return true end
            end
        end
    end
    return not known
end
