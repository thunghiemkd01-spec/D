    -- between ticks; requests from route planning never scan global queues inline.
    while examined < 64 and os.clock() < deadline do
        local job = nav.PromotionJobs[nav.PromotionHead]
        if not job then
            nav.PromotionJobs, nav.PromotionHead = {}, 1
