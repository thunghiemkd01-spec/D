        :gsub("[%z\1-\31\127]", " ")
        :gsub("\226\128[\139-\143\170-\174]", "")
        :gsub("\226\129[\160\166-\169]", "")
        :gsub("\239\187\191", "")
        :gsub("\194\173", "")
