function Fly.Start()
    if EM.ComboState then EM.Stop() end
    local root = RootNow()
    local hum = GetHumanoid()
    if not (root and hum) then return end
    Fly.Active = true
    Fly.Level = 1
    Fly.Speed = Fly.Speeds[1]
    Fly.BV = New("BodyVelocity", root, {
        Name = "NovaFlyBV",
        MaxForce = Vector3.new(1e9, 1e9, 1e9),
        Velocity = Vector3.zero,
    })
    Fly.BG = New("BodyGyro", root, {
        Name = "NovaFlyBG",
        MaxTorque = Vector3.new(1e9, 1e9, 1e9),
        P = 9e4,
        CFrame = root.CFrame,
    })
    hum.PlatformStand = true
    Fly.UpdateButton()
    Fly.Conn = RunService.RenderStepped:Connect(function()
        local r = RootNow()
        local h = GetHumanoid()
        local cam = Workspace.CurrentCamera
        if not (r and h and cam and Fly.BV and Fly.BV.Parent and Fly.BG) then
            Fly.Stop()
            return
        end
        local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
        if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end
        local move = h.MoveDirection
        local dir = look * move:Dot(flatLook) + right * move:Dot(flatRight)
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        end
        if dir.Magnitude > 1 then dir = dir.Unit end
        Fly.BV.Velocity = dir * Fly.Speed
        local _, camY = cam.CFrame:ToOrientation()
        Fly.BG.CFrame = CFrame.new(r.Position) * CFrame.fromOrientation(0, camY, 0)
    end)
end
