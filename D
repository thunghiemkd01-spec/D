    local state = CB.PodHelpState
    if not state then
        state = { chosen = math.random() < CB.PodHelpChance, at = os.clock() }
        CB.PodHelpState = state
    end
    if not state.chosen or state.attempted or not CB.CanSpeak() then return false end
    state.attempted = true
    local replies = {
