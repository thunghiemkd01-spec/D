function FH.GameInfo()
    local now = os.clock()
    local map = GetCurrentMap()
    local refresh = not FH.ValObjs or now - FH.InfoAt >= 1.5 or FH.InfoMap ~= map
    for _, value in ipairs(FH.ValObjs or {}) do
        if not value.Parent or not FH.InfoValues or FH.InfoValues[value] ~= value.Value then
            refresh = true
            break
        end
    end
    if refresh then
        FH.ScanAt = now
        local list, counts = {}, {}
        -- Round values live directly here or in one known state container.
        -- Scan those small child lists, never map templates or the whole service.
        local values = RepStore:GetChildren()
        for _, name in ipairs({ "GameState", "GameStats", "RoundState", "RoundStats" }) do
            local container = RepStore:FindFirstChild(name)
            if container then
                for _, value in ipairs(container:GetChildren()) do
                    values[#values + 1] = value
                end
            end
        end
        for _, d in ipairs(values) do
            local name, parent = string.lower(d.Name), d.Parent
            local stateContainer = parent
                and parent.Parent == RepStore
                and (
                    parent.Name == "GameState"
                    or parent.Name == "GameStats"
                    or parent.Name == "RoundState"
                    or parent.Name == "RoundStats"
                )
            local liveState = parent == RepStore or stateContainer
            if
                d:IsA("StringValue")
                and liveState
                and (
                    name == "gamestatus"
                    or name == "roundstatus"
                    or name == "gamemessage"
                    or name == "statusmessage"
                    or name == "status"
                )
            then
                list[#list + 1] = d
            end
            if
                (
                    name == "currentcomputers"
                    or name == "computersleft"
                    or name == "computersremaining"
                    or name == "compsleft"
                    or name == "computerleft"
                )
                and (d:IsA("IntValue") or d:IsA("NumberValue"))
                and liveState
            then
                counts[#counts + 1] = d
            end
        end
        FH.ValObjs = list
        FH.ComputerCountValues = counts
        FH.InfoAt, FH.InfoMap = now, map
        FH.InfoValues = {}
        local exitTxt, blocked, textCount = false, false, nil
        for _, v in ipairs(FH.ValObjs or {}) do
            if v.Parent then
                FH.InfoValues[v] = v.Value
                local t = string.lower(v.Value)
                local count = tonumber(
                    string.match(t, "computers%s+left%s*:%s*(%d+)")
                        or string.match(t, "computers%s+remaining%s*:%s*(%d+)")
                )
                if count then textCount = math.max(textCount or 0, count) end
                if t ~= "" and string.find(t, "exit", 1, true) then
                    local opened = string.find(t, "now open", 1, true)
                        or string.find(t, "are open", 1, true)
                        or string.find(t, "is open", 1, true)
                        or string.find(t, "opened", 1, true)
                        or string.find(t, "unlocked", 1, true)
                        or string.find(t, "find an exit", 1, true)
                        or string.find(t, "find the exit", 1, true)
                    local notYet = string.find(t, "will open", 1, true)
                        or string.find(t, "when ", 1, true)
                        or string.find(t, "until", 1, true)
                        or string.find(t, "closed", 1, true)
                        or string.find(t, "to open", 1, true)
                        or string.find(t, "%f[%a]locked%f[%A]")
                        or string.find(t, "not open", 1, true)
                        or string.find(t, "not unlocked", 1, true)
                        or string.find(t, "not yet", 1, true)
                        or string.find(t, "not been", 1, true)
                        or string.find(t, "isn't", 1, true)
                        or string.find(t, "aren't", 1, true)
                        or string.find(t, "cannot", 1, true)
                        or string.find(t, "can't", 1, true)
                    if notYet then blocked = true end
                    if opened and not notYet then exitTxt = true end
                end
            end
        end
        FH.Info = { exitTxt = exitTxt and not blocked, exitBlocked = blocked, textCount = textCount }
    end
    -- Read live counters even between status refreshes; a new round must revoke
    -- an old exit latch immediately. A positive count wins conflicting signals.
    local remaining = FH.Info.textCount
    for _, value in ipairs(FH.ComputerCountValues or {}) do
        local count = value.Parent and value.Value
        if type(count) == "number" and count >= 0 and count < math.huge and count == math.floor(count) then
            remaining = math.max(remaining or 0, count)
        end
    end
    FH.Info.computersLeft = remaining
    return FH.Info
end
