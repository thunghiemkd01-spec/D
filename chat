function Engine:plan(item, owner)
    local text, speaker = item.clean, item.speaker
    local values = {
        username = safeName(owner.name), display = safeName(owner.display),
        speaker = safeName(speaker and speaker.name), speakerdisplay = safeName(speaker and speaker.display),
    }
    local names = self.Topics.account_name
    for _, alias in ipairs({ "tom", "tommy", normalize(owner.name), normalize(owner.display) }) do
        if alias ~= "" and text == alias then return self.Topics.greet, values, nil, 1 end
    end
    -- Name questions are explicit, so a nickname answer never replaces a
    -- requested account username/display name or the other player's own name.
    if contains(text, "my name") or contains(text, "my username") or contains(text, "my display name") then
        if contains(text, "what") or contains(text, "whats") or contains(text, "remember") or contains(text, "know") then
            return names, values, { contains(text, "display") and 12 or 4 }, 1
        end
    end
    if contains(text, "real name") or contains(text, "personal name") then return names, values, { 18 }, 1 end
    if contains(text, "how old are you") or contains(text, "how old r u") or contains(text, "your age") then
        return self.Topics.chatbot_identity, values, { 30 }, 1
    end
    if contains(text, "where do you live") or contains(text, "where are you from") or contains(text, "where r u from") then
        return self.Topics.chatbot_identity, values, { 29 }, 1
    end
    if contains(text, "your username") or contains(text, "ur username") or contains(text, "your account")
        or (contains(text, "username") and self:addressed(text, owner)) then
        return names, values, { 5, 7, 8, 13, 16, 21, 24, 26, 30, 36, 40, 44, 48 }, 1
    end
    if contains(text, "your display name") or contains(text, "ur display name")
        or (contains(text, "display name") and self:addressed(text, owner)) then
        return names, values, { 6, 9, 14, 17, 22, 27, 31, 37, 41, 45, 49 }, 1
    end
    local answer = self:mathAnswer(item.raw, owner)
    if answer then values.answer = answer; return self.Topics.knowledge, values, { 45, 46, 47, 48, 49, 50 }, 1 end
    for _, fact in ipairs(Facts) do
        if contains(text, fact[1]) then return self.Topics.knowledge, values, { fact[2] }, 1 end
    end
    local session = speaker and self.Sessions[speaker.id]
    if session and self.Clock() - session.at <= self.Config.FollowWindow and session.phase < 4 then
        for kind, phrases in pairs(FollowSigns) do
            for _, phrase in ipairs(phrases) do
                if text == phrase then
                    local topic = self.Topics[session.tag]
                    if topic and topic.tag ~= "knowledge" and topic.tag ~= "account_name" then
                        -- Continue the same person's topic, not another user's.
                        -- Restrict short followups to responses rather than
                        -- repeatedly throwing unrelated initial questions back.
                        local pool = {}
                        for index, reply in ipairs(topic.replies) do
                            local question = reply:sub(-1) == "?"
                            if not question then
                                pool[#pool + 1] = index
                            end
                        end
                        return topic, values, pool, session.phase + 1
                    end
                end
            end
        end
    end
    local topic = self:topicFor(text) or self.Topics.clarify
    if topic == names then
        return topic, values, { 1, 2, 3, 10, 11, 15, 19, 20, 23, 25, 28, 32, 33, 34, 35, 38, 39, 42, 43, 46, 50 }, 1
    end
    if topic.tag == "knowledge" then
        local pool = {}
        for i = 1, 44 do pool[#pool + 1] = i end
        return topic, values, pool, 1
    end
    if topic.tag == "story" then
        local pool, requested = {}, contains(text, "tell me a story") or text == "story"
        for i = requested and 1 or 26, requested and 25 or 50 do pool[#pool + 1] = i end
        return topic, values, pool, 1
    end
    return topic, values, nil, 1
end

function Engine:render(template, values)
    local missing = false
    local text = template:gsub("{(%w+)}", function(key)
        local value = values[key]
        if not value or value == "" then missing = true; return "" end
        return value
    end)
    -- Public account identifiers can legitimately contain six digits or
    -- non-English characters. Validate the prose separately from trusted
    -- names read directly from Player, rather than silently hiding the name.
    local prose = template:gsub("{(%w+)}", function(key)
        if key == "username" or key == "display" or key == "speaker" or key == "speakerdisplay" then return "player" end
        return values[key] or ""
    end)
    return not missing and #text <= 190 and validReply(prose) and text or nil
end

function Engine:pick(topic, values, pool)
    local used, fresh, reusable = self.Used[topic.tag] or {}, {}, {}
    self.Used[topic.tag] = used
    local indices = pool
    if not indices then indices = {}; for i = 1, #topic.replies do indices[#indices + 1] = i end end
    for _, index in ipairs(indices) do
        local text = self:render(topic.replies[index], values)
        if text and not self.RecentSet[text] then
            local candidate = { text = text, index = index, tag = topic.tag }
            reusable[#reusable + 1] = candidate
            if not used[index] then fresh[#fresh + 1] = candidate end
        end
    end
    if #fresh == 0 and #reusable > 0 then
        -- Only this semantic pool resets, never another topic's history.
        for _, entry in ipairs(reusable) do used[entry.index] = nil end
        fresh = reusable
    end
    if #fresh > 0 then return fresh[self.Random(1, #fresh)] end
    -- A one-line fact/name answer can be exhausted by repetition. Ask for
    -- clarification instead of substituting a different fact or staying silent.
    if topic.tag ~= "clarify" then return self:pick(self.Topics.clarify, {}, nil) end
    return nil
end

function Engine:prepare(owner)
    local now = self.Clock()
    if self.Destroyed or not self.Enabled or self.Sending or now < self.NextSend then return nil end
    local item = self.Pending
    if item and (item.epoch ~= self.Epoch or now - item.at > self.Config.StaleAfter) then
        self.Pending = nil; self.DroppedCount += 1; item = nil
    end
    if not item then
        if not self.Config.AllowIdleOpeners or now - self.LastInbound < self.Config.IdleOpenerAfter
            or now - self.LastOutbound < self.Config.IdleOpenerAfter then return nil end
        item = { clean = "im bored", raw = "im bored", at = now, readyAt = now,
            priority = -1, epoch = self.Epoch, attempts = 0, opener = true }
    end
    if now < item.readyAt then return nil end
    local topic, values, pool, phase = self:plan(item, owner)
    local choice = self:pick(topic, values, pool)
    if not choice then return nil end
    if choice.tag ~= topic.tag then topic, phase = self.Topics[choice.tag], 1 end
    if self.Pending == item then self.Pending = nil end
    self.Sending = true
    return { item = item, topic = topic, choice = choice, phase = phase, epoch = self.Epoch }
end

function Engine:finish(job, success, reason)
    self.Sending = false
    local now = self.Clock()
    if success then
        self.LastOutbound, self.LastError = now, nil
        self.NextSend = now + self.Config.MinGap + self.Random() * (self.Config.MaxGap - self.Config.MinGap)
        self.SentCount += 1
        local text = job.choice.text
        self.Used[job.topic.tag] = self.Used[job.topic.tag] or {}
        self.Used[job.topic.tag][job.choice.index] = true
        self.Recent[#self.Recent + 1], self.RecentSet[text] = text, true
        while #self.Recent > self.Config.RecentBlock do self.RecentSet[table.remove(self.Recent, 1)] = nil end
        local speaker = job.item.speaker
        if not self.Destroyed and self.Enabled and self.Epoch == job.epoch and speaker then
            self.Sessions[speaker.id] = { tag = job.topic.tag, at = now, phase = job.phase }
        end
    else
        self.FailedCount += 1
        self.LastError, self.NextSend = tostring(reason or "chat unavailable"), now + self.Config.MinGap
        if not self.Destroyed and self.Enabled and job.epoch == self.Epoch and not self.Pending
            and job.item.attempts < 1 and now - job.item.at < self.Config.StaleAfter then
            job.item.attempts += 1
            job.item.readyAt = self.NextSend
            self.Pending = job.item
        end
    end
end

function Engine:prune()
    local now, count, oldest, oldestAt = self.Clock(), 0, nil, math.huge
    for id, session in pairs(self.Sessions) do
        if now - session.at > self.Config.FollowWindow then self.Sessions[id] = nil
        else
            count += 1
            if session.at < oldestAt then oldest, oldestAt = id, session.at end
        end
    end
    if count > self.Config.MaxSessions and oldest then self.Sessions[oldest] = nil end
    for key, entry in pairs(self.Seen) do if now - entry.at > 15 then self.Seen[key] = nil end end
    for id, at in pairs(self.MessageIds) do if now - at > 15 then self.MessageIds[id] = nil end end
end

-- ROBLOX_CLIENT_BOOTSTRAP
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then error("Tom Player must run in a Roblox client", 0) end

local environment = type(getgenv) == "function" and getgenv() or _G
local old = environment.TomPlayerChat
local previousNext, previousSent = 0, -math.huge
if type(old) == "table" then
    previousNext = tonumber(old.NextSendAt) or 0
    previousSent = tonumber(old.LastSentAt) or -math.huge
    if type(old.Destroy) == "function" then pcall(old.Destroy) end
end

local bot = Engine.new(Config)
-- Re-execution must not bypass the same client's send cooldown.
bot.NextSend = math.max(0, math.min(previousNext, os.clock() + Config.MaxGap))
bot.LastOutbound = math.min(previousSent, os.clock())
local state = { Destroyed = false, Connections = {}, PlayerConnections = {}, ClickTicket = 0, LastClick = -math.huge }
environment.TomPlayerChat = state

local gui = Instance.new("ScreenGui")
gui.Name = "TomStandalonePlayer"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 1000
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local button = Instance.new("TextButton")
button.Name = "ToggleX"
button.AnchorPoint = Vector2.new(1, 0)
button.Position = UDim2.new(1, -10, 0, 8)
button.Size = UDim2.fromOffset(28, 28)
button.BackgroundColor3 = Color3.fromRGB(20, 23, 28)
button.BackgroundTransparency = 0.15
button.BorderSizePixel = 0
button.Text = "X"
button.Font = Enum.Font.GothamBold
button.TextSize = 18
button.AutoButtonColor = false
button.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 7)
corner.Parent = button
local stroke = Instance.new("UIStroke")
stroke.Thickness = 1.2
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = button

local function repaint()
    local color = bot.Enabled and Color3.fromRGB(70, 230, 110) or Color3.fromRGB(255, 85, 85)
    button.TextColor3, stroke.Color = color, color
    button:SetAttribute("Enabled", bot.Enabled)
    button:SetAttribute("LastError", bot.LastError)
end

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    state.Connections[#state.Connections + 1] = connection
    return connection
end

function state.SetEnabled(value)
    if state.Destroyed then return end
    state.ClickTicket += 1
    state.LastClick = -math.huge
    bot:setEnabled(value)
    repaint()
end

function state.Destroy()
    if state.Destroyed then return end
    state.Destroyed = true
    state.ClickTicket += 1
    bot:destroy()
    if state.Worker and type(task.cancel) == "function" and coroutine.running() ~= state.Worker then
        pcall(task.cancel, state.Worker)
    end
    for _, connection in ipairs(state.Connections) do pcall(function() connection:Disconnect() end) end
    for _, connection in pairs(state.PlayerConnections) do pcall(function() connection:Disconnect() end) end
    table.clear(state.Connections)
    table.clear(state.PlayerConnections)
    if environment.TomPlayerChat == state then environment.TomPlayerChat = nil end
    gui:Destroy()
end

local parent
pcall(function() if type(gethui) == "function" then parent = gethui() end end)
if not parent then parent = game:GetService("CoreGui") end
local parented = pcall(function() gui.Parent = parent end)
if not parented then
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
    if not playerGui then state.Destroy(); error("Tom Player could not find PlayerGui", 0) end
    gui.Parent = playerGui
end

connect(button.Activated, function()
    if state.Destroyed then return end
    local now = os.clock()
    if now - state.LastClick <= Config.DoubleClickWindow then state.Destroy(); return end
    state.LastClick = now
    state.ClickTicket += 1
    local ticket = state.ClickTicket
    task.delay(Config.DoubleClickWindow, function()
        if not state.Destroyed and state.ClickTicket == ticket then state.SetEnabled(not bot.Enabled) end
    end)
end)

connect(UserInputService.InputBegan, function(input, processed)
    if state.Destroyed or processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Equals then state.SetEnabled(not bot.Enabled) end
end)
connect(gui.Destroying, function() state.Destroy() end)

local function ownerInfo()
    return { id = LocalPlayer.UserId, name = LocalPlayer.Name, display = LocalPlayer.DisplayName or LocalPlayer.Name }
end

local function publicChannel(channel)
    if not channel or not channel:IsA("TextChannel") then return false end
    local name = channel.Name:lower()
    return not name:find("whisper", 1, true) and not name:find("team", 1, true) and not name:find("system", 1, true)
end

local function receive(player, text, feed, messageId)
    if state.Destroyed or not player or player.Parent ~= Players then return end
    bot:receive({ id = player.UserId, name = player.Name, display = player.DisplayName or player.Name },
        text, feed, messageId, ownerInfo())
end

local function hookPlayer(player)
    if state.PlayerConnections[player] then return end
    state.PlayerConnections[player] = player.Chatted:Connect(function(text, recipient)
        -- Never echo a private whisper into public chat.
        if recipient ~= nil then return end
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then return end
        receive(player, text, "legacy")
    end)
end
for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
connect(Players.PlayerAdded, hookPlayer)
connect(Players.PlayerRemoving, function(player)
    local connection = state.PlayerConnections[player]
    if connection then connection:Disconnect(); state.PlayerConnections[player] = nil end
    bot.Sessions[player.UserId] = nil
    if bot.Pending and bot.Pending.speaker and bot.Pending.speaker.id == player.UserId then bot.Pending = nil end
end)

connect(TextChatService.MessageReceived, function(message)
    if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService or not message.TextSource then return end
    if not publicChannel(message.TextChannel) then return end
    local player = Players:GetPlayerByUserId(message.TextSource.UserId)
    receive(player, message.Text, "modern", message.MessageId)
end)

local function send(text)
    if state.Destroyed or not bot.Enabled then return false, "bot paused" end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channels = TextChatService:FindFirstChild("TextChannels")
        local channel = channels and channels:FindFirstChild("RBXGeneral")
        if not publicChannel(channel) then
            local config = TextChatService:FindFirstChild("ChatInputBarConfiguration")
            channel = config and config.TargetTextChannel
        end
        if not publicChannel(channel) then return false, "public chat channel unavailable" end
        local ok, result = pcall(function() return channel:SendAsync(text) end)
        if not ok then return false, tostring(result) end
        if result and result.Status and result.Status ~= Enum.TextChatMessageStatus.Success then
            return false, "Roblox chat did not accept the message"
        end
        return true
    end
    local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local remote = events and events:FindFirstChild("SayMessageRequest")
    if not remote then return false, "legacy public chat unavailable" end
    local ok, reason = pcall(function() remote:FireServer(text, "All") end)
    return ok, ok and nil or tostring(reason)
end

state.SetEnabled(Config.StartEnabled)
state.Worker = task.spawn(function()
    local nextPrune, lastWarning = 0, -math.huge
    while not state.Destroyed do
        local now = os.clock()
        if now >= nextPrune then bot:prune(); nextPrune = now + 2 end
        local job = bot:prepare(ownerInfo())
        if job then
            local success, reason = send(job.choice.text)
            bot:finish(job, success, reason)
            state.NextSendAt, state.LastSentAt = bot.NextSend, bot.LastOutbound
            if not state.Destroyed then
                repaint()
                if not success and now - lastWarning >= 30 then
                    lastWarning = now
                    warn("[Tom Player] " .. tostring(reason))
                end
            end
        end
        task.wait(bot.Enabled and 0.1 or 0.25)
    end
end)
