-- Tom Player: standalone AI-only chat client. No canned replies and no D dependency.
-- Same X interface: '=' / one click toggles; double-click unloads everything.
-- Configure a private Worker URL/token locally before executing; see chat-README.md.
local Config = {
    StartEnabled = false, MinGap = 5, MaxGap = 6, LongGap = 10,
    MaxQueue = 1, ReplyDeadline = 13.2, RequestTimeout = 11.5,
    FollowWindow = 120, RecentBlock = 30, ReplyDelay = 0.15,
    DoubleClickWindow = 0.3, MaxInputLength = 320, RequestGap = 2,
}
local Engine = {}
Engine.__index = Engine
local function normalize(text)
    return tostring(text or ""):lower():gsub("’", ""):gsub("'", ""):gsub("[^%w%s]", " "):gsub("%s+", " "):match("^%s*(.-)%s*$")
end
local function contains(text, phrase)
    return (" " .. text .. " "):find(" " .. phrase .. " ", 1, true) ~= nil
end
local function validReply(text)
    if type(text) ~= "string" or text == "" or #text > 190 or text ~= text:lower() then return false end
    if text:find("[%c{}\"`]") or text:find("[.!,:;]$") or text:find("http", 1, true) or text:find("@", 1, true) then return false end
    if contains(normalize(text), "on it") or text:find("[.!?]%s+%S") then return false end
    local words = 0; for _ in text:gmatch("%S+") do words += 1 end
    return words <= 12
end
function Engine.new(settings, clock, random)
    local self = setmetatable({}, Engine)
    self.Config, self.Clock, self.Random = table.clone(settings), clock or os.clock, random or math.random
    self.Enabled, self.Destroyed, self.Epoch, self.Serial = false, false, 0, 0
    self.Pending, self.Current, self.NextSend, self.NextRequest = nil, nil, 0, 0
    self.LastOutbound, self.LastError = -math.huge, nil
    self.Sessions, self.Seen, self.MessageIds, self.Used, self.Recent = {}, {}, {}, {}, {}
    self.SentCount, self.FailedCount, self.DroppedCount = 0, 0, 0
    return self
end
function Engine:cancel()
    if self.Current then self.Current.cancelled = true end
    self.Current = nil
end
function Engine:setEnabled(value)
    if self.Destroyed then return end
    self.Enabled = value == true; self.Epoch += 1; self.Pending = nil; self:cancel()
end
function Engine:destroy()
    self.Enabled, self.Destroyed = false, true; self.Epoch += 1; self.Pending = nil; self:cancel()
    table.clear(self.Sessions); table.clear(self.Seen); table.clear(self.MessageIds)
end
function Engine:addressed(text, owner)
    for _, alias in ipairs({ "tom", "tommy", normalize(owner.name), normalize(owner.display) }) do
        if alias ~= "" and contains(text, alias) then return true end
    end
    return false
end
function Engine:receive(speaker, raw, feed, id, owner)
    if self.Destroyed or not self.Enabled or not speaker or speaker.id == owner.id then return false end
    local text = tostring(raw or ""):sub(1, self.Config.MaxInputLength)
    if text:match("^%s*$") then return false end
    local clean, now = normalize(text), self.Clock()
    local key = tostring(speaker.id) .. ":" .. clean
    if id and id ~= "" and self.MessageIds[id] then return false end
    if id and id ~= "" then self.MessageIds[id] = now end
    local previous = self.Seen[key]
    if previous and previous.feed ~= feed and now - previous.at < 1.5 then return false end
    self.Seen[key] = { at = now, feed = feed }
    local first = clean:match("^%w+")
    local question = text:find("?", 1, true) or first == "what" or first == "why" or first == "how" or first == "who" or first == "where"
    local priority = self:addressed(clean, owner) and 3 or question and 2 or 0
    local pending = self.Pending
    if pending and now < pending.deadline and pending.priority > priority then self.DroppedCount += 1; return false end
    local current = self.Current
    if current and not current.sending and current.item.priority <= priority then self:cancel() end
    if pending then self.DroppedCount += 1 end
    self.Pending = { speaker = speaker, raw = text, at = now, deadline = now + self.Config.ReplyDeadline,
        readyAt = now + self.Config.ReplyDelay, priority = priority, epoch = self.Epoch }
    return true
end
function Engine:prepare(owner)
    local now = self.Clock()
    if self.Current and (self.Current.cancelled or now >= self.Current.item.deadline) and not self.Current.sending then
        self.DroppedCount += 1; self:cancel()
    end
    if self.Destroyed or not self.Enabled or self.Current or now < self.NextRequest then return nil end
    local item = self.Pending
    if not item then return nil end
    if item.epoch ~= self.Epoch or now >= item.deadline or self.NextSend >= item.deadline then
        self.Pending = nil; self.DroppedCount += 1; return nil
    end
    if now < item.readyAt then return nil end
    self.Pending = nil; self.Serial += 1; self.NextRequest = now + self.Config.RequestGap
    local session = self.Sessions[item.speaker.id]
    local history = session and now - session.at <= self.Config.FollowWindow and table.clone(session.messages) or {}
    local job = { item = item, epoch = self.Epoch, id = "tom-" .. self.Epoch .. "-" .. self.Serial .. "-" .. tostring(now),
        requestDeadline = math.min(now + self.Config.RequestTimeout, item.deadline - 0.3), owner = owner, history = history }
    self.Current = job
    return job
end
function Engine:complete(job, reply, reason)
    if self.Current ~= job or job.cancelled or job.epoch ~= self.Epoch or self.Destroyed or not self.Enabled then return false end
    if self.Clock() >= job.requestDeadline or self.Clock() >= job.item.deadline then
        self.LastError = "API response arrived too late"; self.FailedCount += 1; self:cancel(); return false
    end
    if not validReply(reply) or self.Used[reply] then
        self.LastError = reason or "No valid new AI reply"; self.FailedCount += 1; self:cancel(); return false
    end
    job.reply = reply
    self.LastError = nil
    return true
end
function Engine:ready()
    local job, now = self.Current, self.Clock()
    if not job or job.cancelled or job.sending or not job.reply or not self.Enabled or self.Destroyed then return nil end
    if now >= job.item.deadline or job.epoch ~= self.Epoch then self:cancel(); return nil end
    if now < self.NextSend then return nil end
    job.sending = true
    return job
end
function Engine:finish(job, success, reason)
    if self.Current == job then self.Current = nil end
    local now = self.Clock()
    if not success then self.LastError = tostring(reason or "Roblox chat unavailable"); self.FailedCount += 1; return end
    self.Used[job.reply] = true; self.Recent[#self.Recent + 1] = job.reply
    while #self.Recent > self.Config.RecentBlock do table.remove(self.Recent, 1) end
    self.SentCount += 1; self.LastOutbound, self.LastError = now, nil
    self.NextSend = now + (#job.reply > 20 and self.Config.LongGap or self.Config.MinGap + self.Random() * (self.Config.MaxGap - self.Config.MinGap))
    if self.Enabled and not self.Destroyed and job.epoch == self.Epoch then
        local messages = table.clone(job.history)
        messages[#messages + 1] = { role = "user", content = job.item.raw }
        messages[#messages + 1] = { role = "assistant", content = job.reply }
        while #messages > 10 do table.remove(messages, 1) end
        self.Sessions[job.item.speaker.id] = { at = now, messages = messages }
    end
end
function Engine:prune()
    local now = self.Clock()
    for id, session in pairs(self.Sessions) do if now - session.at > self.Config.FollowWindow then self.Sessions[id] = nil end end
    for key, entry in pairs(self.Seen) do if now - entry.at > 15 then self.Seen[key] = nil end end
    for id, at in pairs(self.MessageIds) do if now - at > 15 then self.MessageIds[id] = nil end end
end

-- ROBLOX_CLIENT_BOOTSTRAP
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then error("Tom Player must run in a Roblox client", 0) end

local environment = type(getgenv) == "function" and getgenv() or _G
local old = environment.TomPlayerChat
local previousNext, previousSent = 0, -math.huge
if type(old) == "table" then
    previousNext = tonumber(old.NextSendAt) or 0
    previousSent = tonumber(old.LastSentAt) or -math.huge
    if type(old.Destroy) == "function" then pcall(old.Destroy) end
end

local bot = Engine.new(Config)
-- Re-execution must not bypass the same client's send cooldown.
bot.NextSend = math.max(0, math.min(previousNext, os.clock() + Config.MaxGap))
bot.LastOutbound = math.min(previousSent, os.clock())
local state = { Destroyed = false, Connections = {}, PlayerConnections = {}, ClickTicket = 0, LastClick = -math.huge }
environment.TomPlayerChat = state

local gui = Instance.new("ScreenGui")
gui.Name = "TomStandalonePlayer"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 1000
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local button = Instance.new("TextButton")
button.Name = "ToggleX"
button.AnchorPoint = Vector2.new(1, 0)
button.Position = UDim2.new(1, -10, 0, 8)
button.Size = UDim2.fromOffset(28, 28)
button.BackgroundColor3 = Color3.fromRGB(20, 23, 28)
button.BackgroundTransparency = 0.15
button.BorderSizePixel = 0
button.Text = "X"
button.Font = Enum.Font.GothamBold
button.TextSize = 18
button.AutoButtonColor = false
button.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 7)
corner.Parent = button
local stroke = Instance.new("UIStroke")
stroke.Thickness = 1.2
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = button

local function repaint()
    local color = bot.Enabled and Color3.fromRGB(70, 230, 110) or Color3.fromRGB(255, 85, 85)
    button.TextColor3, stroke.Color = color, color
    button:SetAttribute("Enabled", bot.Enabled)
    button:SetAttribute("LastError", bot.LastError)
end

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    state.Connections[#state.Connections + 1] = connection
    return connection
end

function state.SetEnabled(value)
    if state.Destroyed then return end
    state.ClickTicket += 1
    state.LastClick = -math.huge
    bot:setEnabled(value)
    repaint()
end

function state.Destroy()
    if state.Destroyed then return end
    state.Destroyed = true
    state.ClickTicket += 1
    bot:destroy()
    for job, thread in pairs(state.RequestThreads or {}) do
        job.cancelled = true
        if type(task.cancel) == "function" and coroutine.running() ~= thread then pcall(task.cancel, thread) end
    end
    table.clear(state.RequestThreads or {})
    if state.Worker and type(task.cancel) == "function" and coroutine.running() ~= state.Worker then
        pcall(task.cancel, state.Worker)
    end
    for _, connection in ipairs(state.Connections) do pcall(function() connection:Disconnect() end) end
    for _, connection in pairs(state.PlayerConnections) do pcall(function() connection:Disconnect() end) end
    table.clear(state.Connections)
    table.clear(state.PlayerConnections)
    if environment.TomPlayerChat == state then environment.TomPlayerChat = nil end
    gui:Destroy()
end

local parent
pcall(function() if type(gethui) == "function" then parent = gethui() end end)
if not parent then parent = game:GetService("CoreGui") end
local parented = pcall(function() gui.Parent = parent end)
if not parented then
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
    if not playerGui then state.Destroy(); error("Tom Player could not find PlayerGui", 0) end
    gui.Parent = playerGui
end

connect(button.Activated, function()
    if state.Destroyed then return end
    local now = os.clock()
    if now - state.LastClick <= Config.DoubleClickWindow then state.Destroy(); return end
    state.LastClick = now
    state.ClickTicket += 1
    local ticket = state.ClickTicket
    task.delay(Config.DoubleClickWindow, function()
        if not state.Destroyed and state.ClickTicket == ticket then state.SetEnabled(not bot.Enabled) end
    end)
end)

connect(UserInputService.InputBegan, function(input, processed)
    if state.Destroyed or processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Equals then state.SetEnabled(not bot.Enabled) end
end)
connect(gui.Destroying, function() state.Destroy() end)

local function ownerInfo()
    return { id = LocalPlayer.UserId, name = LocalPlayer.Name, display = LocalPlayer.DisplayName or LocalPlayer.Name }
end

local function publicChannel(channel)
    if not channel or not channel:IsA("TextChannel") then return false end
    local name = channel.Name:lower()
    return not name:find("whisper", 1, true) and not name:find("team", 1, true) and not name:find("system", 1, true)
end

local function receive(player, text, feed, messageId)
    if state.Destroyed or not player or player.Parent ~= Players then return end
    bot:receive({ id = player.UserId, name = player.Name, display = player.DisplayName or player.Name },
        text, feed, messageId, ownerInfo())
end

local function hookPlayer(player)
    if state.PlayerConnections[player] then return end
    state.PlayerConnections[player] = player.Chatted:Connect(function(text, recipient)
        -- Never echo a private whisper into public chat.
        if recipient ~= nil then return end
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then return end
        receive(player, text, "legacy")
    end)
end
for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
connect(Players.PlayerAdded, hookPlayer)
connect(Players.PlayerRemoving, function(player)
    local connection = state.PlayerConnections[player]
    if connection then connection:Disconnect(); state.PlayerConnections[player] = nil end
    bot.Sessions[player.UserId] = nil
    if bot.Current and bot.Current.item.speaker.id == player.UserId and not bot.Current.sending then bot:cancel() end
    if bot.Pending and bot.Pending.speaker and bot.Pending.speaker.id == player.UserId then bot.Pending = nil end
end)

connect(TextChatService.MessageReceived, function(message)
    if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService or not message.TextSource then return end
    if not publicChannel(message.TextChannel) then return end
    local player = Players:GetPlayerByUserId(message.TextSource.UserId)
    receive(player, message.Text, "modern", message.MessageId)
end)

local function send(text)
    if state.Destroyed or not bot.Enabled then return false, "bot paused" end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channels = TextChatService:FindFirstChild("TextChannels")
        local channel = channels and channels:FindFirstChild("RBXGeneral")
        if not publicChannel(channel) then
            local config = TextChatService:FindFirstChild("ChatInputBarConfiguration")
            channel = config and config.TargetTextChannel
        end
        if not publicChannel(channel) then return false, "public chat channel unavailable" end
        local ok, result = pcall(function() return channel:SendAsync(text) end)
        if not ok then return false, tostring(result) end
        if result and result.Status and result.Status ~= Enum.TextChatMessageStatus.Success then
            return false, "Roblox chat did not accept the message"
        end
        return true
    end
    local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local remote = events and events:FindFirstChild("SayMessageRequest")
    if not remote then return false, "legacy public chat unavailable" end
    local ok, reason = pcall(function() remote:FireServer(text, "All") end)
    return ok, ok and nil or tostring(reason)
end

-- Only this private bridge is called; provider keys stay on the Worker.
local HttpService = game:GetService("HttpService")
state.RequestThreads = {}
local function requester()
    if type(request) == "function" then return request end
    if type(http_request) == "function" then return http_request end
    if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
    if type(http) == "table" and type(http.request) == "function" then return http.request end
    return nil
end
local function bridge(job)
    local private = environment.TomPlayerAPI
    if type(private) ~= "table" then return nil, "Set getgenv().TomPlayerAPI locally first" end
    local endpoint, token = private.ProxyEndpoint, private.ProxyToken
    if type(endpoint) ~= "string" or not endpoint:match("^https://[^/%s]+/chat/?$") then
        return nil, "ProxyEndpoint must be your HTTPS Worker /chat URL"
    end
    if type(token) ~= "string" or #token < 16 then return nil, "Private BOT_TOKEN is missing" end
    local call = requester()
    if not call then return nil, "This executor has no supported HTTPS request function" end
    local body = HttpService:JSONEncode({ requestId = job.id, message = job.item.raw,
        account = { username = job.owner.name, displayName = job.owner.display },
        speaker = { username = job.item.speaker.name, displayName = job.item.speaker.display },
        history = job.history, recent = table.clone(bot.Recent) })
    local ok, response = pcall(call, { Url = endpoint, Method = "POST", Body = body,
        Headers = { ["Content-Type"] = "application/json", Authorization = "Bearer " .. token },
        Timeout = math.max(0.2, job.requestDeadline - os.clock()) })
    if not ok or type(response) ~= "table" then return nil, "Bridge connection failed" end
    local status = tonumber(response.StatusCode or response.Status)
    local decodedOK, decoded = pcall(function() return HttpService:JSONDecode(response.Body or "") end)
    if status ~= 200 then
        local detail = ""
        if decodedOK and type(decoded) == "table" then
            if type(decoded.error) == "string" and decoded.error:match("^[%w_]+$") then detail = " (" .. decoded.error .. ")" end
            if type(decoded.attempts) == "table" then
                for index, attempt in ipairs(decoded.attempts) do
                    if index > 7 then break end
                    if type(attempt) == "table" and type(attempt.provider) == "string" and type(attempt.error) == "string"
                        and attempt.provider:match("^[%a_]+$") and attempt.error:match("^[%w_]+$") then
                        detail ..= " " .. attempt.provider .. ":" .. attempt.error
                    end
                end
            end
        end
        return nil, "Bridge HTTP " .. tostring(status or "unknown") .. detail
    end
    if not decodedOK or type(decoded) ~= "table" or decoded.requestId ~= job.id or type(decoded.reply) ~= "string" then
        return nil, "Bridge returned an invalid response"
    end
    return decoded.reply:lower(), nil
end
local function cancelRequest(job, thread)
    if type(task.cancel) == "function" and coroutine.running() ~= thread then pcall(task.cancel, thread) end
    state.RequestThreads[job] = nil
end
state.SetEnabled(Config.StartEnabled)
state.Worker = task.spawn(function()
    local nextPrune, lastWarning = 0, -math.huge
    while not state.Destroyed do
        local now = os.clock()
        if now >= nextPrune then bot:prune(); nextPrune = now + 2 end
        for job, thread in pairs(state.RequestThreads) do
            if job.cancelled or job.epoch ~= bot.Epoch or now >= job.requestDeadline then
                if bot.Current == job then bot.LastError = "API request deadline exceeded"; bot.FailedCount += 1; bot:cancel() end
                cancelRequest(job, thread)
            end
        end
        local job = bot:prepare(ownerInfo())
        if job then
            local thread = task.spawn(function()
                local ok, reply, reason = pcall(bridge, job)
                if not ok then reply, reason = nil, "Bridge request failed" end
                bot:complete(job, reply, reason)
                job.requestFinished = true
                state.RequestThreads[job] = nil
            end)
            if not job.requestFinished then state.RequestThreads[job] = thread end
        end
        local ready = bot:ready()
        if ready then
            local success, reason = send(ready.reply)
            bot:finish(ready, success, reason)
            state.NextSendAt, state.LastSentAt = bot.NextSend, bot.LastOutbound
        end
        if not state.Destroyed then
            repaint()
            if bot.LastError and now - lastWarning >= 30 then lastWarning = now; warn("[Tom Player] " .. bot.LastError) end
        end
        task.wait(bot.Enabled and 0.05 or 0.25)
    end
end)
