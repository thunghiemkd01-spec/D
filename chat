-- Pure matching/queue engine: no Roblox movement, remote hacks or API calls.
local Engine = {}
Engine.__index = Engine

local function normalize(text)
    return tostring(text or ""):lower():gsub("’", ""):gsub("'", ""):gsub("[^%w%s]", " "):gsub("%s+", " "):match("^%s*(.-)%s*$")
end

local function contains(text, phrase)
    return (" " .. text .. " "):find(" " .. phrase .. " ", 1, true) ~= nil
end

local function safeName(value)
    return tostring(value or ""):gsub("[%c]", ""):sub(1, 80):lower()
end

local function validReply(text)
    if type(text) ~= "string" or text == "" or #text > 190 then return false end
    if text ~= text:lower() or text:find("[.!,:;]$") then return false end
    if contains(normalize(text), "on it") or text:find("http", 1, true) or text:find("@", 1, true) then return false end
    if text:find("%d%d%d%d%d%d") or text:find("[%c{}]") then return false end
    local words = 0
    for _ in text:gmatch("%S+") do words += 1 end
    return words <= 12
end

function Engine.new(settings, clock, random)
    local self = setmetatable({}, Engine)
    self.Config = table.clone(settings)
    self.Clock, self.Random = clock or os.clock, random or math.random
    self.Enabled, self.Destroyed, self.Sending, self.Epoch = false, false, false, 0
    self.Pending, self.NextSend = nil, 0
    self.LastInbound, self.LastOutbound = self.Clock(), -math.huge
    self.Sessions, self.Seen, self.MessageIds = {}, {}, {}
    self.Recent, self.RecentSet, self.Used = {}, {}, {}
    self.Topics, self.Index, self.LastError = {}, {}, nil
    self.SentCount, self.DroppedCount, self.FailedCount = 0, 0, 0
    for _, topic in ipairs(Bank) do
        self.Topics[topic.tag] = topic
        for _, trigger in ipairs(topic.triggers) do
            local phrase = normalize(trigger)
            if phrase ~= "" then
                local rows = self.Index[phrase]
                if not rows then rows = {}; self.Index[phrase] = rows end
                rows[#rows + 1] = topic
            end
        end
    end
    return self
end

function Engine:setEnabled(value)
    if self.Destroyed then return end
    self.Enabled = value == true
    self.Epoch += 1
    self.Pending = nil
    self.LastInbound = self.Clock()
    if self.Enabled then self.NextSend = math.max(self.NextSend, self.Clock() + 0.2) end
end

function Engine:destroy()
    self.Destroyed, self.Enabled = true, false
    self.Epoch += 1
    self.Pending = nil
    table.clear(self.Sessions)
    table.clear(self.Seen)
    table.clear(self.MessageIds)
end

function Engine:addressed(text, owner)
    for _, alias in ipairs({ "tom", "tommy", normalize(owner.name), normalize(owner.display) }) do
        if alias ~= "" and contains(text, alias) then return true end
    end
    return false
end

function Engine:receive(speaker, raw, feed, messageId, owner)
    if self.Destroyed then return false end
    self.LastInbound = self.Clock()
    if not self.Enabled or not speaker or speaker.id == owner.id then return false end
    local text = tostring(raw or ""):sub(1, self.Config.MaxInputLength)
    local clean = normalize(text)
    if clean == "" then clean = "unclear message" end
    local now, key = self.Clock(), tostring(speaker.id) .. ":" .. clean
    if messageId and messageId ~= "" and self.MessageIds[messageId] then return false end
    if messageId and messageId ~= "" then self.MessageIds[messageId] = now end
    local previous = self.Seen[key]
    if previous and previous.feed ~= feed and now - previous.at < 1.5 then return false end
    self.Seen[key] = { at = now, feed = feed }
    local priority = self:addressed(clean, owner) and 3 or 0
    if priority < 3 and text:find("?", 1, true) then priority = 2 end
    if priority < 2 then
        local first = clean:match("^%w+")
        if first == "what" or first == "why" or first == "how" or first == "where" or first == "who" then priority = 2 end
    end
    local pending = self.Pending
    if pending and now - pending.at <= self.Config.StaleAfter and pending.priority > priority then
        self.DroppedCount += 1
        return false
    end
    if pending then self.DroppedCount += 1 end
    self.Pending = {
        speaker = speaker, raw = text, clean = clean, at = now,
        readyAt = now + self.Config.ReplyDelay, priority = priority,
        epoch = self.Epoch, attempts = 0,
    }
    return true
end

function Engine:topicFor(text)
    local words, votes, best, score = {}, {}, nil, -1
    for word in text:gmatch("%S+") do words[#words + 1] = word end
    -- At most 6-word phrases from one bounded message; never scan 2,000 lines.
    for i = 1, #words do
        local phrase = ""
        for j = i, math.min(#words, i + 5) do
            phrase = phrase == "" and words[j] or phrase .. " " .. words[j]
            for _, topic in ipairs(self.Index[phrase] or {}) do
                local weight = (j - i + 1) * 8 + math.min(#phrase, 30) * 0.1
                if topic.tag == "clarify" then weight = weight * 0.15 end
                votes[topic] = (votes[topic] or 0) + weight
            end
        end
    end
    -- Stable bank order resolves ties instead of hash-table traversal order.
    for _, topic in ipairs(Bank) do
        local value = votes[topic]
        if value and value > score then best, score = topic, value end
    end
    return best
end

function Engine:mathAnswer(raw, owner)
    local text = tostring(raw):lower():gsub("’", ""):gsub("'", ""):gsub("×", "*"):gsub("÷", "/"):gsub("[?=]+%s*$", "")
    for _, alias in ipairs({ "tommy", "tom", safeName(owner.name), safeName(owner.display) }) do
        if alias ~= "" and text:sub(1, #alias) == alias and text:sub(#alias + 1, #alias + 1):match("[%s,:]") then
            text = text:sub(#alias + 1):gsub("^[%s,:]+", "")
        end
    end
    text = text:gsub("^%s*what is%s+", ""):gsub("^%s*whats%s+", ""):gsub("^%s*how much is%s+", ""):gsub("^%s*calculate%s+", "")
    local a, op, b = text:match("^%s*([%-+]?%d+%.?%d*)%s*([+*/%%%^%-])%s*([%-+]?%d+%.?%d*)%s*$")
    a, b = tonumber(a), tonumber(b)
    if not a or not b or math.abs(a) > 1e9 or math.abs(b) > 1e9 then return nil end
    local value
    if (op == "/" or op == "%") and b == 0 then return "undefined" end
    if op == "+" then value = a + b
    elseif op == "-" then value = a - b
    elseif op == "*" then value = a * b
    elseif op == "/" then value = a / b
    elseif op == "%" then value = a % b
    elseif op == "^" and math.abs(b) <= 12 then value = a ^ b end
    if not value or value ~= value or math.abs(value) == math.huge then return nil end
    return math.abs(value) < 100000 and tostring(value) or string.format("%.4g", value)
end

